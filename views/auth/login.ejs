<%- include('../partials/head') %>
<div class="page-content">
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="content d-flex justify-content-center align-items-center">
        <form method="post" action="/login" class="login-form wmin-sm-400">
          <div class="card mb-0">
            <div class="card-body">
              <div class="text-center mb-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-pill p-3 mb-3">
                  <span class="fw-bold fs-lg">S</span>
                </div>
                <h5 class="mb-0"><%= branding.appName %></h5>
                <span class="d-block text-muted">Admin-only enquiry CRM</span>
              </div>
              <% if (flash) { %><div class="alert alert-warning"><%= flash %></div><% } %>
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="email" required value="admin@example.com">
              </div>
              <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" name="password" required value="change-me">
              </div>
              <button type="submit" class="btn btn-primary w-100">Sign in <i class="ph-sign-in ms-2"></i></button>
              <div class="form-text text-muted mt-3">Change default credentials in <code>.env</code> before production use.</div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
</body>
</html>
