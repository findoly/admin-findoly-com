<%- include('../partials/pageStart', { subtitle: 'Search messages and communication logs' }) %>
<%- include('../partials/searchTabs') %>

<div class="card">
  <div class="card-header d-sm-flex align-items-sm-center py-sm-0">
    <div>
      <h5 class="py-sm-2 my-sm-1 mb-0">Communication Search</h5>
      <div class="text-muted fs-sm">Search only communication logs. Use View to open the related enquiry when available.</div>
    </div>
    <div class="mt-2 mt-sm-0 ms-sm-auto"><span class="badge bg-primary rounded-pill"><%= pagination.total %> found</span></div>
  </div>
  <div class="card-body border-top">
    <form method="get" class="row g-3 align-items-end">
      <div class="col-xl-4 col-lg-6"><label class="form-label">Search text</label><div class="form-control-feedback form-control-feedback-start"><input class="form-control" name="q" placeholder="Recipient, contact, message, enquiry ID..." value="<%= filters.q || filters.search || '' %>"><div class="form-control-feedback-icon"><i class="ph-magnifying-glass"></i></div></div></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All statuses</option><% statuses.forEach((status)=>{ %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= humanize(status) %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Channel</label><select class="form-select" name="channel"><option value="">All channels</option><% ['call','whatsapp','sms','email','note'].forEach((channel)=>{ %><option value="<%= channel %>" <%= filters.channel === channel ? 'selected' : '' %>><%= humanize(channel) %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Enquiry ID</label><input class="form-control" name="enquiryId" placeholder="enq_..." value="<%= filters.enquiryId || '' %>"></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><label class="form-label">Per page</label><select class="form-select" name="pageSize"><% [10,25,50,100].forEach((size)=>{ %><option value="<%= size %>" <%= String(filters.pageSize || 25) === String(size) ? 'selected' : '' %>><%= size %></option><% }) %></select></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><button class="btn btn-primary w-100" type="submit"><i class="ph-magnifying-glass me-2"></i>Search</button></div>
    </form>
  </div>
  <div class="table-responsive">
    <table class="table text-nowrap">
      <thead><tr><th>Recipient</th><th>Channel</th><th>Direction</th><th>Message</th><th>Enquiry</th><th>Provider</th><th>Status</th><th>Created</th><th class="text-center" style="width:120px">Action</th></tr></thead>
      <tbody>
        <% records.forEach((item) => { %>
          <tr>
            <td><div class="fw-semibold"><%= item.recipientName || '-' %></div><div class="text-muted fs-sm"><%= item.recipientContact || '-' %></div></td>
            <td><%= humanize(item.channel) %></td>
            <td><%= humanize(item.direction) %></td>
            <td><div class="text-truncate" style="max-width:320px"><%= item.message || '-' %></div></td>
            <td><% if (item.enquiryId) { %><a href="/enquiries/<%= item.enquiryId %>"><%= item.enquiryId %></a><% } else { %>-<% } %></td>
            <td><% if (item.providerId) { %><a href="/providers/<%= item.providerId %>"><%= item.providerId %></a><% } else { %>-<% } %></td>
            <td><%- include('../partials/statusBadge', { value: item.status, humanize }) %></td>
            <td><%= formatDate(item.createdAt) %></td>
            <td class="text-center"><div class="d-inline-flex gap-1"><a href="/communications/<%= item.id %>" class="btn btn-outline-primary btn-sm"><i class="ph-eye me-1"></i>View</a><a href="/communications/<%= item.id %>/edit" class="btn btn-outline-secondary btn-sm"><i class="ph-pencil me-1"></i>Edit</a></div></td>
          </tr>
        <% }) %>
        <% if (!records.length) { %><tr><td colspan="9" class="text-center text-muted py-4">No communications found.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination }) %>
</div>

<%- include('../partials/pageEnd') %>
