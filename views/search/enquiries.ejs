<%- include('../partials/pageStart', { subtitle: 'Search enquiry records' }) %>
<%- include('../partials/searchTabs') %>

<div class="card">
  <div class="card-header d-sm-flex align-items-sm-center py-sm-0">
    <div>
      <h5 class="py-sm-2 my-sm-1 mb-0">Enquiry Search</h5>
      <div class="text-muted fs-sm">Search only enquiry records. Use View to inspect full enquiry and Edit to update customer, source, assignment and dynamic form fields.</div>
    </div>
    <div class="mt-2 mt-sm-0 ms-sm-auto d-flex gap-2">
      <span class="badge bg-primary rounded-pill align-self-center"><%= pagination.total %> found</span>
      <a href="/enquiries/new" class="btn btn-primary btn-sm"><i class="ph-plus me-2"></i>Create enquiry</a>
    </div>
  </div>
  <div class="card-body border-top">
    <form method="get" class="row g-3 align-items-end">
      <div class="col-xl-3 col-lg-4">
        <label class="form-label">Search text</label>
        <div class="form-control-feedback form-control-feedback-start">
          <input class="form-control" name="q" placeholder="Customer, phone, city, external ID..." value="<%= filters.q || filters.search || '' %>">
          <div class="form-control-feedback-icon"><i class="ph-magnifying-glass"></i></div>
        </div>
      </div>
      <div class="col-xl-2 col-lg-4 col-sm-6"><label class="form-label">Website</label><select class="form-select" name="sourceWebsite"><option value="">All websites</option><% sourceWebsites.forEach((site)=>{ %><option value="<%= site %>" <%= filters.sourceWebsite === site ? 'selected' : '' %>><%= site %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-4 col-sm-6"><label class="form-label">Category</label><select class="form-select" name="categorySlug"><option value="">All categories</option><% categories.forEach((category)=>{ %><option value="<%= category.slug %>" <%= filters.categorySlug === category.slug ? 'selected' : '' %>><%= category.name %> — <%= category.sourceWebsite || 'any' %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-4 col-sm-6"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All statuses</option><% statuses.forEach((status)=>{ %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= humanize(status) %></option><% }) %></select></div>
      <div class="col-xl-1 col-lg-4 col-sm-6"><label class="form-label">Form</label><input class="form-control" name="formType" placeholder="default" value="<%= filters.formType || '' %>"></div>
      <div class="col-xl-1 col-lg-2 col-sm-6"><label class="form-label">Per page</label><select class="form-select" name="pageSize"><% [10,25,50,100].forEach((size)=>{ %><option value="<%= size %>" <%= String(filters.pageSize || 25) === String(size) ? 'selected' : '' %>><%= size %></option><% }) %></select></div>
      <div class="col-xl-1 col-lg-2 col-sm-6"><button class="btn btn-primary w-100" type="submit"><i class="ph-magnifying-glass me-2"></i>Search</button></div>
    </form>
  </div>
  <div class="table-responsive">
    <table class="table text-nowrap">
      <thead><tr><th>Enquiry</th><th>Customer</th><th>Website / form</th><th>Address</th><th>Priority</th><th>Status</th><th>Provider</th><th>Updated</th><th class="text-center" style="width:160px">Action</th></tr></thead>
      <tbody>
        <% records.forEach((enquiry) => { %>
          <tr>
            <td><div class="fw-semibold"><%= enquiry.id %></div><div class="text-muted fs-sm"><%= enquiry.serviceType || humanize(enquiry.categorySlug) %></div></td>
            <td><div class="fw-semibold"><%= enquiry.customer?.name || '-' %></div><div class="text-muted fs-sm"><%= enquiry.customer?.mobile || '-' %> <%= enquiry.customer?.email || '' %></div></td>
            <td><div><%= enquiry.sourceWebsite || '-' %></div><div class="text-muted fs-sm"><%= [enquiry.categorySlug, enquiry.formType, enquiry.source?.channel].filter(Boolean).join(' · ') %></div></td>
            <td><%= [enquiry.address?.city, enquiry.address?.state, enquiry.address?.pincode].filter(Boolean).join(', ') || '-' %></td>
            <td><%- include('../partials/statusBadge', { value: enquiry.priority, humanize }) %></td>
            <td><%- include('../partials/statusBadge', { value: enquiry.status, humanize }) %></td>
            <td><%= enquiry.assignedProviderName || '-' %></td>
            <td><%= formatDate(enquiry.updatedAt || enquiry.createdAt) %></td>
            <td class="text-center"><div class="d-inline-flex gap-2"><a href="/enquiries/<%= enquiry.id %>" class="btn btn-outline-primary btn-sm"><i class="ph-eye me-1"></i>View</a><a href="/enquiries/<%= enquiry.id %>/edit" class="btn btn-light btn-sm"><i class="ph-pencil-simple me-1"></i>Edit</a></div></td>
          </tr>
        <% }) %>
        <% if (!records.length) { %><tr><td colspan="9" class="text-center text-muted py-4">No enquiries found.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination }) %>
</div>

<%- include('../partials/pageEnd') %>
