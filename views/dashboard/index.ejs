<%- include('../partials/pageStart', { subtitle: 'Dashboard' }) %>

<div class="row">
  <% const queueColor = { new: 'primary', verification: 'info', approved: 'success', completed: 'secondary', rejected: 'danger' }; %>
  <% enquiryQueues.forEach((queue) => { const color = queueColor[queue.key] || 'secondary'; %>
    <div class="col-sm-6 col-xl">
      <div class="card crm-queue-card queue-<%= queue.key %> bg-<%= color %> text-white">
        <div class="card-body">
          <div class="d-flex align-items-start">
            <div>
              <h3 class="mb-1"><%= dashboard.queueCounts[queue.key] || 0 %></h3>
              <div class="fw-semibold"><%= queue.label %></div>
              <div class="fs-sm opacity-75"><%= queue.description %></div>
            </div>
            <div class="ms-auto crm-queue-icon"><i class="<%= queue.icon %> ph-2x"></i></div>
          </div>
        </div>
        <div class="card-footer border-white border-opacity-10 d-flex justify-content-between align-items-center py-2">
          <% if (queue.key === 'new') { %>
            <a href="#dashboard_new_requirements" class="text-white text-decoration-none" data-bs-toggle="collapse" data-crm-scroll-target="#new-requirements-section" aria-controls="dashboard_new_requirements">Show table below</a>
          <% } else { %>
            <a href="/enquiries/queue/<%= queue.key %>" class="text-white text-decoration-none">View details</a>
          <% } %>
          <i class="ph-caret-right"></i>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<div class="card crm-dashboard-panel" id="new-requirements-section">
  <div class="card-header d-flex align-items-center flex-wrap gap-2">
    <div>
      <h5 class="mb-0">New requirements table</h5>
      <div class="text-muted fs-sm">Fresh customer requirements that need first review from the team.</div>
    </div>
    <span class="badge status-new rounded-pill ms-sm-2"><%= dashboard.queueCounts.new || 0 %> New</span>
    <div class="ms-sm-auto d-flex gap-2 flex-wrap">
      <a href="/enquiries/new" class="btn btn-primary btn-sm"><i class="ph-plus me-2"></i>Create lead</a>
      <a href="/enquiries/queue/new" class="btn btn-light btn-sm"><i class="ph-list-checks me-2"></i>Open full queue</a>
      <a href="#dashboard_new_requirements" class="btn btn-light btn-sm" data-bs-toggle="collapse" aria-controls="dashboard_new_requirements">Show / hide table</a>
    </div>
  </div>

  <div id="dashboard_new_requirements" class="collapse <%= showNewBookings ? 'show' : '' %>">
    <div class="table-responsive">
      <table class="table table-hover text-nowrap mb-0 crm-action-table">
        <thead>
          <tr>
            <th>Customer</th>
            <th>Service</th>
            <th>Source</th>
            <th>Priority</th>
            <th>Created</th>
            <th class="text-center" style="width: 140px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% dashboard.newBookingEnquiries.forEach((enquiry) => { %>
            <tr>
              <td>
                <div class="fw-semibold"><%= enquiry.customer?.name || '-' %></div>
                <div class="text-muted fs-sm"><%= enquiry.customer?.mobile || '' %></div>
              </td>
              <td>
                <div class="fw-semibold"><%= humanize(enquiry.categorySlug || enquiry.serviceType) %></div>
                <div class="text-muted fs-sm"><%= humanize(enquiry.formType) %></div>
              </td>
              <td>
                <div><%= enquiry.sourceWebsite || '-' %></div>
                <div class="text-muted fs-sm"><%= enquiry.source?.channel || '-' %></div>
              </td>
              <td><%- include('../partials/statusBadge', { value: enquiry.priority || 'normal', humanize }) %></td>
              <td><%= formatDate(enquiry.createdAt) %></td>
              <td class="text-center">
                <div class="btn-group btn-group-sm">
                  <a href="/enquiries/<%= enquiry.id %>" class="btn btn-light"><i class="ph-eye me-1"></i>View</a>
                  <a href="/enquiries/<%= enquiry.id %>/edit" class="btn btn-light"><i class="ph-pencil me-1"></i>Edit</a>
                </div>
              </td>
            </tr>
          <% }) %>
          <% if (!dashboard.newBookingEnquiries.length) { %>
            <tr><td colspan="6" class="text-muted text-center py-4">No new requirements waiting right now.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if ((dashboard.queueCounts.new || 0) > dashboard.newBookingEnquiries.length) { %>
      <div class="card-body border-top py-2 text-end">
        <a href="/enquiries/queue/new" class="btn btn-light btn-sm">View all <%= dashboard.queueCounts.new %> new requirements</a>
      </div>
    <% } %>
  </div>
</div>


<div class="card crm-platform-apps">
  <div class="card-header d-flex align-items-center flex-wrap gap-2">
    <div>
      <h5 class="mb-0">Platform sections</h5>
      <div class="text-muted fs-sm">Quick internal app shortcuts for daily operations.</div>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-sm-6 col-xl-2"><a class="crm-app-tile" href="/enquiries"><i class="ph-list-checks"></i><span>Requirements</span><small>Verify and approve</small></a></div>
      <div class="col-sm-6 col-xl-2"><a class="crm-app-tile" href="/providers"><i class="ph-users-three"></i><span>Providers</span><small>Directory and profile</small></a></div>
      <div class="col-sm-6 col-xl-2"><a class="crm-app-tile" href="/follow-ups"><i class="ph-phone-call"></i><span>Follow-ups</span><small>Tasks and calls</small></a></div>
      <div class="col-sm-6 col-xl-2"><a class="crm-app-tile" href="/communications"><i class="ph-chats"></i><span>Communications</span><small>Call, note, WhatsApp</small></a></div>
      <div class="col-sm-6 col-xl-2"><a class="crm-app-tile" href="/billing"><i class="ph-currency-inr"></i><span>Billing</span><small>Invoices and status</small></a></div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-sm-6 col-xl-3">
    <div class="card crm-stat-card"><div class="card-body"><div class="d-flex align-items-center"><div><div class="text-muted fs-sm">Total requirements</div><h3 class="mb-0"><%= dashboard.counts.enquiries %></h3></div><div class="crm-stat-icon bg-primary bg-opacity-10 text-primary ms-auto"><i class="ph-list-checks"></i></div></div></div></div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card crm-stat-card"><div class="card-body"><div class="d-flex align-items-center"><div><div class="text-muted fs-sm">Providers</div><h3 class="mb-0"><%= dashboard.counts.providers %></h3></div><div class="crm-stat-icon bg-success bg-opacity-10 text-success ms-auto"><i class="ph-users-three"></i></div></div></div></div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card crm-stat-card"><div class="card-body"><div class="d-flex align-items-center"><div><div class="text-muted fs-sm">Open follow-ups</div><h3 class="mb-0"><%= dashboard.counts.openFollowUps %></h3></div><div class="crm-stat-icon bg-secondary bg-opacity-10 text-secondary ms-auto"><i class="ph-clock"></i></div></div></div></div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card crm-stat-card"><div class="card-body"><div class="d-flex align-items-center"><div><div class="text-muted fs-sm">Paid invoices</div><h3 class="mb-0">₹<%= dashboard.counts.paidRevenue.toLocaleString('en-IN') %></h3></div><div class="crm-stat-icon bg-teal bg-opacity-10 text-teal ms-auto"><i class="ph-currency-inr"></i></div></div></div></div>
  </div>
</div>

<div class="row">
  <div class="col-xl-8">
    <div class="card">
      <div class="card-header d-flex align-items-center">
        <h5 class="mb-0">Recent requirements</h5>
        <a href="/enquiries" class="ms-auto">View all <i class="ph-arrow-circle-right ms-1"></i></a>
      </div>
      <div class="table-responsive">
        <table class="table text-nowrap">
          <thead><tr><th>Customer</th><th>Category</th><th>Status</th><th>Source</th><th class="text-center" style="width:20px"><i class="ph-dots-three"></i></th></tr></thead>
          <tbody>
          <% dashboard.recentEnquiries.forEach((enquiry) => { %>
            <tr>
              <td><div class="fw-semibold"><%= enquiry.customer.name || '-' %></div><div class="text-muted fs-sm"><%= enquiry.customer.mobile || '' %></div></td>
              <td><%= humanize(enquiry.categorySlug) %></td>
              <td><%- include('../partials/statusBadge', { value: enquiry.status, humanize }) %></td>
              <td><%= enquiry.sourceWebsite %></td>
              <td class="text-center"><a href="/enquiries/<%= enquiry.id %>" class="text-body"><i class="ph-arrow-circle-right"></i></a></td>
            </tr>
          <% }) %>
          <% if (!dashboard.recentEnquiries.length) { %><tr><td colspan="5" class="text-muted text-center py-4">No requirements yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-xl-4">
    <div class="card">
      <div class="card-header d-flex align-items-center">
        <h5 class="mb-0">Open follow-ups</h5>
        <a href="/follow-ups" class="ms-auto">View all</a>
      </div>
      <div class="card-body">
        <% dashboard.openFollowUps.forEach((item) => { %>
          <div class="d-flex align-items-start mb-3">
            <div class="bg-warning bg-opacity-10 text-warning rounded-pill me-3"><i class="ph-phone-call p-2"></i></div>
            <div class="flex-fill"><div class="fw-semibold"><%= item.title %></div><div class="text-muted fs-sm"><%= item.customerName || item.enquiryId || 'No requirement linked' %> · <%= formatDate(item.dueAt) %></div></div>
          </div>
        <% }) %>
        <% if (!dashboard.openFollowUps.length) { %><div class="text-muted">No open follow-ups.</div><% } %>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-4"><div class="card"><div class="card-header"><h5 class="mb-0">Status funnel</h5></div><div class="card-body"><div class="crm-mini-bars" data-bars='<%- JSON.stringify(dashboard.byStatus) %>'></div></div></div></div>
  <div class="col-lg-4"><div class="card"><div class="card-header"><h5 class="mb-0">Category split</h5></div><div class="card-body"><div class="crm-mini-bars" data-bars='<%- JSON.stringify(dashboard.byCategory) %>'></div></div></div></div>
  <div class="col-lg-4"><div class="card"><div class="card-header"><h5 class="mb-0">Lead sources</h5></div><div class="card-body"><div class="crm-mini-bars" data-bars='<%- JSON.stringify(dashboard.bySource) %>'></div></div></div></div>
</div>

<%- include('../partials/pageEnd') %>
