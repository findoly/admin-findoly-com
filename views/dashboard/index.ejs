<%- include('../partials/pageStart') %>
<div x-data="dashboardPage()" x-init="load()" :class="loading && 'crm-loading'">
  <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
  <div class="row g-3 mb-3">
    <template x-for="card in cards" :key="card.label"><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted" x-text="card.label"></div><div class="crm-stat-value" x-text="card.value"></div><div class="small text-muted" x-text="card.note"></div></div></div></div></template>
  </div>
  <div class="card"><div class="card-header d-flex align-items-center"><h5 class="mb-0">Recent requirements</h5><a href="/enquiries" class="btn btn-light btn-sm ms-auto">View all</a></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Lead</th><th>Customer</th><th>Category</th><th>Status</th><th>Price</th><th>Created</th></tr></thead><tbody>
    <template x-for="lead in data.recentLeads || []" :key="lead.enquiryId || lead.id"><tr><td><a :href="'/enquiries/' + (lead.enquiryId || lead.id)" x-text="lead.requirementTitle || lead.serviceType || 'Requirement'"></a></td><td x-text="lead.name || lead.customer?.name || '—'"></td><td x-text="lead.categorySlug"></td><td><span class="badge bg-light text-body border" x-text="humanize(lead.status)"></span></td><td x-text="money(lead.leadPricePaise)"></td><td x-text="formatDate(lead.createdAt)"></td></tr></template>
    <tr x-show="!loading && !(data.recentLeads || []).length"><td colspan="6" class="text-center text-muted py-4">No leads yet</td></tr>
  </tbody></table></div></div>
</div>
<script>
  function dashboardPage(){return{data:{},loading:true,error:'',get cards(){return[{label:'All requirements',value:this.data.totalLeads||0,note:(this.data.statusCounts?.new||0)+' new'},{label:'Active providers',value:this.data.activeProviders||0,note:(this.data.providers||0)+' total'},{label:'Available offers',value:this.data.offered||0,note:(this.data.unlocked||0)+' unlocked'},{label:'Open follow-ups',value:this.data.openFollowUps||0,note:(this.data.invoices||0)+' invoices'}]},async load(){try{this.data=(await apiFetch('/api/dashboard')).data;}catch(e){this.error=e.message;}finally{this.loading=false;}}}}
</script>
<%- include('../partials/pageEnd') %>
