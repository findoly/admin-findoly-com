<%- include('../partials/pageStart', { subtitle: 'New log entry' }) %>

<div class="row">
  <div class="col-xl-8 offset-xl-2">
    <div class="card">
      <div class="card-header d-sm-flex align-items-sm-center"><h5 class="mb-0">Log communication</h5><div class="ms-sm-auto mt-2 mt-sm-0"><a href="/communications" class="btn btn-light btn-sm"><i class="ph-list me-2"></i>Back to list</a></div></div>
      <div class="card-body border-top">
        <form method="post" action="/communications">
          <input type="hidden" name="returnTo" value="<%= prefill.returnTo || '' %>">
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Related requirement</label><div class="col-lg-9"><select class="form-select" name="enquiryId"><option value="">No requirement</option><% enquiries.forEach((e)=>{ %><option value="<%= e.id %>" <%= prefill.enquiryId === e.id ? 'selected' : '' %>><%= e.customer.name %> — <%= e.serviceType %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Related provider</label><div class="col-lg-9"><select class="form-select" name="providerId"><option value="">No provider</option><% providers.forEach((p)=>{ %><option value="<%= p.id %>" <%= prefill.providerId === p.id ? 'selected' : '' %>><%= p.name %> — <%= p.mobile || p.email || p.city || '' %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Recipient name</label><div class="col-lg-9"><input class="form-control" name="recipientName" value="<%= prefill.recipientName || '' %>"></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Recipient contact</label><div class="col-lg-9"><input class="form-control" name="recipientContact" value="<%= prefill.recipientContact || '' %>"></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Channel</label><div class="col-lg-9"><select class="form-select" name="channel"><option>call</option><option>whatsapp</option><option>email</option><option>sms</option><option>note</option></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Direction</label><div class="col-lg-9"><select class="form-select" name="direction"><option>outbound</option><option>inbound</option><option>internal_note</option></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Message <span class="text-danger">*</span></label><div class="col-lg-9"><textarea class="form-control" name="message" rows="5" required></textarea></div></div>
          <div class="text-end"><a href="/communications" class="btn btn-light">Cancel</a><button class="btn btn-primary ms-2" type="submit">Log communication <i class="ph-paper-plane-tilt ms-2"></i></button></div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/pageEnd') %>
