<%- include('../partials/pageStart', { subtitle: 'List and history' }) %>

<div class="card">
  <div class="card-header d-sm-flex align-items-sm-center py-sm-0">
    <div>
      <h5 class="py-sm-2 my-sm-1 mb-0">Communication history</h5>
      <div class="text-muted fs-sm">List/search only. Use Log communication to add a call, WhatsApp, email, SMS or note.</div>
    </div>
    <div class="mt-2 mt-sm-0 ms-sm-auto d-flex gap-2">
      <a href="/api/communications" target="_blank" class="btn btn-light btn-sm"><i class="ph-code me-2"></i>API</a>
      <a href="/search/communications" class="btn btn-light btn-sm"><i class="ph-magnifying-glass me-2"></i>Advanced search</a>
      <a href="/communications/new" class="btn btn-primary btn-sm"><i class="ph-plus me-2"></i>Log communication</a>
    </div>
  </div>

  <div class="card-body border-top">
    <form method="get" class="row g-3 align-items-end">
      <div class="col-xl-4 col-lg-6"><label class="form-label">Search</label><div class="form-control-feedback form-control-feedback-start"><input class="form-control" name="q" placeholder="Recipient, contact, message..." value="<%= filters.q || filters.search || '' %>"><div class="form-control-feedback-icon"><i class="ph-magnifying-glass"></i></div></div></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Channel</label><select class="form-select" name="channel"><option value="">All channels</option><% ['call','whatsapp','email','sms','note'].forEach((channel)=>{ %><option value="<%= channel %>" <%= filters.channel === channel ? 'selected' : '' %>><%= humanize(channel) %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All statuses</option><% statuses.forEach((s)=>{ %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= humanize(s) %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Requirement ID</label><input class="form-control" name="enquiryId" value="<%= filters.enquiryId || '' %>" placeholder="req_..."></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><label class="form-label">From</label><input type="date" class="form-control" name="dateFrom" value="<%= filters.dateFrom || '' %>"></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><label class="form-label">To</label><input type="date" class="form-control" name="dateTo" value="<%= filters.dateTo || '' %>"></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><label class="form-label">Per page</label><select class="form-select" name="pageSize"><% [10,25,50,100].forEach((size)=>{ %><option value="<%= size %>" <%= String(filters.pageSize || 25) === String(size) ? 'selected' : '' %>><%= size %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-3 col-sm-6 d-flex gap-2"><button class="btn btn-primary flex-fill" type="submit">Filter</button><a href="/communications" class="btn btn-light">Clear</a></div>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table text-nowrap">
      <thead><tr><th>When</th><th>Recipient</th><th>Channel</th><th>Direction</th><th>Message</th><th>Related</th><th>Status</th><th class="text-center" style="width: 160px;">Actions</th></tr></thead>
      <tbody>
        <% communications.forEach((item) => { %>
          <tr>
            <td><%= formatDate(item.createdAt) %></td>
            <td><div class="fw-semibold"><%= item.recipientName || '-' %></div><div class="text-muted fs-sm"><%= item.recipientContact || '' %></div></td>
            <td><%= humanize(item.channel) %></td>
            <td><%= humanize(item.direction) %></td>
            <td><div class="text-truncate" style="max-width: 320px;"><%= item.message || '-' %></div></td>
            <td><% if (item.enquiryId) { %><a href="/enquiries/<%= item.enquiryId %>"><%= item.enquiryId %></a><% } else if (item.providerId) { %><a href="/providers/<%= item.providerId %>"><%= item.providerId %></a><% } else { %>-<% } %></td>
            <td><%- include('../partials/statusBadge', { value: item.status, humanize }) %></td>
            <td class="text-center"><div class="d-inline-flex gap-1"><a href="/communications/<%= item.id %>" class="btn btn-outline-primary btn-sm"><i class="ph-eye me-1"></i>View</a><a href="/communications/<%= item.id %>/edit" class="btn btn-outline-secondary btn-sm"><i class="ph-pencil me-1"></i>Edit</a></div></td>
          </tr>
        <% }) %>
        <% if (!communications.length) { %><tr><td colspan="8" class="text-muted text-center py-4">No communications yet. <a href="/communications/new">Log a communication</a>.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination }) %>
</div>

<%- include('../partials/pageEnd') %>
