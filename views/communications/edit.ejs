<%- include('../partials/pageStart', { subtitle: 'Edit log entry' }) %>

<div class="row">
  <div class="col-xl-8 offset-xl-2">
    <div class="card">
      <div class="card-header d-sm-flex align-items-sm-center"><h5 class="mb-0">Edit communication</h5><div class="ms-sm-auto mt-2 mt-sm-0"><a href="/communications/<%= communication.id %>" class="btn btn-light btn-sm"><i class="ph-eye me-2"></i>View</a></div></div>
      <div class="card-body border-top">
        <form method="post" action="/communications/<%= communication.id %>">
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Related requirement</label><div class="col-lg-9"><select class="form-select" name="enquiryId"><option value="">No requirement</option><% enquiries.forEach((e)=>{ %><option value="<%= e.id %>" <%= communication.enquiryId === e.id ? 'selected' : '' %>><%= e.customer.name %> — <%= e.serviceType %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Related provider</label><div class="col-lg-9"><select class="form-select" name="providerId"><option value="">No provider</option><% providers.forEach((p)=>{ %><option value="<%= p.id %>" <%= communication.providerId === p.id ? 'selected' : '' %>><%= p.name %> — <%= p.mobile || p.email || p.city || '' %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Recipient name</label><div class="col-lg-9"><input class="form-control" name="recipientName" value="<%= communication.recipientName || '' %>"></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Recipient contact</label><div class="col-lg-9"><input class="form-control" name="recipientContact" value="<%= communication.recipientContact || '' %>"></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Channel</label><div class="col-lg-9"><select class="form-select" name="channel"><% ['call','whatsapp','email','sms','note'].forEach((channel)=>{ %><option value="<%= channel %>" <%= communication.channel === channel ? 'selected' : '' %>><%= humanize(channel) %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Direction</label><div class="col-lg-9"><select class="form-select" name="direction"><% ['outbound','inbound','internal_note'].forEach((direction)=>{ %><option value="<%= direction %>" <%= communication.direction === direction ? 'selected' : '' %>><%= humanize(direction) %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Status</label><div class="col-lg-9"><select class="form-select" name="status"><% statuses.forEach((status)=>{ %><option value="<%= status %>" <%= communication.status === status ? 'selected' : '' %>><%= humanize(status) %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Message <span class="text-danger">*</span></label><div class="col-lg-9"><textarea class="form-control" name="message" rows="5" required><%= communication.message || '' %></textarea></div></div>
          <div class="text-end"><a href="/communications/<%= communication.id %>" class="btn btn-light">Cancel</a><button class="btn btn-primary ms-2" type="submit">Save changes <i class="ph-floppy-disk ms-2"></i></button></div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/pageEnd') %>
