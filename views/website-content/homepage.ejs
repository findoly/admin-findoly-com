<%
  const canAccess = typeof can === 'function' ? can : () => true;
  const canManage = canAccess('websiteContent.manage');
  const canPublish = canAccess('websiteContent.publish');
%>
<!doctype html><html lang="en" dir="ltr"><%- include('../partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('../partials/navbar') %>
<div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Website Content / Homepage</div><h1 class="page-title mb-1">Findoly Homepage Manager</h1><p class="crm-page-subtitle mb-0">Manage the content and order of the current Findoly homepage. Draft changes stay private until you publish.</p></div><div class="crm-page-actions"><a href="/website-content/media" class="btn btn-light">Media Library</a><% if (canManage) { %><button form="homepage-form" class="btn btn-light" type="submit">Save draft</button><% } %><% if (canPublish) { %><button class="btn btn-primary" type="button" @click="$dispatch('publish-homepage')">Publish</button><% } %></div></div></div>
<div class="content" x-data="homepageManager()" x-init="init()" @publish-homepage.window="publish()">
  <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
  <div x-show="success" x-cloak class="alert alert-success" x-text="success"></div>
  <div class="alert alert-info" x-show="publishedAt"><strong>Published:</strong> <span x-text="formatDate(publishedAt)"></span>. Draft edits do not affect Findoly.com until Publish is pressed.</div>
  <div class="alert alert-light border"><strong>Live homepage structure:</strong> Hero / Search → navigation tabs → managed content sections → How Findoly Works → Business CTA. Reordering managed sections here changes their order on the website.</div>

<form id="homepage-form" @submit.prevent="save()">
  <fieldset <%= canManage ? '' : 'disabled' %>>
    <div class="card mb-3">
      <div class="card-header"><div><h5 class="mb-1">Hero / Search</h5><p class="text-muted mb-0">The main Findoly entry point.</p></div></div>
      <div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft.hero.enabled"><label class="form-check-label">Show hero</label></div><div class="row g-3"><div class="col-md-5"><label class="form-label">Eyebrow</label><input class="form-control" x-model="draft.hero.eyebrow" maxlength="120"></div><div class="col-md-7"><label class="form-label">Heading</label><input class="form-control" x-model="draft.hero.heading" maxlength="180"></div></div></div>
    </div>

    <div class="card mb-3">
      <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div><h5 class="mb-1">Homepage navigation tabs</h5><p class="text-muted mb-0">Control the sticky homepage tabs such as For You, Home, Repairs, Events and Business. A tab appears live when it has an enabled homepage section.</p></div>
        <button type="button" class="btn btn-light btn-sm" @click="addGroup()">+ Add group</button>
      </div>
      <div class="card-body">
        <template x-for="(group,index) in draft.marketplaceGroups" :key="group.id + '-' + index">
          <div class="border rounded p-3 mb-3">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
              <div class="form-check"><input class="form-check-input" type="checkbox" x-model="group.enabled"><label class="form-check-label fw-semibold">Visible group</label></div>
              <div class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm" @click="move(draft.marketplaceGroups,index,-1)">Up</button><button type="button" class="btn btn-light btn-sm" @click="move(draft.marketplaceGroups,index,1)">Down</button><button type="button" class="btn btn-outline-danger btn-sm" x-show="group.id !== 'for-you'" @click="removeGroup(index)">Remove</button></div>
            </div>
            <div class="row g-3"><div class="col-md-6"><label class="form-label">Tab label</label><input class="form-control" x-model="group.label" maxlength="60" placeholder="Home"></div><div class="col-md-6"><label class="form-label">Stable tab ID</label><input class="form-control" x-model="group.id" maxlength="60" :readonly="group.id === 'for-you'" placeholder="home-services"><div class="form-text">Sections use this ID to connect to the tab. Keep it stable after publishing.</div></div></div>
          </div>
        </template>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div><h5 class="mb-1">Homepage content sections</h5><p class="text-muted mb-0">These cards render directly between the homepage tabs and How Findoly Works. Use Services / Products for rails, Categories for category tiles, or Promotion / CTA for a callout.</p></div>
        <button type="button" class="btn btn-light btn-sm" @click="addSection()">+ Add homepage section</button>
      </div>
      <div class="card-body">
        <template x-for="(section,index) in draft.sections" :key="section.id + '-' + index">
          <div class="border rounded p-3 mb-3">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3"><div><div class="form-check"><input class="form-check-input" type="checkbox" x-model="section.enabled"><label class="form-check-label fw-semibold" x-text="section.heading || 'Show section'"></label></div><small class="text-muted"><span x-text="section.contentType === 'categories' ? 'Category tiles' : (section.contentType === 'promotion' ? 'Promotion / CTA' : 'Services / Products')"></span> · <span x-text="section.id"></span></small></div><div class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm" @click="move(draft.sections,index,-1)">Up</button><button type="button" class="btn btn-light btn-sm" @click="move(draft.sections,index,1)">Down</button><button type="button" class="btn btn-outline-danger btn-sm" @click="draft.sections.splice(index,1)">Remove</button></div></div>
            <div class="row g-3">
              <div class="col-md-3"><label class="form-label">Navigation group</label><select class="form-select" x-model="section.groupId"><template x-for="group in draft.marketplaceGroups" :key="group.id"><option :value="group.id" x-text="group.label"></option></template></select></div>
              <div class="col-md-3"><label class="form-label">Content type</label><select class="form-select" x-model="section.contentType" @change="sectionTypeChanged(section)"><option value="items">Services / Products</option><option value="categories">Categories</option><option value="promotion">Promotion / CTA</option></select></div>
              <div class="col-md-3" x-show="section.contentType !== 'promotion'"><label class="form-label">Layout</label><select class="form-select" x-model="section.layout"><option value="rail">Horizontal cards</option><option value="grid">Grid</option><option value="list">Compact list</option></select></div>
              <div class="col-md-3" x-show="section.contentType !== 'promotion'"><label class="form-label">Card limit</label><input class="form-control" type="number" min="1" max="24" x-model.number="section.cardLimit"></div>
              <div class="col-md-5"><label class="form-label">Heading</label><input class="form-control" x-model="section.heading" maxlength="160"></div>
              <div class="col-md-7"><label class="form-label">Subheading</label><input class="form-control" x-model="section.subheading" maxlength="300"></div>
              <div class="col-md-6" x-show="section.contentType !== 'promotion'"><label class="form-label">See all destination</label><input class="form-control" x-model="section.seeAllHref" placeholder="/explore"></div>
            </div>

            <div class="mt-3" x-show="section.contentType === 'categories'">
              <label class="form-label">Selected Categories</label>
              <div class="input-group"><input class="form-control" x-model="section._search" placeholder="Search categories…"><select class="form-select" @change="addCategoryToSection(section,$event.target.value);$event.target.value='' "><option value="">Add category…</option><template x-for="category in filteredSectionCategories(section)" :key="category.slug"><option :value="category.slug" x-text="category.name"></option></template></select></div>
              <div class="mt-2"><template x-for="(slug,catIndex) in section.categorySlugs" :key="slug"><div class="d-flex align-items-center gap-2 border rounded p-2 mb-1"><span class="flex-grow-1" x-text="categoryName(slug)"></span><button type="button" class="btn btn-light btn-sm" @click="move(section.categorySlugs,catIndex,-1)">Up</button><button type="button" class="btn btn-light btn-sm" @click="move(section.categorySlugs,catIndex,1)">Down</button><button type="button" class="btn btn-light btn-sm" @click="section.categorySlugs.splice(catIndex,1)">Remove</button></div></template></div>
            </div>

            <div class="mt-3" x-show="section.contentType === 'items'">
              <label class="form-label">Selected Services / Products</label>
              <div class="row g-2 mb-2"><div class="col-md-6"><input class="form-control" x-model="section._search" placeholder="Search name, category or subcategory…"></div><div class="col-md-3"><select class="form-select" x-model="section._categoryFilter"><option value="">All categories</option><template x-for="category in categories" :key="category.slug"><option :value="category.slug" x-text="category.name"></option></template></select></div><div class="col-md-3"><select class="form-select" x-model="section._kindFilter"><option value="">Services + Products</option><option value="service">Services</option><option value="product">Products</option></select></div></div>
              <select class="form-select" @change="addItemToSection(section,$event.target.value);$event.target.value='' "><option value="">Add matching content…</option><template x-for="item in filteredItems(section).slice(0,250)" :key="item.itemId"><option :value="item.itemId" x-text="itemLabel(item)"></option></template></select><div class="form-text">Search narrows large catalogs. Up to 250 matching options are shown at once.</div>
              <div class="mt-2"><template x-for="(id,itemIndex) in section.itemIds" :key="id"><div class="d-flex align-items-center gap-2 border rounded p-2 mb-1"><span class="flex-grow-1" x-text="itemName(id)"></span><button type="button" class="btn btn-light btn-sm" @click="move(section.itemIds,itemIndex,-1)">Up</button><button type="button" class="btn btn-light btn-sm" @click="move(section.itemIds,itemIndex,1)">Down</button><button type="button" class="btn btn-light btn-sm" @click="section.itemIds.splice(itemIndex,1)">Remove</button></div></template></div>
            </div>

            <div class="mt-3" x-show="section.contentType === 'promotion'">
              <div class="row g-3"><div class="col-md-6"><label class="form-label">Button text</label><input class="form-control" x-model="section.buttonText" maxlength="100"></div><div class="col-md-6"><label class="form-label">Button destination</label><input class="form-control" x-model="section.buttonHref" maxlength="500"></div><div class="col-12"><label class="form-label">Promotional image</label><select class="form-select" x-model="section.mediaId"><option value="">No image</option><template x-for="media in mediaItems" :key="media.mediaId"><option :value="media.mediaId" x-text="media.altText || media.originalName || media.fileName"></option></template></select></div></div>
            </div>
          </div>
        </template>
      </div>
    </div>

    <div class="card mb-3"><div class="card-header"><h5 class="mb-0">How Findoly Works</h5></div><div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft.howItWorks.enabled"><label class="form-check-label">Show section</label></div><div class="mb-3"><label class="form-label">Heading</label><input class="form-control" x-model="draft.howItWorks.heading" maxlength="160"></div><div class="row g-3"><template x-for="(step,index) in draft.howItWorks.steps" :key="index"><div class="col-lg-4"><div class="border rounded p-3 h-100"><strong x-text="'Step '+(index+1)"></strong><label class="form-label mt-2">Title</label><input class="form-control mb-2" x-model="step.title" maxlength="120"><label class="form-label">Text</label><textarea class="form-control" rows="3" x-model="step.text" maxlength="300"></textarea></div></div></template></div></div></div>

    <div class="card mb-3"><div class="card-header"><h5 class="mb-0">Business CTA</h5></div><div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft.businessCta.enabled"><label class="form-check-label">Show CTA</label></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Eyebrow</label><input class="form-control" x-model="draft.businessCta.eyebrow"></div><div class="col-md-8"><label class="form-label">Heading</label><input class="form-control" x-model="draft.businessCta.heading"></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="2" x-model="draft.businessCta.text"></textarea></div><div class="col-md-6"><label class="form-label">Button text</label><input class="form-control" x-model="draft.businessCta.buttonText"></div><div class="col-md-6"><label class="form-label">Button destination</label><input class="form-control" x-model="draft.businessCta.buttonHref"></div><div class="col-12"><label class="form-label">Optional promotional image</label><select class="form-select" x-model="draft.businessCta.mediaId"><option value="">No dedicated image</option><template x-for="media in mediaItems" :key="media.mediaId"><option :value="media.mediaId" x-text="media.altText || media.originalName || media.fileName"></option></template></select></div></div></div></div>
  </fieldset>
  <% if (canManage || canPublish) { %><div class="d-flex justify-content-end gap-2 mb-4"><% if (canManage) { %><button class="btn btn-light" type="submit" :disabled="saving" x-text="saving?'Saving…':'Save draft'"></button><% } %><% if (canPublish) { %><button class="btn btn-primary" type="button" @click="publish()" :disabled="publishing" x-text="publishing?'Publishing…':'Publish homepage'"></button><% } %></div><% } %>
</form></div><%- include('../partials/footer') %></div></div></div>
<script>
function homepageManager(){return{
  draft:{hero:{},marketplaceGroups:[],sections:[],howItWorks:{steps:[]},businessCta:{}},items:[],categories:[],mediaItems:[],publishedAt:null,saving:false,publishing:false,error:'',success:'',
  async init(){try{const [home,items,cats,media]=await Promise.all([apiFetch('/api/website-content/homepage'),apiFetch('/api/website-content/items?includeInactive=false'),apiFetch('/api/catalog/categories?includeInactive=false'),apiFetch('/api/website-content/media?limit=500')]);this.draft=home.data.draft;this.draft.marketplaceGroups=(this.draft.marketplaceGroups||[]).map(g=>({...g}));this.draft.sections=(this.draft.sections||[]).map(s=>({...s,_search:'',_categoryFilter:'',_kindFilter:''}));this.publishedAt=home.data.publishedAt;this.items=items.data||[];this.categories=cats.data||[];this.mediaItems=media.data||[];}catch(e){this.error=e.message;}},
  slug(v){return String(v||'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')},
  newId(prefix){return prefix+'-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,6)},
  addGroup(){this.draft.marketplaceGroups.push({id:this.newId('tab'),label:'New tab',enabled:true,categorySlugs:[]})},
  removeGroup(index){const group=this.draft.marketplaceGroups[index];if(!group||group.id==='for-you')return;const replacement='for-you';this.draft.sections.forEach(s=>{if(s.groupId===group.id)s.groupId=replacement});this.draft.marketplaceGroups.splice(index,1)},
  addSection(){this.draft.sections.push({id:this.newId('section'),enabled:true,groupId:this.draft.marketplaceGroups[0]?.id||'for-you',contentType:'items',layout:'rail',heading:'New section',subheading:'',categorySlugs:[],itemIds:[],cardLimit:6,seeAllHref:'/explore',buttonText:'Explore',buttonHref:'/explore',mediaId:'',_search:'',_categoryFilter:'',_kindFilter:''})},
  sectionTypeChanged(section){section.categorySlugs=section.categorySlugs||[];section.itemIds=section.itemIds||[];section.layout=section.contentType==='promotion'?'callout':(section.layout==='callout'?'rail':section.layout)},
  categoryName(slug){return this.categories.find(c=>c.slug===slug)?.name||slug},
  itemLabel(item){return `${item.name} · ${item.kind==='product'?'Product':'Service'} · ${item.categorySlug||''} › ${item.serviceTypeSlug||''}`},
  itemName(id){const item=this.items.find(i=>i.itemId===id);return item?this.itemLabel(item):'Missing item'},
  filteredCategories(owner){const used=new Set(owner.categorySlugs||[]);const q=String(owner._search||'').trim().toLowerCase();return this.categories.filter(c=>!used.has(c.slug)&&c.active!==false&&(!q||`${c.name} ${c.slug}`.toLowerCase().includes(q))).slice(0,200)},
  filteredSectionCategories(section){return this.filteredCategories(section)},
  filteredItems(section){const used=new Set(section.itemIds||[]);const q=String(section._search||'').trim().toLowerCase();const cat=String(section._categoryFilter||'');const kind=String(section._kindFilter||'');return this.items.filter(i=>!used.has(i.itemId)&&i.active!==false&&i.websiteVisible!==false&&(!cat||i.categorySlug===cat)&&(!kind||i.kind===kind)&&(!q||`${i.name} ${i.slug} ${i.categorySlug} ${i.serviceTypeSlug}`.toLowerCase().includes(q)))},
  addCategoryToGroup(group,slug){if(slug&&!group.categorySlugs.includes(slug))group.categorySlugs.push(slug)},
  addCategoryToSection(section,slug){if(slug&&!section.categorySlugs.includes(slug))section.categorySlugs.push(slug)},
  addItemToSection(section,id){if(id&&!section.itemIds.includes(id))section.itemIds.push(id)},
  move(list,index,delta){const target=index+delta;if(target<0||target>=list.length)return;const value=list[index];list.splice(index,1);list.splice(target,0,value)},
  cleanDraft(){const clone=JSON.parse(JSON.stringify(this.draft));const idMap=new Map();clone.marketplaceGroups=(clone.marketplaceGroups||[]).map(({_search,...g})=>{const oldId=g.id;const nextId=this.slug(g.id)||this.newId('group');idMap.set(oldId,nextId);return {...g,id:nextId}});clone.sections=(clone.sections||[]).map(({_search,_categoryFilter,_kindFilter,...s})=>({...s,groupId:idMap.get(s.groupId)||s.groupId||'for-you'}));return clone},
  async persistDraft(){const payload=this.cleanDraft();const result=await apiFetch('/api/website-content/homepage',{method:'PUT',body:JSON.stringify(payload)});this.draft=result.data.draft;this.draft.marketplaceGroups=(this.draft.marketplaceGroups||[]).map(g=>({...g}));this.draft.sections=(this.draft.sections||[]).map(s=>({...s,_search:'',_categoryFilter:'',_kindFilter:''}));return result},
  async save(){if(this.saving)return;this.saving=true;this.error='';this.success='';try{await this.persistDraft();this.success='Homepage draft saved. Live website is unchanged until you publish.';}catch(e){this.error=e.message;}finally{this.saving=false;}},
  async publish(){if(this.publishing)return;this.publishing=true;this.error='';this.success='';try{if(<%= canManage ? 'true' : 'false' %>)await this.persistDraft();const result=(await apiFetch('/api/website-content/homepage/publish',{method:'POST',body:'{}'})).data;this.publishedAt=result.publishedAt;this.success='Homepage and marketplace navigation published to Findoly.com.';}catch(e){this.error=e.message;}finally{this.publishing=false;}},
  formatDate(v){return v?new Date(v).toLocaleString():'—'}
}}
</script><%- include('../partials/scripts') %></body></html>
