<%
  const canAccess = typeof can === 'function' ? can : () => true;
  const canManage = canAccess('websiteContent.manage');
  const canPublish = canAccess('websiteContent.publish');
%>
<!doctype html><html lang="en" dir="ltr"><%- include('../partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('../partials/navbar') %>
<div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Website Content / Homepage</div><h1 class="page-title mb-1">Findoly Homepage Manager</h1><p class="crm-page-subtitle mb-0">Manage the fixed content sections used by the current Findoly homepage without changing its design, navigation or catalog hierarchy.</p></div><div class="crm-page-actions"><a href="/website-content/media" class="btn btn-light">Media Library</a><% if (canManage) { %><button form="homepage-form" class="btn btn-light" type="submit">Save draft</button><% } %><% if (canPublish) { %><button class="btn btn-primary" type="button" @click="$dispatch('publish-homepage')">Publish</button><% } %></div></div></div>
<div class="content" x-data="homepageManager()" x-init="init()" @publish-homepage.window="publish()">
  <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
  <div x-show="success" x-cloak class="alert alert-success" x-text="success"></div>
  <div class="alert alert-info" x-show="publishedAt"><strong>Published:</strong> <span x-text="formatDate(publishedAt)"></span>. Draft edits do not affect Findoly.com until Publish is pressed.</div>
  <div class="alert alert-light border"><strong>Current website structure:</strong> Popular near you, What do you need help with?, For your home, Home repairs, and Events &amp; occasions. Reordering below changes only these homepage sections; the existing Findoly navigation tabs stay unchanged.</div>

<form id="homepage-form" @submit.prevent="save()">
  <fieldset <%= canManage ? '' : 'disabled' %>>
    <div class="card mb-3">
      <div class="card-header"><div><h5 class="mb-1">Hero / Search</h5><p class="text-muted mb-0">Content for the existing Findoly homepage hero. Search UI and layout stay unchanged.</p></div></div>
      <div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft.hero.enabled"><label class="form-check-label">Show hero</label></div><div class="row g-3"><div class="col-md-5"><label class="form-label">Eyebrow</label><input class="form-control" x-model="draft.hero.eyebrow" maxlength="120"></div><div class="col-md-7"><label class="form-label">Heading</label><input class="form-control" x-model="draft.hero.heading" maxlength="180"></div></div></div>
    </div>

    <div class="card mb-3">
      <div class="card-header"><div><h5 class="mb-1">Homepage sections</h5><p class="text-muted mb-0">These five controls map directly to the fixed sections already rendered by Findoly.com.</p></div></div>
      <div class="card-body">
        <template x-for="(key,index) in orderedSectionKeys()" :key="key">
          <div class="border rounded p-3 mb-3">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
              <div><h6 class="mb-1" x-text="sectionMeta(key).label"></h6><div class="form-check"><input class="form-check-input" type="checkbox" x-model="draft[key].enabled"><label class="form-check-label">Show section on homepage</label></div></div>
              <div class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm" @click="moveSection(index,-1)" :disabled="index===0">Up</button><button type="button" class="btn btn-light btn-sm" @click="moveSection(index,1)" :disabled="index===orderedSectionKeys().length-1">Down</button></div>
            </div>

            <div class="row g-3">
              <div class="col-md-5"><label class="form-label">Heading</label><input class="form-control" x-model="draft[key].heading" maxlength="160"></div>
              <div class="col-md-7"><label class="form-label">Subheading</label><input class="form-control" x-model="draft[key].subheading" maxlength="300"></div>
            </div>

            <div class="mt-3" x-show="sectionMeta(key).type === 'categories'">
              <label class="form-label">Categories shown in this section</label>
              <div class="input-group"><input class="form-control" x-model="draft[key]._search" placeholder="Search categories…"><select class="form-select" @change="addCategory(draft[key],$event.target.value);$event.target.value='' "><option value="">Add category…</option><template x-for="category in filteredCategories(draft[key])" :key="category.slug"><option :value="category.slug" x-text="category.name"></option></template></select></div>
              <div class="form-text">The order below is the order sent to the current Findoly homepage.</div>
              <div class="mt-2"><template x-for="(slug,catIndex) in draft[key].categorySlugs" :key="slug"><div class="d-flex align-items-center gap-2 border rounded p-2 mb-1"><span class="flex-grow-1" x-text="categoryName(slug)"></span><button type="button" class="btn btn-light btn-sm" @click="move(draft[key].categorySlugs,catIndex,-1)">Up</button><button type="button" class="btn btn-light btn-sm" @click="move(draft[key].categorySlugs,catIndex,1)">Down</button><button type="button" class="btn btn-light btn-sm" @click="draft[key].categorySlugs.splice(catIndex,1)">Remove</button></div></template></div>
            </div>

            <div class="mt-3" x-show="sectionMeta(key).type === 'items'">
              <label class="form-label">Services / Products shown in this section</label>
              <div class="row g-2">
                <div class="col-lg-5"><input class="form-control" x-model="draft[key]._search" placeholder="Search name, category or subcategory…"></div>
                <div class="col-lg-3"><select class="form-select" x-model="draft[key]._categoryFilter"><option value="">All categories</option><template x-for="category in categories" :key="category.slug"><option :value="category.slug" x-text="category.name"></option></template></select></div>
                <div class="col-lg-2"><select class="form-select" x-model="draft[key]._kindFilter"><option value="">All types</option><option value="service">Services</option><option value="product">Products</option></select></div>
                <div class="col-lg-2"><select class="form-select" @change="addItem(draft[key],$event.target.value);$event.target.value='' "><option value="">Add item…</option><template x-for="item in filteredItems(draft[key]).slice(0,200)" :key="item.itemId"><option :value="item.itemId" x-text="itemLabel(item)"></option></template></select></div>
              </div>
              <div class="form-text">Use search/filters to narrow large catalogs. Enabled sections require at least one selected service or product before publishing.</div>
              <div class="mt-2"><template x-for="(id,itemIndex) in draft[key].itemIds" :key="id"><div class="d-flex align-items-center gap-2 border rounded p-2 mb-1"><span class="flex-grow-1" x-text="itemName(id)"></span><button type="button" class="btn btn-light btn-sm" @click="move(draft[key].itemIds,itemIndex,-1)">Up</button><button type="button" class="btn btn-light btn-sm" @click="move(draft[key].itemIds,itemIndex,1)">Down</button><button type="button" class="btn btn-light btn-sm" @click="draft[key].itemIds.splice(itemIndex,1)">Remove</button></div></template></div>
            </div>
          </div>
        </template>
      </div>
    </div>

    <div class="card mb-3"><div class="card-header"><h5 class="mb-0">How Findoly Works</h5></div><div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft.howItWorks.enabled"><label class="form-check-label">Show section</label></div><div class="mb-3"><label class="form-label">Heading</label><input class="form-control" x-model="draft.howItWorks.heading" maxlength="160"></div><div class="row g-3"><template x-for="(step,index) in draft.howItWorks.steps" :key="index"><div class="col-lg-4"><div class="border rounded p-3 h-100"><strong x-text="'Step '+(index+1)"></strong><label class="form-label mt-2">Title</label><input class="form-control mb-2" x-model="step.title" maxlength="120"><label class="form-label">Text</label><textarea class="form-control" rows="3" x-model="step.text" maxlength="300"></textarea></div></div></template></div></div></div>

    <div class="card mb-3"><div class="card-header"><h5 class="mb-0">Business CTA</h5></div><div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft.businessCta.enabled"><label class="form-check-label">Show CTA</label></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Eyebrow</label><input class="form-control" x-model="draft.businessCta.eyebrow" maxlength="100"></div><div class="col-md-8"><label class="form-label">Heading</label><input class="form-control" x-model="draft.businessCta.heading" maxlength="180"></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="2" x-model="draft.businessCta.text" maxlength="400"></textarea></div><div class="col-md-6"><label class="form-label">Button text</label><input class="form-control" x-model="draft.businessCta.buttonText" maxlength="100"></div><div class="col-md-6"><label class="form-label">Button destination</label><input class="form-control" x-model="draft.businessCta.buttonHref" maxlength="500"></div><div class="col-12"><label class="form-label">Optional promotional image</label><select class="form-select" x-model="draft.businessCta.mediaId"><option value="">No dedicated image</option><template x-for="media in mediaItems" :key="media.mediaId"><option :value="media.mediaId" x-text="media.altText || media.originalName || media.fileName"></option></template></select></div></div></div></div>
  </fieldset>
  <% if (canManage || canPublish) { %><div class="d-flex justify-content-end gap-2 mb-4"><% if (canManage) { %><button class="btn btn-light" type="submit" :disabled="saving" x-text="saving?'Saving…':'Save draft'"></button><% } %><% if (canPublish) { %><button class="btn btn-primary" type="button" @click="publish()" :disabled="publishing" x-text="publishing?'Publishing…':'Publish homepage'"></button><% } %></div><% } %>
</form></div><%- include('../partials/footer') %></div></div></div>
<script>
function homepageManager(){return{
  fixedSections:[
    {key:'popular',label:'Popular near you',type:'items'},
    {key:'featuredCategories',label:'What do you need help with?',type:'categories'},
    {key:'homeCare',label:'For your home',type:'items'},
    {key:'repairs',label:'Home repairs',type:'items'},
    {key:'events',label:'Events & occasions',type:'items'}
  ],
  draft:{hero:{},popular:{},featuredCategories:{},homeCare:{},repairs:{},events:{},sectionOrder:[],howItWorks:{steps:[]},businessCta:{}},items:[],categories:[],mediaItems:[],publishedAt:null,saving:false,publishing:false,error:'',success:'',
  async init(){try{const [home,items,cats,media]=await Promise.all([apiFetch('/api/website-content/homepage'),apiFetch('/api/website-content/items?includeInactive=false'),apiFetch('/api/catalog/categories?includeInactive=false'),apiFetch('/api/website-content/media?limit=500')]);this.draft=home.data.draft;this.prepareDraft();this.publishedAt=home.data.publishedAt;this.items=items.data||[];this.categories=cats.data||[];this.mediaItems=media.data||[];}catch(e){this.error=e.message;}},
  prepareDraft(){const valid=this.fixedSections.map(s=>s.key);const sectionIds={popular:'popular',featuredCategories:'featured-categories',homeCare:'home-care',repairs:'repairs',events:'events'};const current=Array.isArray(this.draft.sectionOrder)?this.draft.sectionOrder.filter((key,index,list)=>valid.includes(key)&&list.indexOf(key)===index):[];valid.forEach(key=>{if(!current.includes(key))current.push(key);this.draft[key]=this.draft[key]||{};const old=(this.draft.sections||[]).find(row=>row&&row.id===sectionIds[key]);const directCount=(this.draft[key].itemIds||[]).length+(this.draft[key].categorySlugs||[]).length;const oldCount=(old?.itemIds||[]).length+(old?.categorySlugs||[]).length;if(directCount===0&&oldCount>0){this.draft[key].itemIds=[...(old.itemIds||[])];this.draft[key].categorySlugs=[...(old.categorySlugs||[])];if(!this.draft[key].heading)this.draft[key].heading=old.heading||'';if(!this.draft[key].subheading)this.draft[key].subheading=old.subheading||'';if(this.draft[key].enabled===undefined)this.draft[key].enabled=old.enabled!==false;}this.draft[key].itemIds=this.draft[key].itemIds||[];this.draft[key].categorySlugs=this.draft[key].categorySlugs||[];this.draft[key]._search='';this.draft[key]._categoryFilter='';this.draft[key]._kindFilter='';});this.draft.sectionOrder=current;this.draft.hero=this.draft.hero||{};this.draft.howItWorks=this.draft.howItWorks||{steps:[]};this.draft.howItWorks.steps=this.draft.howItWorks.steps||[];this.draft.businessCta=this.draft.businessCta||{};},
  orderedSectionKeys(){return Array.isArray(this.draft.sectionOrder)&&this.draft.sectionOrder.length?this.draft.sectionOrder:this.fixedSections.map(s=>s.key)},
  sectionMeta(key){return this.fixedSections.find(s=>s.key===key)||{key,label:key,type:'items'}},
  moveSection(index,delta){this.move(this.draft.sectionOrder,index,delta)},
  categoryName(slug){return this.categories.find(c=>c.slug===slug)?.name||slug},
  itemLabel(item){return `${item.name} · ${item.kind==='product'?'Product':'Service'} · ${item.categorySlug||''} › ${item.serviceTypeSlug||''}`},
  itemName(id){const item=this.items.find(i=>i.itemId===id);return item?this.itemLabel(item):'Missing item'},
  filteredCategories(section){const used=new Set(section.categorySlugs||[]);const q=String(section._search||'').trim().toLowerCase();return this.categories.filter(c=>!used.has(c.slug)&&c.active!==false&&c.websiteVisible!==false&&(!q||`${c.name} ${c.slug}`.toLowerCase().includes(q))).slice(0,200)},
  filteredItems(section){const used=new Set(section.itemIds||[]);const q=String(section._search||'').trim().toLowerCase();const cat=String(section._categoryFilter||'');const kind=String(section._kindFilter||'');return this.items.filter(i=>!used.has(i.itemId)&&i.active!==false&&i.websiteVisible!==false&&(!cat||i.categorySlug===cat)&&(!kind||i.kind===kind)&&(!q||`${i.name} ${i.slug} ${i.categorySlug} ${i.serviceTypeSlug}`.toLowerCase().includes(q)))},
  addCategory(section,slug){if(slug&&!section.categorySlugs.includes(slug))section.categorySlugs.push(slug)},
  addItem(section,id){if(id&&!section.itemIds.includes(id))section.itemIds.push(id)},
  move(list,index,delta){const target=index+delta;if(!Array.isArray(list)||target<0||target>=list.length)return;const value=list[index];list.splice(index,1);list.splice(target,0,value)},
  cleanDraft(){const clone=JSON.parse(JSON.stringify(this.draft));const defs={popular:{id:'popular',groupId:'for-you',contentType:'items',layout:'rail'},featuredCategories:{id:'featured-categories',groupId:'for-you',contentType:'categories',layout:'grid'},homeCare:{id:'home-care',groupId:'home-services',contentType:'items',layout:'rail'},repairs:{id:'repairs',groupId:'repairs',contentType:'items',layout:'rail'},events:{id:'events',groupId:'events',contentType:'items',layout:'rail'}};this.fixedSections.forEach(({key})=>{if(!clone[key])return;delete clone[key]._search;delete clone[key]._categoryFilter;delete clone[key]._kindFilter;});clone.sections=clone.sectionOrder.map((key,index)=>{const row=clone[key]||{};return{...defs[key],enabled:row.enabled!==false,heading:row.heading||'',subheading:row.subheading||'',seeAllHref:'/explore',cardLimit:12,itemIds:[...(row.itemIds||[])],categorySlugs:[...(row.categorySlugs||[])],mediaId:'',buttonText:'',buttonHref:'',_order:index};});return clone},
  async persistDraft(){const result=await apiFetch('/api/website-content/homepage',{method:'PUT',body:JSON.stringify(this.cleanDraft())});this.draft=result.data.draft;this.prepareDraft();return result},
  async save(){if(this.saving)return;this.saving=true;this.error='';this.success='';try{await this.persistDraft();this.success='Homepage draft saved. Live website is unchanged until you publish.';}catch(e){this.error=e.message;}finally{this.saving=false;}},
  async publish(){if(this.publishing)return;this.publishing=true;this.error='';this.success='';try{if(<%= canManage ? 'true' : 'false' %>)await this.persistDraft();const result=(await apiFetch('/api/website-content/homepage/publish',{method:'POST',body:'{}'})).data;this.publishedAt=result.publishedAt;this.success='Homepage content published to Findoly.com.';}catch(e){this.error=e.message;}finally{this.publishing=false;}},
  formatDate(v){return v?new Date(v).toLocaleString():'—'}
}}
</script><%- include('../partials/scripts') %></body></html>
