<%
  const canAccess = typeof can === 'function' ? can : () => true;
  const canManage = canAccess('websiteContent.manage');
  const canPublish = canAccess('websiteContent.publish');
%>
<!doctype html><html lang="en" dir="ltr"><%- include('../partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('../partials/navbar') %>
<div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
<div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Website Content / Homepage</div><h1 class="page-title mb-1">Homepage Manager</h1><p class="crm-page-subtitle mb-0">Manage Findoly.com homepage text, visibility and featured content without changing the approved layout.</p></div><div class="crm-page-actions"><a href="/website-content/media" class="btn btn-light">Media Library</a><% if (canManage) { %><button form="homepage-form" class="btn btn-light" type="submit">Save draft</button><% } %><% if (canPublish) { %><button class="btn btn-primary" type="button" @click="$dispatch('publish-homepage')">Publish</button><% } %></div></div></div>
<div class="content" x-data="homepageManager()" x-init="init()" @publish-homepage.window="publish()"><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div x-show="success" x-cloak class="alert alert-success" x-text="success"></div><div class="alert alert-info" x-show="publishedAt"><strong>Published:</strong> <span x-text="formatDate(publishedAt)"></span>. Draft edits do not affect the live website until Publish is pressed.</div>
<form id="homepage-form" @submit.prevent="save()">
  <fieldset <%= canManage ? '' : 'disabled' %>>
  <div class="card mb-3"><div class="card-header"><h5 class="mb-0">Hero / Search</h5></div><div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft.hero.enabled"><label class="form-check-label">Show hero</label></div><div class="row g-3"><div class="col-md-5"><label class="form-label">Eyebrow</label><input class="form-control" x-model="draft.hero.eyebrow" maxlength="120"></div><div class="col-md-7"><label class="form-label">Heading</label><input class="form-control" x-model="draft.hero.heading" maxlength="180"></div></div></div></div>
  <template x-for="key in sectionKeys" :key="key"><div class="card mb-3"><div class="card-header d-flex align-items-center justify-content-between gap-2"><div><h5 class="mb-1" x-text="sectionLabel(key)"></h5><p class="text-muted mb-0">Choose content and use Up/Down to control card order.</p></div><div class="d-flex gap-1"><button type="button" class="btn btn-light btn-sm" @click="moveSection(key,-1)">Section up</button><button type="button" class="btn btn-light btn-sm" @click="moveSection(key,1)">Section down</button></div></div><div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft[key].enabled"><label class="form-check-label">Show section</label></div><div class="row g-3"><div class="col-md-5"><label class="form-label">Heading</label><input class="form-control" x-model="draft[key].heading" maxlength="160"></div><div class="col-md-7"><label class="form-label">Subheading</label><input class="form-control" x-model="draft[key].subheading" maxlength="300"></div></div><div class="mt-3" x-show="key==='featuredCategories'"><label class="form-label">Categories</label><select class="form-select" @change="addCategory(key,$event.target.value);$event.target.value='' "><option value="">Add category…</option><template x-for="category in availableCategories(key)" :key="category.slug"><option :value="category.slug" x-text="category.name"></option></template></select><div class="mt-2"><template x-for="(slug,index) in draft[key].categorySlugs" :key="slug"><div class="d-flex align-items-center gap-2 border rounded p-2 mb-1"><span class="flex-grow-1" x-text="categoryName(slug)"></span><button type="button" class="btn btn-light btn-sm" @click="move(draft[key].categorySlugs,index,-1)">Up</button><button type="button" class="btn btn-light btn-sm" @click="move(draft[key].categorySlugs,index,1)">Down</button><button type="button" class="btn btn-light btn-sm" @click="draft[key].categorySlugs.splice(index,1)">Remove</button></div></template></div></div><div class="mt-3" x-show="key!=='featuredCategories'"><label class="form-label">Services / Products</label><select class="form-select" @change="addItem(key,$event.target.value);$event.target.value='' "><option value="">Add content…</option><template x-for="item in availableItems(key)" :key="item.itemId"><option :value="item.itemId" x-text="item.name+' · '+(item.kind==='product'?'Product':'Service')"></option></template></select><div class="mt-2"><template x-for="(id,index) in draft[key].itemIds" :key="id"><div class="d-flex align-items-center gap-2 border rounded p-2 mb-1"><span class="flex-grow-1" x-text="itemName(id)"></span><button type="button" class="btn btn-light btn-sm" @click="move(draft[key].itemIds,index,-1)">Up</button><button type="button" class="btn btn-light btn-sm" @click="move(draft[key].itemIds,index,1)">Down</button><button type="button" class="btn btn-light btn-sm" @click="draft[key].itemIds.splice(index,1)">Remove</button></div></template></div></div></div></div></template>
  <div class="card mb-3"><div class="card-header"><h5 class="mb-0">How Findoly Works</h5></div><div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft.howItWorks.enabled"><label class="form-check-label">Show section</label></div><div class="mb-3"><label class="form-label">Heading</label><input class="form-control" x-model="draft.howItWorks.heading" maxlength="160"></div><div class="row g-3"><template x-for="(step,index) in draft.howItWorks.steps" :key="index"><div class="col-lg-4"><div class="border rounded p-3 h-100"><strong x-text="'Step '+(index+1)"></strong><label class="form-label mt-2">Title</label><input class="form-control mb-2" x-model="step.title" maxlength="120"><label class="form-label">Text</label><textarea class="form-control" rows="3" x-model="step.text" maxlength="300"></textarea></div></div></template></div></div></div>
  <div class="card mb-3"><div class="card-header"><h5 class="mb-0">Business CTA</h5></div><div class="card-body"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" x-model="draft.businessCta.enabled"><label class="form-check-label">Show CTA</label></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Eyebrow</label><input class="form-control" x-model="draft.businessCta.eyebrow"></div><div class="col-md-8"><label class="form-label">Heading</label><input class="form-control" x-model="draft.businessCta.heading"></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="2" x-model="draft.businessCta.text"></textarea></div><div class="col-md-6"><label class="form-label">Button text</label><input class="form-control" x-model="draft.businessCta.buttonText"></div><div class="col-md-6"><label class="form-label">Button destination</label><input class="form-control" x-model="draft.businessCta.buttonHref"></div><div class="col-12"><label class="form-label">Optional promotional image</label><select class="form-select" x-model="draft.businessCta.mediaId"><option value="">No dedicated image</option><template x-for="media in mediaItems" :key="media.mediaId"><option :value="media.mediaId" x-text="media.altText || media.originalName || media.fileName"></option></template></select></div></div></div></div>
  </fieldset>
  <% if (canManage || canPublish) { %><div class="d-flex justify-content-end gap-2 mb-4"><% if (canManage) { %><button class="btn btn-light" type="submit" :disabled="saving" x-text="saving?'Saving…':'Save draft'"></button><% } %><% if (canPublish) { %><button class="btn btn-primary" type="button" @click="publish()" :disabled="publishing" x-text="publishing?'Publishing…':'Publish homepage'"></button><% } %></div><% } %>
</form></div><%- include('../partials/footer') %></div></div></div>
<script>
function homepageManager(){return{draft:{sectionOrder:[],hero:{},featuredCategories:{},popular:{},homeCare:{},repairs:{},events:{},howItWorks:{steps:[]},businessCta:{}},items:[],categories:[],mediaItems:[],publishedAt:null,saving:false,publishing:false,error:'',success:'',sectionKeys:['popular','featuredCategories','homeCare','repairs','events'],
 async init(){try{const [home,items,cats,media]=await Promise.all([apiFetch('/api/website-content/homepage'),apiFetch('/api/website-content/items?includeInactive=false'),apiFetch('/api/catalog/categories?includeInactive=false'),apiFetch('/api/website-content/media?limit=500')]);this.draft=home.data.draft;this.sectionKeys=Array.isArray(this.draft.sectionOrder)&&this.draft.sectionOrder.length?this.draft.sectionOrder:['popular','featuredCategories','homeCare','repairs','events'];this.draft.sectionOrder=[...this.sectionKeys];this.publishedAt=home.data.publishedAt;this.items=items.data||[];this.categories=cats.data||[];this.mediaItems=media.data||[];}catch(e){this.error=e.message;}},
 sectionLabel(k){return({featuredCategories:'What do you need help with?',popular:'Popular near you',homeCare:'For your home',repairs:'Home repairs',events:'Events & occasions'})[k]||k}, itemName(id){return this.items.find(i=>i.itemId===id)?.name||'Missing item'}, categoryName(slug){return this.categories.find(c=>c.slug===slug)?.name||slug}, availableItems(k){const used=new Set(this.draft[k].itemIds||[]);return this.items.filter(i=>!used.has(i.itemId)&&i.active!==false&&i.websiteVisible!==false)},availableCategories(k){const used=new Set(this.draft[k].categorySlugs||[]);return this.categories.filter(c=>!used.has(c.slug)&&c.active!==false)},addItem(k,id){if(id&&!this.draft[k].itemIds.includes(id))this.draft[k].itemIds.push(id)},addCategory(k,slug){if(slug&&!this.draft[k].categorySlugs.includes(slug))this.draft[k].categorySlugs.push(slug)},move(list,index,delta){const target=index+delta;if(target<0||target>=list.length)return;const value=list[index];list.splice(index,1);list.splice(target,0,value)},moveSection(key,delta){const index=this.sectionKeys.indexOf(key);this.move(this.sectionKeys,index,delta);this.draft.sectionOrder=[...this.sectionKeys]},
 async persistDraft(){this.draft.sectionOrder=[...this.sectionKeys];return apiFetch('/api/website-content/homepage',{method:'PUT',body:JSON.stringify(this.draft)})},
 async save(){if(this.saving)return;this.saving=true;this.error='';this.success='';try{await this.persistDraft();this.success='Homepage draft saved. Live website is unchanged until you publish.';}catch(e){this.error=e.message;}finally{this.saving=false;}},
 async publish(){if(this.publishing)return;this.publishing=true;this.error='';this.success='';try{if(<%= canManage ? 'true' : 'false' %>)await this.persistDraft();const result=(await apiFetch('/api/website-content/homepage/publish',{method:'POST',body:'{}'})).data;this.publishedAt=result.publishedAt;this.success='Homepage published to the customer website.';}catch(e){this.error=e.message;}finally{this.publishing=false;}},formatDate(v){return v?new Date(v).toLocaleString():'—'}
}}
</script><%- include('../partials/scripts') %></body></html>
