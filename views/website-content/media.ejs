<%
  const canAccess = typeof can === 'function' ? can : () => true;
  const canManage = canAccess('websiteContent.manage');
%>
<!doctype html><html lang="en" dir="ltr"><%- include('../partials/head') %><body x-data="crmShell()" x-init="initShell()"><%- include('../partials/navbar') %>
<div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
  <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Website Content / Media</div><h1 class="page-title mb-1">Media Library</h1><p class="crm-page-subtitle mb-0">Upload once to the existing CRM S3 storage and reuse images across services, products and homepage content.</p></div><div class="crm-page-actions"><a href="/website-content/services" class="btn btn-light">Services</a><a href="/website-content/products" class="btn btn-light">Products</a><a href="/website-content/homepage" class="btn btn-primary">Homepage</a></div></div></div>
  <div class="content" x-data="mediaLibrary()" x-init="load()"><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div x-show="success" x-cloak class="alert alert-success" x-text="success"></div>
    <% if (canManage) { %><form class="card mb-3" @submit.prevent="upload()"><div class="card-header"><div><h5 class="mb-1">Upload website image</h5><p class="text-muted mb-0">JPEG, PNG and WebP are resized in your browser to a maximum 1920px edge and saved as optimized WebP before S3 upload.</p></div></div><div class="card-body"><div class="row g-3"><div class="col-lg-5"><label class="form-label">Choose image</label><input type="file" class="form-control" accept="image/jpeg,image/png,image/webp" x-ref="file" @change="selected=$event.target.files[0]||null" required></div><div class="col-lg-5"><label class="form-label">Alt text</label><input class="form-control" x-model="altText" maxlength="300" placeholder="Describe the image for accessibility"></div><div class="col-lg-2 d-flex align-items-end"><button class="btn btn-primary w-100" :disabled="uploading || !selected" x-text="uploading ? 'Uploading…' : 'Upload'"></button></div></div><div class="progress mt-3" x-show="uploading" x-cloak><div class="progress-bar" :style="'width:'+progress+'%'" x-text="progress+'%'"></div></div></div></form><% } %>
    <div class="card"><div class="card-header crm-card-heading"><div><h5 class="mb-1">Library</h5><p class="text-muted mb-0"><span x-text="items.length"></span> reusable website images</p></div><div style="max-width:320px"><input class="form-control" type="search" x-model="q" @input.debounce.250ms="load()" placeholder="Search images"></div></div><div class="card-body"><div class="row g-3"><template x-for="media in items" :key="media.mediaId"><div class="col-6 col-md-4 col-xl-3"><div class="card h-100"><img :src="media.publicUrl" :alt="media.altText || ''" class="card-img-top" style="height:150px;object-fit:cover"><div class="card-body p-3"><div class="fw-semibold text-truncate" x-text="media.altText || media.originalName || media.fileName"></div><small class="text-muted" x-text="dimensions(media)"></small><% if (canManage) { %><div class="mt-2 d-flex gap-1"><button class="btn btn-light btn-sm" type="button" @click="editAlt(media)">Edit</button><button class="btn btn-light btn-sm text-danger" type="button" @click="remove(media)">Delete</button></div><% } %></div></div></div></template><div class="col-12 text-center text-muted py-5" x-show="!items.length">No website images found.</div></div></div></div>
  </div><%- include('../partials/footer') %>
</div></div></div>
<script>
function mediaLibrary(){return{items:[],q:'',selected:null,altText:'',uploading:false,progress:0,error:'',success:'',
 async load(){this.error='';try{this.items=(await apiFetch('/api/website-content/media?limit=500&q='+encodeURIComponent(this.q))).data||[];}catch(e){this.error=e.message;}},
 dimensions(m){return (m.width&&m.height?m.width+'×'+m.height+' · ':'')+this.formatBytes(m.sizeBytes)},formatBytes(v){const b=Number(v||0);if(!b)return'0 B';const u=['B','KB','MB'];const i=Math.min(Math.floor(Math.log(b)/Math.log(1024)),2);return(b/Math.pow(1024,i)).toFixed(i?1:0)+' '+u[i]},
 async optimize(file){const bitmap=await createImageBitmap(file);const max=1920;const scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));const width=Math.max(1,Math.round(bitmap.width*scale));const height=Math.max(1,Math.round(bitmap.height*scale));const canvas=document.createElement('canvas');canvas.width=width;canvas.height=height;canvas.getContext('2d').drawImage(bitmap,0,0,width,height);bitmap.close();const blob=await new Promise((resolve,reject)=>canvas.toBlob((value)=>value?resolve(value):reject(new Error('Could not optimize image.')),'image/webp',0.86));return{blob,width,height};},
 async upload(){if(this.uploading||!this.selected)return;this.uploading=true;this.progress=5;this.error='';this.success='';try{const original=this.selected;const optimized=await this.optimize(original);this.progress=20;const upload=(await apiFetch('/api/website-content/media/upload-url',{method:'POST',body:JSON.stringify({fileName:original.name,contentType:'image/webp',sizeBytes:optimized.blob.size})})).data;this.progress=40;const response=await fetch(upload.url,{method:upload.method||'PUT',headers:upload.headers||{},body:optimized.blob});if(!response.ok)throw new Error('S3 image upload failed with status '+response.status+'.');this.progress=80;await apiFetch('/api/website-content/media',{method:'POST',body:JSON.stringify({s3Key:upload.key,fileName:upload.fileName,originalName:original.name,mimeType:'image/webp',sizeBytes:optimized.blob.size,width:optimized.width,height:optimized.height,altText:this.altText})});this.progress=100;this.success='Image uploaded to the Media Library.';this.selected=null;this.altText='';this.$refs.file.value='';await this.load();}catch(e){this.error=e.message;}finally{this.uploading=false;setTimeout(()=>this.progress=0,400);}},
 async editAlt(media){const value=window.prompt('Alt text',media.altText||'');if(value===null)return;try{await apiFetch('/api/website-content/media/'+encodeURIComponent(media.mediaId),{method:'PATCH',body:JSON.stringify({altText:value})});this.success='Alt text updated.';await this.load();}catch(e){this.error=e.message;}},
 async remove(media){if(!window.confirm('Delete this image? It will be blocked if any website content still uses it.'))return;try{await apiFetch('/api/website-content/media/'+encodeURIComponent(media.mediaId),{method:'DELETE'});this.success='Image deleted.';await this.load();}catch(e){this.error=e.message;}}
}}
</script><%- include('../partials/scripts') %></body></html>
