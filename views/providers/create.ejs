<%- include('../partials/pageStart', { subtitle: 'Create provider' }) %>

<div class="card">
  <div class="card-header d-sm-flex align-items-sm-center"><h5 class="mb-0">Create provider</h5><a href="/providers" class="btn btn-light ms-sm-auto mt-2 mt-sm-0"><i class="ph-arrow-left me-2"></i>Back</a></div>
  <div class="card-body border-top">
    <form method="post" action="/providers">
      <fieldset class="mb-3"><legend class="fs-base fw-bold border-bottom pb-2 mb-3">Provider profile</legend>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Name <span class="text-danger">*</span></label><div class="col-lg-9"><input class="form-control" name="name" required></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Business name</label><div class="col-lg-9"><input class="form-control" name="businessName"></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Mobile / email</label><div class="col-lg-4"><input class="form-control" name="mobile" required></div><div class="col-lg-5"><input class="form-control" type="email" name="email"></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Status</label><div class="col-lg-9"><select class="form-select" name="status"><% statuses.forEach((s)=>{ %><option value="<%= s %>"><%= humanize(s) %></option><% }) %></select></div></div>
      </fieldset>
      <fieldset class="mb-3"><legend class="fs-base fw-bold border-bottom pb-2 mb-3">Service capability</legend>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Categories</label><div class="col-lg-9"><input class="form-control" name="categorySlugs" value="<%= categories.slice(0,2).map(c=>c.slug).join(', ') %>"><div class="form-text">Comma-separated category slugs.</div></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Skills</label><div class="col-lg-9"><input class="form-control" name="skills" placeholder="home visit, polishing, wall repair"><div class="form-text">Comma-separated skills.</div></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Location</label><div class="col-lg-4"><input class="form-control" name="city"></div><div class="col-lg-5"><input class="form-control" name="state"></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Service areas</label><div class="col-lg-9"><input class="form-control" name="serviceAreas"><div class="form-text">Comma-separated cities/areas.</div></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Availability / rating</label><div class="col-lg-6"><select class="form-select" name="availability"><option value="available_today">Available today</option><option value="available_this_week">Available this week</option><option value="limited">Limited</option><option value="unavailable">Unavailable</option></select></div><div class="col-lg-3"><input class="form-control" type="number" name="rating" step="0.1" min="0" max="5" value="4"></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Documents verified</label><div class="col-lg-9"><select class="form-select" name="documentsVerified"><option value="true">Yes</option><option value="false">No</option></select></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label">Notes</label><div class="col-lg-9"><textarea class="form-control" name="notes" rows="4"></textarea></div></div>
      </fieldset>
      <div class="text-end"><button class="btn btn-primary" type="submit">Create provider</button></div>
    </form>
  </div>
</div>

<%- include('../partials/pageEnd') %>
