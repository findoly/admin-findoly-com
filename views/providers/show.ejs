<%- include('../partials/pageStart', { subtitle: 'Provider profile' }) %>

<div class="row">
  <div class="col-xl-5">
    <div class="card">
      <div class="card-header d-flex align-items-center"><h5 class="mb-0"><%= provider.name %></h5><div class="ms-auto d-inline-flex align-items-center gap-2"><a href="/providers/<%= provider.id %>/edit" class="btn btn-light btn-sm"><i class="ph-pencil-simple me-2"></i>Edit</a><%- include('../partials/statusBadge', { value: provider.status, humanize }) %></div></div>
      <div class="card-body">
        <div class="row mb-2"><label class="col-sm-4 col-form-label text-muted">Business</label><div class="col-sm-8 pt-sm-2"><%= provider.businessName || '-' %></div></div>
        <div class="row mb-2"><label class="col-sm-4 col-form-label text-muted">Mobile</label><div class="col-sm-8 pt-sm-2"><%= provider.mobile || '-' %></div></div>
        <div class="row mb-2"><label class="col-sm-4 col-form-label text-muted">Email</label><div class="col-sm-8 pt-sm-2"><%= provider.email || '-' %></div></div>
        <div class="row mb-2"><label class="col-sm-4 col-form-label text-muted">Categories</label><div class="col-sm-8 pt-sm-2"><%= (provider.categorySlugs || []).map(humanize).join(', ') %></div></div>
        <div class="row mb-2"><label class="col-sm-4 col-form-label text-muted">Skills</label><div class="col-sm-8 pt-sm-2"><%= (provider.skills || []).join(', ') || '-' %></div></div>
        <div class="row mb-2"><label class="col-sm-4 col-form-label text-muted">Location</label><div class="col-sm-8 pt-sm-2"><%= [provider.city, provider.state].filter(Boolean).join(', ') || '-' %></div></div>
        <div class="row mb-2"><label class="col-sm-4 col-form-label text-muted">Service areas</label><div class="col-sm-8 pt-sm-2"><%= (provider.serviceAreas || []).join(', ') || '-' %></div></div>
        <div class="row mb-2"><label class="col-sm-4 col-form-label text-muted">Availability</label><div class="col-sm-8 pt-sm-2"><%= humanize(provider.availability) %></div></div>
        <div class="row mb-2"><label class="col-sm-4 col-form-label text-muted">Rating</label><div class="col-sm-8 pt-sm-2"><%= provider.rating || 0 %> / 5</div></div>
        <div class="row mb-0"><label class="col-sm-4 col-form-label text-muted">Documents</label><div class="col-sm-8 pt-sm-2"><%= provider.documentsVerified ? 'Verified' : 'Pending' %></div></div>
      </div>
    </div>
  </div>
  <div class="col-xl-7">
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Edit provider</h5></div>
      <div class="card-body border-top">
        <form method="post" action="/providers/<%= provider.id %>">
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Status</label><div class="col-lg-9"><select class="form-select" name="status"><% statuses.forEach((s)=>{ %><option value="<%= s %>" <%= provider.status === s ? 'selected' : '' %>><%= humanize(s) %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Categories</label><div class="col-lg-9"><input class="form-control" name="categorySlugs" value="<%= (provider.categorySlugs || []).join(', ') %>"></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Skills</label><div class="col-lg-9"><input class="form-control" name="skills" value="<%= (provider.skills || []).join(', ') %>"></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Service areas</label><div class="col-lg-9"><input class="form-control" name="serviceAreas" value="<%= (provider.serviceAreas || []).join(', ') %>"></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Availability</label><div class="col-lg-5"><input class="form-control" name="availability" value="<%= provider.availability %>"></div><label class="col-lg-1 col-form-label text-lg-end">Rating</label><div class="col-lg-3"><input class="form-control" type="number" step="0.1" min="0" max="5" name="rating" value="<%= provider.rating || 0 %>"></div></div>
          <div class="row mb-3"><label class="col-lg-3 col-form-label">Notes</label><div class="col-lg-9"><textarea class="form-control" name="notes" rows="4"><%= provider.notes || '' %></textarea></div></div>
          <div class="text-end"><button class="btn btn-primary" type="submit">Save provider</button></div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header"><h5 class="mb-0">Assigned enquiries</h5></div>
  <div class="table-responsive"><table class="table text-nowrap"><thead><tr><th>Customer</th><th>Service</th><th>Status</th><th>Created</th><th class="text-center" style="width:20px"><i class="ph-dots-three"></i></th></tr></thead><tbody>
    <% enquiries.forEach((enquiry) => { %><tr><td><%= enquiry.customer.name %></td><td><%= enquiry.serviceType %></td><td><%- include('../partials/statusBadge', { value: enquiry.status, humanize }) %></td><td><%= formatDate(enquiry.createdAt) %></td><td class="text-center"><a href="/enquiries/<%= enquiry.id %>" class="text-body"><i class="ph-arrow-circle-right"></i></a></td></tr><% }) %>
    <% if (!enquiries.length) { %><tr><td colspan="5" class="text-muted text-center py-4">No assigned enquiries.</td></tr><% } %>
  </tbody></table></div>
</div>

<%- include('../partials/pageEnd') %>
