<%- include('../partials/pageStart', { subtitle: 'Provider directory' }) %>

<div class="card">
  <div class="card-header d-sm-flex align-items-sm-center py-sm-0">
    <h5 class="py-sm-2 my-sm-1">Providers</h5>
    <div class="mt-2 mt-sm-0 ms-sm-auto"><a class="btn btn-primary" href="/providers/new"><i class="ph-plus me-2"></i>Create provider</a></div>
  </div>
  <div class="card-body border-top">
    <form class="row g-3 align-items-end" method="get">
      <div class="col-lg-5"><label class="form-label">Search</label><input class="form-control" name="search" placeholder="Provider, skill, city..." value="<%= filters.search || '' %>"></div>
      <div class="col-lg-3"><label class="form-label">Category</label><select class="form-select" name="categorySlug"><option value="">All categories</option><% categories.forEach((c)=>{ %><option value="<%= c.slug %>" <%= filters.categorySlug === c.slug ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
      <div class="col-lg-3"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All statuses</option><% statuses.forEach((s)=>{ %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= humanize(s) %></option><% }) %></select></div>
      <div class="col-lg-1"><label class="form-label">Per page</label><select class="form-select" name="pageSize"><% [10,25,50,100].forEach((size)=>{ %><option value="<%= size %>" <%= String(filters.pageSize || 25) === String(size) ? 'selected' : '' %>><%= size %></option><% }) %></select></div><div class="col-lg-1"><button class="btn btn-light w-100" type="submit">Filter</button></div>
    </form>
  </div>
  <div class="table-responsive">
    <table class="table text-nowrap">
      <thead><tr><th>Name</th><th>Categories</th><th>Skills</th><th>Location</th><th>Status</th><th>Rating</th><th class="text-center" style="width:150px">Action</th></tr></thead>
      <tbody>
      <% providers.forEach((provider) => { %>
        <tr>
          <td><div class="fw-semibold"><%= provider.name %></div><div class="text-muted fs-sm"><%= provider.mobile %> <%= provider.email || '' %></div></td>
          <td><%= (provider.categorySlugs || []).map(humanize).join(', ') %></td>
          <td><%= (provider.skills || []).join(', ') %></td>
          <td><%= [provider.city, provider.state].filter(Boolean).join(', ') %></td>
          <td><%- include('../partials/statusBadge', { value: provider.status, humanize }) %></td>
          <td><%= provider.rating || 0 %></td>
          <td class="text-center"><div class="d-inline-flex gap-2"><a class="btn btn-outline-primary btn-sm" href="/providers/<%= provider.id %>"><i class="ph-eye me-1"></i>View</a><a class="btn btn-light btn-sm" href="/providers/<%= provider.id %>/edit"><i class="ph-pencil-simple me-1"></i>Edit</a></div></td>
        </tr>
      <% }) %>
      <% if (!providers.length) { %><tr><td colspan="7" class="text-muted text-center py-4">No providers found.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination }) %>
</div>

<%- include('../partials/pageEnd') %>
