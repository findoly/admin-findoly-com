<%- include('../partials/pageStart') %><div x-data="formPage()" x-init="init()"><div x-show="error" class="alert alert-danger" x-text="error"></div><form class="card" @submit.prevent="save"><div class="card-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Requirement ID</label><input class="form-control" x-model="form.enquiryId"></div><div class="col-md-4"><label class="form-label">Recipient</label><input class="form-control" x-model="form.recipientName"></div><div class="col-md-4"><label class="form-label">Contact</label><input class="form-control" x-model="form.recipientContact"></div><div class="col-md-3"><label class="form-label">Channel</label><select class="form-select" x-model="form.channel"><option>call</option><option>whatsapp</option><option>email</option><option>sms</option></select></div><div class="col-md-3"><label class="form-label">Direction</label><select class="form-select" x-model="form.direction"><option>outbound</option><option>inbound</option></select></div><div class="col-md-3"><label class="form-label">Status</label><input class="form-control" x-model="form.status"></div><div class="col-12"><label class="form-label">Message</label><textarea class="form-control" rows="5" x-model="form.message"></textarea></div></div></div><div class="card-footer"><button class="btn btn-primary">Save</button></div></form></div><script>function formPage(){return{mode:<%- JSON.stringify(mode) %>,recordId:<%- JSON.stringify(recordId) %>,form:{enquiryId:<%- JSON.stringify(enquiryId) %>,recipientName:'',recipientContact:'',channel:'call',direction:'outbound',status:'logged',message:''},error:'',async init(){if(this.mode==='edit')this.form={...this.form,...(await apiFetch('/api/communication/'+this.recordId)).data}},async save(){try{await apiFetch(this.mode==='edit'?'/api/communication/'+this.recordId:'/api/communication',{method:this.mode==='edit'?'PUT':'POST',body:JSON.stringify(this.form)});location.href='/communications'}catch(e){this.error=e.message}}}}</script><%- include('../partials/pageEnd') %>
