<%
  const channel = typeof communicationChannel === 'string' ? communicationChannel : '';
  const base = channel === 'email' ? '/communications/email' : '/communications/whatsapp';
  const items = channel === 'email'
    ? [
        { key: 'overview', label: 'Email overview', href: base },
        { key: 'internal-alerts', label: 'Internal alerts', href: base + '/internal-alerts' },
        { key: 'templates', label: 'Templates', href: base + '/templates' },
        { key: 'rules', label: 'Automations', href: base + '/automations' },
        { key: 'logs', label: 'Message logs', href: base + '/logs' },
      ]
    : [
        { key: 'overview', label: 'WhatsApp overview', href: base },
        { key: 'inbox', label: 'Open Inbox ↗', href: '/whatsapp-inbox', external: true },
        { key: 'templates', label: 'Templates', href: base + '/templates' },
        { key: 'rules', label: 'Automations', href: base + '/automations' },
        { key: 'logs', label: 'Message logs', href: base + '/logs' },
      ];
%>
<nav class="crm-communication-tabs mb-3" aria-label="<%= channel === 'email' ? 'Email management' : 'WhatsApp management' %>">
  <% items.forEach((item) => { %>
    <a class="<%= active === item.key ? 'active' : '' %>" href="<%= item.href %>" <%- item.external ? 'target="_blank" rel="noopener"' : '' %>><%= item.label %></a>
  <% }) %>
</nav>
