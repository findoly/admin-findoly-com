<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Communication Center</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">Monitor OTP delivery and verification without exposing OTP values.</p></div><a href="#send-test-otp" class="btn btn-primary crm-primary-action">Send test OTP</a></div></div>
      <div class="content" x-data="otpPage()" x-init="load()">
        <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div x-show="message" x-cloak class="alert alert-success" x-text="message"></div>
        <%- include('_navigation', { active: 'otp' }) %>

        <section id="send-test-otp" class="card mb-3"><div class="card-header crm-card-heading"><div><h5 class="mb-1">Send test OTP</h5><p class="text-muted mb-0">Uses the latest approved Authentication template for WhatsApp.</p></div></div><form @submit.prevent="sendOtp()"><div class="card-body"><div class="row g-3"><div class="col-md-3"><label class="form-label">Channel</label><select class="form-select" x-model="form.channel"><option value="whatsapp">WhatsApp</option><option value="email">Email</option></select></div><div class="col-md-4"><label class="form-label">Recipient</label><input class="form-control" x-model="form.recipient" maxlength="254" required></div><div class="col-md-3"><label class="form-label">Purpose</label><input class="form-control" x-model="form.purpose" maxlength="80" pattern="[a-zA-Z0-9_-]+" required></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100" :disabled="sending"><span x-text="sending ? 'Sending…' : 'Send OTP'"></span></button></div></div></div></form></section>

        <section class="card crm-filter-card mb-3"><form class="crm-filter-bar" @submit.prevent="search()">
          <label class="crm-search-control"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" x-model="filters.q" placeholder="Search recipient or OTP request ID" aria-label="Search OTP activity"></label>
          <label class="crm-filter-field"><span>Channel</span><select x-model="filters.channel"><option value="">All channels</option><option value="whatsapp">WhatsApp</option><option value="email">Email</option></select></label>
          <label class="crm-filter-field crm-filter-field-wide"><span>Purpose</span><input type="text" x-model="filters.purpose" maxlength="80" placeholder="login"></label>
          <label class="crm-filter-field"><span>Status</span><select x-model="filters.status"><option value="">All statuses</option><option value="sent">Sent</option><option value="verified">Verified</option><option value="expired">Expired</option><option value="blocked">Blocked</option><option value="failed">Failed</option></select></label>
          <label class="crm-filter-field crm-filter-date"><span>From</span><input type="date" x-model="filters.startDate"></label>
          <label class="crm-filter-field crm-filter-date"><span>To</span><input type="date" x-model="filters.endDate"></label>
          <label class="crm-filter-field"><span>Sort</span><select x-model="filters.sortOrder"><option value="newest">Newest</option><option value="oldest">Oldest</option></select></label>
          <div class="crm-filter-actions"><button class="btn btn-primary" type="submit">Apply</button><button class="btn btn-light" type="button" x-show="hasFilters()" @click="reset()">Clear</button></div>
          <label class="crm-filter-field crm-filter-page-size"><span>Rows</span><select x-model.number="pagination.limit" @change="search()"><option :value="10">10</option><option :value="20">20</option><option :value="50">50</option><option :value="100">100</option></select></label>
        </form></section>

        <section class="card crm-data-card"><div class="card-header crm-card-heading"><div><h5 class="mb-1">OTP activity</h5><p class="text-muted mb-0">OTP hashes and codes are never returned to this page.</p></div><button class="btn btn-light btn-sm" @click="load()" :disabled="loading">Refresh</button></div><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Request ID</th><th>Recipient</th><th>Channel</th><th>Purpose</th><th>Status</th><th>Attempts</th><th>Expires</th><th>Created</th></tr></thead><tbody>
          <template x-if="loading"><tr><td colspan="8"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
          <template x-for="row in rows" :key="row.otpId"><tr><td><code x-text="row.otpId"></code></td><td x-text="row.recipient"></td><td x-text="humanize(row.channel)"></td><td x-text="humanize(row.purpose)"></td><td><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span><div class="text-danger fs-sm" x-show="row.failureReason" x-text="row.failureReason"></div></td><td x-text="row.attempts+' / '+row.maxAttempts"></td><td x-text="formatDate(row.expiresAt)"></td><td x-text="formatDate(row.createdAt)"></td></tr></template>
          <tr x-show="!loading && !rows.length"><td colspan="8" class="text-center text-muted py-4">No OTP activity found</td></tr>
        </tbody></table></div><div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page <= 1 || loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext || loading" @click="next()">Next</button></div></div></section>
      </div><%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function otpPage(){return{
        rows:[], form:{channel:'whatsapp',recipient:'',purpose:'login'}, filters:{q:'',channel:'',purpose:'',status:'',startDate:'',endDate:'',sortOrder:'newest'}, pagination:createCursorPagination(20), loading:false, sending:false,error:'',message:'',
        query(){const query=new URLSearchParams({...this.filters,limit:this.pagination.limit,cursor:this.pagination.cursor});[...query].forEach(([key,value])=>{if(!value)query.delete(key)});return query.toString();},
        hasFilters(){return Boolean(this.filters.q||this.filters.channel||this.filters.purpose||this.filters.status||this.filters.startDate||this.filters.endDate||this.filters.sortOrder!=='newest'||this.pagination.limit!==20);},
        async load(){this.loading=true;this.error='';try{const body=await apiFetch('/api/communication/otp?'+this.query());this.rows=body.data||[];applyCursorPagination(this.pagination,body.pagination||{});}catch(error){this.error=error.message;}finally{this.loading=false;}},
        search(){resetCursorPagination(this.pagination);this.load();},reset(){this.filters={q:'',channel:'',purpose:'',status:'',startDate:'',endDate:'',sortOrder:'newest'};this.pagination.limit=20;this.search();},next(){if(cursorNext(this.pagination))this.load();},previous(){if(cursorPrevious(this.pagination))this.load();},
        async sendOtp(){if(this.sending)return;this.sending=true;this.error='';this.message='';try{const body=await apiFetch('/api/communication/otp/send',{method:'POST',body:JSON.stringify(this.form)});this.message='OTP sent. Request ID: '+body.data.otpId;await this.load();}catch(error){this.error=error.message;}finally{this.sending=false;}}
      };}
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
