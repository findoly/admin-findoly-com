<%- include('../partials/pageStart') %><div x-data="listPage()" x-init="load()"><div class="d-flex gap-2 mb-3"><input class="form-control" style="max-width:360px" x-model="q" @keyup.enter="load" placeholder="Search communications"><select class="form-select" style="max-width:180px" x-model="channel" @change="load"><option value="">All channels</option><option>call</option><option>whatsapp</option><option>email</option><option>sms</option></select><a href="/communications/new" class="btn btn-primary ms-auto">Log communication</a></div><div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Recipient</th><th>Lead</th><th>Channel</th><th>Message</th><th>Date</th><th></th></tr></thead><tbody><template x-for="r in rows" :key="r.communicationId"><tr><td><div x-text="r.recipientName||'—'"></div><div class="text-muted fs-sm" x-text="r.recipientContact"></div></td><td x-text="r.enquiryId||'—'"></td><td x-text="humanize(r.channel)"></td><td x-text="r.message"></td><td x-text="formatDate(r.createdAt)"></td><td><a class="btn btn-light btn-sm" :href="'/communications/'+r.communicationId+'/edit'">Edit</a></td></tr></template></tbody></table></div></div></div><script>function listPage(){return{rows:[],q:'',channel:'',async load(){const b=await apiFetch('/api/communication?'+new URLSearchParams({q:this.q,channel:this.channel}));this.rows=b.data}}}</script><%- include('../partials/pageEnd') %>
