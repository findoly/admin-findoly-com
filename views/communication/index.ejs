<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Operations</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Review customer and provider communication history.</p>
              </div>
              <a href="/communications/new" class="btn btn-primary crm-primary-action"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Log communication</a>
            </div>
          </div>
          <div class="content">
            <div
              x-show="shellError"
              x-cloak
              class="alert alert-danger"
              x-text="shellError"
            ></div>
            <div x-data="listPage()" x-init="load()">
              <div class="d-flex gap-2 mb-3">
                <input
                  class="form-control"
                  style="max-width: 360px"
                  x-model="q"
                  @keyup.enter="load"
                  placeholder="Search communications"
                /><select
                  class="form-select"
                  style="max-width: 180px"
                  x-model="channel"
                  @change="load"
                >
                  <option value="">All channels</option>
                  <option>call</option>
                  <option>whatsapp</option>
                  <option>email</option>
                  <option>sms</option></select
                ><a href="/communications/new" class="btn btn-primary ms-auto"
                  >Log communication</a
                >
              </div>
              <div class="card">
                <div class="table-responsive">
                  <table class="table">
                    <thead>
                      <tr>
                        <th>Recipient</th>
                        <th>Lead</th>
                        <th>Channel</th>
                        <th>Message</th>
                        <th>Date</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-for="r in rows" :key="r.communicationId"
                        ><tr>
                          <td>
                            <div x-text="r.recipientName||'—'"></div>
                            <div
                              class="text-muted fs-sm"
                              x-text="r.recipientContact"
                            ></div>
                          </td>
                          <td x-text="r.enquiryId||'—'"></td>
                          <td x-text="humanize(r.channel)"></td>
                          <td x-text="r.message"></td>
                          <td x-text="formatDate(r.createdAt)"></td>
                          <td>
                            <a
                              class="btn btn-light btn-sm"
                              :href="'/communications/'+r.communicationId+'/edit'"
                              >Edit</a
                            >
                          </td>
                        </tr></template
                      >
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <script>
              function listPage() {
                return {
                  rows: [],
                  q: "",
                  channel: "",
                  async load() {
                    const b = await apiFetch(
                      "/api/communication?" +
                        new URLSearchParams({
                          q: this.q,
                          channel: this.channel,
                        }),
                    );
                    this.rows = b.data;
                  },
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
