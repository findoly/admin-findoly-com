<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow"><%= communicationChannel === 'email' ? 'Email management' : 'WhatsApp management' %></div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">Choose an event, recipient and <%= communicationChannel === 'email' ? 'active SES email' : 'approved Gupshup WhatsApp' %> template. Only <%= communicationChannel === 'email' ? 'email' : 'WhatsApp' %> settings are shown here.</p></div><button type="button" class="btn btn-primary crm-primary-action" @click="window.dispatchEvent(new CustomEvent('simple-rule-create'))">Create automation</button></div></div>
      <div class="content" x-data="simpleRulePage('<%= communicationChannel %>')" x-init="load()" @simple-rule-create.window="startCreate()">
        <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div x-show="message" x-cloak class="alert alert-success" x-text="message"></div>
        <%- include('_navigation', { active: 'rules', communicationChannel }) %>
        <% if (communicationChannel === 'email') { %><div class="alert alert-info">Automatic operational emails to <strong>alert@findoly.com</strong> are managed separately under <a href="/communications/email/internal-alerts">Internal alerts</a>.</div><% } %>
        <section class="card crm-filter-card mb-3"><form class="crm-filter-bar" @submit.prevent="search()"><label class="crm-search-control"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" x-model="q" placeholder="Search automation or event"></label><label class="crm-filter-field"><span>Status</span><select x-model="enabled"><option value="">All</option><option value="true">Enabled</option><option value="false">Disabled</option></select></label><div class="crm-filter-actions"><button class="btn btn-primary">Apply</button><button type="button" class="btn btn-light" @click="reset()">Clear</button></div></form></section>
        <section class="card mb-3" x-show="editing" x-cloak>
          <div class="card-header crm-card-heading"><div><h5 class="mb-1" x-text="mode === 'create' ? 'Create automation' : 'Edit automation'"></h5><p class="text-muted mb-0">The other communication channel remains unchanged when an existing shared rule is edited.</p></div><button type="button" class="btn btn-light btn-sm" @click="cancel()">Close</button></div>
          <form @submit.prevent="save()"><div class="card-body"><div class="row g-3">
            <div class="col-lg-4"><label class="form-label">Automation name</label><input class="form-control" x-model="form.name" maxlength="160" required></div>
            <div class="col-lg-4"><label class="form-label">Business event</label><select class="form-select" x-model="form.event" @change="applyDefaults()" :disabled="mode === 'edit'" required><option value="">Select event</option><template x-for="event in selectableEvents" :key="event"><option :value="event" x-text="humanize(event)"></option></template></select></div>
            <div class="col-lg-4"><label class="form-label">Recipient</label><select class="form-select" x-model="form.recipientSource" :disabled="form.event === 'nearby_lead_available'" required><option value="customer">Customer</option><option value="provider">Provider</option><option value="agent">Partner</option><option value="employee">Employee</option><option value="manual">Manual contact</option></select></div>
            <div class="col-lg-8"><label class="form-label"><span x-text="channelLabel"></span> template</label><select class="form-select" x-model="selectedTemplateId" @change="syncTemplate(false)" required><option value="">Select template</option><template x-for="template in availableTemplates" :key="template.templateId"><option :value="template.templateId" x-text="(template.displayName || template.name) + ' · ' + humanize(template.status)"></option></template></select><div class="form-text" x-show="!availableTemplates.length">No eligible template is available for this channel.</div></div>
            <div class="col-lg-4"><label class="form-label">Automation status</label><select class="form-select" x-model="form.enabled"><option :value="true">Enabled</option><option :value="false">Disabled</option></select></div>
            <div class="col-12" x-show="channel === 'whatsapp' && form.event" x-cloak>
              <div class="crm-automation-variable-summary">
                <div><strong>Event provides</strong><div class="crm-variable-chip-list"><template x-for="variable in eventVariables" :key="variable"><code x-text="'{{' + variable + '}}'"></code></template><span class="text-muted" x-show="!eventVariables.length">No event values are available.</span></div></div>
                <div><strong>Template requires</strong><div class="crm-variable-chip-list"><template x-for="(parameter,index) in selectedVariables" :key="index"><code x-text="parameter.variable || ('{{' + (parameter.placeholder || (index + 1)) + '}}')"></code></template><span class="text-muted" x-show="!selectedVariables.length">Select a template to view its parameters.</span></div></div>
              </div>
            </div>
            <div class="col-12" x-show="channel === 'whatsapp' && selectedVariables.length" x-cloak>
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2"><label class="form-label mb-0">Template parameters</label><span class="crm-status status-pending" x-show="missingWhatsappMappings">Mapping incomplete</span></div>
              <div class="row g-2"><template x-for="(parameter,index) in selectedVariables" :key="index"><div class="col-md-6"><label class="form-label fs-sm" x-text="'Parameter ' + (index + 1) + (parameter.label ? ' · ' + parameter.label : '')"></label><select class="form-select" x-model="form.whatsappParameterMappings[index]" required><option value="">Select event value</option><template x-for="variable in eventVariables" :key="variable"><option :value="variable" x-text="'{{' + variable + '}}'"></option></template></select><div class="form-text" x-show="!form.whatsappParameterMappings[index]">Choose the event value that fills this template parameter.</div></div></template></div>
            </div>
            <div class="col-md-6" x-show="channel === 'whatsapp' && form.event === 'nearby_lead_available'" x-cloak><label class="form-label">Unlock Lead quick-reply button</label><select class="form-select" x-model.number="form.whatsappActionButtonIndex" required><template x-for="button in quickReplyButtons" :key="button.index"><option :value="button.index" x-text="button.text"></option></template></select></div>
            <div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="2" x-model="form.description" maxlength="1000"></textarea></div>
          </div></div><div class="card-footer d-flex gap-2"><button class="btn btn-primary" :disabled="saving"><span x-text="saving ? 'Saving…' : 'Save automation'"></span></button><button type="button" class="btn btn-light" @click="cancel()">Cancel</button></div></form>
        </section>
        <section class="card crm-data-card"><div class="card-header crm-card-heading"><div><h5 class="mb-1"><span x-text="channelLabel"></span> automations</h5><p class="text-muted mb-0">Rules using only the other channel are still shown so this channel can be added without creating a duplicate event/recipient rule.</p></div></div><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Name</th><th>Event</th><th>Recipient</th><th>Template</th><th>Status</th><th></th></tr></thead><tbody><template x-if="loading"><tr><td colspan="6"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template><template x-for="row in visibleRows" :key="row.ruleId"><tr><td><div class="fw-semibold" x-text="row.name"></div><div class="text-muted fs-sm" x-text="row.description || ''"></div></td><td x-text="humanize(row.event)"></td><td x-text="recipientLabel(row.recipientSource)"></td><td><span x-text="templateName(templateIdFor(row)) || 'Not configured'"></span><div class="text-muted fs-sm" x-show="!channelEnabled(row)">This channel is not enabled</div></td><td><span class="crm-status" :class="row.enabled && channelEnabled(row) ? 'status-approved' : 'status-inactive'" x-text="row.enabled && channelEnabled(row) ? 'Enabled' : 'Disabled'"></span></td><td><button class="btn btn-light btn-sm" @click="edit(row)">Edit</button></td></tr></template><tr x-show="!loading && !visibleRows.length"><td colspan="6" class="text-center text-muted py-4">No automations found</td></tr></tbody></table></div><div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page <= 1 || loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext || loading" @click="next()">Next</button></div></div></section>
      </div><%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function simpleRulePage(channel) {
        return {
          channel, rows: [], templates: [], events: [], variableSets: {}, q: '', enabled: '', pagination: createCursorPagination(20), loading: false, editing: false, saving: false, mode: 'create', form: {}, error: '', message: '',
          get channelLabel(){ return channel === 'email' ? 'Email' : 'WhatsApp'; },
          get selectableEvents(){ return this.events.filter((event) => !['partner_lead_submitted','provider_join_request_submitted'].includes(event) && !(channel === 'email' && event === 'nearby_lead_available')); },
          get visibleRows(){ return this.rows.filter((row) => row.recipientSource !== 'internal' && !['partner_lead_submitted','provider_join_request_submitted'].includes(row.event) && !(channel === 'email' && row.event === 'nearby_lead_available')); },
          get availableTemplates(){ return this.templates.filter((item) => item.channel === channel && item.isActive !== false && (channel === 'email' ? item.status === 'active' : item.status === 'approved' && item.externalTemplateId)); },
          get selectedTemplateId(){ return channel === 'email' ? this.form.emailTemplateId : this.form.whatsappTemplateId; },
          set selectedTemplateId(value){ if(channel === 'email') this.form.emailTemplateId=value; else this.form.whatsappTemplateId=value; },
          get selectedTemplate(){ return this.availableTemplates.find((item) => item.templateId === this.selectedTemplateId) || null; },
          get selectedVariables(){ return Array.isArray(this.selectedTemplate?.parameterDefinitions) && this.selectedTemplate.parameterDefinitions.length ? this.selectedTemplate.parameterDefinitions : (Array.isArray(this.selectedTemplate?.templateVariables) ? this.selectedTemplate.templateVariables : []); },
          get eventVariables(){ return [...new Set(this.variableSets[this.form.event] || this.variableSets.default || [])]; },
          get quickReplyButtons(){ return (this.selectedTemplate?.buttons || []).map((button,index)=>({index:Number.isInteger(Number(button.index))?Number(button.index):index,text:button.text||button.title||('Button '+(index+1)),type:String(button.type||button.buttonType||'').toUpperCase()})).filter((button)=>button.type.includes('QUICK')||button.type==='REPLY'); },
          emptyForm(){ return { name:'', event:'', recipientSource:'customer', enabled:false, whatsappEnabled:channel==='whatsapp', whatsappTemplateId:'', whatsappParameterMappings:[], whatsappActionType:'', whatsappActionButtonIndex:null, emailEnabled:channel==='email', emailTemplateId:'', description:'' }; },
          query(){ const query=new URLSearchParams({q:this.q,enabled:this.enabled,excludeInternal:'true',limit:this.pagination.limit,cursor:this.pagination.cursor,sortOrder:'event'}); [...query].forEach(([key,value])=>{if(value===''||value===null)query.delete(key)}); return query.toString(); },
          async load(){ this.loading=true;this.error='';try{const [rules,templates]=await Promise.all([apiFetch('/api/communication/rules?'+this.query()),apiFetch('/api/communication/templates?limit=100&sortOrder=name')]);this.rows=rules.data||[];applyCursorPagination(this.pagination,rules.pagination||{});this.events=rules.metadata?.events||[];this.variableSets=rules.metadata?.eventVariables||{};this.templates=templates.data||[];}catch(error){this.error=error.message}finally{this.loading=false}},
          search(){resetCursorPagination(this.pagination);this.load()}, reset(){this.q='';this.enabled='';this.search()}, next(){if(cursorNext(this.pagination))this.load()}, previous(){if(cursorPrevious(this.pagination))this.load()},
          startCreate(){this.mode='create';this.form=this.emptyForm();this.editing=true;this.message='';this.error='';window.scrollTo({top:0,behavior:'smooth'})}, cancel(){this.editing=false;this.form={}},
          applyDefaults(){ if(!this.form.event)return;if(!this.form.name)this.form.name=humanize(this.form.event);if(this.form.event==='nearby_lead_available'){this.form.recipientSource='provider';this.form.whatsappActionType='unlock_lead'}else if(this.form.event.startsWith('provider_'))this.form.recipientSource='provider';else if(this.form.event.startsWith('agent_'))this.form.recipientSource='agent';else if(this.form.event.startsWith('employee_'))this.form.recipientSource='employee';else if(this.form.event.startsWith('lead_'))this.form.recipientSource='customer';this.syncTemplate(false)},
          syncTemplate(preserve=true){ if(channel!=='whatsapp')return;const existing=Array.isArray(this.form.whatsappParameterMappings)?this.form.whatsappParameterMappings:[];const preserveExisting = preserve && existing.length > 0;this.form.whatsappParameterMappings=this.selectedVariables.map((parameter,index)=>preserveExisting ? (existing[index] || '') : (this.eventVariables.includes(parameter.placeholder) ? parameter.placeholder : ''));if(this.form.event==='nearby_lead_available'){this.form.whatsappActionType='unlock_lead';this.form.whatsappActionButtonIndex=this.quickReplyButtons[0]?.index??null}else{this.form.whatsappActionType='';this.form.whatsappActionButtonIndex=null}},
          edit(row){this.mode='edit';this.form=JSON.parse(JSON.stringify(row));if(!Array.isArray(this.form.whatsappParameterMappings))this.form.whatsappParameterMappings=[];if(channel==='email')this.form.emailEnabled=true;else this.form.whatsappEnabled=true;this.syncTemplate(true);this.editing=true;this.error='';this.message='';window.scrollTo({top:0,behavior:'smooth'})},
          async save(){if(this.saving)return;this.saving=true;this.error='';this.message='';try{const payload={...this.form};if(channel==='email')payload.emailEnabled=true;else payload.whatsappEnabled=true;const url=this.mode==='create'?'/api/communication/rules':'/api/communication/rules/'+payload.ruleId;await apiFetch(url,{method:this.mode==='create'?'POST':'PUT',body:JSON.stringify(payload)});this.message='Automation saved.';this.editing=false;await this.load()}catch(error){this.error=error.message}finally{this.saving=false}},
          channelEnabled(row){return channel==='email'?row.emailEnabled===true:row.whatsappEnabled===true}, templateIdFor(row){return channel==='email'?row.emailTemplateId:row.whatsappTemplateId}, templateName(id){const item=this.templates.find((template)=>template.templateId===id);return item?(item.displayName||item.name):''}, recipientLabel(value){return value==='agent'?'Partner':humanize(value)},
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
