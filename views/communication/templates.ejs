<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Communication Center</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">Manage approved WhatsApp templates and reusable SES email content.</p></div><a href="/communications/templates/new" class="btn btn-primary crm-primary-action">Create template</a></div></div>
      <div class="content" x-data="templateList()" x-init="load()">
        <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div x-show="message" x-cloak class="alert alert-success" x-text="message"></div>
        <%- include('_navigation', { active: 'templates' }) %>
        <section class="card crm-filter-card mb-3"><form class="crm-filter-bar" @submit.prevent="search()">
          <label class="crm-search-control"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" x-model="filters.q" placeholder="Search templates" aria-label="Search communication templates"></label>
          <label class="crm-filter-field"><span>Channel</span><select x-model="filters.channel"><option value="">All channels</option><option value="whatsapp">WhatsApp</option><option value="email">Email</option></select></label>
          <label class="crm-filter-field"><span>Status</span><select x-model="filters.status"><option value="">All statuses</option><option value="draft">Draft</option><option value="pending">Pending</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="paused">Paused</option><option value="disabled">Disabled</option><option value="active">Active</option><option value="inactive">Inactive</option></select></label>
          <label class="crm-filter-field"><span>Category</span><select x-model="filters.category"><option value="">All categories</option><option value="authentication">Authentication</option><option value="utility">Utility</option><option value="marketing">Marketing</option><option value="transactional">Transactional</option></select></label>
          <label class="crm-filter-field"><span>Language</span><input type="text" x-model="filters.language" maxlength="20" placeholder="en_US"></label>
          <label class="crm-filter-field"><span>Active</span><select x-model="filters.active"><option value="">All</option><option value="true">Active</option><option value="false">Inactive</option></select></label>
          <label class="crm-filter-field"><span>Sort</span><select x-model="filters.sortOrder"><option value="newest">Recently updated</option><option value="oldest">Oldest updated</option><option value="name">Name A–Z</option></select></label>
          <div class="crm-filter-actions"><button class="btn btn-primary" type="submit">Apply</button><button class="btn btn-light" type="button" x-show="hasFilters()" @click="reset()">Clear</button><button class="btn btn-light" type="button" @click="sync()" :disabled="syncing"><span x-text="syncing ? 'Syncing…' : 'Sync Meta'"></span></button></div>
          <label class="crm-filter-field crm-filter-page-size"><span>Rows</span><select x-model.number="pagination.limit" @change="search()"><option :value="10">10</option><option :value="20">20</option><option :value="50">50</option><option :value="100">100</option></select></label>
        </form></section>
        <section class="card crm-data-card">
          <div class="card-header crm-card-heading"><div><h5 class="mb-1">Communication templates</h5><p class="text-muted mb-0"><span x-text="rows.length"></span> templates on this page</p></div></div>
          <div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Name</th><th>Channel</th><th>Category</th><th>Language</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>
            <template x-if="loading"><tr><td colspan="7"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
            <template x-for="row in rows" :key="row.templateId"><tr><td><div class="fw-semibold" x-text="row.displayName || row.name"></div><div class="text-muted fs-sm" x-text="row.name"></div></td><td x-text="humanize(row.channel)"></td><td x-text="humanize(row.category)"></td><td x-text="row.language"></td><td><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span><div class="text-danger fs-sm" x-show="row.rejectionReason" x-text="row.rejectionReason"></div></td><td x-text="formatDate(row.updatedAt)"></td><td class="text-end"><div class="d-flex gap-2 justify-content-end"><button x-show="row.channel === 'whatsapp' && ['draft','rejected'].includes(row.status)" class="btn btn-primary btn-sm" @click="submit(row)" :disabled="row.busy">Submit to Meta</button><a class="btn btn-light btn-sm" :href="'/communications/templates/'+row.templateId+'/edit'">Edit</a></div></td></tr></template>
            <tr x-show="!loading && !rows.length"><td colspan="7" class="text-center text-muted py-4">No templates found</td></tr>
          </tbody></table></div>
          <div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page <= 1 || loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext || loading" @click="next()">Next</button></div></div>
        </section>
      </div><%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function templateList() {
        return {
          rows: [], filters: { q: '', channel: '', status: '', category: '', language: '', active: '', sortOrder: 'newest' }, pagination: createCursorPagination(20), loading: false, error: '', message: '', syncing: false,
          query() { const query = new URLSearchParams({ ...this.filters, limit: this.pagination.limit, cursor: this.pagination.cursor }); [...query].forEach(([key,value]) => { if(!value) query.delete(key); }); return query.toString(); },
          hasFilters() { return Boolean(this.filters.q || this.filters.channel || this.filters.status || this.filters.category || this.filters.language || this.filters.active || this.filters.sortOrder !== 'newest' || this.pagination.limit !== 20); },
          async load() { this.loading = true; this.error = ''; try { const body = await apiFetch('/api/communication/templates?' + this.query()); this.rows = body.data || []; applyCursorPagination(this.pagination, body.pagination || {}); } catch(error){ this.error=error.message; } finally { this.loading = false; } },
          search() { resetCursorPagination(this.pagination); this.load(); },
          reset() { this.filters = { q: '', channel: '', status: '', category: '', language: '', active: '', sortOrder: 'newest' }; this.pagination.limit = 20; this.search(); },
          next() { if (cursorNext(this.pagination)) this.load(); }, previous() { if (cursorPrevious(this.pagination)) this.load(); },
          async sync() { if(this.syncing)return; this.syncing=true; this.error=''; this.message=''; try { const body=await apiFetch('/api/communication/templates/sync',{method:'POST',body:'{}'}); this.message=`Synced ${body.data.remoteCount} Meta templates: imported ${body.data.imported || 0}, updated ${body.data.updated || 0}.`; this.search(); } catch(error){ this.error=error.message; } finally { this.syncing=false; } },
          async submit(row) { if(row.busy)return; row.busy=true; this.error=''; this.message=''; try { await apiFetch('/api/communication/templates/'+row.templateId+'/submit',{method:'POST',body:'{}'}); this.message='Template submitted to Meta.'; await this.load(); } catch(error){ this.error=error.message; } finally { row.busy=false; } }
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
