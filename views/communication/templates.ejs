<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Communication Center</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">Synchronize approved WhatsApp templates from Gupshup, then control their CRM availability and event assignments.</p></div><div class="d-flex gap-2 flex-wrap"><button type="button" class="btn btn-primary crm-primary-action" @click="window.dispatchEvent(new CustomEvent('gupshup-template-sync'))">Sync from Gupshup</button><a href="/communications/templates/new?channel=email" class="btn btn-light crm-primary-action">New email template</a></div></div></div>
      <div class="content" x-data="templateList()" x-init="load()" @gupshup-template-sync.window="syncTemplates()">
        <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div x-show="message" x-cloak class="alert alert-success" x-text="message"></div>
        <%- include('_navigation', { active: 'templates' }) %>
        <section class="crm-template-channel-cards" aria-label="Template channel management">
          <a href="/communications/templates" class="crm-template-channel-card" :class="{ 'is-active': !filters.channel }"><span class="crm-channel-picker-icon">ALL</span><span><strong>All templates</strong><small>View every reusable template</small></span></a>
          <a href="/communications/templates?channel=whatsapp" class="crm-template-channel-card" :class="{ 'is-active': filters.channel === 'whatsapp' }"><span class="crm-channel-picker-icon">WA</span><span><strong>WhatsApp templates</strong><small>Synchronized from the configured Gupshup app</small></span></a>
          <a href="/communications/templates?channel=email" class="crm-template-channel-card" :class="{ 'is-active': filters.channel === 'email' }"><span class="crm-channel-picker-icon">EM</span><span><strong>Email templates</strong><small>Amazon SES subjects and HTML content</small></span></a>
        </section>
        <section class="card crm-filter-card mb-3"><form class="crm-filter-bar" @submit.prevent="search()">
          <label class="crm-search-control"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" x-model="filters.q" placeholder="Search templates or Gupshup ID" aria-label="Search communication templates"></label>
          <label class="crm-filter-field"><span>Channel</span><select x-model="filters.channel"><option value="">All channels</option><option value="whatsapp">WhatsApp</option><option value="email">Email</option></select></label>
          <label class="crm-filter-field"><span>Provider status</span><select x-model="filters.status"><option value="">All statuses</option><option value="draft">Draft</option><option value="pending">Pending</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="paused">Paused</option><option value="disabled">Disabled</option><option value="deleted">Deleted</option><option value="active">Active</option><option value="inactive">Inactive</option></select></label>
          <label class="crm-filter-field"><span>Category</span><select x-model="filters.category"><option value="">All categories</option><option value="authentication">Authentication</option><option value="utility">Utility</option><option value="marketing">Marketing</option><option value="transactional">Transactional</option></select></label>
          <label class="crm-filter-field"><span>Language</span><input type="text" x-model="filters.language" maxlength="20" placeholder="en_US"></label>
          <label class="crm-filter-field"><span>CRM state</span><select x-model="filters.active"><option value="">All</option><option value="true">Enabled</option><option value="false">Disabled</option></select></label>
          <label class="crm-filter-field"><span>Sort</span><select x-model="filters.sortOrder"><option value="newest">Recently updated</option><option value="oldest">Oldest updated</option><option value="name">Name A–Z</option></select></label>
          <div class="crm-filter-actions"><button class="btn btn-primary" type="submit">Apply</button><button class="btn btn-light" type="button" x-show="hasFilters()" @click="reset()">Clear</button></div>
          <label class="crm-filter-field crm-filter-page-size"><span>Rows</span><select x-model.number="pagination.limit" @change="search()"><option :value="10">10</option><option :value="20">20</option><option :value="50">50</option><option :value="100">100</option></select></label>
        </form></section>
        <section class="card crm-data-card">
          <div class="card-header crm-card-heading"><div><h5 class="mb-1">Communication templates</h5><p class="text-muted mb-0"><span x-text="rows.length"></span> templates on this page</p></div><button type="button" class="btn btn-primary btn-sm" @click="syncTemplates()" :disabled="syncing"><span x-text="syncing ? 'Syncing…' : 'Sync from Gupshup'"></span></button></div>
          <div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Name</th><th>Channel</th><th>Category</th><th>Provider status</th><th>CRM state</th><th>Variables</th><th>Assigned events</th><th>Last sync</th><th></th></tr></thead><tbody>
            <template x-if="loading"><tr><td colspan="9"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
            <template x-for="row in rows" :key="row.templateId"><tr>
              <td><div class="fw-semibold" x-text="row.displayName || row.name"></div><div class="text-muted fs-sm" x-text="row.name"></div><div class="text-muted fs-sm" x-show="row.externalTemplateId" x-text="'Gupshup: ' + row.externalTemplateId"></div></td>
              <td><div x-text="humanize(row.channel)"></div><small class="text-muted" x-text="row.language"></small></td>
              <td><div x-text="humanize(row.category)"></div><small class="text-warning d-block" x-show="row.providerPayload?.suggestedCategory" x-text="'Gupshup suggests: ' + humanize(row.providerPayload?.suggestedCategory)"></small><small class="text-muted" x-show="row.remoteQuality" x-text="'Quality: ' + row.remoteQuality"></small></td>
              <td><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span><div class="text-danger fs-sm" x-show="row.rejectionReason" x-text="row.rejectionReason"></div></td>
              <td><span class="crm-status" :class="row.isActive !== false ? 'status-approved' : 'status-inactive'" x-text="row.isActive !== false ? 'Enabled' : 'Disabled'"></span><div class="text-muted fs-sm" x-show="row.channel === 'whatsapp'" x-text="row.providerManaged ? 'Gupshup managed' : 'Legacy/manual'"></div></td>
              <td><div class="crm-template-variable-preview"><strong x-text="variableCount(row) + (variableCount(row) === 1 ? ' variable' : ' variables')"></strong><div class="crm-variable-chip-list" x-show="variableCount(row)"><template x-for="variable in templateVariables(row).slice(0, 3)" :key="variable.position + ':' + variable.component + ':' + variable.placeholder"><span class="crm-variable-chip" :title="variableTooltip(variable)"><code x-text="variable.variable || ('{{' + variable.placeholder + '}}')"></code><small x-text="variable.componentLabel || humanize(variable.component)"></small></span></template><span class="crm-variable-more" x-show="variableCount(row) > 3" x-text="'+' + (variableCount(row) - 3) + ' more'"></span></div><span class="text-muted fs-sm" x-show="!variableCount(row)">No dynamic variables</span></div></td>
              <td><div class="d-flex gap-1 flex-wrap"><template x-for="assignment in (row.assignedEvents || [])" :key="assignment.event"><span class="badge text-bg-light" :class="assignment.enabled ? 'border border-success-subtle' : ''" x-text="humanize(assignment.event)"></span></template><span class="text-muted fs-sm" x-show="!(row.assignedEvents || []).length">Not assigned</span></div></td>
              <td><span x-text="row.syncedAt ? formatDate(row.syncedAt) : formatDate(row.updatedAt)"></span></td>
              <td class="text-end"><div class="d-flex gap-2 justify-content-end"><button class="btn btn-light btn-sm" @click="toggle(row)" :disabled="row.busy" x-text="row.isActive !== false ? 'Disable' : 'Enable'"></button><button x-show="row.channel === 'whatsapp' && !row.providerManaged && ['draft','rejected'].includes(row.status)" class="btn btn-primary btn-sm" @click="submit(row)" :disabled="row.busy">Activate Gupshup ID</button><a class="btn btn-light btn-sm" :href="'/communications/templates/'+row.templateId+'/edit'" x-text="row.providerManaged ? 'View' : 'Edit'"></a></div></td>
            </tr></template>
            <tr x-show="!loading && !rows.length"><td colspan="9" class="text-center text-muted py-4">No templates found. Synchronize your Gupshup app or create an email template.</td></tr>
          </tbody></table></div>
          <div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page <= 1 || loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext || loading" @click="next()">Next</button></div></div>
        </section>
      </div><%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function templateList() {
        return {
          rows: [], metadata: {}, filters: { q: queryValue('q'), channel: queryValue('channel'), status: queryValue('status'), category: queryValue('category'), language: queryValue('language'), active: queryValue('active'), sortOrder: queryValue('sortOrder') || 'newest' }, pagination: createCursorPagination(Number(queryValue('limit') || 20)), loading: false, error: '', message: '', syncing: false,
          query() { const query = new URLSearchParams({ ...this.filters, limit: this.pagination.limit, cursor: this.pagination.cursor }); [...query].forEach(([key,value]) => { if(!value) query.delete(key); }); return query.toString(); },
          hasFilters() { return Boolean(this.filters.q || this.filters.channel || this.filters.status || this.filters.category || this.filters.language || this.filters.active || this.filters.sortOrder !== 'newest' || this.pagination.limit !== 20); },
          templateVariables(row) { return Array.isArray(row?.templateVariables) ? row.templateVariables : (Array.isArray(row?.parameterDefinitions) ? row.parameterDefinitions : []); },
          variableCount(row) { return this.templateVariables(row).length; },
          variableTooltip(variable) { return [variable.label, variable.description, variable.example ? ('Example: ' + variable.example) : ''].filter(Boolean).join(' — '); },
          async load() { this.loading = true; this.error = ''; try { const body = await apiFetch('/api/communication/templates?' + this.query()); this.rows = body.data || []; this.metadata = body.metadata || {}; applyCursorPagination(this.pagination, body.pagination || {}); } catch(error){ this.error=error.message; } finally { this.loading = false; } },
          search() { resetCursorPagination(this.pagination); this.load(); },
          reset() { this.filters = { q: '', channel: '', status: '', category: '', language: '', active: '', sortOrder: 'newest' }; this.pagination.limit = 20; this.search(); },
          next() { if (cursorNext(this.pagination)) this.load(); }, previous() { if (cursorPrevious(this.pagination)) this.load(); },
          async syncTemplates() { if (this.syncing) return; this.syncing = true; this.error = ''; this.message = ''; try { const body = await apiFetch('/api/communication/templates/sync', { method: 'POST', body: '{}' }); const result = body.data || {}; this.message = `Gupshup sync completed: ${result.imported || 0} imported, ${result.updated || 0} updated, ${result.unchanged || 0} unchanged${result.remotelyMissing ? `, ${result.remotelyMissing} removed remotely and disabled` : ''}${result.failed ? `, ${result.failed} failed` : ''}. Newly imported templates stay disabled until you enable them.`; if (result.failed && Array.isArray(result.failures)) this.error = result.failures.slice(0, 3).map((item) => `${item.name || item.externalTemplateId || 'Template'}: ${item.message || 'Sync failed'}`).join(' | '); await this.load(); } catch (error) { this.error = error.message; } finally { this.syncing = false; } },
          async toggle(row) { if (row.busy) return; row.busy = true; this.error = ''; this.message = ''; try { const enabled = row.isActive === false; await apiFetch('/api/communication/templates/' + row.templateId, { method: 'PATCH', body: JSON.stringify({ isActive: enabled }) }); this.message = `${row.displayName || row.name} ${enabled ? 'enabled' : 'disabled'} in CRM.`; await this.load(); } catch (error) { this.error = error.message; } finally { row.busy = false; } },
          async submit(row) { if(row.busy)return; row.busy=true; this.error=''; this.message=''; try { await apiFetch('/api/communication/templates/'+row.templateId+'/submit',{method:'POST',body:'{}'}); this.message='Gupshup template ID activated.'; await this.load(); } catch(error){ this.error=error.message; } finally { row.busy=false; } }
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
