<%- include('../partials/pageStart') %><div x-data="distPage()" x-init="load()"><div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><input class="form-control" x-model="filters.requirementId" placeholder="Requirement ID"></div><div class="col-md-3"><input class="form-control" x-model="filters.providerId" placeholder="Provider ID"></div><div class="col-md-2"><select class="form-select" x-model="filters.status"><option value="">All statuses</option><option>offered</option><option>unlocked</option><option>withdrawn</option><option>expired</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100" @click="load">Apply</button></div></div></div><div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Lead</th><th>Provider</th><th>Category</th><th>Status</th><th>Price</th><th>Date</th></tr></thead><tbody><template x-for="d in rows" :key="d.leadDistributionId"><tr><td><a :href="'/enquiries/'+d.requirementId" x-text="d.leadTitle||d.requirementId"></a></td><td><a :href="'/providers/'+d.providerId" x-text="d.providerName||d.providerId"></a></td><td x-text="d.categorySlug"></td><td x-text="humanize(d.status)"></td><td x-text="money(d.leadPricePaise)"></td><td x-text="formatDate(d.distributedAt)"></td></tr></template></tbody></table></div></div></div><script>function distPage(){return{rows:[],filters:{requirementId:'',providerId:'',status:''},async load(){const b=await apiFetch('/api/distribution?'+new URLSearchParams(this.filters));this.rows=b.data}}}</script><%- include('../partials/pageEnd') %>
