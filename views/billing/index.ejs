<%- include('../partials/pageStart', { subtitle: 'Invoice list' }) %>

<div class="card">
  <div class="card-header d-sm-flex align-items-sm-center py-sm-0">
    <div>
      <h5 class="py-sm-2 my-sm-1 mb-0">Invoices</h5>
      <div class="text-muted fs-sm">List/search only. Use Create invoice for billing entry creation.</div>
    </div>
    <div class="mt-2 mt-sm-0 ms-sm-auto d-flex gap-2">
      <a href="/api/invoices" target="_blank" class="btn btn-light btn-sm"><i class="ph-code me-2"></i>API</a>
      <a href="/search/invoices" class="btn btn-light btn-sm"><i class="ph-magnifying-glass me-2"></i>Advanced search</a>
      <a href="/billing/new" class="btn btn-primary btn-sm"><i class="ph-plus me-2"></i>Create invoice</a>
    </div>
  </div>

  <div class="card-body border-top">
    <form method="get" class="row g-3 align-items-end">
      <div class="col-xl-4 col-lg-6"><label class="form-label">Search</label><div class="form-control-feedback form-control-feedback-start"><input class="form-control" name="q" placeholder="Invoice, customer, provider..." value="<%= filters.q || filters.search || '' %>"><div class="form-control-feedback-icon"><i class="ph-magnifying-glass"></i></div></div></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All statuses</option><% statuses.forEach((status)=>{ %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= humanize(status) %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Requirement ID</label><input class="form-control" name="enquiryId" value="<%= filters.enquiryId || '' %>" placeholder="req_..."></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><label class="form-label">Issue from</label><input type="date" class="form-control" name="dateFrom" value="<%= filters.dateFrom || '' %>"></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><label class="form-label">Issue to</label><input type="date" class="form-control" name="dateTo" value="<%= filters.dateTo || '' %>"></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><label class="form-label">Per page</label><select class="form-select" name="pageSize"><% [10,25,50,100].forEach((size)=>{ %><option value="<%= size %>" <%= String(filters.pageSize || 25) === String(size) ? 'selected' : '' %>><%= size %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-3 col-sm-6 d-flex gap-2"><button class="btn btn-primary flex-fill" type="submit">Filter</button><a href="/billing" class="btn btn-light">Clear</a></div>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table text-nowrap">
      <thead><tr><th>No</th><th>Customer</th><th>Provider</th><th>Related requirement</th><th>Status</th><th>Issue</th><th>Total</th><th class="text-center" style="width: 160px;">Actions</th></tr></thead>
      <tbody>
        <% invoices.forEach((invoice) => { %>
          <tr>
            <td><div class="fw-semibold"><%= invoice.invoiceNo %></div><div class="text-muted fs-sm"><%= invoice.id %></div></td>
            <td><%= invoice.customerName || '-' %></td>
            <td><%= invoice.providerName || '-' %></td>
            <td><% if (invoice.enquiryId) { %><a href="/enquiries/<%= invoice.enquiryId %>"><%= invoice.enquiryId %></a><% } else { %>-<% } %></td>
            <td><%- include('../partials/statusBadge', { value: invoice.status, humanize }) %></td>
            <td><%= formatDate(invoice.issueDate || invoice.createdAt) %></td>
            <td>₹<%= Number(invoice.total || 0).toLocaleString('en-IN') %></td>
            <td class="text-center"><div class="d-inline-flex gap-1"><a class="btn btn-outline-primary btn-sm" href="/billing/<%= invoice.id %>"><i class="ph-eye me-1"></i>View</a><a class="btn btn-outline-secondary btn-sm" href="/billing/<%= invoice.id %>/edit"><i class="ph-pencil me-1"></i>Edit</a></div></td>
          </tr>
        <% }) %>
        <% if (!invoices.length) { %><tr><td colspan="8" class="text-muted text-center py-4">No invoices yet. <a href="/billing/new">Create an invoice</a>.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination }) %>
</div>

<%- include('../partials/pageEnd') %>
