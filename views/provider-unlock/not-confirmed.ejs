<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper"><div class="content-inner">
        <div class="page-header page-header-light crm-page-header">
          <div class="page-header-content crm-page-heading">
            <div>
              <div class="crm-page-eyebrow">Provider marketplace</div>
              <h1 class="page-title mb-1"><%= title %></h1>
              <p class="crm-page-subtitle mb-0">Review provider Not Confirmed outcomes, decide whether to return unlock credits, and reassign only after every previous provider is Not Confirmed.</p>
            </div>
            <a href="/provider-unlocks" class="btn btn-light crm-primary-action">All provider unlocks</a>
          </div>
        </div>

        <div class="content">
          <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
          <main x-data="notConfirmedReviewList()" x-init="load()">
            <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
            <div class="alert alert-info">
              Unlock credits are never returned automatically. Reassignment is allowed only when every earlier provider for the requirement is Not Confirmed, either from the provider portal or a CRM manual review.
            </div>

            <section class="card crm-filter-card mb-3">
              <form class="crm-filter-bar" @submit.prevent="search()">
                <label class="crm-filter-field crm-filter-field-wide">
                  <span>Lead reference ID</span>
                  <input class="form-control" x-model="filters.enquiryId" placeholder="Lead Reference ID">
                </label>
                <label class="crm-filter-field crm-filter-field-wide">
                  <span>Provider ID</span>
                  <input class="form-control" x-model="filters.providerId" placeholder="Provider ID">
                </label>
                <label class="crm-filter-field">
                  <span>Refund review</span>
                  <select x-model="filters.refundStatus">
                    <option value="pending_review">Pending review</option>
                    <option value="refunded">Credits reverted</option>
                    <option value="kept_charged">Charge kept</option>
                    <option value="">All Not Confirmed</option>
                  </select>
                </label>
                <label class="crm-filter-field crm-filter-date">
                  <span>From</span>
                  <input class="form-control" type="date" x-model="filters.startDate">
                </label>
                <label class="crm-filter-field crm-filter-date">
                  <span>To</span>
                  <input class="form-control" type="date" x-model="filters.endDate">
                </label>
                <div class="crm-filter-actions">
                  <button class="btn btn-primary" type="submit">Apply</button>
                  <button class="btn btn-light" type="button" @click="reset()">Clear</button>
                </div>
              </form>
            </section>

            <section class="card crm-data-card">
              <div class="card-header crm-card-heading">
                <div>
                  <h5 class="mb-1">Not Confirmed provider reviews</h5>
                  <p class="text-muted mb-0"><span x-text="rows.length"></span> records on this page</p>
                </div>
              </div>
              <div class="table-responsive">
                <table class="table crm-table mb-0">
                  <thead>
                    <tr>
                      <th>Requirement</th>
                      <th>Provider</th>
                      <th>Charged</th>
                      <th>Provider note</th>
                      <th>Refund review</th>
                      <th>Outcome updated</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <template x-if="loading">
                      <tr><td colspan="7"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr>
                    </template>
                    <template x-for="row in rows" :key="row.providerLeadUnlockId">
                      <tr>
                        <td>
                          <a :href="'/enquiries/' + row.enquiryId" x-text="row.leadTitle || row.enquiryId"></a>
                          <div class="text-muted fs-sm" x-text="row.enquiryId"></div>
                        </td>
                        <td>
                          <a :href="'/providers/' + row.providerId" x-text="row.providerBusinessName || row.providerName || row.providerId"></a>
                        </td>
                        <td class="crm-nowrap">
                          <strong x-text="Number(row.chargedCredits || 0) + ' credits'"></strong>
                          <div class="text-muted fs-sm" x-text="humanize(row.unlockMethod || 'credits')"></div>
                        </td>
                        <td>
                          <span x-text="row.providerSaleOutcomeNote || 'No provider note'"></span>
                        </td>
                        <td>
                          <span class="crm-status" :class="refundClass(row.creditRefundStatus)" x-text="refundLabel(row)"></span>
                        </td>
                        <td class="crm-nowrap" x-text="formatDate(row.providerSaleOutcomeUpdatedAt || row.updatedAt)"></td>
                        <td class="text-end crm-nowrap">
                          <a class="btn btn-light btn-sm me-2" :href="'/enquiries/' + row.enquiryId + '/providers/' + row.providerLeadUnlockId">Review</a>
                          <a
                            class="btn btn-primary btn-sm"
                            :class="row.reassignmentEligible ? '' : 'disabled'"
                            :aria-disabled="row.reassignmentEligible ? 'false' : 'true'"
                            :href="row.reassignmentEligible ? '/enquiries/' + row.enquiryId + '/nearby-providers' : '#'"
                            x-text="row.reassignmentEligible ? 'Reassign / Copy link' : 'Waiting for all providers'"
                          ></a>
                        </td>
                      </tr>
                    </template>
                    <tr x-show="!loading && !rows.length">
                      <td colspan="7" class="text-center text-muted py-4">No Not Confirmed reviews match these filters.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="crm-table-footer">
                <div class="text-muted">Page <strong x-text="pagination.page"></strong></div>
                <div class="crm-pagination">
                  <button :disabled="pagination.page <= 1 || loading" @click="previous()">Previous</button>
                  <span x-text="pagination.page"></span>
                  <button :disabled="!pagination.hasNext || loading" @click="next()">Next</button>
                </div>
              </div>
            </section>
          </main>
        </div>
        <%- include('../partials/footer') %>
      </div></div>
    </div>

    <script>
      function notConfirmedReviewList() {
        return {
          rows: [],
          loading: false,
          error: '',
          filters: {
            enquiryId: '',
            providerId: '',
            refundStatus: 'pending_review',
            startDate: '',
            endDate: ''
          },
          pagination: createCursorPagination(20),
          refundLabel(row) {
            if (row.creditRefundStatus === 'refunded') {
              return 'Credits reverted' + (row.creditRefundedCredits ? ' · ' + Number(row.creditRefundedCredits) : '');
            }
            if (row.creditRefundStatus === 'kept_charged') return 'Charge kept';
            if (row.unlockMethod !== 'credits' || Number(row.chargedCredits || 0) <= 0) return 'No credit refund';
            return 'Pending review';
          },
          refundClass(status) {
            if (status === 'refunded') return 'status-active';
            if (status === 'kept_charged') return 'status-inactive';
            return 'status-pending';
          },
          query(cursor = '') {
            const q = new URLSearchParams();
            q.set('outcome', 'not_confirmed');
            if (this.filters.enquiryId) q.set('enquiryId', this.filters.enquiryId);
            if (this.filters.providerId) q.set('providerId', this.filters.providerId);
            if (this.filters.refundStatus) q.set('refundStatus', this.filters.refundStatus);
            if (this.filters.startDate) q.set('startDate', this.filters.startDate);
            if (this.filters.endDate) q.set('endDate', this.filters.endDate);
            q.set('dateField', 'providerSaleOutcomeUpdatedAt');
            q.set('sortField', 'providerSaleOutcomeUpdatedAt');
            q.set('sortOrder', 'newest');
            q.set('limit', this.pagination.limit);
            if (cursor) q.set('cursor', cursor);
            return q.toString();
          },
          async load(cursor = '') {
            this.loading = true;
            this.error = '';
            try {
              const body = await apiFetch('/api/provider-unlocks?' + this.query(cursor));
              this.rows = body.data || [];
              applyCursorPagination(this.pagination, body.pagination || {});
            } catch (error) {
              this.error = error.message;
            } finally {
              this.loading = false;
            }
          },
          search() {
            resetCursorPagination(this.pagination);
            this.load();
          },
          next() {
            const cursor = this.pagination.nextCursor;
            if (!cursor) return;
            advanceCursorPagination(this.pagination, cursor);
            this.load(cursor);
          },
          previous() {
            const cursor = retreatCursorPagination(this.pagination);
            this.load(cursor);
          },
          reset() {
            this.filters = {
              enquiryId: '',
              providerId: '',
              refundStatus: 'pending_review',
              startDate: '',
              endDate: ''
            };
            this.search();
          }
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
