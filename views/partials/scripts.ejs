<script>
  function pathParts() {
    return location.pathname.split('/').filter(Boolean);
  }

  function pathRecordId(editPage = false) {
    const parts = pathParts();
    return editPage ? (parts[parts.length - 2] || '') : (parts[parts.length - 1] || '');
  }

  function pageMode() {
    return location.pathname.endsWith('/new') ? 'create' : 'edit';
  }

  function queryValue(name, fallback = '') {
    return new URLSearchParams(location.search).get(name) || fallback;
  }

  async function apiFetch(url, options = {}) {
    const response = await fetch(url, {
      credentials: 'same-origin',
      ...options,
      headers: { 'Content-Type': 'application/json', ...(options.headers || {}) }
    });
    const body = await response.json().catch(() => ({ success: false, message: 'Invalid server response' }));
    if (response.status === 401) {
      window.location.href = '/login?returnTo=' + encodeURIComponent(location.pathname + location.search);
      throw new Error('Authentication required');
    }
    if (!response.ok || body.success === false) throw new Error(body.message || 'Request failed');
    return body;
  }

  function recordId(record, field) {
    if (!record) return '';
    const value = record[field] || record.id || record._id || '';
    if (value && typeof value === 'object') return value.$oid || value.toString?.() || '';
    return String(value || '');
  }

  function leadName(lead) {
    return lead?.name || lead?.customer?.name || '—';
  }

  function leadMobile(lead) {
    return lead?.mobile || lead?.customer?.mobile || '—';
  }

  function leadCity(lead) {
    return lead?.city || lead?.address?.city || '—';
  }

  function leadState(lead) {
    return lead?.state || lead?.address?.state || '';
  }

  function leadCategory(lead) {
    if (!lead) return '—';
    if (typeof lead.category === 'string' && lead.category) return lead.category;
    if (lead.category && typeof lead.category === 'object' && lead.category.name) return lead.category.name;
    return humanize(lead.categorySlug || lead.category?.slug || '');
  }

  function money(paise) {
    const amount = Number(paise);
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 2
    }).format(Number.isFinite(amount) ? amount / 100 : 0);
  }

  function credits(minorUnits) {
    const amount = Number(minorUnits);
    const value = Number.isFinite(amount) ? Math.max(0, amount) / 100 : 0;
    return new Intl.NumberFormat('en-IN', {
      minimumFractionDigits: 0,
      maximumFractionDigits: 2
    }).format(value) + ' credits';
  }

  function safeDate(value) {
    if (!value) return null;
    const date = new Date(value);
    return Number.isFinite(date.getTime()) ? date : null;
  }

  function formatDate(value) {
    const date = safeDate(value);
    return date
      ? new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium', timeStyle: 'short' }).format(date)
      : '—';
  }

  function formatDateOnly(value) {
    const date = safeDate(value);
    return date
      ? new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' }).format(date)
      : '—';
  }

  function formatDateTimeLocal(value) {
    const date = safeDate(value);
    if (!date) return '';
    const offsetMs = date.getTimezoneOffset() * 60 * 1000;
    return new Date(date.getTime() - offsetMs).toISOString().slice(0, 16);
  }

  function formatIndiaDateInput(value) {
    const date = safeDate(value);
    if (!date) return '';
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Kolkata',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit'
    }).formatToParts(date).reduce((output, part) => {
      if (part.type !== 'literal') output[part.type] = part.value;
      return output;
    }, {});
    return parts.year + '-' + parts.month + '-' + parts.day;
  }

  function formatIndiaDateOnly(value) {
    const input = formatIndiaDateInput(value);
    if (!input) return '—';
    const [year, month, day] = input.split('-');
    return day + '/' + month + '/' + year;
  }

  function formatIndiaDateTimeLocal(value) {
    const date = safeDate(value);
    if (!date) return '';
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Kolkata',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23'
    }).formatToParts(date).reduce((output, part) => {
      if (part.type !== 'literal') output[part.type] = part.value;
      return output;
    }, {});
    return parts.year + '-' + parts.month + '-' + parts.day + 'T' + parts.hour + ':' + parts.minute;
  }

  const HUMAN_TEXT_EMOJI_PATTERN = /[\p{Extended_Pictographic}\u{1F1E6}-\u{1F1FF}\uFE0F\u20E3]/u;
  const HUMAN_TEXT_HTML_PATTERN = /<\/?[A-Za-z][^>]*>|&(?:#\d+|#x[0-9A-Fa-f]+|[A-Za-z][A-Za-z0-9]+);/u;

  function assertPlainHumanText(value, label = 'Text') {
    const text = String(value || '');
    if (HUMAN_TEXT_EMOJI_PATTERN.test(text)) throw new Error(label + ' must not contain emoji');
    if (HUMAN_TEXT_HTML_PATTERN.test(text)) throw new Error(label + ' must not contain HTML tags or encoded HTML');
    return text;
  }

  function humanize(value) {
    return String(value || '—').replace(/[_-]/g, ' ').replace(/\b\w/g, (character) => character.toUpperCase());
  }

  function statusClass(value) {
    return 'status-' + String(value || 'unknown').toLowerCase().replace(/_/g, '-');
  }

  function showCrmToast(message, type = 'success', durationMs) {
    const text = String(message || '').trim();
    if (!text) return;
    let region = document.getElementById('crm-toast-region');
    if (!region) {
      region = document.createElement('div');
      region.id = 'crm-toast-region';
      region.className = 'crm-toast-region';
      region.setAttribute('aria-live', 'polite');
      region.setAttribute('aria-atomic', 'false');
      document.body.appendChild(region);
    }
    const normalizedType = ['success', 'error', 'warning', 'info'].includes(type) ? type : 'info';
    const toast = document.createElement('div');
    toast.className = 'crm-toast crm-toast-' + normalizedType;
    toast.setAttribute('role', normalizedType === 'error' ? 'alert' : 'status');
    const icon = document.createElement('span');
    icon.className = 'crm-toast-icon';
    icon.textContent = normalizedType === 'success' ? '✓' : normalizedType === 'error' ? '!' : normalizedType === 'warning' ? '!' : 'i';
    const content = document.createElement('div');
    content.className = 'crm-toast-content';
    const title = document.createElement('strong');
    title.textContent = normalizedType === 'success' ? 'Success' : normalizedType === 'error' ? 'Unable to complete action' : normalizedType === 'warning' ? 'Attention' : 'Information';
    const body = document.createElement('span');
    body.textContent = text;
    content.append(title, body);
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'crm-toast-close';
    close.setAttribute('aria-label', 'Close notification');
    close.textContent = '×';
    const dismiss = () => {
      toast.classList.add('is-leaving');
      window.setTimeout(() => toast.remove(), 180);
    };
    close.addEventListener('click', dismiss);
    toast.append(icon, content, close);
    region.appendChild(toast);
    const lifetime = Number(durationMs) || (normalizedType === 'error' ? 9000 : 6000);
    window.setTimeout(dismiss, lifetime);
  }

  function createCursorPagination(limit = 100) {
    const requestedLimit = Number(limit);
    const initialLimit = requestedLimit === 20 ? 100 : requestedLimit;
    return {
      limit: Number.isInteger(initialLimit) && initialLimit > 0 ? Math.min(100, initialLimit) : 100,
      page: 1,
      cursor: '',
      nextCursor: '',
      hasNext: false,
      returned: 0,
      history: []
    };
  }

  function resetCursorPagination(pagination) {
    pagination.page = 1;
    pagination.cursor = '';
    pagination.nextCursor = '';
    pagination.hasNext = false;
    pagination.returned = 0;
    pagination.history = [];
  }

  function applyCursorPagination(pagination, response = {}) {
    const requestedLimit = Number(response.limit || pagination.limit || 100);
    pagination.limit = Number.isInteger(requestedLimit) && requestedLimit > 0
      ? Math.min(100, requestedLimit)
      : 100;
    pagination.nextCursor = typeof response.nextCursor === 'string' ? response.nextCursor : '';
    pagination.hasNext = Boolean(response.hasNext && pagination.nextCursor);
    const returned = Number(response.returned || 0);
    pagination.returned = Number.isFinite(returned) && returned >= 0 ? returned : 0;
  }

  function cursorNext(pagination) {
    if (!pagination.hasNext || !pagination.nextCursor) return false;
    pagination.history.push(pagination.cursor || '');
    pagination.cursor = pagination.nextCursor;
    pagination.page += 1;
    return true;
  }

  function cursorPrevious(pagination) {
    if (pagination.page <= 1 || !pagination.history.length) return false;
    pagination.cursor = pagination.history.pop() || '';
    pagination.page -= 1;
    return true;
  }

  function cursorGoToPage(pagination, targetPage) {
    const target = Number(targetPage);
    const current = Number(pagination?.page || 1);
    if (!Number.isInteger(target) || target < 1 || target === current) return false;
    if (target === current + 1) return cursorNext(pagination);
    if (target > current) return false;

    const history = Array.isArray(pagination.history) ? pagination.history : [];
    const historyIndex = target - 1;
    if (historyIndex >= history.length) return false;

    pagination.cursor = history[historyIndex] || '';
    pagination.history = history.slice(0, historyIndex);
    pagination.page = target;
    pagination.nextCursor = '';
    pagination.hasNext = false;
    pagination.returned = 0;
    return true;
  }

  function knownCursorPageItems(currentPage, hasNext) {
    const current = Math.max(1, Number(currentPage) || 1);
    const lastKnown = current + (hasNext ? 1 : 0);
    const wanted = new Set([1, current - 2, current - 1, current, current + 1, lastKnown]);
    const pages = [...wanted]
      .filter((page) => Number.isInteger(page) && page >= 1 && page <= lastKnown)
      .sort((a, b) => a - b);
    const items = [];
    for (const page of pages) {
      const previous = items[items.length - 1];
      if (typeof previous === 'number' && page - previous > 1) items.push('ellipsis');
      items.push(page);
    }
    return items;
  }

  function crmPaginationContext(container) {
    if (!window.Alpine || typeof window.Alpine.$data !== 'function') return null;
    const currentElement = container.__crmCurrentPageElement;
    const expression = String(currentElement?.getAttribute('x-text') || '').trim();
    const match = expression.match(/^([A-Za-z_$][\w$]*)\.page$/);
    if (!match) return null;
    const paginationKey = match[1];

    let scope = container.closest('[x-data]');
    while (scope) {
      try {
        const state = window.Alpine.$data(scope);
        const pagination = state?.[paginationKey];
        if (pagination && typeof pagination === 'object') {
          return { state, pagination, paginationKey };
        }
      } catch (error) {
        // Continue looking for the nearest Alpine component that owns this pagination object.
      }
      scope = scope.parentElement ? scope.parentElement.closest('[x-data]') : null;
    }
    return null;
  }

  function renderCrmPaginationNumbers(container) {
    const currentElement = container.__crmCurrentPageElement;
    const previousButton = container.__crmPreviousButton;
    const nextButton = container.__crmNextButton;
    if (!currentElement || !previousButton || !nextButton) return;

    container.querySelectorAll('[data-crm-page-number], [data-crm-page-ellipsis]').forEach((element) => element.remove());

    const currentPage = Math.max(1, Number(currentElement.textContent.trim()) || 1);
    const context = crmPaginationContext(container);
    const hasNext = context?.pagination ? Boolean(context.pagination.hasNext) : !nextButton.disabled;
    const items = knownCursorPageItems(currentPage, hasNext);

    currentElement.setAttribute('aria-current', 'page');
    currentElement.setAttribute('aria-label', 'Current page ' + currentPage);
    currentElement.dataset.crmCurrentPage = 'true';

    if (currentElement.parentElement === container) currentElement.remove();

    for (const item of items) {
      if (item === 'ellipsis') {
        const ellipsis = document.createElement('span');
        ellipsis.dataset.crmPageEllipsis = 'true';
        ellipsis.setAttribute('aria-hidden', 'true');
        ellipsis.textContent = '…';
        container.insertBefore(ellipsis, nextButton);
        continue;
      }
      if (item === currentPage) {
        container.insertBefore(currentElement, nextButton);
        continue;
      }
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.crmPageNumber = String(item);
      button.textContent = String(item);
      button.setAttribute('aria-label', 'Go to page ' + item);
      button.addEventListener('click', () => {
        const liveContext = crmPaginationContext(container);
        const livePagination = liveContext?.pagination;
        const livePage = Number(livePagination?.page || currentElement.textContent.trim() || 1);
        if (item === livePage + 1) {
          nextButton.click();
          return;
        }
        if (item === livePage - 1) {
          previousButton.click();
          return;
        }
        if (item < livePage - 1 && livePagination && cursorGoToPage(livePagination, item + 1)) {
          previousButton.click();
        }
      });
      container.insertBefore(button, nextButton);
    }
  }

  function enhanceCrmPagination(container) {
    if (!container || container.dataset.crmNumberedPagination === 'true') return;
    const children = [...container.children];
    const navigationButtons = children.filter((element) => element.tagName === 'BUTTON');
    const currentElement = children.find((element) => element.tagName === 'SPAN');
    if (navigationButtons.length < 2 || !currentElement) return;

    container.dataset.crmNumberedPagination = 'true';
    container.__crmPreviousButton = navigationButtons[0];
    container.__crmNextButton = navigationButtons[navigationButtons.length - 1];
    container.__crmCurrentPageElement = currentElement;

    const observer = new MutationObserver(() => renderCrmPaginationNumbers(container));
    observer.observe(currentElement, { childList: true, characterData: true, subtree: true });
    observer.observe(container.__crmNextButton, { attributes: true, attributeFilter: ['disabled'] });
    renderCrmPaginationNumbers(container);
  }

  function enhanceAllCrmPaginations() {
    document.querySelectorAll('.crm-pagination').forEach(enhanceCrmPagination);
  }

  document.addEventListener('alpine:initialized', enhanceAllCrmPaginations);
  document.addEventListener('DOMContentLoaded', () => {
    enhanceAllCrmPaginations();
    window.setTimeout(enhanceAllCrmPaginations, 0);
  }, { once: true });

  const CRM_SIDEBAR_COLLAPSED_KEY = 'leadops.crm.sidebar.collapsed.v1';
  function readSidebarCollapsed() {
    try {
      return window.localStorage.getItem(CRM_SIDEBAR_COLLAPSED_KEY) === '1';
    } catch (error) {
      return false;
    }
  }

  function syncSidebarDocumentState(collapsed) {
    document.documentElement.classList.toggle('crm-sidebar-saved-collapsed', Boolean(collapsed));
  }

  function enableSidebarTransitionsAfterInitialLayout() {
    window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => {
        document.documentElement.classList.remove('crm-sidebar-no-transition');
      });
    });
  }

  document.addEventListener('submit', (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || form.dataset.allowRichText === 'true') return;
    const fields = form.querySelectorAll('input[type="text"], input[type="search"], textarea');
    for (const field of fields) {
      if (field.disabled || field.dataset.allowRichText === 'true' || field.classList.contains('crm-json')) continue;
      try {
        assertPlainHumanText(field.value, field.labels?.[0]?.textContent?.trim() || field.placeholder || 'Text');
      } catch (error) {
        event.preventDefault();
        event.stopImmediatePropagation();
        field.focus();
        field.setCustomValidity(error.message);
        field.reportValidity();
        window.setTimeout(() => field.setCustomValidity(''), 0);
        showCrmToast(error.message, 'error');
        return;
      }
    }
  }, true);

  function crmShell() {
    return {
      admin: {},
      shellError: '',
      sidebarOpen: false,
      sidebarCollapsed: readSidebarCollapsed(),
      communicationMenuOpen: location.pathname === '/communications' || location.pathname.startsWith('/communications/'),
      catalogMenuOpen: location.pathname === '/categories' || location.pathname.startsWith('/categories/') || location.pathname === '/service-types' || location.pathname.startsWith('/service-types/'),
      async initShell() {
        syncSidebarDocumentState(this.sidebarCollapsed);
        enableSidebarTransitionsAfterInitialLayout();
        try {
          this.admin = (await apiFetch('/api/auth/me')).data || {};
        } catch (error) {
          this.shellError = error.message;
          showCrmToast(error.message, 'error');
        }
      },
      toggleSidebar() {
        this.sidebarCollapsed = !this.sidebarCollapsed;
        syncSidebarDocumentState(this.sidebarCollapsed);
        try {
          window.localStorage.setItem(CRM_SIDEBAR_COLLAPSED_KEY, this.sidebarCollapsed ? '1' : '0');
        } catch (error) {
          // The sidebar still works when browser storage is unavailable.
        }
      },
      can(permission) {
        const permissions = Array.isArray(this.admin.permissions) ? this.admin.permissions : [];
        return permissions.includes('*') || permissions.includes(permission);
      },
      pathIs(path) {
        return location.pathname === path || location.pathname.startsWith(path + '/');
      },
      async logout() {
        try {
          await apiFetch('/api/auth/logout', { method: 'POST', body: '{}' });
          location.href = '/login';
        } catch (error) {
          this.shellError = error.message;
        }
      }
    };
  }
</script>
