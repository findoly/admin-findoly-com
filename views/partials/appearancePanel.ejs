<% if (admin) { %>
<div class="crm-appearance-backdrop" data-crm-appearance-backdrop hidden></div>
<aside class="crm-appearance-panel" data-crm-appearance-panel aria-hidden="true" aria-label="Appearance settings">
  <div class="crm-appearance-panel-header">
    <div>
      <h5 class="mb-1">Appearance settings</h5>
      <div class="text-muted fs-sm">Saved in this browser for <strong><%= admin.email %></strong>.</div>
    </div>
    <button type="button" class="btn btn-light btn-icon rounded-pill" data-crm-appearance-close aria-label="Close appearance settings">
      <svg class="crm-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>

  <div class="crm-appearance-panel-body">
    <section class="crm-appearance-section">
      <div class="crm-appearance-section-title">Dashboard themes</div>
      <div class="text-muted fs-sm mb-2">Choose a simple professional dashboard theme. Font settings stay fixed for consistency.</div>
      <div class="crm-theme-presets crm-theme-presets-featured">
        <button type="button" class="crm-theme-preset crm-theme-preset-five" data-appearance-preset="blackWhite" data-preset-label="Black and white">
          <span style="--preset-1:#111111;--preset-2:#171717;--preset-3:#f5f5f5;--preset-4:#ffffff;--preset-5:#dedede"></span>
          <b>Black &amp; white</b>
        </button>
        <button type="button" class="crm-theme-preset crm-theme-preset-five" data-appearance-preset="whiteBlack" data-preset-label="White and black">
          <span style="--preset-1:#ffffff;--preset-2:#f8fafc;--preset-3:#f4f5f7;--preset-4:#111827;--preset-5:#dfe3e8"></span>
          <b>White &amp; black</b>
        </button>
        <button type="button" class="crm-theme-preset crm-theme-preset-five" data-appearance-preset="facebook" data-preset-label="Facebook style">
          <span style="--preset-1:#1877f2;--preset-2:#e7f3ff;--preset-3:#f0f2f5;--preset-4:#ffffff;--preset-5:#1c1e21"></span>
          <b>Facebook style</b>
        </button>
        <button type="button" class="crm-theme-preset crm-theme-preset-five" data-appearance-preset="blueBlackWhite" data-preset-label="Blue black and white">
          <span style="--preset-1:#2563eb;--preset-2:#0f172a;--preset-3:#111827;--preset-4:#ffffff;--preset-5:#f3f6fb"></span>
          <b>Blue, black &amp; white</b>
        </button>
        <button type="button" class="crm-theme-preset crm-theme-preset-five" data-appearance-preset="facebookLight" data-preset-label="Facebook light">
          <span style="--preset-1:#ffffff;--preset-2:#1877f2;--preset-3:#f0f2f5;--preset-4:#e7f3ff;--preset-5:#1c1e21"></span>
          <b>Facebook light</b>
        </button>
        <button type="button" class="crm-theme-preset crm-theme-preset-five" data-appearance-preset="linkedin" data-preset-label="LinkedIn professional">
          <span style="--preset-1:#ffffff;--preset-2:#0a66c2;--preset-3:#f3f2ef;--preset-4:#e8f3ff;--preset-5:#191919"></span>
          <b>LinkedIn professional</b>
        </button>
        <button type="button" class="crm-theme-preset crm-theme-preset-five" data-appearance-preset="tealProfessional" data-preset-label="Teal professional">
          <span style="--preset-1:#ffffff;--preset-2:#0f766e;--preset-3:#f7faf9;--preset-4:#ccfbf1;--preset-5:#17332f"></span>
          <b>Teal professional</b>
        </button>
      </div>
    </section>

    <details class="crm-appearance-section" open>
      <summary>Layout density</summary>
      <label class="crm-select-control mt-2"><span>Spacing</span><select class="form-select" data-appearance-key="density"><option value="compact">Compact</option><option value="comfortable">Comfortable</option><option value="spacious">Spacious</option></select></label>
    </details>

    <details class="crm-appearance-section" open>
      <summary>Background combinations</summary>
      <div class="crm-appearance-two-col">
        <label class="crm-select-control"><span>Page background</span>
          <select class="form-select" data-appearance-key="backgroundStyle">
            <option value="solid">Solid</option><option value="soft-gradient">Soft gradient</option><option value="gradient">Gradient</option>
            <option value="radial">Radial glow</option><option value="dots">Dot pattern</option><option value="grid">Grid pattern</option><option value="paper">Paper lines</option>
          </select>
        </label>
        <label class="crm-select-control"><span>Header treatment</span><select class="form-select" data-appearance-key="headerStyle"><option value="solid">Solid</option><option value="gradient">Gradient</option></select></label>
      </div>
      <div class="crm-appearance-two-col">
        <label class="crm-select-control"><span>Sidebar treatment</span><select class="form-select" data-appearance-key="sidebarStyle"><option value="solid">Solid</option><option value="gradient">Gradient</option></select></label>
        <label class="crm-select-control"><span>Card shadow</span><select class="form-select" data-appearance-key="shadow"><option value="none">None</option><option value="subtle">Subtle</option><option value="soft">Soft</option><option value="strong">Strong</option></select></label>
      </div>
      <div class="crm-appearance-grid mt-2">
        <label class="crm-color-control"><span>Page color 1</span><input type="color" data-appearance-key="pageBg"></label>
        <label class="crm-color-control"><span>Page color 2</span><input type="color" data-appearance-key="pageBg2"></label>
        <label class="crm-color-control"><span>Header color 1</span><input type="color" data-appearance-key="headerBg"></label>
        <label class="crm-color-control"><span>Header color 2</span><input type="color" data-appearance-key="headerBg2"></label>
        <label class="crm-color-control"><span>Sidebar color 1</span><input type="color" data-appearance-key="sidebarBg"></label>
        <label class="crm-color-control"><span>Sidebar color 2</span><input type="color" data-appearance-key="sidebarBg2"></label>
      </div>
    </details>

    <details class="crm-appearance-section" open>
      <summary>Shell and navigation</summary>
      <div class="crm-appearance-grid">
        <label class="crm-color-control"><span>Accent</span><input type="color" data-appearance-key="accent"></label>
        <label class="crm-color-control"><span>Accent text</span><input type="color" data-appearance-key="accentText"></label>
        <label class="crm-color-control"><span>Header text</span><input type="color" data-appearance-key="headerText"></label>
        <label class="crm-color-control"><span>Sidebar text</span><input type="color" data-appearance-key="sidebarText"></label>
        <label class="crm-color-control"><span>Active menu</span><input type="color" data-appearance-key="sidebarActiveBg"></label>
        <label class="crm-color-control"><span>Active text</span><input type="color" data-appearance-key="sidebarActiveText"></label>
        <label class="crm-color-control"><span>Main text</span><input type="color" data-appearance-key="mainText"></label>
        <label class="crm-color-control"><span>Muted text</span><input type="color" data-appearance-key="mutedText"></label>
      </div>
      <div class="crm-appearance-two-col">
        <label class="crm-range-control"><span>Sidebar width <output data-appearance-output="sidebarWidth"></output></span><input type="range" min="230" max="360" step="2" data-appearance-key="sidebarWidth"></label>
        <label class="crm-range-control"><span>Navigation edge <output data-appearance-output="navRadius"></output></span><input type="range" min="0" max="20" step="1" data-appearance-key="navRadius"></label>
      </div>
    </details>

    <details class="crm-appearance-section" open>
      <summary>Cards and forms</summary>
      <div class="crm-appearance-grid">
        <label class="crm-color-control"><span>Card surface</span><input type="color" data-appearance-key="cardBg"></label>
        <label class="crm-color-control"><span>Card header</span><input type="color" data-appearance-key="cardHeaderBg"></label>
        <label class="crm-color-control"><span>Card edge</span><input type="color" data-appearance-key="cardBorder"></label>
        <label class="crm-color-control"><span>Input surface</span><input type="color" data-appearance-key="inputBg"></label>
        <label class="crm-color-control"><span>Input edge</span><input type="color" data-appearance-key="inputBorder"></label>
      </div>
      <div class="crm-appearance-two-col">
        <label class="crm-range-control"><span>Card radius <output data-appearance-output="cardRadius"></output></span><input type="range" min="0" max="24" step="1" data-appearance-key="cardRadius"></label>
        <label class="crm-range-control"><span>Card border <output data-appearance-output="cardBorderWidth"></output></span><input type="range" min="0" max="3" step="1" data-appearance-key="cardBorderWidth"></label>
      </div>
      <div class="crm-appearance-two-col">
        <label class="crm-range-control"><span>Button radius <output data-appearance-output="buttonRadius"></output></span><input type="range" min="0" max="20" step="1" data-appearance-key="buttonRadius"></label>
      </div>
    </details>

    <details class="crm-appearance-section" open>
      <summary>Tables</summary>
      <div class="crm-appearance-grid">
        <label class="crm-color-control"><span>Header surface</span><input type="color" data-appearance-key="tableHeadBg"></label>
        <label class="crm-color-control"><span>Header text</span><input type="color" data-appearance-key="tableHeadText"></label>
        <label class="crm-color-control"><span>Table edge</span><input type="color" data-appearance-key="tableBorder"></label>
        <label class="crm-color-control"><span>Row surface</span><input type="color" data-appearance-key="tableRowBg"></label>
        <label class="crm-color-control"><span>Alternate row</span><input type="color" data-appearance-key="tableAltBg"></label>
        <label class="crm-color-control"><span>Hover row</span><input type="color" data-appearance-key="tableHover"></label>
      </div>
      <div class="crm-appearance-two-col">
        <label class="crm-range-control"><span>Table radius <output data-appearance-output="tableRadius"></output></span><input type="range" min="0" max="24" step="1" data-appearance-key="tableRadius"></label>
        <label class="crm-range-control"><span>Table border <output data-appearance-output="tableBorderWidth"></output></span><input type="range" min="0" max="3" step="1" data-appearance-key="tableBorderWidth"></label>
      </div>
      <label class="crm-select-control mt-2"><span>Row style</span><select class="form-select" data-appearance-key="tableStyle"><option value="striped">Striped</option><option value="plain">Plain</option></select></label>
    </details>
  </div>

  <div class="crm-appearance-panel-footer">
    <span class="crm-appearance-status" data-appearance-status>Saved in this browser</span>
    <button type="button" class="btn btn-light" data-appearance-reset>Restore White &amp; black</button>
    <button type="button" class="btn btn-primary" data-crm-appearance-close>Done</button>
  </div>
</aside>
<% } %>
