<% if (pagination && pagination.total > 0) { %>
  <div class="card-footer d-sm-flex align-items-sm-center">
    <div class="text-muted fs-sm mb-2 mb-sm-0">
      Showing <%= pagination.from %> to <%= pagination.to %> of <%= pagination.total %> records
    </div>
    <ul class="pagination pagination-flat ms-sm-auto mb-0">
      <li class="page-item <%= pagination.previousUrl ? '' : 'disabled' %>"><a class="page-link" href="<%= pagination.firstUrl %>"><i class="ph-caret-double-left"></i></a></li>
      <li class="page-item <%= pagination.previousUrl ? '' : 'disabled' %>"><a class="page-link" href="<%= pagination.previousUrl || '#' %>"><i class="ph-caret-left"></i></a></li>
      <% pagination.pages.forEach((item) => { %>
        <li class="page-item <%= item.active ? 'active' : '' %>"><a class="page-link" href="<%= item.url %>"><%= item.page %></a></li>
      <% }) %>
      <li class="page-item <%= pagination.nextUrl ? '' : 'disabled' %>"><a class="page-link" href="<%= pagination.nextUrl || '#' %>"><i class="ph-caret-right"></i></a></li>
      <li class="page-item <%= pagination.nextUrl ? '' : 'disabled' %>"><a class="page-link" href="<%= pagination.lastUrl %>"><i class="ph-caret-double-right"></i></a></li>
    </ul>
  </div>
<% } %>
