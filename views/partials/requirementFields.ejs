<%
  const capturedFields = fields || {};
  const definitionFields = template && Array.isArray(template.fields) ? template.fields : [];
  const usedKeys = new Set();
  const rows = [];

  definitionFields.forEach((field) => {
    const key = field.name;
    usedKeys.add(key);
    rows.push({
      key,
      label: field.label || humanize(key),
      type: field.type || 'text',
      required: !!field.required,
      value: capturedFields[key]
    });
  });

  Object.keys(capturedFields).forEach((key) => {
    if (!usedKeys.has(key)) {
      rows.push({
        key,
        label: humanize(key),
        type: 'captured',
        required: false,
        value: capturedFields[key]
      });
    }
  });

  function displayValue(value) {
    if (Array.isArray(value)) return value.join(', ');
    if (value === undefined || value === null || value === '') return '';
    if (typeof value === 'object') return JSON.stringify(value, null, 2);
    return String(value);
  }
%>

<% if (rows.length) { %>
  <div class="table-responsive crm-requirement-fields-table">
    <table class="table table-sm align-middle mb-0">
      <thead>
        <tr>
          <th>Field</th>
          <th style="width: 150px;">Type</th>
          <th>Customer value</th>
          <th style="width: 95px;">Rule</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach((row) => { const valueText = displayValue(row.value); %>
          <tr>
            <td>
              <div class="fw-semibold"><%= row.label %></div>
              <div class="text-muted fs-sm"><%= row.key %></div>
            </td>
            <td><span class="badge bg-light text-body border"><%= humanize(row.type) %></span></td>
            <td class="crm-break">
              <% if (valueText) { %>
                <% if ((row.type === 'url' || row.type === 'file_url') && /^https?:\/\//i.test(valueText)) { %>
                  <a href="<%= valueText %>" target="_blank" rel="noopener"><%= valueText %></a>
                <% } else { %>
                  <%= valueText %>
                <% } %>
              <% } else { %>
                <span class="text-muted">Not filled</span>
              <% } %>
            </td>
            <td>
              <% if (row.required) { %><span class="badge status-urgent rounded-pill">Required</span><% } else { %><span class="badge bg-light text-body border rounded-pill">Optional</span><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="text-muted">No requirement form fields have been captured yet.</div>
<% } %>
