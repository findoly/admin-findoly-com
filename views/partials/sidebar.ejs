<!-- Main sidebar -->
<div class="sidebar sidebar-light sidebar-main sidebar-expand-lg crm-sidebar">
  <div class="sidebar-content">
    <div class="sidebar-section">
      <div class="sidebar-section-body d-flex justify-content-center">
        <div class="sidebar-resize-hide flex-grow-1 my-auto">
          <div class="crm-sidebar-title">LeadOps CRM</div>
          <div class="crm-sidebar-caption">Requirement workspace</div>
        </div>
        <div>
          <button type="button" class="btn btn-light btn-icon btn-sm rounded-pill border-transparent sidebar-control sidebar-main-resize d-none d-lg-inline-flex" aria-label="Resize sidebar">
            <svg class="crm-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7H3m0 0 3-3M3 7l3 3"/><path d="M16 17h5m0 0-3-3m3 3-3 3"/><path d="M4 17h16M20 7H4"/></svg>
          </button>
          <button type="button" class="btn btn-light btn-icon btn-sm rounded-pill border-transparent sidebar-mobile-main-toggle d-lg-none" aria-label="Close navigation">
            <svg class="crm-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="sidebar-section">
      <ul class="nav nav-sidebar" data-nav-type="accordion">
        <li class="nav-item-header pt-0"><div class="text-uppercase fs-sm lh-sm opacity-50 sidebar-resize-hide">Workspace</div><i class="ph-dots-three sidebar-resize-show"></i></li>
        <li class="nav-item"><a href="/dashboard" class="nav-link <%= currentPath.startsWith('/dashboard') ? 'active' : '' %>"><i class="ph-house"></i><span>Dashboard<span class="d-block fw-normal opacity-50">Today and workload</span></span></a></li>

        <li class="nav-item-header"><div class="text-uppercase fs-sm lh-sm opacity-50 sidebar-resize-hide">Requirement queues</div><i class="ph-dots-three sidebar-resize-show"></i></li>
        <li class="nav-item nav-item-submenu <%= currentPath.startsWith('/enquiries/queue') ? 'nav-item-expanded nav-item-open' : '' %>">
          <a href="#" class="nav-link">
            <i class="ph-calendar-check"></i>
            <span>Requirement queues<span class="d-block fw-normal opacity-50">Verify and approve</span></span>
            <% if ((navCounts.queues && navCounts.queues.new) || 0) { %><span class="badge bg-primary rounded-pill ms-auto"><%= navCounts.queues.new %> New</span><% } %>
          </a>
          <ul class="nav-group-sub collapse <%= currentPath.startsWith('/enquiries/queue') ? 'show' : '' %>">
            <% enquiryQueues.forEach((queue) => { %>
              <li class="nav-item">
                <a href="/enquiries/queue/<%= queue.key %>" class="nav-link <%= currentPath === '/enquiries/queue/' + queue.key ? 'active' : '' %>">
                  <span><%= queue.label %></span>
                  <span class="badge bg-transparent align-self-center ms-auto"><%= (navCounts.queues && navCounts.queues[queue.key]) || 0 %></span>
                </a>
              </li>
            <% }) %>
            <li class="nav-item-divider"></li>
            <li class="nav-item"><a href="/enquiries" class="nav-link <%= currentPath === '/enquiries' ? 'active' : '' %>">All requirements <span class="badge bg-transparent align-self-center ms-auto"><%= navCounts.enquiries || 0 %></span></a></li>
          </ul>
        </li>

        <li class="nav-item-header"><div class="text-uppercase fs-sm lh-sm opacity-50 sidebar-resize-hide">Core records</div><i class="ph-dots-three sidebar-resize-show"></i></li>

        <li class="nav-item nav-item-submenu <%= (currentPath.startsWith('/enquiries') && !currentPath.startsWith('/enquiries/queue')) || currentPath.startsWith('/search/enquiries') ? 'nav-item-expanded nav-item-open' : '' %>">
          <a href="#" class="nav-link"><i class="ph-list-checks"></i><span>Requirements<span class="d-block fw-normal opacity-50">Verify and approve</span></span></a>
          <ul class="nav-group-sub collapse <%= (currentPath.startsWith('/enquiries') && !currentPath.startsWith('/enquiries/queue')) || currentPath.startsWith('/search/enquiries') ? 'show' : '' %>">
            <li class="nav-item"><a href="/enquiries" class="nav-link <%= currentPath === '/enquiries' ? 'active' : '' %>">All requirements</a></li>
            <li class="nav-item"><a href="/enquiries/new" class="nav-link <%= currentPath === '/enquiries/new' ? 'active' : '' %>">Create lead</a></li>
            <li class="nav-item"><a href="/search/enquiries" class="nav-link <%= currentPath.startsWith('/search/enquiries') ? 'active' : '' %>">Requirement search</a></li>
          </ul>
        </li>

        <li class="nav-item nav-item-submenu <%= currentPath.startsWith('/providers') || currentPath.startsWith('/search/providers') ? 'nav-item-expanded nav-item-open' : '' %>">
          <a href="#" class="nav-link"><i class="ph-users-three"></i><span>Providers<span class="d-block fw-normal opacity-50">Directory and edit</span></span><span class="badge bg-transparent align-self-center ms-auto"><%= navCounts.providers || 0 %></span></a>
          <ul class="nav-group-sub collapse <%= currentPath.startsWith('/providers') || currentPath.startsWith('/search/providers') ? 'show' : '' %>">
            <li class="nav-item"><a href="/providers" class="nav-link <%= currentPath === '/providers' ? 'active' : '' %>">Provider list</a></li>
            <li class="nav-item"><a href="/providers/new" class="nav-link <%= currentPath === '/providers/new' ? 'active' : '' %>">Create provider</a></li>
            <li class="nav-item"><a href="/search/providers" class="nav-link <%= currentPath.startsWith('/search/providers') ? 'active' : '' %>">Provider search</a></li>
          </ul>
        </li>

        <li class="nav-item-header"><div class="text-uppercase fs-sm lh-sm opacity-50 sidebar-resize-hide">Work queue</div><i class="ph-dots-three sidebar-resize-show"></i></li>

        <li class="nav-item nav-item-submenu <%= currentPath.startsWith('/follow-ups') || currentPath.startsWith('/search/follow-ups') ? 'nav-item-expanded nav-item-open' : '' %>">
          <a href="#" class="nav-link"><i class="ph-clock-counter-clockwise"></i><span>Follow-ups<span class="d-block fw-normal opacity-50">Tasks and callbacks</span></span><span class="badge bg-transparent align-self-center ms-auto"><%= navCounts.openFollowUps || 0 %></span></a>
          <ul class="nav-group-sub collapse <%= currentPath.startsWith('/follow-ups') || currentPath.startsWith('/search/follow-ups') ? 'show' : '' %>">
            <li class="nav-item"><a href="/follow-ups" class="nav-link <%= currentPath === '/follow-ups' ? 'active' : '' %>">Follow-up list</a></li>
            <li class="nav-item"><a href="/follow-ups/new" class="nav-link <%= currentPath === '/follow-ups/new' ? 'active' : '' %>">Create follow-up</a></li>
            <li class="nav-item"><a href="/search/follow-ups" class="nav-link <%= currentPath.startsWith('/search/follow-ups') ? 'active' : '' %>">Follow-up search</a></li>
          </ul>
        </li>

        <li class="nav-item nav-item-submenu <%= currentPath.startsWith('/communications') || currentPath.startsWith('/search/communications') ? 'nav-item-expanded nav-item-open' : '' %>">
          <a href="#" class="nav-link"><i class="ph-chats"></i><span>Communications<span class="d-block fw-normal opacity-50">Calls, notes, WhatsApp</span></span></a>
          <ul class="nav-group-sub collapse <%= currentPath.startsWith('/communications') || currentPath.startsWith('/search/communications') ? 'show' : '' %>">
            <li class="nav-item"><a href="/communications" class="nav-link <%= currentPath === '/communications' ? 'active' : '' %>">Communication list</a></li>
            <li class="nav-item"><a href="/communications/new" class="nav-link <%= currentPath === '/communications/new' ? 'active' : '' %>">Log communication</a></li>
            <li class="nav-item"><a href="/search/communications" class="nav-link <%= currentPath.startsWith('/search/communications') ? 'active' : '' %>">Communication search</a></li>
          </ul>
        </li>

        <li class="nav-item nav-item-submenu <%= currentPath.startsWith('/billing') || currentPath.startsWith('/search/invoices') ? 'nav-item-expanded nav-item-open' : '' %>">
          <a href="#" class="nav-link"><i class="ph-currency-inr"></i><span>Billing<span class="d-block fw-normal opacity-50">Invoices and status</span></span><span class="badge bg-transparent align-self-center ms-auto"><%= navCounts.invoices || 0 %></span></a>
          <ul class="nav-group-sub collapse <%= currentPath.startsWith('/billing') || currentPath.startsWith('/search/invoices') ? 'show' : '' %>">
            <li class="nav-item"><a href="/billing" class="nav-link <%= currentPath === '/billing' ? 'active' : '' %>">Invoice list</a></li>
            <li class="nav-item"><a href="/billing/new" class="nav-link <%= currentPath === '/billing/new' ? 'active' : '' %>">Create invoice</a></li>
            <li class="nav-item"><a href="/search/invoices" class="nav-link <%= currentPath.startsWith('/search/invoices') ? 'active' : '' %>">Invoice search</a></li>
          </ul>
        </li>

        <li class="nav-item-header"><div class="text-uppercase fs-sm lh-sm opacity-50 sidebar-resize-hide">Search</div><i class="ph-dots-three sidebar-resize-show"></i></li>
        <li class="nav-item nav-item-submenu <%= currentPath.startsWith('/search') ? 'nav-item-expanded nav-item-open' : '' %>">
          <a href="#" class="nav-link"><i class="ph-magnifying-glass"></i><span>Search pages<span class="d-block fw-normal opacity-50">Separate tables</span></span></a>
          <ul class="nav-group-sub collapse <%= currentPath.startsWith('/search') ? 'show' : '' %>">
            <li class="nav-item"><a href="/search/enquiries" class="nav-link <%= currentPath.startsWith('/search/enquiries') ? 'active' : '' %>">Requirement Search</a></li>
            <li class="nav-item"><a href="/search/providers" class="nav-link <%= currentPath.startsWith('/search/providers') ? 'active' : '' %>">Provider Search</a></li>
            <li class="nav-item"><a href="/search/invoices" class="nav-link <%= currentPath.startsWith('/search/invoices') ? 'active' : '' %>">Invoice Search</a></li>
            <li class="nav-item"><a href="/search/follow-ups" class="nav-link <%= currentPath.startsWith('/search/follow-ups') ? 'active' : '' %>">Follow-up Search</a></li>
            <li class="nav-item"><a href="/search/communications" class="nav-link <%= currentPath.startsWith('/search/communications') ? 'active' : '' %>">Communication Search</a></li>
          </ul>
        </li>

        <li class="nav-item-header"><div class="text-uppercase fs-sm lh-sm opacity-50 sidebar-resize-hide">Admin</div><i class="ph-dots-three sidebar-resize-show"></i></li>
        <li class="nav-item"><a href="/reports" class="nav-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>"><i class="ph-chart-bar"></i><span>Reports & audit log</span></a></li>

      </ul>
    </div>
  </div>
</div>
<!-- /main sidebar -->
