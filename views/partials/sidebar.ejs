<div class="sidebar sidebar-main sidebar-expand-lg crm-sidebar" :class="{'crm-sidebar-open': sidebarOpen, 'crm-sidebar-collapsed': sidebarCollapsed}">
  <div class="sidebar-content">
    <div class="crm-sidebar-mobile-head d-lg-none">
      <div class="d-flex align-items-center gap-2">
        <span class="crm-brand-mark">C</span>
        <strong>CRM navigation</strong>
      </div>
      <button type="button" class="crm-sidebar-close" @click="sidebarOpen = false" aria-label="Close navigation">×</button>
    </div>

    <div class="crm-sidebar-desktop-actions d-none d-lg-flex">
      <button
        type="button"
        class="crm-sidebar-collapse"
        @click="toggleSidebar()"
        :aria-label="sidebarCollapsed ? 'Expand sidebar' : 'Collapse sidebar'"
        :aria-expanded="(!sidebarCollapsed).toString()"
        :title="sidebarCollapsed ? 'Expand sidebar' : 'Collapse sidebar'"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" :class="{'is-collapsed': sidebarCollapsed}"><path d="m14 7-5 5 5 5"/></svg>
        <span class="crm-sidebar-collapse-label" x-text="sidebarCollapsed ? 'Expand' : 'Collapse'">Collapse</span>
      </button>
    </div>

    <div class="sidebar-section pt-2">
      <ul class="nav nav-sidebar" data-nav-type="accordion">
        <li class="nav-item-header"><span>Workspace</span></li>
        <li class="nav-item">
          <a href="/dashboard" title="Dashboard" class="nav-link" :class="{active:pathIs('/dashboard')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.7 12 3l9 7.7v9.8a.5.5 0 0 1-.5.5h-5.2v-6.2H8.7V21H3.5a.5.5 0 0 1-.5-.5Z"/><path d="M9.2 21v-6.2h5.6V21"/></svg>
            <span>Dashboard</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/enquiries" title="Requirements" class="nav-link" :class="{active:pathIs('/enquiries') || pathIs('/requirements')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
            <span>Requirements</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/providers" title="Providers" class="nav-link" :class="{active:pathIs('/providers')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M13 20a4.5 4.5 0 0 1 8 0"/></svg>
            <span>Providers</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/agents" title="Agents" class="nav-link" :class="{active:pathIs('/agents')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M3 20a5 5 0 0 1 10 0M16 7h5M18.5 4.5v5"/><path d="M15 20a4 4 0 0 1 6 0"/></svg>
            <span>Agents</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/partner-withdrawals" title="Partner withdrawals" class="nav-link" :class="{active:pathIs('/partner-withdrawals')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v11H4z"/><path d="M4 10h16M8 15h4M16 14.5h.01"/></svg>
            <span>Partner payouts</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/categories" title="Categories" class="nav-link" :class="{active:pathIs('/categories')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H12l2 2h3.5A2.5 2.5 0 0 1 20 8.5v8A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5Z"/><path d="M8 11h8M8 15h5"/></svg>
            <span>Categories</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/distributions" title="Distribution" class="nav-link" :class="{active:pathIs('/distributions')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="19" cy="19" r="2"/><path d="m7 11 10-5M7 13l10 5"/></svg>
            <span>Distribution</span>
          </a>
        </li>

        <li class="nav-item-header"><span>Operations</span></li>
        <li class="nav-item">
          <a href="/follow-ups" title="Follow-ups" class="nav-link" :class="{active:pathIs('/follow-ups')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2M4.5 5.5 3 8"/></svg>
            <span>Follow-ups</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/communications" title="Communications" class="nav-link" :class="{active:pathIs('/communications')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v12H8l-4 4Z"/><path d="M8 9h8M8 13h5"/></svg>
            <span>Communications</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/billing" title="Billing" class="nav-link" :class="{active:pathIs('/billing')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h4"/></svg>
            <span>Billing</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/reports" title="Reports" class="nav-link" :class="{active:pathIs('/reports')}" @click="sidebarOpen=false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V10M12 20V4M19 20v-7"/><path d="M3 20h18"/></svg>
            <span>Reports</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="crm-sidebar-foot">
      <div class="crm-sidebar-support">
        <span class="crm-sidebar-support-icon">?</span>
        <div><strong>Need help?</strong><small>Check platform setup</small></div>
      </div>
    </div>
  </div>
</div>
<div class="crm-sidebar-overlay" x-show="sidebarOpen" x-cloak @click="sidebarOpen=false"></div>
