<%
  const canAccess = typeof can === 'function' ? can : () => true;
  const showWorkspace = canAccess('dashboard.view') || canAccess('requirements.view') || canAccess('providers.view') || canAccess('provider_requests.view') || canAccess('agents.view') || canAccess('partnerPayouts.view') || canAccess('categories.view') || canAccess('provider_unlocks.view');
  const showCommunications = canAccess('communications.view') || canAccess('communications.send') || canAccess('communications.manage');
  const showOperations = canAccess('followUps.view') || showCommunications || canAccess('billing.view') || canAccess('reports.view');
  const showAdministration = canAccess('storage.view') || canAccess('employees.view') || canAccess('roles.view');
%>
<div id="crmPrimaryNavigation" class="sidebar sidebar-main sidebar-expand-lg crm-sidebar" :class="{'crm-sidebar-open': sidebarOpen, 'crm-sidebar-collapsed': sidebarCollapsed}" :aria-hidden="(!sidebarOpen && window.innerWidth < 992).toString()" x-effect="document.documentElement.classList.toggle('crm-mobile-drawer-open', sidebarOpen); document.body.classList.toggle('crm-mobile-drawer-open', sidebarOpen)" @keydown.escape.window="sidebarOpen=false">
  <div class="sidebar-content">
    <div class="crm-sidebar-mobile-head d-lg-none">
      <div class="d-flex align-items-center gap-2"><img src="/images/findoly-logo.png" alt="Findoly" class="crm-sidebar-brand-logo"><strong>CRM navigation</strong></div>
      <button type="button" class="crm-sidebar-close" @click="sidebarOpen = false" aria-label="Close navigation">×</button>
    </div>

    <div class="crm-sidebar-desktop-actions d-none d-lg-flex">
      <button type="button" class="crm-sidebar-collapse" @click="toggleSidebar()" :aria-label="sidebarCollapsed ? 'Expand sidebar' : 'Collapse sidebar'" :aria-expanded="(!sidebarCollapsed).toString()" :title="sidebarCollapsed ? 'Expand sidebar' : 'Collapse sidebar'">
        <svg viewBox="0 0 24 24" aria-hidden="true" :class="{'is-collapsed': sidebarCollapsed}"><path d="m14 7-5 5 5 5"/></svg>
        <span class="crm-sidebar-collapse-label" x-text="sidebarCollapsed ? 'Expand' : 'Collapse'">Collapse</span>
      </button>
    </div>

    <div class="sidebar-section pt-2">
      <ul class="nav nav-sidebar" data-nav-type="accordion">
        <% if (showWorkspace) { %><li class="nav-item-header"><span>Workspace</span></li><% } %>
        <% if (canAccess('dashboard.view')) { %><li class="nav-item"><a href="/dashboard" title="Dashboard" class="nav-link" :class="{active:pathIs('/dashboard')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.7 12 3l9 7.7v9.8a.5.5 0 0 1-.5.5h-5.2v-6.2H8.7V21H3.5a.5.5 0 0 1-.5-.5Z"/><path d="M9.2 21v-6.2h5.6V21"/></svg><span>Dashboard</span></a></li><% } %>
        <% if (canAccess('requirements.view')) { %><li class="nav-item"><a href="/enquiries" title="Requirements" class="nav-link" :class="{active:pathIs('/enquiries') || pathIs('/requirements')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><span>Requirements</span></a></li><% } %>
        <% if (canAccess('providers.view')) { %><li class="nav-item"><a href="/providers" title="Providers" class="nav-link" :class="{active:pathIs('/providers')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M13 20a4.5 4.5 0 0 1 8 0"/></svg><span>Providers</span></a></li><% } %>
        <% if (canAccess('provider_requests.view')) { %><li class="nav-item"><a href="/provider-requests" title="Provider requests" class="nav-link" :class="{active:pathIs('/provider-requests')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/><path d="M16 3v3M8 3v3"/></svg><span>Provider requests</span></a></li><% } %>
        <% if (canAccess('agents.view')) { %><li class="nav-item"><a href="/agents" title="Agents" class="nav-link" :class="{active:pathIs('/agents')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M3 20a5 5 0 0 1 10 0M16 7h5M18.5 4.5v5"/><path d="M15 20a4 4 0 0 1 6 0"/></svg><span>Agents</span></a></li><% } %>
        <% if (canAccess('partnerPayouts.view')) { %><li class="nav-item"><a href="/partner-withdrawals" title="Partner withdrawals" class="nav-link" :class="{active:pathIs('/partner-withdrawals')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v11H4z"/><path d="M4 10h16M8 15h4M16 14.5h.01"/></svg><span>Partner payouts</span></a></li><% } %>
        <% if (canAccess('categories.view')) { %>
          <li class="nav-item nav-item-submenu crm-sidebar-group" :class="{'nav-item-expanded': catalogMenuOpen || pathIs('/categories') || pathIs('/service-types')}">
            <button type="button" class="nav-link crm-sidebar-group-toggle" :class="{active:pathIs('/categories') || pathIs('/service-types')}" @click="catalogMenuOpen = !catalogMenuOpen" :aria-expanded="(catalogMenuOpen || pathIs('/categories') || pathIs('/service-types')).toString()" aria-controls="catalogSubmenu" title="Catalog">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H12l2 2h3.5A2.5 2.5 0 0 1 20 8.5v8A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5Z"/><path d="M8 11h8M8 15h5"/></svg><span>Catalog</span>
            </button>
            <ul id="catalogSubmenu" class="nav nav-group-sub crm-sidebar-submenu" x-show="catalogMenuOpen || pathIs('/categories') || pathIs('/service-types')" x-cloak>
              <li class="nav-item"><a href="/categories" class="nav-link" :class="{active:pathIs('/categories')}" :aria-current="pathIs('/categories') ? 'page' : null" @click="sidebarOpen=false"><span>Manage categories</span></a></li>
              <li class="nav-item"><a href="/service-types" class="nav-link" :class="{active:pathIs('/service-types')}" :aria-current="pathIs('/service-types') ? 'page' : null" @click="sidebarOpen=false"><span>Manage subcategories</span></a></li>
            </ul>
          </li>
        <% } %>
        <% if (canAccess('provider_unlocks.view')) { %><li class="nav-item"><a href="/provider-unlocks" title="Provider unlocks" class="nav-link" :class="{active:pathIs('/provider-unlocks')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span>Provider unlocks</span></a></li><% } %>

        <% if (showOperations) { %><li class="nav-item-header"><span>Operations</span></li><% } %>
        <% if (canAccess('followUps.view')) { %><li class="nav-item"><a href="/follow-ups" title="Follow-ups" class="nav-link" :class="{active:pathIs('/follow-ups')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2M4.5 5.5 3 8"/></svg><span>Follow-ups</span></a></li><% } %>
        <% if (showCommunications) { %>
          <li class="nav-item nav-item-submenu crm-sidebar-group" :class="{'nav-item-expanded': communicationMenuOpen || pathIs('/communications')}">
            <button type="button" class="nav-link crm-sidebar-group-toggle" :class="{active:pathIs('/communications')}" @click="communicationMenuOpen = !communicationMenuOpen" :aria-expanded="(communicationMenuOpen || pathIs('/communications')).toString()" aria-controls="communicationCenterSubmenu" title="Communication Center">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v12H8l-4 4Z"/><path d="M8 9h8M8 13h5"/></svg><span>Communication Center</span>
            </button>
            <ul id="communicationCenterSubmenu" class="nav nav-group-sub crm-sidebar-submenu" x-show="communicationMenuOpen || pathIs('/communications')" x-cloak>
              <% if (canAccess('communications.view')) { %><li class="nav-item"><a href="/communications/whatsapp" class="nav-link" :class="{active:pathIs('/communications/whatsapp')}" @click="sidebarOpen=false"><span>WhatsApp</span></a></li><% } %>
              <% if (canAccess('communications.view')) { %><li class="nav-item"><a href="/communications/email" class="nav-link" :class="{active:pathIs('/communications/email')}" @click="sidebarOpen=false"><span>Email</span></a></li><% } %>
              <% if (canAccess('communications.view')) { %><li class="nav-item"><a href="/communications/otp" class="nav-link" :class="{active:pathIs('/communications/otp')}" @click="sidebarOpen=false"><span>OTP activity</span></a></li><% } %>
            </ul>
          </li>
        <% } %>
        <% if (canAccess('communications.view')) { %><li class="nav-item"><a href="/whatsapp-inbox" target="_blank" rel="noopener" title="Open WhatsApp Inbox in a new tab" class="nav-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v12H8l-4 4Z"/><path d="M8 9h8M8 13h5"/></svg><span>WhatsApp Inbox</span><span class="crm-sidebar-external" aria-hidden="true">↗</span></a></li><% } %>

        <% if (canAccess('billing.view')) { %><li class="nav-item"><a href="/billing" title="Billing" class="nav-link" :class="{active:location.pathname==='/billing' || pathIs('/billing/new')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h4"/></svg><span>Billing</span></a></li><li class="nav-item"><a href="/billing/provider-subscriptions" title="Provider subscriptions" class="nav-link" :class="{active:pathIs('/billing/provider-subscriptions')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 9h16M8 14h4"/></svg><span>Provider subscriptions</span></a></li><% } %>
        <% if (canAccess('reports.view')) { %><li class="nav-item"><a href="/reports" title="Reports" class="nav-link" :class="{active:pathIs('/reports')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V10M12 20V4M19 20v-7"/><path d="M3 20h18"/></svg><span>Reports</span></a></li><% } %>

        <% if (showAdministration) { %><li class="nav-item-header"><span>Administration</span></li><% } %>
        <% if (canAccess('storage.view')) { %><li class="nav-item"><a href="/storage" title="File Manager" class="nav-link" :class="{active:pathIs('/storage')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H12l2 2h3.5A2.5 2.5 0 0 1 20 8.5v8A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5Z"/><path d="M8 11h8M8 15h5"/></svg><span>File Manager</span></a></li><% } %>
        <% if (canAccess('employees.view')) { %><li class="nav-item"><a href="/employees" title="Employees" class="nav-link" :class="{active:pathIs('/employees')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M14 20a4 4 0 0 1 7 0"/></svg><span>Employees</span></a></li><% } %>
        <% if (canAccess('roles.view')) { %><li class="nav-item"><a href="/roles" title="Roles and permissions" class="nav-link" :class="{active:pathIs('/roles')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 2.8 8 7 10 4.2-2 7-5.4 7-10V6Z"/><path d="m9 12 2 2 4-5"/></svg><span>Roles &amp; permissions</span></a></li><% } %>

        <li class="nav-item-header"><span>Help &amp; Training</span></li>
        <li class="nav-item"><a href="/employee-guide" title="Employee Guide" class="nav-link" :class="{active:pathIs('/employee-guide')}" @click="sidebarOpen=false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H20v17H7.5A2.5 2.5 0 0 0 5 21.5Z"/><path d="M5 4.5v17M9 7h7M9 11h7M9 15h4"/></svg><span>Employee Guide</span></a></li>
      </ul>
    </div>

    <div class="crm-sidebar-foot"><a href="/employee-guide" class="crm-sidebar-support text-decoration-none" @click="sidebarOpen=false"><span class="crm-sidebar-support-icon">?</span><div><strong>Need help?</strong><small>Open employee guide</small></div></a></div>
  </div>
</div>
<div class="crm-sidebar-overlay" x-show="sidebarOpen" x-cloak x-transition.opacity @click="sidebarOpen=false" aria-hidden="true"></div>
