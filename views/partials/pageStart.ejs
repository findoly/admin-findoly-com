<%- include('head') %>
<%- include('topbar') %>

<!-- Page content -->
<div class="page-content">
  <%- include('sidebar') %>

  <!-- Main content -->
  <div class="content-wrapper">
    <div class="content-inner">
      <!-- Page header -->
      <div class="page-header page-header-light crm-page-header">
        <div class="page-header-content d-lg-flex crm-page-heading">
          <div class="d-flex">
            <h3 class="page-title mb-0">
              <%= title || branding.appName %> <span class="fw-normal"><%= typeof subtitle !== 'undefined' && subtitle ? '- ' + subtitle : '' %></span>
            </h3>
            <a href="#page_header" class="btn btn-light align-self-center collapsed d-lg-none border-transparent rounded-pill p-0 ms-auto" data-bs-toggle="collapse">
              <svg class="crm-svg-icon collapsible-indicator m-1" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </a>
          </div>
          <div class="collapse d-lg-block my-lg-auto ms-lg-auto" id="page_header">
            <div class="d-sm-flex align-items-center mb-3 mb-lg-0 ms-lg-3">
              <div class="d-inline-flex mt-3 mt-sm-0 gap-2 flex-wrap">
                <% if (!currentPath.startsWith('/enquiries/new')) { %><a href="/enquiries/new" class="btn btn-primary btn-sm"><i class="ph-plus me-2"></i>Create lead</a><% } %>
                <% if (!currentPath.startsWith('/search')) { %><a href="/search/enquiries" class="btn btn-light btn-sm"><i class="ph-magnifying-glass me-2"></i>Search</a><% } %>
              </div>
            </div>
          </div>
        </div>

      </div>
      <!-- /page header -->

      <!-- Content area -->
      <div class="content">
        <% if (flash) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flash %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>
