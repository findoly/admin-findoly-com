<%- include('head') %>
<body x-data="crmShell()" x-init="init()">
<div class="navbar navbar-expand-lg navbar-static shadow crm-topbar">
  <div class="container-fluid">
    <div class="d-flex d-lg-none me-2"><button class="navbar-toggler sidebar-mobile-main-toggle" type="button"><i class="ph-list"></i></button></div>
    <div class="navbar-brand flex-1 flex-lg-0"><a href="/dashboard" class="d-inline-flex align-items-center text-decoration-none"><span class="crm-brand-mark">C</span><span class="fw-semibold ms-2"><%= appName %></span></a></div>
    <ul class="nav flex-row justify-content-end order-1 order-lg-2">
      <li class="nav-item"><button type="button" class="navbar-nav-link navbar-nav-link-icon rounded" data-crm-appearance-open aria-label="Appearance"><i class="ph-palette"></i></button></li>
      <li class="nav-item dropdown">
        <button type="button" class="navbar-nav-link dropdown-toggle d-flex align-items-center rounded" data-bs-toggle="dropdown"><span class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-2" style="width:30px;height:30px">A</span><span x-text="admin.name || 'Admin'">Admin</span></button>
        <div class="dropdown-menu dropdown-menu-end"><span class="dropdown-item-text text-muted" x-text="admin.email"></span><button class="dropdown-item text-danger" @click="logout()">Sign out</button></div>
      </li>
    </ul>
  </div>
</div>
<div class="page-content">
  <div class="sidebar sidebar-main sidebar-expand-lg crm-sidebar">
    <div class="sidebar-content"><div class="sidebar-section"><ul class="nav nav-sidebar" data-nav-type="accordion">
      <li class="nav-item-header pt-0"><div class="text-uppercase fs-sm opacity-50">Workspace</div></li>
      <li class="nav-item"><a href="/dashboard" class="nav-link <%= currentPath.startsWith('/dashboard') ? 'active' : '' %>"><i class="ph-house"></i><span>Dashboard</span></a></li>
      <li class="nav-item"><a href="/enquiries" class="nav-link <%= currentPath.startsWith('/enquiries') || currentPath.startsWith('/requirements') ? 'active' : '' %>"><i class="ph-list-checks"></i><span>Requirements</span></a></li>
      <li class="nav-item"><a href="/providers" class="nav-link <%= currentPath.startsWith('/providers') ? 'active' : '' %>"><i class="ph-users-three"></i><span>Providers</span></a></li>
      <li class="nav-item"><a href="/distributions" class="nav-link <%= currentPath.startsWith('/distributions') ? 'active' : '' %>"><i class="ph-share-network"></i><span>Distribution</span></a></li>
      <li class="nav-item-header"><div class="text-uppercase fs-sm opacity-50">Operations</div></li>
      <li class="nav-item"><a href="/follow-ups" class="nav-link <%= currentPath.startsWith('/follow-ups') ? 'active' : '' %>"><i class="ph-clock-counter-clockwise"></i><span>Follow-ups</span></a></li>
      <li class="nav-item"><a href="/communications" class="nav-link <%= currentPath.startsWith('/communications') ? 'active' : '' %>"><i class="ph-chats"></i><span>Communications</span></a></li>
      <li class="nav-item"><a href="/billing" class="nav-link <%= currentPath.startsWith('/billing') ? 'active' : '' %>"><i class="ph-currency-inr"></i><span>Billing</span></a></li>
      <li class="nav-item"><a href="/reports" class="nav-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>"><i class="ph-chart-bar"></i><span>Reports</span></a></li>
    </ul></div></div>
  </div>
  <div class="content-wrapper"><div class="content-inner">
    <div class="page-header page-header-light crm-page-header"><div class="page-header-content d-flex align-items-center crm-page-heading"><div class="flex-grow-1"><h3 class="page-title mb-0"><%= title %></h3></div><div class="d-flex gap-2"><% if (!currentPath.includes('/new')) { %><a href="/enquiries/new" class="btn btn-primary btn-sm"><i class="ph-plus me-1"></i>Create lead</a><% } %></div></div></div>
    <div class="content">
      <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
