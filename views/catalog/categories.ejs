<%- include('../partials/pageStart', { subtitle: 'Website module builder' }) %>

<div class="row">
  <div class="col-xl-8">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Create category with dynamic form</h5>
        <div class="text-muted fs-sm mt-1">Define exactly what each website form should collect. Mapping key: sourceWebsite + categorySlug + formType.</div>
      </div>
      <div class="card-body border-top">
        <div class="alert alert-info"><strong>Example:</strong> <code>woodoly.com</code> + <code>furniture-repair</code> + <code>wardrobe-repair</code>.</div>
        <form method="post" action="/catalog/categories" data-field-builder>
          <fieldset class="mb-3">
            <legend class="fs-base fw-bold border-bottom pb-2 mb-3">Website category</legend>
            <div class="row mb-3">
              <label class="col-lg-3 col-form-label">Source website <span class="text-danger">*</span></label>
              <div class="col-lg-9"><input class="form-control" name="sourceWebsite" list="source-websites" placeholder="woodoly.com" required><datalist id="source-websites"><% sourceWebsites.forEach((site) => { %><option value="<%= site %>"><% }) %></datalist></div>
            </div>
            <div class="row mb-3">
              <label class="col-lg-3 col-form-label">Category name <span class="text-danger">*</span></label>
              <div class="col-lg-9"><input class="form-control" name="name" placeholder="Furniture repair" required data-autoslug-source="#categorySlug"></div>
            </div>
            <div class="row mb-3">
              <label class="col-lg-3 col-form-label">Category slug</label>
              <div class="col-lg-4"><input class="form-control" id="categorySlug" name="slug" placeholder="furniture-repair"></div>
              <label class="col-lg-2 col-form-label text-lg-end">Form type</label>
              <div class="col-lg-3"><input class="form-control" name="formType" placeholder="wardrobe-repair" value="default"></div>
            </div>
            <div class="row mb-3">
              <label class="col-lg-3 col-form-label">Description</label>
              <div class="col-lg-9"><textarea class="form-control" name="description" rows="3" placeholder="What kind of enquiries this module handles"></textarea></div>
            </div>
            <div class="row mb-3">
              <label class="col-lg-3 col-form-label">Template name</label>
              <div class="col-lg-9"><input class="form-control" name="templateName" placeholder="Woodoly wardrobe repair enquiry form"></div>
            </div>
          </fieldset>

          <fieldset class="mb-3">
            <legend class="fs-base fw-bold border-bottom pb-2 mb-3 d-flex align-items-center">
              <span>Form builder</span>
              <button class="btn btn-light btn-sm ms-auto" type="button" data-add-field><i class="ph-plus me-1"></i>Add field</button>
            </legend>
            <p class="text-muted">These fields are saved as the intake schema. External websites can call the Form Schema API to know what to render and submit.</p>
            <div data-builder-rows></div>
            <input type="hidden" name="fields" data-fields-json>
          </fieldset>

          <div class="accordion mb-3" id="schema_preview_accordion">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#schema_preview">Preview schema payload</button></h2>
              <div id="schema_preview" class="accordion-collapse collapse" data-bs-parent="#schema_preview_accordion"><div class="accordion-body"><pre class="schema-preview" data-schema-preview>{}</pre></div></div>
            </div>
          </div>

          <div class="text-end"><button class="btn btn-primary" type="submit">Create category and form <i class="ph-paper-plane-tilt ms-2"></i></button></div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-xl-4">
    <div class="card">
      <div class="card-header d-flex align-items-center"><h5 class="mb-0">Configured modules</h5><a class="btn btn-light btn-sm ms-auto" href="/catalog/templates">Templates</a></div>
      <div class="card-body p-0">
        <div class="list-group list-group-flush">
          <% categories.forEach((category) => { const moduleTemplates = templates.filter((tpl) => tpl.sourceWebsite === category.sourceWebsite && tpl.categorySlug === category.slug && (tpl.formType || 'default') === (category.formType || 'default')); const schemaUrl = `/api/forms/schema?sourceWebsite=${encodeURIComponent(category.sourceWebsite || 'any')}&categorySlug=${encodeURIComponent(category.slug)}&formType=${encodeURIComponent(category.formType || 'default')}`; %>
            <div class="list-group-item">
              <div class="d-flex align-items-start">
                <div class="flex-fill">
                  <div class="fw-semibold"><%= category.name %></div>
                  <div class="text-muted fs-sm"><%= category.sourceWebsite || 'any' %> · <%= category.slug %> · <%= category.formType || 'default' %></div>
                  <div class="mt-2"><span class="badge bg-primary rounded-pill"><%= moduleTemplates.length %> template<%= moduleTemplates.length === 1 ? '' : 's' %></span></div>
                  <a class="d-inline-block mt-2" href="<%= schemaUrl %>" target="_blank">Open schema API</a>
                </div>
                <%- include('../partials/statusBadge', { value: category.active ? 'active' : 'inactive', humanize }) %>
              </div>
            </div>
          <% }) %>
          <% if (!categories.length) { %><div class="list-group-item text-muted">No service modules yet.</div><% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="application/json" id="field-types-json"><%- JSON.stringify(fieldTypes) %></script>
<%- include('../partials/pageEnd') %>
