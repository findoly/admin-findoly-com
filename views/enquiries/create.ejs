<%- include('../partials/pageStart', { subtitle: 'Lead intake' }) %>

<div class="card crm-lead-wizard-card crm-workspace-card">
  <div class="card-header d-sm-flex align-items-sm-center">
    <div>
      <h5 class="mb-0">Lead information</h5>
      <div class="text-muted fs-sm mt-1">Complete the lead in three short steps. Required fields are marked clearly.</div>
    </div>
    <div class="ms-sm-auto mt-2 mt-sm-0"><a href="/enquiries" class="btn btn-light"><i class="ph-arrow-left me-2"></i>Back to leads</a></div>
  </div>

  <form method="post" action="/enquiries" data-lead-create-wizard novalidate>
    <div class="card-body border-top py-3 crm-wizard-header">
      <ul class="nav nav-pills crm-wizard-nav" role="tablist">
        <li class="nav-item"><button class="nav-link active" type="button" data-wizard-step-button="0"><span>1</span>Customer details</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-wizard-step-button="1"><span>2</span>Additional details</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-wizard-step-button="2"><span>3</span>Lead source</button></li>
      </ul>
    </div>

    <div class="card-body border-top crm-wizard-step active" data-wizard-step="0">
      <div class="crm-wizard-heading">
        <h6>Customer and requirement</h6>
        <p>These are the fixed fields used for every lead, regardless of category.</p>
      </div>

      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Customer name <span class="text-danger">*</span></label>
        <div class="col-lg-9"><input class="form-control" name="customerName" placeholder="Customer full name" required></div>
      </div>
      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Mobile / email <span class="text-danger">*</span></label>
        <div class="col-lg-4"><input class="form-control" name="mobile" inputmode="tel" placeholder="Mobile number" required></div>
        <div class="col-lg-5"><input class="form-control" type="email" name="email" placeholder="Email address"></div>
      </div>
      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Address</label>
        <div class="col-lg-9"><input class="form-control" name="addressLine1" placeholder="House, street, locality"></div>
      </div>
      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">City / state / pincode</label>
        <div class="col-lg-4"><input class="form-control" name="city" placeholder="City"></div>
        <div class="col-lg-3"><input class="form-control" name="state" placeholder="State"></div>
        <div class="col-lg-2"><input class="form-control" name="pincode" placeholder="Pincode"></div>
      </div>
      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Category <span class="text-danger">*</span></label>
        <div class="col-lg-9">
          <select class="form-select" name="categorySlug" required data-lead-category>
            <option value="">Select category</option>
            <% categories.forEach((category) => { %>
              <option value="<%= category.slug %>" data-source="<%= category.sourceWebsite || 'any' %>" data-form-type="<%= category.formType || 'default' %>"><%= category.name %></option>
            <% }) %>
          </select>
          <div class="form-text">Category connects the lead to the correct internal workflow.</div>
        </div>
      </div>
      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Requirement title <span class="text-danger">*</span></label>
        <div class="col-lg-6"><input class="form-control" name="serviceType" placeholder="Example: Wardrobe repair required" required></div>
        <div class="col-lg-3"><select class="form-select" name="priority"><% priorities.forEach((priority)=>{ %><option value="<%= priority %>"><%= humanize(priority) %></option><% }) %></select></div>
      </div>
      <div class="row mb-0">
        <label class="col-lg-3 col-form-label">Preferred date / time</label>
        <div class="col-lg-4"><input class="form-control" type="date" name="preferredDate"></div>
        <div class="col-lg-5"><input class="form-control" name="preferredSlot" placeholder="Morning, afternoon, after 6 PM"></div>
      </div>
    </div>

    <div class="card-body border-top crm-wizard-step" data-wizard-step="1">
      <div class="crm-wizard-heading">
        <h6>Additional details</h6>
        <p>Configured category fields appear as simple text fields. You can also add any extra name/value information supplied by the customer.</p>
      </div>

      <input type="hidden" name="formType" value="default" data-lead-form-type>
      <input type="hidden" name="templateId" value="" data-lead-template-id>
      <input type="hidden" name="dynamicFieldKeys" value="" data-dynamic-field-keys>
      <input type="hidden" name="additionalDetailsJson" value="{}" data-extra-details-json>

      <div class="alert alert-light border crm-schema-summary" data-schema-summary>Select a category in step 1 to load its known fields.</div>
      <div data-schema-fields></div>

      <div class="border-top pt-4 mt-4">
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Any other details?</label>
          <div class="col-lg-9">
            <div class="form-check-horizontal">
              <label class="form-check form-check-inline"><input class="form-check-input" type="radio" name="hasExtraDetails" value="no" checked data-extra-details-choice><span class="form-check-label">No</span></label>
              <label class="form-check form-check-inline"><input class="form-check-input" type="radio" name="hasExtraDetails" value="yes" data-extra-details-choice><span class="form-check-label">Yes, add fields</span></label>
            </div>
            <div class="form-text">Use this only for details that are not already shown above.</div>
          </div>
        </div>

        <div class="crm-extra-details d-none" data-extra-details-section>
          <div data-extra-detail-rows></div>
          <div class="text-end"><button class="btn btn-light btn-sm" type="button" data-add-extra-detail><i class="ph-plus me-2"></i>Add detail</button></div>
        </div>
      </div>
    </div>

    <div class="card-body border-top crm-wizard-step" data-wizard-step="2">
      <div class="crm-wizard-heading">
        <h6>Lead source</h6>
        <p>Record where the lead came from. This stays separate from customer and requirement information.</p>
      </div>

      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Source type <span class="text-danger">*</span></label>
        <div class="col-lg-9">
          <select class="form-select" name="sourceType" required>
            <option value="customer_website">Customer website</option>
            <option value="agent">Agent</option>
            <option value="phone_call">Phone call</option>
            <option value="whatsapp">WhatsApp</option>
            <option value="manual_admin" selected>Internal/manual</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>
      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Website / source name <span class="text-danger">*</span></label>
        <div class="col-lg-5"><input class="form-control" name="sourceWebsite" value="manual-admin" list="source-websites" placeholder="website.com or manual-admin" required data-lead-source><datalist id="source-websites"><% sourceWebsites.forEach((site) => { %><option value="<%= site %>"><% }) %></datalist></div>
        <div class="col-lg-4"><input class="form-control" name="sourceName" placeholder="Agent name, partner, campaign owner"></div>
      </div>
      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Channel / campaign</label>
        <div class="col-lg-4"><input class="form-control" name="sourceChannel" placeholder="website, agent, call, WhatsApp"></div>
        <div class="col-lg-5"><input class="form-control" name="campaign" placeholder="Campaign or referral name"></div>
      </div>
      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Tracking</label>
        <div class="col-lg-4"><input class="form-control" name="formId" placeholder="Form ID"></div>
        <div class="col-lg-5"><input class="form-control" name="externalEnquiryId" placeholder="External lead ID"></div>
      </div>
      <div class="row mb-3">
        <label class="col-lg-3 col-form-label">Landing page</label>
        <div class="col-lg-9"><input class="form-control" type="url" name="landingPage" placeholder="https://example.com/service-page"></div>
      </div>
      <div class="row mb-0">
        <label class="col-lg-3 col-form-label">Internal note</label>
        <div class="col-lg-9"><textarea class="form-control" name="notes" rows="4" placeholder="Initial call summary or internal context"></textarea></div>
      </div>
    </div>

    <div class="card-footer d-flex align-items-center border-top">
      <button class="btn btn-light d-none" type="button" data-wizard-prev><i class="ph-arrow-left me-2"></i>Back</button>
      <div class="ms-auto d-flex gap-2">
        <a href="/enquiries" class="btn btn-light">Cancel</a>
        <button class="btn btn-primary" type="button" data-wizard-next>Continue <i class="ph-arrow-right ms-2"></i></button>
        <button class="btn btn-primary d-none" type="submit" data-wizard-submit>Create lead <i class="ph-check ms-2"></i></button>
      </div>
    </div>
  </form>
</div>

<script type="application/json" id="templates-json"><%- JSON.stringify(templates) %></script>
<%- include('../partials/pageEnd') %>
