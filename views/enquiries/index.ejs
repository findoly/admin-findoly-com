<%- include('../partials/pageStart', { subtitle: queueDefinition ? queueDefinition.description : 'Requirement list' }) %>

<% const currentQueue = queueDefinition || null; %>
<% const queueCounts = (typeof navCounts !== 'undefined' && navCounts.queues) ? navCounts.queues : {}; %>
<% const basePath = currentQueue ? '/enquiries/queue/' + currentQueue.key : '/enquiries'; %>

<div class="card crm-list-page">
  <div class="card-header d-lg-flex align-items-lg-center py-lg-0">
    <div class="py-lg-2 my-lg-1">
      <h5 class="mb-0"><%= currentQueue ? currentQueue.label : 'All requirements' %></h5>
      <div class="text-muted fs-sm"><%= currentQueue ? currentQueue.description : 'Search, filter and open requirement records. Queue summary cards stay on Dashboard only.' %></div>
    </div>
    <div class="mt-2 mt-lg-0 ms-lg-auto d-flex gap-2 flex-wrap align-items-center">
      <span class="badge bg-light text-body border rounded-pill"><%= pagination.total || 0 %> records</span>
      <% if (currentQueue) { %><a class="btn btn-light btn-sm" href="/enquiries"><i class="ph-list me-2"></i>All requirements</a><% } %>
      <a class="btn btn-light btn-sm" href="/search/enquiries"><i class="ph-magnifying-glass me-2"></i>Advanced search</a>
      <a class="btn btn-primary btn-sm" href="/enquiries/new"><i class="ph-plus me-2"></i>Create lead</a>
    </div>
  </div>

  <div class="crm-queue-strip border-top px-3 py-2">
    <div class="d-flex gap-2 flex-wrap align-items-center">
      <span class="text-muted fs-sm me-1">Queues:</span>
      <% enquiryQueues.forEach((queue) => { %>
        <a href="/enquiries/queue/<%= queue.key %>" class="btn btn-sm <%= currentQueue && currentQueue.key === queue.key ? 'btn-primary' : 'btn-light' %>">
          <%= queue.shortLabel %>
          <span class="badge <%= currentQueue && currentQueue.key === queue.key ? 'bg-white text-primary' : 'bg-secondary bg-opacity-10 text-secondary' %> ms-1"><%= queueCounts[queue.key] || 0 %></span>
        </a>
      <% }) %>
    </div>
  </div>

  <div class="card-body border-top">
    <form class="row g-3 align-items-end" method="get">
      <div class="col-xxl-3 col-lg-4">
        <label class="form-label">Search</label>
        <div class="form-control-feedback form-control-feedback-start">
          <input class="form-control" name="search" placeholder="Customer, phone, city, source..." value="<%= filters.search || filters.q || '' %>">
          <div class="form-control-feedback-icon"><i class="ph-magnifying-glass"></i></div>
        </div>
      </div>
      <div class="col-xxl-2 col-lg-3 col-sm-6">
        <label class="form-label">Website</label>
        <select class="form-select" name="sourceWebsite">
          <option value="">All websites</option>
          <% sourceWebsites.forEach((site)=>{ %><option value="<%= site %>" <%= filters.sourceWebsite === site ? 'selected' : '' %>><%= site %></option><% }) %>
        </select>
      </div>
      <% if (!currentQueue) { %>
      <div class="col-xxl-2 col-lg-3 col-sm-6">
        <label class="form-label">Status</label>
        <select class="form-select" name="status">
          <option value="">All statuses</option>
          <% statuses.forEach((s)=>{ %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= humanize(s) %></option><% }) %>
        </select>
      </div>
      <% } %>
      <div class="col-xxl-2 col-lg-3 col-sm-6">
        <label class="form-label">Category</label>
        <select class="form-select" name="categorySlug">
          <option value="">All categories</option>
          <% categories.forEach((c)=>{ %><option value="<%= c.slug %>" <%= filters.categorySlug === c.slug ? 'selected' : '' %>><%= c.name %> — <%= c.sourceWebsite || 'any' %></option><% }) %>
        </select>
      </div>
      <div class="col-xxl-1 col-lg-2 col-sm-6"><label class="form-label">From</label><input type="date" class="form-control" name="dateFrom" value="<%= filters.dateFrom || '' %>"></div>
      <div class="col-xxl-1 col-lg-2 col-sm-6"><label class="form-label">To</label><input type="date" class="form-control" name="dateTo" value="<%= filters.dateTo || '' %>"></div>
      <div class="col-xxl-1 col-lg-2 col-sm-6"><label class="form-label">Per page</label><select class="form-select" name="pageSize"><% [10,25,50,100].forEach((size)=>{ %><option value="<%= size %>" <%= String(filters.pageSize || 25) === String(size) ? 'selected' : '' %>><%= size %></option><% }) %></select></div>
      <div class="col-lg-2 col-sm-6 d-flex gap-2"><button class="btn btn-primary flex-fill" type="submit">Filter</button><a class="btn btn-light" href="<%= basePath %>">Clear</a></div>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table table-hover text-nowrap mb-0 crm-action-table">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Requirement</th>
          <th>Website / form</th>
          <th>Priority</th>
          <th>Status</th>
          <th>Location</th>
          <th>Created</th>
          <th class="text-center" style="width:150px">Action</th>
        </tr>
      </thead>
      <tbody>
      <% enquiries.forEach((enquiry) => { %>
        <tr>
          <td><div class="fw-semibold"><%= enquiry.customer.name || '-' %></div><div class="text-muted fs-sm"><%= enquiry.customer.mobile %> <%= enquiry.customer.email || '' %></div></td>
          <td><div><%= enquiry.serviceType %></div><div class="text-muted fs-sm"><%= humanize(enquiry.categorySlug) %></div></td>
          <td><div><%= enquiry.sourceWebsite %></div><div class="text-muted fs-sm"><%= [enquiry.formType, enquiry.source?.channel, enquiry.source?.campaign || enquiry.source?.utm?.campaign].filter(Boolean).join(' · ') %></div></td>
          <td><%- include('../partials/statusBadge', { value: enquiry.priority, humanize }) %></td>
          <td><%- include('../partials/statusBadge', { value: enquiry.status, humanize }) %></td>
          <td><%= [enquiry.address?.city, enquiry.address?.state].filter(Boolean).join(', ') || '-' %><% if (enquiry.address?.pincode) { %><div class="text-muted fs-sm"><%= enquiry.address.pincode %></div><% } %></td>
          <td><%= formatDate(enquiry.createdAt) %></td>
          <td class="text-center"><div class="d-inline-flex gap-2"><a href="/enquiries/<%= enquiry.id %>" class="btn btn-outline-primary btn-sm"><i class="ph-eye me-1"></i>View</a><a href="/enquiries/<%= enquiry.id %>/edit" class="btn btn-light btn-sm"><i class="ph-pencil-simple me-1"></i>Edit</a></div></td>
        </tr>
      <% }) %>
      <% if (!enquiries.length) { %><tr><td colspan="8" class="text-muted text-center py-4"><%= currentQueue ? currentQueue.emptyMessage : 'No requirements found.' %></td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination }) %>
</div>

<%- include('../partials/pageEnd') %>
