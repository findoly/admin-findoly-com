<%- include('../partials/pageStart', { subtitle: 'Requirement verification and edit' }) %>

<div class="card">
  <div class="card-header d-sm-flex align-items-sm-center">
    <div>
      <h5 class="mb-0">Edit requirement</h5>
      <div class="text-muted fs-sm mt-1"><%= enquiry.id %> · update customer, source, requirement status and additional details.</div>
    </div>
    <div class="mt-2 mt-sm-0 ms-sm-auto">
      <a href="/enquiries/<%= enquiry.id %>" class="btn btn-light"><i class="ph-arrow-left me-2"></i>Back to requirement</a>
    </div>
  </div>

  <div class="card-body border-top">
    <form method="post" action="/enquiries/<%= enquiry.id %>">
      <input type="hidden" name="redirectTo" value="edit">
      <input type="hidden" name="dynamicFieldKeys" value="<%= fieldCompletion.editableFields.map((field) => field.name).join(',') %>">

      <fieldset class="mb-3">
        <legend class="fs-base fw-bold border-bottom pb-2 mb-3">Website and category mapping</legend>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Source website <span class="text-danger">*</span></label>
          <div class="col-lg-9">
            <input class="form-control" list="sourceWebsiteOptions" name="sourceWebsite" value="<%= enquiry.sourceWebsite || '' %>" required>
            <datalist id="sourceWebsiteOptions"><% sourceWebsites.forEach((site) => { %><option value="<%= site %>"><% }) %></datalist>
            <div class="form-text">Example: woodoly.com, vetskart.com, painting.example.com</div>
          </div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Category / form type</label>
          <div class="col-lg-5">
            <select class="form-select" name="categorySlug" required>
              <% categories.forEach((category) => { %>
                <option value="<%= category.slug %>" <%= enquiry.categorySlug === category.slug ? 'selected' : '' %>><%= category.name %> — <%= category.sourceWebsite || 'any' %> / <%= category.formType || 'default' %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-lg-4">
            <input class="form-control" name="formType" value="<%= enquiry.formType || 'default' %>" placeholder="wardrobe-repair">
          </div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Saved category schema</label>
          <div class="col-lg-9">
            <select class="form-select" name="templateId">
              <option value="">Auto match by website/category/form type</option>
              <% templates.forEach((tpl) => { %>
                <option value="<%= tpl.id %>" <%= enquiry.templateId === tpl.id ? 'selected' : '' %>><%= tpl.name %> — <%= tpl.sourceWebsite %> / <%= tpl.categorySlug %> / <%= tpl.formType %></option>
              <% }) %>
            </select>
            <div class="form-text">Changing this can change which additional details are expected in CRM.</div>
          </div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Channel / campaign</label>
          <div class="col-lg-4"><input class="form-control" name="sourceChannel" value="<%= enquiry.source?.channel || '' %>" placeholder="landing-page, api, call-center"></div>
          <div class="col-lg-5"><input class="form-control" name="campaign" value="<%= enquiry.source?.campaign || enquiry.source?.utm?.campaign || '' %>" placeholder="campaign name"></div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Form / external ID</label>
          <div class="col-lg-4"><input class="form-control" name="formId" value="<%= enquiry.source?.formId || '' %>" placeholder="website form ID"></div>
          <div class="col-lg-5"><input class="form-control" name="externalEnquiryId" value="<%= enquiry.source?.externalEnquiryId || '' %>" placeholder="external lead/requirement ID"></div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Landing / referrer</label>
          <div class="col-lg-4"><input class="form-control" type="url" name="landingPage" value="<%= enquiry.source?.landingPage || '' %>" placeholder="https://"></div>
          <div class="col-lg-5"><input class="form-control" type="url" name="referrer" value="<%= enquiry.source?.referrer || '' %>" placeholder="https://"></div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">UTM</label>
          <div class="col-lg-3"><input class="form-control" name="utm_source" value="<%= enquiry.source?.utm?.source || '' %>" placeholder="source"></div>
          <div class="col-lg-3"><input class="form-control" name="utm_medium" value="<%= enquiry.source?.utm?.medium || '' %>" placeholder="medium"></div>
          <div class="col-lg-3"><input class="form-control" name="utm_campaign" value="<%= enquiry.source?.utm?.campaign || '' %>" placeholder="campaign"></div>
        </div>
      </fieldset>

      <fieldset class="mb-3">
        <legend class="fs-base fw-bold border-bottom pb-2 mb-3">Fixed requirement fields</legend>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Customer</label>
          <div class="col-lg-3"><input class="form-control" name="customerName" value="<%= enquiry.customer?.name || '' %>" placeholder="Name"></div>
          <div class="col-lg-3"><input class="form-control" name="mobile" value="<%= enquiry.customer?.mobile || '' %>" required placeholder="Mobile"></div>
          <div class="col-lg-3"><input class="form-control" type="email" name="email" value="<%= enquiry.customer?.email || '' %>" placeholder="Email"></div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Service type</label>
          <div class="col-lg-9"><input class="form-control" name="serviceType" value="<%= enquiry.serviceType || '' %>" required></div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Address</label>
          <div class="col-lg-9"><input class="form-control mb-2" name="addressLine1" value="<%= enquiry.address?.line1 || '' %>" placeholder="Address line"></div>
          <label class="col-lg-3 col-form-label d-none d-lg-block"></label>
          <div class="col-lg-3"><input class="form-control" name="city" value="<%= enquiry.address?.city || '' %>" placeholder="City"></div>
          <div class="col-lg-3"><input class="form-control" name="state" value="<%= enquiry.address?.state || '' %>" placeholder="State"></div>
          <div class="col-lg-3"><input class="form-control" name="pincode" value="<%= enquiry.address?.pincode || '' %>" placeholder="Pincode"></div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Preferred date / slot</label>
          <div class="col-lg-4"><input class="form-control" type="date" name="preferredDate" value="<%= dateOnly(enquiry.preferredDate) %>"></div>
          <div class="col-lg-5"><input class="form-control" name="preferredSlot" value="<%= enquiry.preferredSlot || '' %>" placeholder="10 AM - 1 PM"></div>
        </div>
      </fieldset>

      <fieldset class="mb-3">
        <legend class="fs-base fw-bold border-bottom pb-2 mb-3">Status and internal tracking</legend>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Status / priority</label>
          <div class="col-lg-4"><select class="form-select" name="status"><% statuses.forEach((s)=>{ %><option value="<%= s %>" <%= enquiry.status === s ? 'selected' : '' %>><%= humanize(s) %></option><% }) %></select></div>
          <div class="col-lg-5"><select class="form-select" name="priority"><% priorities.forEach((p)=>{ %><option value="<%= p %>" <%= enquiry.priority === p ? 'selected' : '' %>><%= humanize(p) %></option><% }) %></select></div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Estimated / final value</label>
          <div class="col-lg-4"><input class="form-control" type="number" name="quotedAmount" value="<%= enquiry.quotedAmount || 0 %>"></div>
          <div class="col-lg-5"><input class="form-control" type="number" name="finalAmount" value="<%= enquiry.finalAmount || 0 %>"></div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Notes</label>
          <div class="col-lg-9"><textarea class="form-control" name="notes" rows="4"><%= enquiry.notes || '' %></textarea></div>
        </div>
      </fieldset>

      <fieldset class="mb-3">
        <legend class="fs-base fw-bold border-bottom pb-2 mb-3">Additional details <% if (template) { %><span class="fw-normal text-muted">— <%= template.name %></span><% } %></legend>
        <% if (fieldCompletion.missingRequired.length) { %>
          <div class="alert alert-warning">Missing required fields: <%= fieldCompletion.missingRequired.map((field) => field.label).join(', ') %></div>
        <% } %>
        <% if (fieldCompletion.editableFields.length) { %>
          <% fieldCompletion.editableFields.forEach((field) => { const details = enquiry.additionalDetails || enquiry.fields || {}; const value = details?.[field.name]; const valueText = fieldValue(details, field.name); %>
            <div class="row mb-3">
              <label class="col-lg-3 col-form-label"><%= field.label %><% if (field.required) { %> <span class="text-danger">*</span><% } %></label>
              <div class="col-lg-9">
                <% if (field.type === 'textarea') { %>
                  <textarea class="form-control" name="field__<%= field.name %>" rows="3" placeholder="<%= field.placeholder || '' %>"><%= valueText %></textarea>
                <% } else if (field.type === 'select') { %>
                  <select class="form-select" name="field__<%= field.name %>"><option value="">Select</option><% (field.options || []).forEach((option) => { %><option value="<%= option %>" <%= valueText === option ? 'selected' : '' %>><%= option %></option><% }) %></select>
                <% } else if (field.type === 'radio') { %>
                  <div class="form-check-horizontal"><% (field.options || []).forEach((option) => { %><label class="form-check form-check-inline"><input class="form-check-input" type="radio" name="field__<%= field.name %>" value="<%= option %>" <%= valueText === option ? 'checked' : '' %>><span class="form-check-label"><%= option %></span></label><% }) %></div>
                <% } else if (field.type === 'checkbox') { %>
                  <div class="form-check-horizontal"><% (field.options || []).forEach((option) => { const selected = Array.isArray(value) ? value.includes(option) : valueText.split(',').map((v)=>v.trim()).includes(option); %><label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="field__<%= field.name %>" value="<%= option %>" <%= selected ? 'checked' : '' %>><span class="form-check-label"><%= option %></span></label><% }) %></div>
                <% } else { %>
                  <input class="form-control" type="<%= field.type === 'file_url' ? 'url' : field.type %>" name="field__<%= field.name %>" value="<%= valueText %>" placeholder="<%= field.placeholder || (field.type === 'file_url' ? 'https://file-url.example.com/photo.jpg' : '') %>">
                <% } %>
                <% if (field.helpText) { %><div class="form-text"><%= field.helpText %></div><% } %>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="alert alert-info">No saved category schema fields are available. You can still save additional details below.</div>
        <% } %>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Raw additional details</label>
          <div class="col-lg-9">
            <textarea class="form-control font-monospace fs-sm" name="additionalDetailsJson" rows="6"><%= JSON.stringify(enquiry.additionalDetails || enquiry.fields || {}, null, 2) %></textarea>
            <div class="form-text">WordPress-style custom fields for this requirement. Dynamic field inputs above override matching keys.</div>
          </div>
        </div>
        <div class="row mb-3">
          <label class="col-lg-3 col-form-label">Internal metadata</label>
          <div class="col-lg-9">
            <textarea class="form-control font-monospace fs-sm" name="metadataJson" rows="4"><%= JSON.stringify(enquiry.metadata || {}, null, 2) %></textarea>
            <div class="form-text">Admin-only metadata/tracking. Kept separate from customer additional details.</div>
          </div>
        </div>
      </fieldset>

      <div class="text-end">
        <a href="/enquiries/<%= enquiry.id %>" class="btn btn-light">Cancel</a>
        <button class="btn btn-primary ms-2" type="submit">Save requirement <i class="ph-floppy-disk ms-2"></i></button>
      </div>
    </form>
  </div>
</div>


<%- include('../partials/pageEnd') %>
