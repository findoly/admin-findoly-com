<%- include('../partials/pageStart', { subtitle: enquiry.sourceWebsite + ' · ' + (enquiry.formType || 'default') }) %>

<div class="row">
  <div class="col-xl-7">
    <div class="card">
      <div class="card-header d-flex align-items-center">
        <div>
          <h5 class="mb-0"><%= enquiry.customer.name || 'Unnamed customer' %></h5>
          <div class="text-muted fs-sm"><%= enquiry.serviceType %> · <%= humanize(enquiry.categorySlug) %></div>
        </div>
        <div class="ms-auto d-inline-flex align-items-center gap-2"><a href="/enquiries/<%= enquiry.id %>/edit" class="btn btn-light btn-sm"><i class="ph-pencil-simple me-2"></i>Edit</a><%- include('../partials/statusBadge', { value: enquiry.status, humanize }) %></div>
      </div>
      <div class="card-body">
        <div class="row mb-3"><label class="col-lg-3 col-form-label text-muted">Template</label><div class="col-lg-9 pt-lg-2"><%= template ? template.name : 'No matching template' %></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label text-muted">Source</label><div class="col-lg-9 pt-lg-2"><%= enquiry.sourceWebsite %><% if (enquiry.source?.channel) { %> · <%= enquiry.source.channel %><% } %></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label text-muted">Campaign</label><div class="col-lg-9 pt-lg-2"><%= enquiry.source?.campaign || enquiry.source?.utm?.campaign || '-' %></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label text-muted">Form / external ID</label><div class="col-lg-9 pt-lg-2"><%= [enquiry.source?.formId, enquiry.source?.externalEnquiryId].filter(Boolean).join(' / ') || '-' %></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label text-muted">Landing/referrer</label><div class="col-lg-9 pt-lg-2 crm-break"><%= [enquiry.source?.landingPage, enquiry.source?.referrer].filter(Boolean).join(' ← ') || '-' %></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label text-muted">Contact</label><div class="col-lg-9 pt-lg-2"><%= enquiry.customer.mobile || '-' %> · <%= enquiry.customer.email || '-' %></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label text-muted">Address</label><div class="col-lg-9 pt-lg-2"><%= [enquiry.address.line1, enquiry.address.city, enquiry.address.state, enquiry.address.pincode].filter(Boolean).join(', ') || '-' %></div></div>
        <div class="row mb-3"><label class="col-lg-3 col-form-label text-muted">Assigned provider</label><div class="col-lg-9 pt-lg-2"><%= enquiry.assignedProviderName || 'Not assigned yet' %></div></div>
        <div class="row mb-0"><label class="col-lg-3 col-form-label text-muted">Quoted/final</label><div class="col-lg-9 pt-lg-2">₹<%= enquiry.quotedAmount || 0 %> / ₹<%= enquiry.finalAmount || 0 %></div></div>
      </div>
    </div>
  </div>
  <div class="col-xl-5">
    <div class="card">
      <div class="card-header d-flex align-items-center">
        <h5 class="mb-0">Dynamic data</h5>
        <span class="badge bg-primary rounded-pill ms-auto"><%= fieldCompletion.completionPercent %>% complete</span>
      </div>
      <div class="card-body">
        <% if (fieldCompletion.missingRequired.length) { %>
          <div class="alert alert-warning"><strong>Missing required fields:</strong> <%= fieldCompletion.missingRequired.map((field) => field.label).join(', ') %></div>
        <% } else { %>
          <div class="alert alert-success">All configured required fields are filled.</div>
        <% } %>
        <% if (Object.keys(enquiry.fields || {}).length) { %>
          <% Object.entries(enquiry.fields).forEach(([key, value]) => { %>
            <div class="row mb-2"><label class="col-sm-5 col-form-label text-muted"><%= humanize(key) %></label><div class="col-sm-7 pt-sm-2 crm-break"><%= Array.isArray(value) ? value.join(', ') : value %></div></div>
          <% }) %>
        <% } else { %>
          <div class="text-muted">No dynamic source fields have been captured yet.</div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-xl-6">
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Update enquiry</h5></div>
      <div class="card-body border-top">
        <form method="post" action="/enquiries/<%= enquiry.id %>">
          <div class="row mb-3"><label class="col-lg-4 col-form-label">Status</label><div class="col-lg-8"><select class="form-select" name="status"><% statuses.forEach((s)=>{ %><option value="<%= s %>" <%= enquiry.status === s ? 'selected' : '' %>><%= humanize(s) %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-4 col-form-label">Priority</label><div class="col-lg-8"><select class="form-select" name="priority"><% priorities.forEach((p)=>{ %><option value="<%= p %>" <%= enquiry.priority === p ? 'selected' : '' %>><%= humanize(p) %></option><% }) %></select></div></div>
          <div class="row mb-3"><label class="col-lg-4 col-form-label">Quoted / final</label><div class="col-lg-4"><input class="form-control" type="number" name="quotedAmount" value="<%= enquiry.quotedAmount || 0 %>"></div><div class="col-lg-4"><input class="form-control" type="number" name="finalAmount" value="<%= enquiry.finalAmount || 0 %>"></div></div>
          <div class="row mb-3"><label class="col-lg-4 col-form-label">Preferred date / slot</label><div class="col-lg-4"><input class="form-control" type="date" name="preferredDate" value="<%= dateOnly(enquiry.preferredDate) %>"></div><div class="col-lg-4"><input class="form-control" name="preferredSlot" value="<%= enquiry.preferredSlot || '' %>"></div></div>
          <div class="text-end"><button class="btn btn-primary" type="submit">Save changes</button></div>
        </form>
      </div>
    </div>
  </div>
  <div class="col-xl-6">
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Assign provider</h5></div>
      <div class="card-body border-top">
        <form method="post" action="/enquiries/<%= enquiry.id %>/assign">
          <div class="row mb-3"><label class="col-lg-4 col-form-label">Recommended providers</label><div class="col-lg-8"><select class="form-select" name="providerId" required>
            <% const providerOptions = recommendations.length ? recommendations : providers; %>
            <% providerOptions.forEach((provider) => { %><option value="<%= provider.id %>"><%= provider.name %><% if (provider.matchScore !== undefined) { %> — score <%= provider.matchScore %><% } %> — <%= provider.city %></option><% }) %>
          </select><div class="form-text">Matching considers category, city/service area, rating and availability.</div></div></div>
          <div class="text-end"><button class="btn btn-primary" type="submit">Assign provider</button></div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header d-sm-flex align-items-sm-center">
    <div><h5 class="mb-0">Update dynamic form data</h5><div class="text-muted fs-sm mt-1">Complete missing fields later without blocking booking creation.</div></div>
    <% if (template) { %><span class="badge bg-primary rounded-pill ms-sm-auto mt-2 mt-sm-0"><%= template.name %></span><% } %>
  </div>
  <div class="card-body border-top">
    <form method="post" action="/enquiries/<%= enquiry.id %>/fields">
      <input type="hidden" name="dynamicFieldKeys" value="<%= fieldCompletion.editableFields.map((field) => field.name).join(',') %>">
      <% if (fieldCompletion.editableFields.length) { %>
        <% fieldCompletion.editableFields.forEach((field) => { const value = enquiry.fields?.[field.name]; const valueText = fieldValue(enquiry.fields, field.name); %>
          <div class="row mb-3">
            <label class="col-lg-3 col-form-label"><%= field.label %><% if (field.required) { %><span class="required-hint">Required</span><% } %></label>
            <div class="col-lg-9">
              <% if (field.type === 'textarea') { %>
                <textarea class="form-control" name="field__<%= field.name %>" rows="3" placeholder="<%= field.placeholder || '' %>"><%= valueText %></textarea>
              <% } else if (field.type === 'select') { %>
                <select class="form-select" name="field__<%= field.name %>"><option value="">Select</option><% (field.options || []).forEach((option) => { %><option value="<%= option %>" <%= valueText === option ? 'selected' : '' %>><%= option %></option><% }) %></select>
              <% } else if (field.type === 'radio') { %>
                <div class="form-check-horizontal"><% (field.options || []).forEach((option) => { %><label class="form-check form-check-inline"><input class="form-check-input" type="radio" name="field__<%= field.name %>" value="<%= option %>" <%= valueText === option ? 'checked' : '' %>><span class="form-check-label"><%= option %></span></label><% }) %></div>
              <% } else if (field.type === 'checkbox') { %>
                <div class="form-check-horizontal"><% (field.options || []).forEach((option) => { const selected = Array.isArray(value) ? value.includes(option) : valueText.split(',').map((v)=>v.trim()).includes(option); %><label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="field__<%= field.name %>" value="<%= option %>" <%= selected ? 'checked' : '' %>><span class="form-check-label"><%= option %></span></label><% }) %></div>
              <% } else { %>
                <input class="form-control" type="<%= field.type === 'file_url' ? 'url' : field.type %>" name="field__<%= field.name %>" value="<%= valueText %>" placeholder="<%= field.placeholder || (field.type === 'file_url' ? 'https://file-url.example.com/photo.jpg' : '') %>">
              <% } %>
              <% if (field.helpText) { %><div class="form-text"><%= field.helpText %></div><% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-muted">No template fields are configured for this enquiry yet. Create a matching template from Catalog → Form Templates.</div>
      <% } %>
      <div class="text-end"><button class="btn btn-primary" type="submit">Save dynamic fields</button></div>
    </form>
  </div>
</div>

<div class="row">
  <div class="col-xl-4"><div class="card"><div class="card-header"><h5 class="mb-0">Add note</h5></div><div class="card-body"><form method="post" action="/enquiries/<%= enquiry.id %>/notes"><textarea class="form-control mb-3" name="note" rows="4" placeholder="Internal update, call summary, customer concern..." required></textarea><button class="btn btn-light" type="submit">Add note</button></form></div></div></div>
  <div class="col-xl-4"><div class="card"><div class="card-header"><h5 class="mb-0">Create follow-up</h5></div><div class="card-body"><form method="post" action="/follow-ups"><input type="hidden" name="returnTo" value="/enquiries/<%= enquiry.id %>"><input type="hidden" name="enquiryId" value="<%= enquiry.id %>"><input type="hidden" name="customerName" value="<%= enquiry.customer.name %>"><div class="mb-3"><label class="form-label">Title</label><input class="form-control" name="title" value="Call <%= enquiry.customer.name || 'customer' %>" required></div><div class="mb-3"><label class="form-label">Due at</label><input class="form-control" type="datetime-local" name="dueAt"></div><div class="mb-3"><label class="form-label">Channel</label><select class="form-select" name="channel"><option>call</option><option>whatsapp</option><option>email</option><option>sms</option></select></div><button class="btn btn-light" type="submit">Create follow-up</button></form></div></div></div>
  <div class="col-xl-4"><div class="card"><div class="card-header"><h5 class="mb-0">Log communication</h5></div><div class="card-body"><form method="post" action="/communications"><input type="hidden" name="returnTo" value="/enquiries/<%= enquiry.id %>"><input type="hidden" name="enquiryId" value="<%= enquiry.id %>"><input type="hidden" name="recipientName" value="<%= enquiry.customer.name %>"><input type="hidden" name="recipientContact" value="<%= enquiry.customer.mobile || enquiry.customer.email %>"><div class="mb-3"><label class="form-label">Channel</label><select class="form-select" name="channel"><option>call</option><option>whatsapp</option><option>email</option><option>sms</option></select></div><div class="mb-3"><label class="form-label">Message</label><textarea class="form-control" name="message" rows="3" required></textarea></div><button class="btn btn-light" type="submit">Log/send</button></form></div></div></div>
</div>

<div class="row">
  <div class="col-xl-5"><div class="card"><div class="card-header"><h5 class="mb-0">Create invoice</h5></div><div class="card-body"><form method="post" action="/billing"><input type="hidden" name="enquiryId" value="<%= enquiry.id %>"><input type="hidden" name="customerName" value="<%= enquiry.customer.name %>"><input type="hidden" name="providerName" value="<%= enquiry.assignedProviderName %>"><label class="form-label">Items <span class="text-muted">description|qty|rate</span></label><textarea class="form-control mb-3" name="items" rows="3">Service charge|1|<%= enquiry.finalAmount || enquiry.quotedAmount || 0 %></textarea><button class="btn btn-light" type="submit">Create invoice</button></form></div></div></div>
  <div class="col-xl-7"><div class="card"><div class="card-header"><h5 class="mb-0">Follow-ups and communications</h5></div><div class="card-body p-0"><div class="list-group list-group-flush"><% followUps.forEach((item) => { %><div class="list-group-item"><div class="fw-semibold"><%= item.title %></div><div class="text-muted fs-sm"><%= humanize(item.status) %> · <%= formatDate(item.dueAt) %></div></div><% }) %><% communications.forEach((item) => { %><div class="list-group-item"><div class="fw-semibold"><%= humanize(item.channel) %></div><div class="text-muted fs-sm"><%= item.message %></div></div><% }) %><% if (!followUps.length && !communications.length) { %><div class="list-group-item text-muted">No follow-ups or communication logs yet.</div><% } %></div></div></div></div>
</div>

<div class="card">
  <div class="card-header"><h5 class="mb-0">Timeline</h5></div>
  <div class="card-body">
    <div class="list-feed">
      <% (enquiry.timeline || []).slice().reverse().forEach((item) => { %>
        <div class="list-feed-item"><div class="fw-semibold"><%= humanize(item.type) %></div><%= item.message %><div class="text-muted fs-sm"><%= item.actor %> · <%= formatDate(item.createdAt) %></div></div>
      <% }) %>
      <% if (!(enquiry.timeline || []).length) { %><div class="text-muted">No timeline yet.</div><% } %>
    </div>
  </div>
</div>

<%- include('../partials/pageEnd') %>
