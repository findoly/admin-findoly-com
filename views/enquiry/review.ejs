<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Lead management</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Read-only record of the saved validation and qualification decisions.</p>
              </div>
              <a id="lead-review-back-link" href="/enquiries" class="btn btn-light crm-primary-action">
                <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to requirement
              </a>
            </div>
          </div>

          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <main x-data="leadReview()" :class="loading && 'crm-loading'">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

              <section class="card mb-3">
                <div class="card-header crm-card-heading">
                  <div>
                    <h2 class="card-title mb-1" x-text="lead.requirementTitle || 'Requirement'"></h2>
                    <p class="text-muted mb-0">Saved review data only. Changes must be made from the requirement workflow before approval.</p>
                  </div>
                  <span class="crm-status" :class="statusClass(lead.journeyStatus || lead.status || 'new')" x-text="humanize(lead.journeyStatus || lead.status || 'new')"></span>
                </div>
                <div class="card-body">
                  <div class="row g-3">
                    <div class="col-md-3">
                      <div class="text-muted fs-sm">Reference ID</div>
                      <div class="fw-semibold" x-text="lead.enquiryId || '—'"></div>
                    </div>
                    <div class="col-md-3">
                      <div class="text-muted fs-sm">Customer</div>
                      <div class="fw-semibold" x-text="lead.name || '—'"></div>
                    </div>
                    <div class="col-md-3">
                      <div class="text-muted fs-sm">Category</div>
                      <div class="fw-semibold" x-text="lead.category || humanize(lead.categorySlug)"></div>
                    </div>
                    <div class="col-md-3">
                      <div class="text-muted fs-sm">Lead price</div>
                      <div class="fw-semibold" x-text="money(lead.leadPricePaise)"></div>
                    </div>
                  </div>
                </div>
              </section>

              <div class="row g-3">
                <div class="col-xl-6">
                  <section class="card h-100">
                    <div class="card-header crm-card-heading">
                      <div>
                        <div class="crm-page-eyebrow">Step 1</div>
                        <h2 class="card-title mb-1">Lead validation</h2>
                        <p class="text-muted mb-0">Saved customer verification questions and answers.</p>
                      </div>
                      <span class="crm-status" :class="statusClass(validation.final?.decision || (validation.completed ? 'completed' : 'pending'))" x-text="humanize(validation.final?.decision || (validation.completed ? 'completed' : 'pending'))"></span>
                    </div>
                    <div class="card-body">
                      <div x-show="!validation.completed && !validationQuestions.length" x-cloak class="alert alert-light border">
                        No validation questionnaire has been saved for this requirement.
                      </div>

                      <template x-for="(question, index) in validationQuestions" :key="question.id">
                        <div class="border rounded p-3 mb-2">
                          <div class="text-muted fs-sm mb-1" x-text="'Question ' + (index + 1)"></div>
                          <div class="fw-semibold mb-2" x-text="question.prompt"></div>
                          <div><span class="text-muted">Answer:</span> <strong x-text="answerLabel(question, validation.answers)"></strong></div>
                        </div>
                      </template>

                      <div class="row g-3 mt-1" x-show="validation.completed || validation.system || validation.final">
                        <div class="col-md-6">
                          <div class="text-muted fs-sm">System decision</div>
                          <div class="fw-semibold" x-text="humanize(validation.system?.decision || '—')"></div>
                        </div>
                        <div class="col-md-6">
                          <div class="text-muted fs-sm">Final decision</div>
                          <div class="fw-semibold" x-text="humanize(validation.final?.decision || '—')"></div>
                        </div>
                        <div class="col-md-6">
                          <div class="text-muted fs-sm">Validation method</div>
                          <div class="fw-semibold" x-text="humanize(validation.method || '—')"></div>
                        </div>
                        <div class="col-md-6">
                          <div class="text-muted fs-sm">Completed</div>
                          <div class="fw-semibold" x-text="formatDate(validation.completedAt)"></div>
                        </div>
                        <div class="col-12" x-show="validation.completedBy">
                          <div class="text-muted fs-sm">Completed by</div>
                          <div class="fw-semibold" x-text="validation.completedBy"></div>
                        </div>
                        <div class="col-12" x-show="validation.note">
                          <div class="text-muted fs-sm">Validation note</div>
                          <div class="fw-semibold" x-text="validation.note"></div>
                        </div>
                        <div class="col-12" x-show="validation.overrideReason">
                          <div class="text-muted fs-sm">Override / review reason</div>
                          <div class="fw-semibold" x-text="validation.overrideReason"></div>
                        </div>
                      </div>

                      <div class="mt-3" x-show="Array.isArray(validation.system?.reasons) && validation.system.reasons.length">
                        <div class="text-muted fs-sm mb-1">System reasons</div>
                        <ul class="mb-0">
                          <template x-for="reason in (validation.system?.reasons || [])" :key="reason">
                            <li x-text="reason"></li>
                          </template>
                        </ul>
                      </div>
                    </div>
                  </section>
                </div>

                <div class="col-xl-6">
                  <section class="card h-100">
                    <div class="card-header crm-card-heading">
                      <div>
                        <div class="crm-page-eyebrow">Step 2</div>
                        <h2 class="card-title mb-1">Lead qualification</h2>
                        <p class="text-muted mb-0">Saved qualification answers and calculated final values.</p>
                      </div>
                      <span class="crm-status" :class="qualification.completed ? 'status-approved' : 'status-pending'" x-text="qualification.completed ? 'Qualified' : 'Pending'"></span>
                    </div>
                    <div class="card-body">
                      <div x-show="!qualification.completed && !qualificationQuestions.length" x-cloak class="alert alert-light border">
                        No qualification questionnaire has been saved for this requirement.
                      </div>

                      <template x-for="(question, index) in qualificationQuestions" :key="question.id">
                        <div class="border rounded p-3 mb-2">
                          <div class="text-muted fs-sm mb-1" x-text="'Question ' + (index + 1)"></div>
                          <div class="fw-semibold mb-2" x-text="question.prompt"></div>
                          <div><span class="text-muted">Answer:</span> <strong x-text="answerLabel(question, qualification.answers)"></strong></div>
                        </div>
                      </template>

                      <div class="alert alert-light border mt-3 mb-3" x-show="qualification.system" x-cloak>
                        <div class="fw-semibold mb-2">System calculation</div>
                        <div class="small">
                          Price score <strong x-text="(qualification.system?.priceScorePercent ?? '—') + '%'"></strong>
                          → rounded to <strong x-text="(qualification.system?.roundedPricePercent ?? '—') + '%'"></strong>
                          of category maximum <strong x-text="money(qualification.system?.categoryMaxLeadPricePaise)"></strong>.
                        </div>
                        <div class="small mt-1">
                          Suggested price <strong x-text="money(qualification.system?.leadPricePaise)"></strong>
                          · Intent <strong x-text="humanize(qualification.system?.leadIntent)"></strong>
                          · Priority <strong x-text="humanize(qualification.system?.priority)"></strong>
                        </div>
                      </div>

                      <div class="border rounded p-3" x-show="qualification.final || qualification.completed" x-cloak>
                        <div class="fw-semibold mb-2">Final qualification</div>
                        <div class="row g-3">
                          <div class="col-md-4">
                            <div class="text-muted fs-sm">Lead price</div>
                            <div class="fw-semibold" x-text="money(qualification.final?.leadPricePaise)"></div>
                          </div>
                          <div class="col-md-4">
                            <div class="text-muted fs-sm">Intent</div>
                            <div class="fw-semibold" x-text="humanize(qualification.final?.leadIntent || '—')"></div>
                          </div>
                          <div class="col-md-4">
                            <div class="text-muted fs-sm">Priority</div>
                            <div class="fw-semibold" x-text="humanize(qualification.final?.priority || '—')"></div>
                          </div>
                          <div class="col-md-6">
                            <div class="text-muted fs-sm">Completed</div>
                            <div class="fw-semibold" x-text="formatDate(qualification.completedAt)"></div>
                          </div>
                          <div class="col-md-6">
                            <div class="text-muted fs-sm">Completed by</div>
                            <div class="fw-semibold" x-text="qualification.completedBy || '—'"></div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </section>
                </div>
              </div>
            </main>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>

    <script>
      function leadReview() {
        const parts = pathParts();
        const section = parts[0] === 'requirements' ? 'requirements' : 'enquiries';
        return {
          leadId: parts[1] || '',
          section,
          lead: {},
          validation: { questions: [], answers: {}, system: null, final: null, completed: false },
          qualification: { questions: [], answers: {}, system: null, final: null, completed: false },
          loading: true,
          error: '',
          get validationQuestions() {
            return Array.isArray(this.validation?.questions) ? this.validation.questions : [];
          },
          get qualificationQuestions() {
            return Array.isArray(this.qualification?.questions) ? this.qualification.questions : [];
          },
          answerLabel(question, answers = {}) {
            const answerId = String(answers?.[question?.id] || '');
            const option = Array.isArray(question?.options)
              ? question.options.find((item) => String(item.id) === answerId)
              : null;
            return option?.label || (answerId ? humanize(answerId) : 'Not answered');
          },
          async init() {
            const backLink = document.getElementById('lead-review-back-link');
            if (backLink) backLink.href = '/' + this.section + '/' + encodeURIComponent(this.leadId);
            await this.load();
          },
          async load() {
            if (!this.leadId) {
              this.error = 'Requirement reference is missing.';
              this.loading = false;
              return;
            }
            this.loading = true;
            this.error = '';
            try {
              const encodedId = encodeURIComponent(this.leadId);
              const [leadBody, validationBody, qualificationBody] = await Promise.all([
                apiFetch('/api/enquiry/' + encodedId),
                apiFetch('/api/enquiry/' + encodedId + '/validation'),
                apiFetch('/api/enquiry/' + encodedId + '/qualification')
              ]);
              this.lead = leadBody.data || {};
              this.validation = validationBody.data || this.validation;
              this.qualification = qualificationBody.data || this.qualification;
            } catch (error) {
              this.error = error.message;
            } finally {
              this.loading = false;
            }
          }
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
