<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Provider unlock</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">Review the current provider activity and sale outcome without storing growing history arrays.</p></div><a :href="'/enquiries/' + enquiryId + '/providers'" class="btn btn-light" x-data="{ enquiryId: pathParts()[1] || '' }">Back to unlocked providers</a></div></div>
      <div class="content"><main x-data="providerUnlockShow()" x-init="load()">
        <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
        <section class="card mb-3"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1" x-text="unlock.providerBusinessName || unlock.providerName || unlock.providerId || 'Provider'"></h2><p class="text-muted mb-0" x-text="unlock.providerLeadUnlockId || ''"></p></div><span class="crm-status" :class="unlock.providerSaleOutcome === 'confirmed' ? 'status-sale-converted' : 'status-pending'" x-text="unlock.providerSaleOutcome ? humanize(unlock.providerSaleOutcome) : 'Pending outcome'"></span></div>
          <div class="card-body"><div class="row g-3">
            <div class="col-md-3"><div class="text-muted fs-sm">Lead</div><a :href="'/enquiries/' + enquiryId" class="fw-semibold" x-text="lead.requirementTitle || lead.enquiryId"></a></div>
            <div class="col-md-3"><div class="text-muted fs-sm">Provider ID</div><a :href="'/providers/' + unlock.providerId" class="fw-semibold" x-text="unlock.providerId || '—'"></a></div>
            <div class="col-md-2"><div class="text-muted fs-sm">Unlock method</div><div class="fw-semibold" x-text="humanize(unlock.unlockMethod)"></div></div>
            <div class="col-md-2"><div class="text-muted fs-sm">Credits charged</div><div class="fw-semibold" x-text="unlock.chargedCredits || 0"></div></div>
            <div class="col-md-2"><div class="text-muted fs-sm">Unlocked</div><div class="fw-semibold" x-text="formatDate(unlock.unlockedAt)"></div></div>
            <div class="col-md-3"><div class="text-muted fs-sm">Activity status</div><div class="fw-semibold" x-text="unlock.providerLeadStatus ? humanize(unlock.providerLeadStatus) : 'Not updated'"></div></div>
            <div class="col-md-3"><div class="text-muted fs-sm">Reason</div><div class="fw-semibold" x-text="unlock.providerLeadReason || '—'"></div></div>
            <div class="col-md-6"><div class="text-muted fs-sm">Provider note</div><div class="fw-semibold" x-text="unlock.providerLeadNote || unlock.providerSaleOutcomeNote || '—'"></div></div>
          </div></div>
        </section>

        <section class="card"><div class="card-header"><h2 class="card-title mb-0">CRM outcome review</h2></div><div class="card-body">
          <div class="row g-3"><div class="col-md-4"><label class="form-label">Verification</label><select class="form-select" x-model="form.verificationStatus"><option value="pending_review">Pending review</option><option value="verified">Verified</option><option value="unable_to_verify">Unable to verify</option><option value="incorrect_status">Incorrect status</option><option value="under_review">Under review</option></select></div>
          <div class="col-md-4"><label class="form-label">Provider action</label><select class="form-select" x-model="form.reviewAction"><option value="none">No account action</option><option value="warning">Issue warning</option><option value="suspend">Suspend provider</option><option value="ban">Block provider</option></select></div>
          <div class="col-md-12"><label class="form-label">Review note</label><textarea class="form-control" rows="4" maxlength="2000" x-model="form.note" placeholder="Record how the outcome was verified"></textarea></div></div>
          <div class="d-flex justify-content-end mt-3"><button class="btn btn-primary" @click="saveReview()" :disabled="saving || !form.note.trim()" x-text="saving ? 'Saving…' : 'Save review'"></button></div>
        </div></section>
      </main></div><%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function providerUnlockShow() {
        const parts = pathParts();
        return {
          enquiryId: parts[1] || '', unlockId: parts[3] || '', lead: {}, unlock: {}, saving: false, error: '', form: { verificationStatus: 'pending_review', reviewAction: 'none', note: '' },
          async load() { try { const body = await apiFetch('/api/enquiry/' + this.enquiryId + '/providers/' + this.unlockId); this.lead = body.data?.lead || {}; this.unlock = body.data?.unlock || {}; this.form.verificationStatus = this.unlock.outcomeVerificationStatus || 'pending_review'; this.form.note = this.unlock.outcomeVerificationNote || ''; } catch (error) { this.error = error.message; } },
          async saveReview() { if (this.saving) return; this.saving = true; try { const body = await apiFetch('/api/provider/' + this.unlock.providerId + '/unlocks/' + this.unlockId + '/outcome-review', { method: 'PATCH', body: JSON.stringify(this.form) }); this.unlock = body.data?.unlock || this.unlock; showCrmToast('Provider outcome review saved.', 'success'); } catch (error) { showCrmToast(error.message, 'error'); } finally { this.saving = false; } }
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
