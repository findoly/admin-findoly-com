<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Lead editor</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Capture customer, requirement, source and pricing details.</p>
              </div>
              <a href="/enquiries" class="btn btn-light crm-primary-action"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to requirements</a>
            </div>
          </div>
          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <div x-data="leadForm()" x-init="init()">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
              <div x-show="success" x-cloak class="alert alert-success" x-text="success"></div>
              <form class="card" @submit.prevent="save">
                <div class="card-body" :class="loading && 'crm-loading'">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label">Customer name</label>
                      <input class="form-control" x-model="form.name" maxlength="120" required />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Mobile</label>
                      <div class="input-group">
                        <span class="input-group-text crm-mobile-prefix">+91</span>
                        <input
                          class="form-control"
                          x-model="form.mobile"
                          @input="form.mobile = digitsOnly(form.mobile)"
                          inputmode="numeric"
                          autocomplete="tel-national"
                          pattern="[0-9]{10}"
                          minlength="10"
                          maxlength="10"
                          placeholder="10 digit number"
                          required
                        />
                      </div>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Email</label>
                      <input type="email" class="form-control" x-model="form.email" maxlength="254" />
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Address</label>
                      <input class="form-control" x-model="form.addressLine" maxlength="500" />
                    </div>
                    <div class="col-md-2">
                      <label class="form-label">City</label>
                      <input class="form-control" x-model="form.city" maxlength="100" />
                    </div>
                    <div class="col-md-2">
                      <label class="form-label">State</label>
                      <input class="form-control" x-model="form.state" maxlength="100" />
                    </div>
                    <div class="col-md-2">
                      <label class="form-label">Pincode</label>
                      <input class="form-control" x-model="form.pincode" @input="form.pincode = String(form.pincode || '').replace(/\D/g, '').slice(0, 6)" inputmode="numeric" pattern="[1-9][0-9]{5}" maxlength="6" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Category</label>
                      <select class="form-select" x-model="form.categorySlug" @change="syncCategory()" required>
                        <option value="">Select</option>
                        <template x-for="category in categories" :key="category.slug">
                          <option :value="category.slug" x-text="category.name"></option>
                        </template>
                      </select>
                      <div class="form-text">Options are managed from the Categories feature.</div>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Service type</label>
                      <input class="form-control" x-model="form.serviceType" maxlength="120" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Requirement title</label>
                      <input class="form-control" x-model="form.requirementTitle" maxlength="200" required />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Journey status</label>
                      <div class="form-control bg-light" x-text="humanize(form.status || 'new')"></div>
                      <div class="form-text">Status moves from the requirement details page using Next or Previous.</div>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Priority</label>
                      <select class="form-select" x-model="form.priority">
                        <option>low</option>
                        <option>normal</option>
                        <option>high</option>
                        <option>urgent</option>
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Lead price (₹)</label>
                      <input type="number" min="0" max="10000000" step="0.01" class="form-control" x-model.number="priceRupees" required />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Preferred date</label>
                      <input type="date" class="form-control" x-model="form.preferredDate" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Preferred slot</label>
                      <input class="form-control" x-model="form.preferredSlot" maxlength="100" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Source website</label>
                      <input class="form-control" x-model="form.sourceWebsite" maxlength="120" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Source name</label>
                      <input class="form-control" x-model="form.sourceName" maxlength="120" />
                    </div>
                    <div class="col-12">
                      <label class="form-label">Notes</label>
                      <textarea class="form-control" rows="3" x-model="form.notes" maxlength="5000"></textarea>
                    </div>
                  </div>
                  <hr />
                  <div class="d-flex align-items-center mb-2">
                    <h6 class="mb-0">Additional details</h6>
                    <button type="button" class="btn btn-light btn-sm ms-auto" @click="details.push({key:'',value:''})">Add field</button>
                  </div>
                  <template x-for="(item,index) in details" :key="index">
                    <div class="row g-2 mb-2">
                      <div class="col-md-5">
                        <input class="form-control" placeholder="Field name" x-model="item.key" maxlength="100" />
                      </div>
                      <div class="col-md-6">
                        <input class="form-control" placeholder="Value" x-model="item.value" maxlength="2000" />
                      </div>
                      <div class="col-md-1">
                        <button type="button" class="btn btn-light w-100" @click="details.splice(index,1)">×</button>
                      </div>
                    </div>
                  </template>
                </div>
                <div class="card-footer d-flex">
                  <a href="/enquiries" class="btn btn-light">Cancel</a>
                  <button class="btn btn-primary ms-auto" :disabled="saving" x-text="saving ? 'Saving…' : 'Save requirement'"></button>
                </div>
              </form>
            </div>
            <script>
              function leadForm() {
                return {
                  mode: pageMode(),
                  recordId: pageMode() === "edit" ? pathRecordId(true) : "",
                  categories: [],
                  form: {
                    name: "",
                    mobile: "",
                    email: "",
                    addressLine: "",
                    city: "",
                    state: "",
                    pincode: "",
                    category: "",
                    categorySlug: "",
                    serviceType: "",
                    requirementTitle: "",
                    status: "new",
                    priority: "normal",
                    preferredDate: "",
                    preferredSlot: "",
                    sourceWebsite: "manual-admin",
                    sourceName: "",
                    notes: "",
                  },
                  priceRupees: 100,
                  details: [],
                  loading: true,
                  saving: false,
                  error: "",
                  success: "",
                  digitsOnly(value) {
                    let digits = String(value || "").replace(/\D/g, "");
                    if (digits.length === 12 && digits.startsWith("91")) digits = digits.slice(2);
                    if (digits.length === 11 && digits.startsWith("0")) digits = digits.slice(1);
                    return digits.slice(0, 10);
                  },
                  async init() {
                    try {
                      this.categories = (await apiFetch("/api/catalog/categories")).data || [];
                      if (this.mode === "edit") {
                        const data = (await apiFetch("/api/enquiry/" + this.recordId)).data;
                        this.form = {
                          ...this.form,
                          ...data,
                          mobile: this.digitsOnly(data.mobile),
                        };
                        this.priceRupees = Number(data.leadPricePaise || 0) / 100;
                        this.details = Object.entries(data.additionalDetails || {}).map(([key, value]) => ({
                          key,
                          value: typeof value === "object" ? JSON.stringify(value) : value,
                        }));
                      }
                    } catch (e) {
                      this.error = e.message;
                    } finally {
                      this.loading = false;
                    }
                  },
                  syncCategory() {
                    const category = this.categories.find((item) => item.slug === this.form.categorySlug);
                    this.form.category = category?.name || this.form.categorySlug;
                  },
                  payload() {
                    const additionalDetails = {};
                    this.details.forEach((item) => {
                      if (item.key.trim()) additionalDetails[item.key.trim()] = item.value;
                    });
                    return {
                      name: this.form.name,
                      mobile: this.form.mobile,
                      email: this.form.email,
                      addressLine: this.form.addressLine,
                      city: this.form.city,
                      state: this.form.state,
                      pincode: this.form.pincode,
                      category: this.form.category,
                      categorySlug: this.form.categorySlug,
                      serviceType: this.form.serviceType,
                      requirementTitle: this.form.requirementTitle,
                      priority: this.form.priority,
                      preferredDate: this.form.preferredDate,
                      preferredSlot: this.form.preferredSlot,
                      sourceWebsite: this.form.sourceWebsite,
                      sourceName: this.form.sourceName,
                      notes: this.form.notes,
                      leadPricePaise: Math.round(Number(this.priceRupees || 0) * 100),
                      additionalDetails,
                    };
                  },
                  async save() {
                    this.saving = true;
                    this.error = "";
                    try {
                      if (!/^\d{10}$/.test(this.form.mobile)) {
                        throw new Error("Customer mobile number must contain exactly 10 digits");
                      }
                      if (this.form.pincode && !/^[1-9]\d{5}$/.test(this.form.pincode)) {
                        throw new Error("Pincode must contain exactly 6 digits");
                      }
                      if (!Number.isFinite(Number(this.priceRupees)) || Number(this.priceRupees) < 0) {
                        throw new Error("Lead price must be a valid non-negative amount");
                      }
                      if (this.details.length > 100) {
                        throw new Error("Additional details cannot contain more than 100 fields");
                      }
                      const url = this.mode === "edit"
                        ? "/api/enquiry/" + this.recordId
                        : "/api/enquiry";
                      const response = await apiFetch(url, {
                        method: this.mode === "edit" ? "PUT" : "POST",
                        body: JSON.stringify(this.payload()),
                      });
                      this.success = "Saved";
                      location.href = "/enquiries/" + response.data.enquiryId;
                    } catch (e) {
                      this.error = e.message;
                    } finally {
                      this.saving = false;
                    }
                  },
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
