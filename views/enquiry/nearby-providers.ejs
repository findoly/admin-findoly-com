<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Lead management</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">View providers in the same category around this requirement location.</p>
              </div>
              <a id="nearby-provider-back-link" href="/enquiries" class="btn btn-light crm-primary-action">
                <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to requirement
              </a>
            </div>
          </div>

          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <main x-data="nearbyProviderMap()" x-init="init()" :class="loading && 'crm-loading'">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

              <section class="card mb-3">
                <div class="card-body">
                  <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                      <div class="text-muted fs-sm">Requirement</div>
                      <div class="fw-semibold" x-text="lead.requirementTitle || 'Requirement'"></div>
                    </div>
                    <div class="col-md-3">
                      <div class="text-muted fs-sm">Category</div>
                      <div class="fw-semibold" x-text="lead.category || humanize(lead.categorySlug)"></div>
                    </div>
                    <div class="col-md-3">
                      <div class="text-muted fs-sm">Requirement location</div>
                      <div class="fw-semibold" x-text="lead.locationLabel || '—'"></div>
                    </div>
                    <div class="col-md-2">
                      <div class="text-muted fs-sm">Saved alert radius</div>
                      <div class="fw-semibold" x-text="(lead.alertDistanceKm || 20) + ' km'"></div>
                    </div>
                  </div>
                </div>
              </section>

              <section class="card crm-filter-card mb-3">
                <div class="card-body">
                  <div class="row g-3 align-items-end">
                    <div class="col-lg-5">
                      <label class="form-label d-flex justify-content-between" for="nearby-radius">
                        <span>Map radius</span>
                        <strong x-text="radiusKm + ' km'"></strong>
                      </label>
                      <input id="nearby-radius" class="form-range" type="range" min="1" max="100" step="1" x-model.number="radiusKm" @change="applyRadius()" :disabled="loading">
                      <div class="form-text">1–100 km. View only — this does not change the requirement's saved WhatsApp alert distance.</div>
                    </div>
                    <div class="col-lg-4">
                      <label class="form-label" for="nearby-provider-search">Find provider</label>
                      <input id="nearby-provider-search" type="search" class="form-control" x-model="searchText" @input.debounce.250ms="renderMap()" placeholder="Provider or location">
                    </div>
                    <div class="col-lg-3">
                      <label class="form-label" for="nearby-provider-sort">List order</label>
                      <select id="nearby-provider-sort" class="form-select" x-model="sortOrder">
                        <option value="nearest">Nearest first</option>
                        <option value="farthest">Farthest first</option>
                        <option value="name">Provider name</option>
                      </select>
                    </div>
                  </div>
                </div>
              </section>

              <div x-show="reason === 'lead_coordinates_missing'" x-cloak class="alert alert-warning">
                This requirement does not have saved coordinates yet, so nearby-provider distance cannot be calculated.
              </div>

              <section class="card mb-3" x-show="hasLocation" x-cloak>
                <div class="card-header d-flex align-items-center flex-wrap gap-2">
                  <div>
                    <h2 class="card-title mb-1">Provider map</h2>
                    <p class="text-muted mb-0">Requirement at the centre with active same-category providers inside the selected radius.</p>
                  </div>
                  <span class="badge bg-light text-dark ms-auto" x-text="resultCountLabel"></span>
                </div>
                <div class="card-body p-0">
                  <div id="nearby-provider-map" class="crm-nearby-provider-map" aria-label="Nearby providers map"></div>
                  <div x-show="mapError" x-cloak class="alert alert-warning m-3" x-text="mapError"></div>
                </div>
              </section>

              <section class="card crm-data-card">
                <div class="card-header crm-card-heading">
                  <div>
                    <h2 class="card-title mb-1">Nearby provider list</h2>
                    <p class="text-muted mb-0" x-text="resultCountLabel"></p>
                  </div>
                </div>
                <div class="table-responsive">
                  <table class="table crm-table mb-0">
                    <thead>
                      <tr><th>Provider</th><th>Distance</th><th>Service location</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                      <template x-if="loading">
                        <tr><td colspan="5"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr>
                      </template>
                      <template x-for="provider in filteredProviders" :key="provider.providerId">
                        <tr>
                          <td>
                            <div class="fw-semibold" x-text="provider.businessName || provider.name"></div>
                            <div class="text-muted fs-sm" x-show="provider.businessName" x-text="provider.name"></div>
                          </td>
                          <td class="crm-nowrap"><strong x-text="provider.distanceKm.toFixed(1) + ' km'"></strong></td>
                          <td>
                            <div x-text="provider.locationLabel || '—'"></div>
                            <div class="text-muted fs-sm" x-show="provider.servicePincode" x-text="provider.servicePincode"></div>
                          </td>
                          <td>
                            <span class="crm-status" :class="provider.portalAccessEnabled === false ? 'status-inactive' : 'status-active'" x-text="provider.portalAccessEnabled === false ? 'Active · portal restricted' : 'Active'"></span>
                          </td>
                          <td class="text-end"><a class="crm-row-action" :href="'/providers/' + provider.providerId">View provider</a></td>
                        </tr>
                      </template>
                      <tr x-show="!loading && !filteredProviders.length">
                        <td colspan="5">
                          <div class="crm-empty-state">
                            <strong x-text="searchText ? 'No matching providers' : 'No nearby providers'"></strong>
                            <span x-text="searchText ? 'Clear the provider search or increase the map radius.' : 'Increase the map radius to inspect a wider area.'"></span>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </section>
            </main>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>

    <style>
      .crm-nearby-provider-map{height:440px;min-height:320px;width:100%;background:#f4f6f8}
      .crm-nearby-map-popup strong{display:block;margin-bottom:4px}
      .crm-nearby-map-popup span{display:block;margin-bottom:6px}
      @media (max-width:767.98px){.crm-nearby-provider-map{height:360px}}
    </style>

    <script>
      function nearbyProviderMap() {
        const parts = pathParts();
        const section = parts[0] === 'requirements' ? 'requirements' : 'enquiries';
        return {
          leadId: parts[1] || '',
          section,
          lead: {},
          providers: [],
          radiusKm: 20,
          searchText: '',
          sortOrder: 'nearest',
          loading: false,
          error: '',
          mapError: '',
          reason: '',
          map: null,
          mapLayers: [],
          get hasLocation() {
            return Number.isFinite(Number(this.lead.latitude)) && Number.isFinite(Number(this.lead.longitude));
          },
          get filteredProviders() {
            const needle = String(this.searchText || '').trim().toLowerCase();
            const rows = this.providers.filter((provider) => {
              if (!needle) return true;
              return [provider.name, provider.businessName, provider.locationLabel, provider.city, provider.servicePincode]
                .some((value) => String(value || '').toLowerCase().includes(needle));
            });
            return rows.sort((left, right) => {
              if (this.sortOrder === 'farthest') return right.distanceKm - left.distanceKm;
              if (this.sortOrder === 'name') return String(left.businessName || left.name).localeCompare(String(right.businessName || right.name));
              return left.distanceKm - right.distanceKm;
            });
          },
          get resultCountLabel() {
            const count = this.filteredProviders.length;
            return count + ' provider' + (count === 1 ? '' : 's') + ' within ' + this.radiusKm + ' km';
          },
          async init() {
            const backLink = document.getElementById('nearby-provider-back-link');
            if (backLink) backLink.href = '/' + this.section + '/' + encodeURIComponent(this.leadId);
            await this.load(false);
          },
          async applyRadius() {
            const value = Math.round(Number(this.radiusKm || 20));
            this.radiusKm = Math.min(100, Math.max(1, Number.isFinite(value) ? value : 20));
            await this.load(true);
          },
          async load(useSelectedRadius) {
            if (this.loading) return;
            this.loading = true;
            this.error = '';
            try {
              const suffix = useSelectedRadius ? '?radiusKm=' + encodeURIComponent(this.radiusKm) : '';
              const body = await apiFetch('/api/enquiry/' + encodeURIComponent(this.leadId) + '/nearby-providers' + suffix);
              this.lead = body.lead || {};
              this.providers = Array.isArray(body.data) ? body.data : [];
              this.radiusKm = Number(body.radiusKm || this.lead.alertDistanceKm || 20);
              this.reason = body.reason || '';
              await this.renderMap();
            } catch (error) {
              this.error = error.message;
            } finally {
              this.loading = false;
            }
          },
          async ensureLeaflet() {
            if (window.L) return window.L;
            if (!document.querySelector('link[data-crm-leaflet]')) {
              const stylesheet = document.createElement('link');
              stylesheet.rel = 'stylesheet';
              stylesheet.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
              stylesheet.dataset.crmLeaflet = 'true';
              document.head.appendChild(stylesheet);
            }
            await new Promise((resolve, reject) => {
              const existing = document.querySelector('script[data-crm-leaflet]');
              if (existing) {
                if (window.L) return resolve();
                existing.addEventListener('load', resolve, { once: true });
                existing.addEventListener('error', reject, { once: true });
                return;
              }
              const script = document.createElement('script');
              script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
              script.dataset.crmLeaflet = 'true';
              script.onload = resolve;
              script.onerror = reject;
              document.head.appendChild(script);
            });
            if (!window.L) throw new Error('Map library did not load');
            return window.L;
          },
          escapeHtml(value) {
            return String(value || '')
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;')
              .replace(/'/g, '&#039;');
          },
          async renderMap() {
            this.mapError = '';
            if (!this.hasLocation) {
              if (this.map) {
                this.map.remove();
                this.map = null;
              }
              return;
            }
            try {
              const L = await this.ensureLeaflet();
              if (this.map) this.map.remove();
              const leadPoint = [Number(this.lead.latitude), Number(this.lead.longitude)];
              this.map = L.map('nearby-provider-map', { scrollWheelZoom: false });
              L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
              }).addTo(this.map);

              const radiusCircle = L.circle(leadPoint, {
                radius: Number(this.radiusKm) * 1000,
                color: '#082B67',
                weight: 2,
                fillColor: '#082B67',
                fillOpacity: 0.04
              }).addTo(this.map);

              L.circleMarker(leadPoint, {
                radius: 9,
                color: '#DF4300',
                weight: 3,
                fillColor: '#FF5A12',
                fillOpacity: 0.9
              }).addTo(this.map).bindPopup(
                '<div class="crm-nearby-map-popup"><strong>Requirement</strong><span>' + this.escapeHtml(this.lead.locationLabel || '') + '</span></div>'
              );

              for (const provider of this.filteredProviders) {
                const point = [Number(provider.latitude), Number(provider.longitude)];
                const name = provider.businessName || provider.name || 'Provider';
                const popup = '<div class="crm-nearby-map-popup">'
                  + '<strong>' + this.escapeHtml(name) + '</strong>'
                  + '<span>' + Number(provider.distanceKm).toFixed(1) + ' km from requirement</span>'
                  + '<span>' + this.escapeHtml(provider.locationLabel || '') + '</span>'
                  + '<a href="/providers/' + encodeURIComponent(provider.providerId) + '">View provider</a>'
                  + '</div>';
                L.circleMarker(point, {
                  radius: 7,
                  color: '#031C49',
                  weight: 2,
                  fillColor: '#082B67',
                  fillOpacity: 0.82
                }).addTo(this.map).bindPopup(popup);
              }

              this.map.fitBounds(radiusCircle.getBounds(), { padding: [20, 20] });
              window.setTimeout(() => this.map && this.map.invalidateSize(), 50);
            } catch (error) {
              this.mapError = 'The visual map could not load. The nearby-provider list and distances are still available below.';
            }
          }
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
