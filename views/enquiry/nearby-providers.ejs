<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Lead management</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Select nearby providers and send WhatsApp manually when needed.</p>
              </div>
              <a id="nearby-provider-back-link" href="/enquiries" class="btn btn-light crm-primary-action">
                <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to requirement
              </a>
            </div>
          </div>

          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <main x-data="nearbyProviderList()" :class="loading && 'crm-loading'">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
              <div x-show="successMessage" x-cloak class="alert alert-success" x-text="successMessage"></div>

              <div x-show="reason === 'lead_coordinates_missing'" x-cloak class="alert alert-warning">
                This requirement does not have saved coordinates yet, so nearby-provider distance cannot be calculated.
              </div>
              <div x-show="reason === 'no_eligible_providers' && !loading && canSendAlerts" x-cloak class="alert alert-warning">
                No eligible nearby providers are currently available for manual WhatsApp.
              </div>
              <div x-show="!loading && lead.enquiryId && !canSendAlerts" x-cloak class="alert alert-light border">
                Manual WhatsApp is available only while this requirement is published and still available to providers.
              </div>

              <section class="card crm-data-card">
                <div class="card-header crm-card-heading gap-3">
                  <div>
                    <h2 class="card-title mb-1">Nearby providers</h2>
                    <p class="text-muted mb-0" x-text="providerCountLabel"></p>
                  </div>
                  <div class="d-flex flex-wrap align-items-center gap-2">
                    <span x-show="searchText" x-cloak class="badge bg-light text-dark" x-text="filteredProviders.length + ' matching'"></span>
                    <button
                      x-show="can('requirements.manage')"
                      x-cloak
                      type="button"
                      class="btn btn-primary btn-sm"
                      :disabled="sendingAlerts || !canSendAlerts || !selectedProviderIds.length"
                      @click="sendAlerts(selectedProviderIds)"
                    >
                      <span x-text="sendingAlerts ? 'Sending…' : 'Send WhatsApp to selected'"></span>
                      <span x-show="selectedProviderIds.length" x-text="' (' + selectedProviderIds.length + ')'"></span>
                    </button>
                  </div>
                </div>
                <div class="card-body border-bottom">
                  <div class="row g-3 align-items-end">
                    <div class="col-lg-6">
                      <label class="form-label" for="nearby-provider-search">Find provider</label>
                      <input id="nearby-provider-search" type="search" class="form-control" x-model="searchText" placeholder="Provider or location">
                    </div>
                    <div class="col-lg-6">
                      <label class="form-label" for="nearby-provider-sort">List order</label>
                      <select id="nearby-provider-sort" class="form-select" x-model="sortOrder">
                        <option value="nearest">Nearest first</option>
                        <option value="farthest">Farthest first</option>
                        <option value="name">Provider name</option>
                      </select>
                    </div>
                  </div>
                </div>
                <div class="table-responsive">
                  <table class="table crm-table mb-0">
                    <thead>
                      <tr>
                        <th class="text-center">Select</th>
                        <th>Provider</th>
                        <th>Credits</th>
                        <th>Distance</th>
                        <th>Service location</th>
                        <th>WhatsApp</th>
                        <th>Status</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-if="loading">
                        <tr><td colspan="8"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr>
                      </template>
                      <template x-for="provider in filteredProviders" :key="provider.providerId">
                        <tr>
                          <td class="text-center">
                            <input
                              x-show="can('requirements.manage')"
                              x-cloak
                              class="form-check-input"
                              type="checkbox"
                              :value="provider.providerId"
                              x-model="selectedProviderIds"
                              :disabled="sendingAlerts || !canSendAlerts || !provider.whatsappAlertEligible"
                              :aria-label="'Select ' + (provider.businessName || provider.name) + ' for WhatsApp'"
                            >
                          </td>
                          <td>
                            <div class="fw-semibold" x-text="provider.businessName || provider.name"></div>
                            <div class="text-muted fs-sm" x-show="provider.businessName" x-text="provider.name"></div>
                          </td>
                          <td class="crm-nowrap">
                            <strong x-text="formatCredits(provider.walletBalanceCredits)"></strong>
                            <span class="text-muted fs-sm"> credits</span>
                          </td>
                          <td class="crm-nowrap"><strong x-text="provider.distanceKm.toFixed(1) + ' km'"></strong></td>
                          <td>
                            <div x-text="provider.locationLabel || '—'"></div>
                            <div class="text-muted fs-sm" x-show="provider.servicePincode" x-text="provider.servicePincode"></div>
                          </td>
                          <td>
                            <span
                              class="crm-status"
                              :class="provider.whatsappAlertEligible ? 'status-active' : 'status-inactive'"
                              x-text="provider.whatsappAlertEligible
                                ? (provider.alertAlreadySent ? 'Previously sent · ' + formatAlertTime(provider.alertedAt) : 'Ready')
                                : alertReasonLabel(provider.whatsappAlertReason)"
                            ></span>
                            <div
                              x-show="provider.alertAlreadySent && provider.alertMode"
                              x-cloak
                              class="text-muted fs-sm mt-1"
                              x-text="provider.alertMode === 'automatic' ? 'Automatic' : 'Manual'"
                            ></div>
                          </td>
                          <td>
                            <span class="crm-status" :class="provider.portalAccessEnabled === false ? 'status-inactive' : 'status-active'" x-text="provider.portalAccessEnabled === false ? 'Active · portal restricted' : 'Active'"></span>
                          </td>
                          <td class="text-end crm-nowrap">
                            <button
                              x-show="can('requirements.manage')"
                              x-cloak
                              type="button"
                              class="btn btn-light btn-sm me-2"
                              :disabled="sendingAlerts || !canSendAlerts || !provider.whatsappAlertEligible"
                              @click="sendAlerts([provider.providerId])"
                            ><span>Send WhatsApp</span></button>
                            <button
                              x-show="can('requirements.manage')"
                              x-cloak
                              type="button"
                              class="btn btn-light btn-sm me-2"
                              :disabled="copyingProviderId === provider.providerId || provider.portalAccessEnabled === false"
                              @click="copyDirectLink(provider)"
                            ><span x-text="copyingProviderId === provider.providerId ? 'Preparing…' : 'Copy lead link'"></span></button>
                            <a class="crm-row-action" :href="'/providers/' + provider.providerId">View provider</a>
                          </td>
                        </tr>
                      </template>
                      <tr x-show="!loading && !filteredProviders.length">
                        <td colspan="8">
                          <div class="crm-empty-state">
                            <strong x-text="searchText ? 'No matching providers' : 'No nearby providers'"></strong>
                            <span x-text="searchText ? 'Clear the provider search to see all nearby providers.' : 'No active same-category providers are within the saved radius.'"></span>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </section>
            </main>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>

    <script>
      function nearbyProviderList() {
        const parts = pathParts();
        const section = parts[0] === 'requirements' ? 'requirements' : 'enquiries';
        return {
          leadId: parts[1] || '',
          section,
          lead: {},
          providers: [],
          providerCount: 0,
          eligibleCount: 0,
          radiusKm: 20,
          searchText: '',
          sortOrder: 'nearest',
          loading: false,
          sendingAlerts: false,
          copyingProviderId: '',
          selectedProviderIds: [],
          error: '',
          successMessage: '',
          reason: '',
          get canSendAlerts() {
            return this.lead.providerAlertStatus?.canSend === true;
          },
          get filteredProviders() {
            const needle = String(this.searchText || '').trim().toLowerCase();
            const rows = this.providers.filter((provider) => {
              if (!needle) return true;
              return [provider.name, provider.businessName, provider.locationLabel, provider.city, provider.servicePincode]
                .some((value) => String(value || '').toLowerCase().includes(needle));
            });
            return rows.sort((left, right) => {
              if (this.sortOrder === 'farthest') return right.distanceKm - left.distanceKm;
              if (this.sortOrder === 'name') return String(left.businessName || left.name).localeCompare(String(right.businessName || right.name));
              return left.distanceKm - right.distanceKm;
            });
          },
          get providerCountLabel() {
            const total = this.providerCount + ' provider' + (this.providerCount === 1 ? '' : 's')
              + ' within the saved ' + this.radiusKm + ' km radius';
            if (!this.canSendAlerts) return total;
            return total + ' · ' + this.eligibleCount + ' eligible for manual WhatsApp';
          },
          formatCredits(value) {
            const credits = Number(value || 0);
            if (!Number.isFinite(credits)) return '0';
            return credits.toLocaleString('en-IN', { maximumFractionDigits: 2 });
          },
          formatAlertTime(value) {
            const date = value ? new Date(value) : null;
            if (!date || Number.isNaN(date.getTime())) return 'sent';
            return date.toLocaleString('en-IN', {
              day: '2-digit',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
            });
          },
          alertReasonLabel(reason) {
            return {
              portal_restricted: 'Portal restricted',
              provider_alerts_disabled: 'WhatsApp disabled',
              whatsapp_contact_missing: 'No WhatsApp number',
              subcategory_not_selected: 'Service not selected',
            }[String(reason || '')] || 'Not eligible';
          },
          async copyText(value) {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(value);
              return;
            }
            const textarea = document.createElement('textarea');
            textarea.value = value;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            const copied = document.execCommand('copy');
            textarea.remove();
            if (!copied) throw new Error('Could not copy the lead link. Please try again.');
          },
          async init() {
            const backLink = document.getElementById('nearby-provider-back-link');
            if (backLink) backLink.href = '/' + this.section + '/' + encodeURIComponent(this.leadId);
            await this.load();
          },
          async load() {
            if (this.loading) return;
            this.loading = true;
            this.error = '';
            try {
              const body = await apiFetch('/api/enquiry/' + encodeURIComponent(this.leadId) + '/nearby-providers');
              this.lead = body.lead || {};
              this.providers = Array.isArray(body.data) ? body.data : [];
              const count = Number(body.count);
              this.providerCount = Number.isFinite(count) ? Math.max(0, Math.trunc(count)) : this.providers.length;
              const eligibleCount = Number(body.eligibleCount);
              this.eligibleCount = Number.isFinite(eligibleCount)
                ? Math.max(0, Math.trunc(eligibleCount))
                : this.providers.filter((provider) => provider.whatsappAlertEligible).length;
              this.radiusKm = Number(body.radiusKm || this.lead.alertDistanceKm || 20);
              this.reason = body.reason || '';
              const availableIds = new Set(this.providers.filter((provider) => provider.whatsappAlertEligible).map((provider) => provider.providerId));
              this.selectedProviderIds = this.selectedProviderIds.filter((providerId) => availableIds.has(providerId));
            } catch (error) {
              this.error = error.message;
            } finally {
              this.loading = false;
            }
          },
          async copyDirectLink(provider) {
            const providerId = String(provider?.providerId || '').trim();
            if (!providerId || this.copyingProviderId) return;
            this.copyingProviderId = providerId;
            this.error = '';
            this.successMessage = '';
            try {
              const body = await apiFetch(
                '/api/enquiry/' + encodeURIComponent(this.leadId)
                  + '/nearby-providers/' + encodeURIComponent(providerId) + '/direct-link',
                { method: 'POST', body: '{}' },
              );
              const url = String(body.data?.url || '').trim();
              if (!url) throw new Error('The direct lead link could not be created.');
              await this.copyText(url);
              const providerName = provider.businessName || provider.name || 'provider';
              this.successMessage = 'Lead link copied for ' + providerName + '.';
              showCrmToast(this.successMessage, 'success');
            } catch (error) {
              this.error = error.message;
              showCrmToast(error.message, 'error');
            } finally {
              this.copyingProviderId = '';
            }
          },
          async sendAlerts(providerIds) {
            if (this.sendingAlerts || !this.canSendAlerts) return;
            const selected = [...new Set((Array.isArray(providerIds) ? providerIds : [])
              .map((providerId) => String(providerId || '').trim())
              .filter(Boolean))];
            if (!selected.length) return;
            this.sendingAlerts = true;
            this.error = '';
            this.successMessage = '';
            try {
              const body = await apiFetch('/api/enquiry/' + encodeURIComponent(this.leadId) + '/nearby-providers/alerts', {
                method: 'POST',
                body: JSON.stringify({ providerIds: selected }),
              });
              const result = body.data || {};
              const alerted = Number(result.alerted || 0);
              const skippedIds = Array.isArray(result.skippedProviderIds) ? result.skippedProviderIds : [];
              if (alerted > 0) {
                this.successMessage = 'WhatsApp sent to ' + alerted + ' provider' + (alerted === 1 ? '' : 's') + '.';
                showCrmToast(this.successMessage, 'success');
              } else {
                this.error = skippedIds.length
                  ? 'WhatsApp was not sent to the selected provider.'
                  : 'WhatsApp was not sent. Check provider eligibility and the communication rule.';
                showCrmToast(this.error, 'warning');
              }
              this.selectedProviderIds = this.selectedProviderIds.filter((providerId) => !selected.includes(providerId));
              if (alerted > 0) await this.load();
            } catch (error) {
              this.error = error.message;
              showCrmToast(error.message, 'error');
            } finally {
              this.sendingAlerts = false;
            }
          },
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>