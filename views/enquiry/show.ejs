<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Lead management</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Review the CRM journey and provider progress after distribution.</p>
              </div>
              <a href="/enquiries" class="btn btn-light crm-primary-action"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to requirements</a>
            </div>
          </div>

          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <div x-data="leadShow()" x-init="load()" :class="loading && 'crm-loading'">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
              <div x-show="success" x-cloak class="alert alert-success" x-text="success"></div>
              <div x-show="lead.isActive === false" x-cloak class="alert alert-warning">
                This lead is deactivated. Its Reference ID and history are preserved, unlocked providers remain accessible, and no new distribution will occur.
                <span x-show="lead.deactivationReason"> Reason: <strong x-text="lead.deactivationReason"></strong></span>
              </div>

              <div class="d-flex flex-wrap gap-2 mb-3">
                <a class="btn btn-light" :href="'/enquiries/'+recordId+'/edit'">Edit</a>
                <button class="btn btn-primary" @click="syncDistribution()" :disabled="lead.isActive === false || !['approved', 'distributed'].includes(currentStatus) || (lead.agentId && lead.agentReferralValidation !== 'valid')" title="Approve and activate the lead before synchronizing providers">Sync providers</button>
                <a class="btn btn-light" :href="providerJourneyUrl">Provider status</a>
                <a class="btn btn-light" :href="'/follow-ups/new?enquiryId='+recordId">Add follow-up</a>
                <a class="btn btn-light" :href="'/communications/new?enquiryId='+recordId">Log communication</a>
                <a class="btn btn-light" :href="'/communications/send?enquiryId='+recordId">Send message</a>
                <button x-show="lead.isActive !== false" class="btn btn-outline-danger ms-auto" @click="deactivateLead()" :disabled="stateSaving">Deactivate</button>
                <button x-show="lead.isActive === false" class="btn btn-primary ms-auto" @click="reactivateLead()" :disabled="stateSaving">Reactivate</button>
              </div>

              <div class="card mb-3">
                <div class="card-header d-flex align-items-center flex-wrap gap-2">
                  <h5 class="mb-0" x-text="lead.requirementTitle || 'Requirement'"></h5>
                  <span class="badge ms-auto" :class="lead.isActive === false ? 'bg-warning bg-opacity-10 text-warning' : (isRejected ? 'bg-danger bg-opacity-10 text-danger' : 'bg-primary bg-opacity-10 text-primary')" x-text="lead.isActive === false ? 'Deactivated' : humanize(currentStatus)"></span>
                </div>
                <div class="card-body">
                  <div class="row g-3">
                    <template x-for="item in summary" :key="item.label">
                      <div class="col-md-4 col-xl-3">
                        <div class="text-muted fs-sm" x-text="item.label"></div>
                        <div class="fw-semibold" x-text="item.value || '—'"></div>
                      </div>
                    </template>
                  </div>
                  <hr />
                  <h6>Additional details</h6>
                  <pre class="crm-json bg-light p-3 rounded mb-0" x-text="JSON.stringify(lead.additionalDetails || {}, null, 2)"></pre>
                </div>
              </div>

              <div class="card mb-3">
                <div class="card-header"><h5 class="mb-0">CRM lead journey</h5></div>
                <div class="card-body">
                  <div class="crm-journey" :class="isRejected && 'crm-journey-rejected'">
                    <template x-for="(step,index) in journeySteps" :key="step">
                      <div class="crm-journey-step" :class="stepClass(step)">
                        <div class="crm-journey-dot" x-text="index + 1"></div>
                        <div class="crm-journey-label" x-text="humanize(step)"></div>
                      </div>
                    </template>
                  </div>
                  <div x-show="isRejected" x-cloak class="alert alert-danger mt-3 mb-0">
                    Rejected from <strong x-text="humanize(lead.metadata?.rejectedFromStatus || 'new')"></strong>
                    <span x-show="lead.metadata?.rejectionReason"> — <span x-text="lead.metadata?.rejectionReason"></span></span>
                  </div>
                </div>
              </div>

              <div class="row g-3">
                <div class="col-xl-8">
                  <div class="card mb-3">
                    <div class="card-header d-flex align-items-center">
                      <h5 class="mb-0">Lead activity timeline</h5>
                      <span class="badge bg-light text-dark ms-auto" x-text="leadTimeline.length + ' events'"></span>
                    </div>
                    <div class="card-body">
                      <div class="crm-timeline" x-show="leadTimeline.length">
                        <template x-for="event in leadTimeline" :key="event.timelineId || event.createdAt || event.message">
                          <div class="crm-timeline-item">
                            <div class="crm-timeline-marker"></div>
                            <div class="crm-timeline-content">
                              <div class="d-flex flex-wrap gap-2 align-items-center">
                                <strong x-text="timelineTitle(event)"></strong>
                                <small class="text-muted" x-text="formatDate(event.createdAt)"></small>
                              </div>
                              <div class="text-muted mt-1" x-show="event.message" x-text="event.message"></div>
                              <div class="mt-1" x-show="event.note"><span class="fw-semibold">Reason/note:</span> <span x-text="event.note"></span></div>
                              <small class="text-muted d-block mt-1">Updated by <span x-text="event.actor || 'system'"></span></small>
                            </div>
                          </div>
                        </template>
                      </div>
                      <div class="text-center text-muted py-3" x-show="!leadTimeline.length">No lead activity recorded</div>
                    </div>
                  </div>

                  <div class="card mb-3">
                    <div class="card-header d-flex align-items-center">
                      <div>
                        <h5 class="mb-1">Communication history</h5>
                        <p class="text-muted mb-0">WhatsApp, email and manually logged contact for this lead.</p>
                      </div>
                      <a class="btn btn-light btn-sm ms-auto" :href="'/communications/send?enquiryId='+recordId">Send message</a>
                    </div>
                    <div class="table-responsive">
                      <table class="table mb-0">
                        <thead><tr><th>Channel</th><th>Purpose</th><th>Status</th><th>Message</th><th>Date</th></tr></thead>
                        <tbody>
                          <template x-for="row in communications" :key="row.communicationId">
                            <tr><td x-text="humanize(row.channel)"></td><td x-text="humanize(row.purpose)"></td><td><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span></td><td><div class="text-truncate" style="max-width:280px" x-text="row.subject || row.message || '—'"></div><div class="text-danger fs-sm" x-show="row.failureReason" x-text="row.failureReason"></div></td><td x-text="formatDate(row.createdAt)"></td></tr>
                          </template>
                          <tr x-show="!communications.length"><td colspan="5" class="text-center text-muted py-4">No communication history</td></tr>
                        </tbody>
                      </table>
                    </div>
                  </div>

                  <div class="card">
                    <div class="card-header d-flex align-items-center">
                      <div>
                        <h5 class="mb-1">Provider status</h5>
                        <p class="text-muted mb-0">Provider journeys are shown in a separate paginated table for scalable viewing.</p>
                      </div>
                      <span class="badge bg-light text-dark ms-auto" x-text="(lead.distributionCount || 0) + ' providers'"></span>
                    </div>
                    <div class="card-body d-flex flex-wrap align-items-center gap-3">
                      <div><div class="text-muted fs-sm">Offers</div><div class="fw-semibold fs-5" x-text="lead.distributionCount || 0"></div></div>
                      <div><div class="text-muted fs-sm">Unlocked</div><div class="fw-semibold fs-5" x-text="lead.unlockedCount || 0"></div></div>
                      <a class="btn btn-primary ms-auto" :href="providerJourneyUrl">View provider status table</a>
                    </div>
                  </div>
                </div>

                <div class="col-xl-4">
                  <div class="card mb-3" x-show="lead.agentId">
                    <div class="card-header"><h5 class="mb-0">Agent referral review</h5></div>
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center mb-3"><span>Referral validation</span><span class="crm-status" :class="statusClass(lead.agentReferralValidation||'pending')" x-text="humanize(lead.agentReferralValidation||'pending')"></span></div>
                      <label class="form-label">Validation decision</label><select class="form-select mb-2" x-model="referralForm.status"><option value="pending">Pending</option><option value="valid">Valid</option><option value="invalid">Invalid</option></select>
                      <label class="form-label" x-show="referralForm.status==='invalid'">Invalid reason</label><select class="form-select mb-2" x-show="referralForm.status==='invalid'" x-model="referralForm.reason"><option value="duplicate">Duplicate</option><option value="incorrect_details">Incorrect details</option><option value="customer_not_interested">Customer not interested</option><option value="fake_referral">Fake referral</option><option value="unreachable">Unreachable</option><option value="outside_assigned_category">Outside assigned category</option><option value="other">Other</option></select>
                      <textarea class="form-control mb-2" rows="3" maxlength="2000" x-model="referralForm.note" placeholder="Mandatory validation note"></textarea><button class="btn btn-primary w-100 mb-3" @click="saveReferralValidation()">Save validation</button>
                      <hr><div class="d-flex justify-content-between align-items-center mb-2"><span>Sale conversion</span><span class="crm-status" :class="statusClass(lead.agentSaleConversion||'pending')" x-text="humanize(lead.agentSaleConversion||'pending')"></span></div>
                      <select class="form-select mb-2" x-model="conversionForm.status"><option value="pending">Pending</option><option value="converted">Converted to sale</option><option value="not_converted">Not converted</option></select><textarea class="form-control mb-2" rows="3" maxlength="2000" x-model="conversionForm.note" placeholder="Mandatory conversion note"></textarea><button class="btn btn-light w-100" @click="saveSaleConversion()">Save conversion</button>
                    </div>
                  </div>
                  <div class="card mb-3">
                    <div class="card-header"><h5 class="mb-0">Update journey status</h5></div>
                    <div class="card-body">
                      <div class="mb-3">
                        <div class="text-muted fs-sm">Current status</div>
                        <div class="fw-semibold fs-5" x-text="humanize(currentStatus)"></div>
                        <small class="text-muted" x-show="lead.statusUpdatedBy">Last updated by <span x-text="lead.statusUpdatedBy"></span> <span x-show="lead.statusUpdatedAt">on <span x-text="formatDate(lead.statusUpdatedAt)"></span></span></small>
                      </div>
                      <label class="form-label">Reason / note</label>
                      <textarea class="form-control mb-3" rows="3" x-model="statusNote" maxlength="1000" :disabled="lead.isActive === false"  :placeholder="lead.agentId ? 'Mandatory for every status change' : 'Required when rejecting; optional for Next or Previous'"></textarea>
                      <div class="d-grid gap-2">
                        <div class="d-flex gap-2">
                          <button class="btn btn-light flex-fill" @click="changeStatus('previous')" :disabled="lead.isActive === false || statusSaving || !canPrevious" x-text="isRejected ? 'Restore previous' : 'Previous'"></button>
                          <button class="btn btn-primary flex-fill" @click="changeStatus('next')" :disabled="lead.isActive === false || statusSaving || !canNext">Next</button>
                        </div>
                        <button class="btn btn-outline-danger" @click="changeStatus('reject')" :disabled="lead.isActive === false || statusSaving || isRejected">Reject lead</button>
                      </div>
                    </div>
                  </div>

                  <div class="card">
                    <div class="card-header"><h5 class="mb-0">Add note</h5></div>
                    <div class="card-body">
                      <textarea class="form-control mb-2" rows="4" x-model="note" maxlength="5000"></textarea>
                      <button class="btn btn-light w-100" @click="addNote()">Add note</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <script>
              function leadShow() {
                return {
                  recordId: pathRecordId(),
                  lead: {},
                  communications: [],
                  note: '',
                  statusNote: '',
                  referralForm: { status: 'pending', reason: 'other', note: '' },
                  conversionForm: { status: 'pending', note: '' },
                  loading: true,
                  statusSaving: false,
                  stateSaving: false,
                  error: '',
                  success: '',
                  journeySteps: ['new', 'verification', 'approved', 'distributed'],
                  get providerJourneyUrl() {
                    return '/enquiries/' + this.recordId + '/providers';
                  },
                  get currentStatus() {
                    return this.lead.journeyStatus || this.lead.status || 'new';
                  },
                  get isRejected() {
                    return this.currentStatus === 'rejected';
                  },
                  get journeyBaseStatus() {
                    return this.isRejected ? (this.lead.metadata?.rejectedFromStatus || 'new') : this.currentStatus;
                  },
                  get canPrevious() {
                    return this.isRejected || this.journeySteps.indexOf(this.journeyBaseStatus) > 0;
                  },
                  get canNext() {
                    const index = this.journeySteps.indexOf(this.journeyBaseStatus);
                    if (this.isRejected || index < 0 || index >= this.journeySteps.length - 1) return false;
                    const target = this.journeySteps[index + 1];
                    if (this.lead.agentId && ['approved','distributed'].includes(target) && this.lead.agentReferralValidation !== 'valid') return false;
                    return true;
                  },
                  get summary() {
                    return [
                      { label: 'Reference ID', value: this.lead.enquiryId },
                      { label: 'Record state', value: this.lead.isActive === false ? 'Deactivated' : 'Active' },
                      { label: 'Customer', value: this.lead.name },
                      { label: 'Mobile', value: this.lead.mobile ? '+91 ' + this.lead.mobile : '' },
                      { label: 'Source', value: this.lead.sourceChannel === 'agent' ? 'Agent Portal' : humanize(this.lead.sourceChannel || 'admin') },
                      { label: 'Referral ID', value: this.lead.referralId || '—' },
                      { label: 'Agent', value: this.lead.agentBusinessName || this.lead.agentName || '—' },
                      { label: 'Customer OTP', value: this.lead.customerMobileVerified ? 'Verified' : 'Not verified' },
                      { label: 'Category', value: this.lead.category || humanize(this.lead.categorySlug) },
                      { label: 'City', value: this.lead.city },
                      { label: 'Price', value: money(this.lead.leadPricePaise) },
                      { label: 'Status', value: humanize(this.currentStatus) },
                      { label: 'Status updated by', value: this.lead.statusUpdatedBy || '—' },
                      { label: 'Distribution', value: (this.lead.distributionCount || 0) + ' offers' },
                      { label: 'Unlocked', value: (this.lead.unlockedCount || 0) + ' providers' }
                    ];
                  },
                  get leadTimeline() {
                    return [...(this.lead.timeline || [])].sort((left, right) => new Date(right.createdAt || 0).getTime() - new Date(left.createdAt || 0).getTime());
                  },
                  stepClass(step) {
                    const stepIndex = this.journeySteps.indexOf(step);
                    const currentIndex = this.journeySteps.indexOf(this.journeyBaseStatus);
                    return {
                      'is-complete': stepIndex < currentIndex,
                      'is-current': stepIndex === currentIndex && !this.isRejected,
                      'is-rejected-stage': stepIndex === currentIndex && this.isRejected
                    };
                  },
                  timelineTitle(event) {
                    if (event.type === 'status_changed') return humanize(event.toStatus || 'Status changed');
                    if (event.type === 'created') return 'Lead created';
                    if (event.type === 'note') return 'Note added';
                    if (event.type === 'deactivated') return 'Lead deactivated';
                    if (event.type === 'reactivated') return 'Lead reactivated';
                    return humanize(event.type || 'Activity');
                  },
                  async load() {
                    this.loading = true;
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId)).data; this.referralForm.status=this.lead.agentReferralValidation||'pending'; this.conversionForm.status=this.lead.agentSaleConversion||'pending';
                      await this.loadCommunications();
                    } catch (error) {
                      this.error = error.message;
                    } finally {
                      this.loading = false;
                    }
                  },
                  async loadCommunications() {
                    try {
                      const body = await apiFetch('/api/communication?enquiryId=' + encodeURIComponent(this.recordId) + '&limit=20');
                      this.communications = body.data || [];
                    } catch (error) {
                      this.error = error.message;
                    }
                  },
                  async changeStatus(action) {
                    this.error = '';
                    this.success = '';
                    if ((this.lead.agentId || action === 'reject') && !this.statusNote.trim()) { this.error = this.lead.agentId ? 'Enter a mandatory note before changing an agent requirement status' : 'Enter a rejection reason before rejecting the lead'; return; }
                    this.statusSaving = true;
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId + '/status', {
                        method: 'POST',
                        body: JSON.stringify({ action, note: this.statusNote })
                      })).data;
                      this.statusNote = '';
                      this.success = 'Lead status updated';
                      await this.loadCommunications();
                    } catch (error) {
                      this.error = error.message;
                    } finally {
                      this.statusSaving = false;
                    }
                  },
                  async saveReferralValidation() { this.error=''; this.success=''; try { if(!this.referralForm.note.trim()) throw new Error('Enter a mandatory validation note'); this.lead=(await apiFetch('/api/enquiry/'+this.recordId+'/referral-validation',{method:'POST',body:JSON.stringify(this.referralForm)})).data; this.referralForm.note=''; this.success='Referral validation updated'; } catch(error){this.error=error.message;} },
                  async saveSaleConversion() { this.error=''; this.success=''; try { if(!this.conversionForm.note.trim()) throw new Error('Enter a mandatory conversion note'); this.lead=(await apiFetch('/api/enquiry/'+this.recordId+'/sale-conversion',{method:'POST',body:JSON.stringify(this.conversionForm)})).data; this.conversionForm.note=''; this.success='Sale conversion updated'; } catch(error){this.error=error.message;} },
                  async addNote() {
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId + '/note', {
                        method: 'POST',
                        body: JSON.stringify({ note: this.note })
                      })).data;
                      this.note = '';
                    } catch (error) {
                      this.error = error.message;
                    }
                  },
                  async syncDistribution() {
                    try {
                      await apiFetch('/api/enquiry/' + this.recordId + '/distribute', { method: 'POST', body: '{}' });
                      await this.load();
                      this.success = 'Providers synchronized';
                    } catch (error) {
                      this.error = error.message;
                    }
                  },
                  async deactivateLead() {
                    const reason = window.prompt('Optional reason for deactivation:', this.lead.deactivationReason || '');
                    if (reason === null) return;
                    if (!window.confirm('Deactivate this lead? The lead will be preserved and cannot be deleted.')) return;
                    this.stateSaving = true;
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId + '/deactivate', {
                        method: 'POST',
                        body: JSON.stringify({ reason })
                      })).data;
                      this.success = 'Lead deactivated';
                    } catch (error) {
                      this.error = error.message;
                    } finally {
                      this.stateSaving = false;
                    }
                  },
                  async reactivateLead() {
                    if (!window.confirm('Reactivate this lead? Eligible provider offers may be synchronized again.')) return;
                    this.stateSaving = true;
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId + '/reactivate', { method: 'POST', body: '{}' })).data;
                      this.success = 'Lead reactivated';
                    } catch (error) {
                      this.error = error.message;
                    } finally {
                      this.stateSaving = false;
                    }
                  }
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
