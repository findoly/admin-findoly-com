<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Lead management</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Review the CRM journey and each provider's progress after distribution.</p>
              </div>
              <a href="/enquiries" class="btn btn-light crm-primary-action"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to requirements</a>
            </div>
          </div>
          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <div x-data="leadShow()" x-init="load()" :class="loading && 'crm-loading'">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
              <div x-show="success" x-cloak class="alert alert-success" x-text="success"></div>

              <div class="d-flex flex-wrap gap-2 mb-3">
                <a class="btn btn-light" :href="'/enquiries/'+recordId+'/edit'">Edit</a>
                <button class="btn btn-primary" @click="syncDistribution()" :disabled="!['approved', 'distributed'].includes(currentStatus)" title="Approve the lead before synchronizing providers">Sync providers</button>
                <a class="btn btn-light" :href="'/follow-ups/new?enquiryId='+recordId">Add follow-up</a>
                <a class="btn btn-light" :href="'/communications/new?enquiryId='+recordId">Log communication</a>
              </div>

              <div class="card mb-3">
                <div class="card-header d-flex align-items-center flex-wrap gap-2">
                  <h5 class="mb-0" x-text="lead.requirementTitle || 'Requirement'"></h5>
                  <span class="badge ms-auto" :class="isRejected ? 'bg-danger bg-opacity-10 text-danger' : 'bg-primary bg-opacity-10 text-primary'" x-text="humanize(currentStatus)"></span>
                </div>
                <div class="card-body">
                  <div class="row g-3">
                    <template x-for="item in summary" :key="item.label">
                      <div class="col-md-4 col-xl-3">
                        <div class="text-muted fs-sm" x-text="item.label"></div>
                        <div class="fw-semibold" x-text="item.value || '—'"></div>
                      </div>
                    </template>
                  </div>
                  <hr />
                  <h6>Additional details</h6>
                  <pre class="crm-json bg-light p-3 rounded mb-0" x-text="JSON.stringify(lead.additionalDetails || {}, null, 2)"></pre>
                </div>
              </div>

              <div class="card mb-3">
                <div class="card-header">
                  <h5 class="mb-0">CRM lead journey</h5>
                </div>
                <div class="card-body">
                  <div class="crm-journey" :class="isRejected && 'crm-journey-rejected'">
                    <template x-for="(step,index) in journeySteps" :key="step">
                      <div class="crm-journey-step" :class="stepClass(step)">
                        <div class="crm-journey-dot" x-text="index + 1"></div>
                        <div class="crm-journey-label" x-text="humanize(step)"></div>
                      </div>
                    </template>
                  </div>
                  <div x-show="isRejected" x-cloak class="alert alert-danger mt-3 mb-0">
                    Rejected from <strong x-text="humanize(lead.metadata?.rejectedFromStatus || 'new')"></strong>
                    <span x-show="lead.metadata?.rejectionReason"> — <span x-text="lead.metadata?.rejectionReason"></span></span>
                  </div>
                </div>
              </div>

              <div class="row g-3">
                <div class="col-xl-8">
                  <div class="card mb-3">
                    <div class="card-header d-flex align-items-center">
                      <h5 class="mb-0">Lead activity timeline</h5>
                      <span class="badge bg-light text-dark ms-auto" x-text="leadTimeline.length + ' events'"></span>
                    </div>
                    <div class="card-body">
                      <div class="crm-timeline" x-show="leadTimeline.length">
                        <template x-for="event in leadTimeline" :key="event.timelineId || event.createdAt || event.message">
                          <div class="crm-timeline-item">
                            <div class="crm-timeline-marker"></div>
                            <div class="crm-timeline-content">
                              <div class="d-flex flex-wrap gap-2 align-items-center">
                                <strong x-text="timelineTitle(event)"></strong>
                                <small class="text-muted" x-text="formatDate(event.createdAt)"></small>
                              </div>
                              <div class="text-muted mt-1" x-show="event.message" x-text="event.message"></div>
                              <div class="mt-1" x-show="event.note"><span class="fw-semibold">Reason/note:</span> <span x-text="event.note"></span></div>
                              <small class="text-muted d-block mt-1">Updated by <span x-text="event.actor || 'system'"></span></small>
                            </div>
                          </div>
                        </template>
                      </div>
                      <div class="text-center text-muted py-3" x-show="!leadTimeline.length">No lead activity recorded</div>
                    </div>
                  </div>

                  <div class="card">
                    <div class="card-header d-flex align-items-center">
                      <h5 class="mb-0">Provider offers and journeys</h5>
                      <span class="badge bg-light text-dark ms-auto" x-text="(lead.distributions || []).length + ' providers'"></span>
                    </div>
                    <div class="card-body p-0">
                      <template x-for="distribution in lead.distributions || []" :key="distribution.leadDistributionId">
                        <div class="crm-provider-journey-card">
                          <div class="crm-provider-journey-head">
                            <div>
                              <a class="fw-semibold" :href="'/providers/'+distribution.providerId" x-text="distribution.providerName || distribution.providerBusinessName || distribution.providerId"></a>
                              <div class="text-muted fs-sm" x-text="distribution.providerBusinessName || distribution.providerMobile || ''"></div>
                            </div>
                            <div class="text-end">
                              <span class="badge bg-light text-dark" x-text="humanize(distribution.status)"></span>
                              <div class="fs-sm text-muted mt-1" x-text="money(distribution.leadPricePaise)"></div>
                            </div>
                          </div>

                          <div class="row g-3 mt-1 mb-3">
                            <div class="col-md-3">
                              <div class="text-muted fs-sm">Contact</div>
                              <div class="fw-semibold" x-text="distribution.contactUnlocked ? 'Unlocked' : 'Locked'"></div>
                            </div>
                            <div class="col-md-3">
                              <div class="text-muted fs-sm">Provider status</div>
                              <div class="fw-semibold" x-text="distribution.providerLeadStatus ? humanize(distribution.providerLeadStatus) : 'Not updated'"></div>
                            </div>
                            <div class="col-md-3">
                              <div class="text-muted fs-sm">Reason</div>
                              <div class="fw-semibold" x-text="distribution.providerLeadReason ? humanize(distribution.providerLeadReason) : '—'"></div>
                            </div>
                            <div class="col-md-3">
                              <div class="text-muted fs-sm">Last provider update</div>
                              <div class="fw-semibold" x-text="formatDate(distribution.providerLeadStatusUpdatedAt)"></div>
                            </div>
                            <div class="col-12" x-show="distribution.providerLeadNote">
                              <div class="crm-provider-note"><strong>Provider note:</strong> <span x-text="distribution.providerLeadNote"></span></div>
                            </div>
                          </div>

                          <div class="crm-provider-timeline">
                            <template x-for="event in distribution.providerJourney || []" :key="(event.type || '') + (event.createdAt || '') + (event.status || '')">
                              <div class="crm-provider-timeline-item">
                                <span class="crm-provider-timeline-dot"></span>
                                <div>
                                  <div class="fw-semibold" x-text="providerEventTitle(event)"></div>
                                  <div class="text-muted fs-sm" x-show="providerEventDetail(event)" x-text="providerEventDetail(event)"></div>
                                  <small class="text-muted" x-text="formatDate(event.createdAt) + ' · ' + (event.actor || 'system')"></small>
                                </div>
                              </div>
                            </template>
                            <div class="text-muted fs-sm" x-show="!(distribution.providerJourney || []).length">No provider journey events</div>
                          </div>
                        </div>
                      </template>
                      <div class="text-center text-muted py-4" x-show="!(lead.distributions || []).length">No matching provider offers</div>
                    </div>
                  </div>
                </div>

                <div class="col-xl-4">
                  <div class="card mb-3">
                    <div class="card-header">
                      <h5 class="mb-0">Update journey status</h5>
                    </div>
                    <div class="card-body">
                      <div class="mb-3">
                        <div class="text-muted fs-sm">Current status</div>
                        <div class="fw-semibold fs-5" x-text="humanize(currentStatus)"></div>
                        <small class="text-muted" x-show="lead.statusUpdatedBy">Last updated by <span x-text="lead.statusUpdatedBy"></span> <span x-show="lead.statusUpdatedAt">on <span x-text="formatDate(lead.statusUpdatedAt)"></span></span></small>
                      </div>
                      <label class="form-label">Reason / note</label>
                      <textarea class="form-control mb-3" rows="3" x-model="statusNote" placeholder="Required when rejecting; optional for Next or Previous"></textarea>
                      <div class="d-grid gap-2">
                        <div class="d-flex gap-2">
                          <button class="btn btn-light flex-fill" @click="changeStatus('previous')" :disabled="statusSaving || !canPrevious" x-text="isRejected ? 'Restore previous' : 'Previous'"></button>
                          <button class="btn btn-primary flex-fill" @click="changeStatus('next')" :disabled="statusSaving || !canNext">Next</button>
                        </div>
                        <button class="btn btn-outline-danger" @click="changeStatus('reject')" :disabled="statusSaving || isRejected">Reject lead</button>
                      </div>
                    </div>
                  </div>

                  <div class="card">
                    <div class="card-header">
                      <h5 class="mb-0">Add note</h5>
                    </div>
                    <div class="card-body">
                      <textarea class="form-control mb-2" rows="4" x-model="note"></textarea>
                      <button class="btn btn-light w-100" @click="addNote()">Add note</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <script>
              function leadShow() {
                return {
                  recordId: pathRecordId(),
                  lead: {},
                  note: "",
                  statusNote: "",
                  loading: true,
                  statusSaving: false,
                  error: "",
                  success: "",
                  journeySteps: ["new", "verification", "approved", "distributed"],
                  get currentStatus() {
                    return this.lead.journeyStatus || this.lead.status || "new";
                  },
                  get isRejected() {
                    return this.currentStatus === "rejected";
                  },
                  get journeyBaseStatus() {
                    return this.isRejected
                      ? (this.lead.metadata?.rejectedFromStatus || "new")
                      : this.currentStatus;
                  },
                  get canPrevious() {
                    return this.isRejected || this.journeySteps.indexOf(this.journeyBaseStatus) > 0;
                  },
                  get canNext() {
                    const index = this.journeySteps.indexOf(this.journeyBaseStatus);
                    return !this.isRejected && index >= 0 && index < this.journeySteps.length - 1;
                  },
                  get summary() {
                    return [
                      { label: "Lead ID", value: this.lead.enquiryId },
                      { label: "Customer", value: this.lead.name },
                      { label: "Mobile", value: this.lead.mobile ? "+91 " + this.lead.mobile : "" },
                      { label: "Category", value: this.lead.category || humanize(this.lead.categorySlug) },
                      { label: "City", value: this.lead.city },
                      { label: "Price", value: money(this.lead.leadPricePaise) },
                      { label: "Status", value: humanize(this.currentStatus) },
                      { label: "Status updated by", value: this.lead.statusUpdatedBy || "—" },
                      { label: "Distribution", value: (this.lead.distributionCount || 0) + " offers" },
                      { label: "Unlocked", value: (this.lead.unlockedCount || 0) + " providers" },
                    ];
                  },
                  get leadTimeline() {
                    return [...(this.lead.timeline || [])].sort((left, right) => {
                      return new Date(right.createdAt || 0).getTime() - new Date(left.createdAt || 0).getTime();
                    });
                  },
                  stepClass(step) {
                    const stepIndex = this.journeySteps.indexOf(step);
                    const currentIndex = this.journeySteps.indexOf(this.journeyBaseStatus);
                    return {
                      "is-complete": stepIndex < currentIndex,
                      "is-current": stepIndex === currentIndex && !this.isRejected,
                      "is-rejected-stage": stepIndex === currentIndex && this.isRejected,
                    };
                  },
                  timelineTitle(event) {
                    if (event.type === "status_changed") return humanize(event.toStatus || "Status changed");
                    if (event.type === "created") return "Lead created";
                    if (event.type === "note") return "Note added";
                    return humanize(event.type || "Activity");
                  },
                  providerEventTitle(event) {
                    if (event.type === "distributed") return "Lead offered";
                    if (event.type === "unlocked") return "Contact unlocked";
                    if (event.status) return "Provider marked " + humanize(event.status);
                    return event.message || "Provider update";
                  },
                  providerEventDetail(event) {
                    const details = [];
                    if (event.reason) details.push(humanize(event.reason));
                    if (event.note) details.push(event.note);
                    if (!details.length && event.message) details.push(event.message);
                    return details.join(" — ");
                  },
                  async load() {
                    this.loading = true;
                    try {
                      this.lead = (await apiFetch("/api/enquiry/" + this.recordId)).data;
                    } catch (e) {
                      this.error = e.message;
                    } finally {
                      this.loading = false;
                    }
                  },
                  async changeStatus(action) {
                    this.error = "";
                    this.success = "";
                    if (action === "reject" && !this.statusNote.trim()) {
                      this.error = "Enter a rejection reason before rejecting the lead";
                      return;
                    }
                    this.statusSaving = true;
                    try {
                      this.lead = (
                        await apiFetch("/api/enquiry/" + this.recordId + "/status", {
                          method: "POST",
                          body: JSON.stringify({ action, note: this.statusNote }),
                        })
                      ).data;
                      this.statusNote = "";
                      this.success = "Lead status updated";
                    } catch (e) {
                      this.error = e.message;
                    } finally {
                      this.statusSaving = false;
                    }
                  },
                  async addNote() {
                    try {
                      this.lead = (
                        await apiFetch("/api/enquiry/" + this.recordId + "/note", {
                          method: "POST",
                          body: JSON.stringify({ note: this.note }),
                        })
                      ).data;
                      this.note = "";
                    } catch (e) {
                      this.error = e.message;
                    }
                  },
                  async syncDistribution() {
                    try {
                      await apiFetch("/api/enquiry/" + this.recordId + "/distribute", {
                        method: "POST",
                        body: "{}",
                      });
                      await this.load();
                    } catch (e) {
                      this.error = e.message;
                    }
                  },
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
