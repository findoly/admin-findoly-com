<%- include('../partials/pageStart') %>
<div x-data="leadShow()" x-init="load()" :class="loading && 'crm-loading'">
  <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
  <div class="d-flex flex-wrap gap-2 mb-3"><a class="btn btn-light" :href="'/enquiries/'+recordId+'/edit'">Edit</a><button class="btn btn-primary" @click="syncDistribution()">Sync providers</button><a class="btn btn-light" :href="'/follow-ups/new?enquiryId='+recordId">Add follow-up</a><a class="btn btn-light" :href="'/communications/new?enquiryId='+recordId">Log communication</a></div>
  <div class="row g-3"><div class="col-xl-8"><div class="card mb-3"><div class="card-header"><h5 class="mb-0" x-text="lead.requirementTitle || 'Requirement'"></h5></div><div class="card-body"><div class="row g-3"><template x-for="item in summary" :key="item.label"><div class="col-md-4"><div class="text-muted fs-sm" x-text="item.label"></div><div class="fw-semibold" x-text="item.value || '—'"></div></div></template></div><hr><h6>Additional details</h6><pre class="crm-json bg-light p-3 rounded" x-text="JSON.stringify(lead.additionalDetails || {}, null, 2)"></pre></div></div>
    <div class="card"><div class="card-header"><h5 class="mb-0">Provider offers</h5></div><div class="table-responsive"><table class="table"><thead><tr><th>Provider</th><th>Status</th><th>Price</th><th>Distributed</th></tr></thead><tbody><template x-for="d in lead.distributions || []" :key="d.leadDistributionId"><tr><td><a :href="'/providers/'+d.providerId" x-text="d.providerName || d.providerSnapshot?.name || d.providerId"></a></td><td x-text="humanize(d.status)"></td><td x-text="money(d.leadPricePaise)"></td><td x-text="formatDate(d.distributedAt)"></td></tr></template><tr x-show="!(lead.distributions||[]).length"><td colspan="4" class="text-center text-muted py-4">No matching provider offers</td></tr></tbody></table></div></div>
  </div><div class="col-xl-4"><div class="card mb-3"><div class="card-header"><h5 class="mb-0">Update status</h5></div><div class="card-body"><select class="form-select mb-2" x-model="lead.status"><template x-for="s in statuses"><option :value="s" x-text="humanize(s)"></option></template></select><button class="btn btn-primary w-100" @click="saveStatus()">Save status</button></div></div><div class="card"><div class="card-header"><h5 class="mb-0">Add note</h5></div><div class="card-body"><textarea class="form-control mb-2" rows="4" x-model="note"></textarea><button class="btn btn-light w-100" @click="addNote()">Add note</button></div></div></div></div>
</div>
<script>
  function leadShow(){return{recordId:<%- JSON.stringify(recordId) %>,lead:{},note:'',loading:true,error:'',statuses:['new','verification_pending','verified','approved','distributed','in_progress','completed','rejected','closed'],get summary(){return[{label:'Lead ID',value:this.lead.enquiryId},{label:'Customer',value:this.lead.name},{label:'Mobile',value:this.lead.mobile},{label:'Category',value:this.lead.category||humanize(this.lead.categorySlug)},{label:'City',value:this.lead.city},{label:'Price',value:money(this.lead.leadPricePaise)},{label:'Status',value:humanize(this.lead.status)},{label:'Distribution',value:(this.lead.distributionCount||0)+' offers'},{label:'Unlocked',value:(this.lead.unlockedCount||0)+' providers'}]},async load(){this.loading=true;try{this.lead=(await apiFetch('/api/enquiry/'+this.recordId)).data;}catch(e){this.error=e.message;}finally{this.loading=false;}},async saveStatus(){try{this.lead=(await apiFetch('/api/enquiry/'+this.recordId,{method:'PUT',body:JSON.stringify({status:this.lead.status})})).data;}catch(e){this.error=e.message;}},async addNote(){try{this.lead=(await apiFetch('/api/enquiry/'+this.recordId+'/note',{method:'POST',body:JSON.stringify({note:this.note})})).data;this.note='';}catch(e){this.error=e.message;}},async syncDistribution(){try{await apiFetch('/api/enquiry/'+this.recordId+'/distribute',{method:'POST',body:'{}'});await this.load();}catch(e){this.error=e.message;}}}}
</script>
<%- include('../partials/pageEnd') %>
