<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Lead management</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Complete mandatory actions quickly, then review provider progress and activity.</p>
              </div>
              <a href="/enquiries" class="btn btn-light crm-primary-action"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to requirements</a>
            </div>
          </div>

          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <div x-data="leadShow()" x-init="load()" :class="loading && 'crm-loading'">
              <div x-show="lead.isActive === false" x-cloak class="alert alert-warning">
                This lead is deactivated. Its Reference ID and history are preserved, unlocked providers remain accessible, and it is hidden from the marketplace.
                <span x-show="lead.deactivationReason"> Reason: <strong x-text="lead.deactivationReason"></strong></span>
              </div>

              <div class="d-flex flex-wrap gap-2 mb-3">
                <a class="btn btn-light" :href="'/enquiries/'+recordId+'/edit'">Edit</a>
                <a class="btn btn-light" :href="providerJourneyUrl">Provider status</a>
                <a x-show="['valid', 'invalid'].includes(lead.agentReferralValidation) || qualificationComplete" x-cloak class="btn btn-light" :href="'/enquiries/'+recordId+'/review'">View validation & qualification</a>
                <a class="btn btn-light" :href="'/follow-ups/new?enquiryId='+recordId">Add follow-up</a>
                <a class="btn btn-light" :href="'/communications/new?enquiryId='+recordId">Log communication</a>
                <a class="btn btn-light" :href="'/communications/send?enquiryId='+recordId">Send message</a>
                <button x-show="lead.isActive === false" class="btn btn-primary ms-auto" @click="reactivateLead()" :disabled="stateSaving">Reactivate</button>
              </div>

              <section class="card crm-lead-command-center mb-3">
                <div class="card-header crm-card-heading">
                  <div>
                    <div class="crm-page-eyebrow">Fast actions</div>
                    <h2 class="card-title mb-1">Lead action centre</h2>
                    <p class="text-muted mb-0">Complete the highlighted requirement before moving to the next action.</p>
                  </div>
                  <span class="crm-status" :class="statusClass(currentStatus)" x-text="humanize(currentStatus)"></span>
                </div>
                <div class="card-body">
                  <div class="crm-lead-action-grid">
                    <article class="crm-lead-action-card crm-validation-action" :class="{'is-required': !validationReady && !providerControlled, 'is-complete': lead.agentReferralValidation === 'valid', 'is-invalid': lead.agentReferralValidation === 'invalid'}">
                      <div class="crm-action-heading">
                        <span class="crm-action-step">1</span>
                        <div>
                          <h3>Lead validation</h3>
                          <p>Mandatory before qualification and journey actions.</p>
                        </div>
                        <span class="crm-status ms-auto" :class="statusClass(lead.agentReferralValidation || 'pending')" x-text="humanize(lead.agentReferralValidation || 'pending')"></span>
                      </div>

                      <div x-show="providerControlled" x-cloak class="crm-action-lock">
                        <strong>Lead validation locked after approval</strong>
                        <span>This lead is already published to providers. Provider outcomes control sale conversion.</span>
                      </div>

                      <div x-show="!providerControlled" x-cloak>
                        <label class="form-label">Decision</label>
                        <div class="crm-decision-options mb-2">
                          <label :class="{'is-selected is-valid': referralForm.status === 'valid'}">
                            <input type="radio" value="valid" x-model="referralForm.status">
                            <span>Valid</span>
                          </label>
                          <label :class="{'is-selected is-invalid': referralForm.status === 'invalid'}">
                            <input type="radio" value="invalid" x-model="referralForm.status">
                            <span>Invalid</span>
                          </label>
                        </div>
                        <label class="form-label">Validation method</label>
                        <select class="form-select mb-2" x-model="referralForm.method">
                          <option value="">Select how the lead was validated</option>
                          <option value="phone_call">Phone call</option>
                          <option value="whatsapp">WhatsApp</option>
                          <option value="email">Email</option>
                          <option value="in_person">In person</option>
                          <option value="other">Other</option>
                        </select>
                        <div x-show="referralForm.status === 'invalid'" x-cloak>
                          <label class="form-label">Invalid reason</label>
                          <select class="form-select mb-2" x-model="referralForm.reason">
                            <option value="">Select why the lead is invalid</option>
                            <option value="duplicate">Duplicate</option>
                            <option value="incorrect_details">Incorrect details</option>
                            <option value="customer_not_interested">Customer not interested</option>
                            <option value="fake_referral">Fake referral</option>
                            <option value="unreachable">Unreachable</option>
                            <option value="outside_assigned_category">Outside assigned category</option>
                            <option value="other">Other</option>
                          </select>
                        </div>
                        <label class="form-label" x-text="referralForm.method === 'other' ? 'How was this lead validated?' : (referralForm.status === 'invalid' ? 'Invalid lead note' : 'Validation note (optional)')"></label>
                        <textarea class="form-control mb-2" rows="2" maxlength="2000" x-model="referralForm.note" :placeholder="referralForm.method === 'other' ? 'Describe the validation method' : (referralForm.status === 'invalid' ? 'Explain why this lead is invalid' : 'Add a short verification note, if useful')"></textarea>
                        <button class="btn btn-primary w-100" @click="saveReferralValidation()" :disabled="referralSaving || !referralForm.status || !referralForm.method">
                          <span x-text="referralSaving ? 'Saving…' : 'Save validation'"></span>
                        </button>
                        <p class="crm-action-help mb-0 mt-2" x-show="referralForm.status === 'invalid'">Saving Invalid will automatically move this lead to Rejected.</p>
                        <p class="crm-action-help mb-0 mt-2" x-show="referralForm.method === 'other'">Please explain the validation method before saving.</p>
                      </div>
                    </article>

                    <article class="crm-lead-action-card" :class="{'is-required': validationReady && !qualificationComplete && !providerControlled && !isRejected, 'is-complete': qualificationComplete, 'is-locked': !validationReady || providerControlled || isRejected}">
                      <div class="crm-action-heading">
                        <span class="crm-action-step">2</span>
                        <div>
                          <h3>Lead qualification</h3>
                          <p>Six selectable answers calculate price, intent and priority.</p>
                        </div>
                        <span class="crm-status ms-auto" :class="qualificationComplete ? 'status-approved' : 'status-pending'" x-text="qualificationComplete ? 'Qualified' : 'Pending'"></span>
                      </div>

                      <div x-show="!validationReady && !providerControlled" x-cloak class="crm-action-lock crm-action-lock-warning">
                        <strong>Complete lead validation first</strong>
                        <span>Mark the lead Valid before answering qualification questions.</span>
                      </div>

                      <div x-show="validationReady && isRejected && !providerControlled" x-cloak class="crm-action-lock crm-action-lock-warning">
                        <strong>Restore the rejected lead first</strong>
                        <span>Use Restore previous in Journey status before completing lead qualification.</span>
                      </div>

                      <div x-show="providerControlled" x-cloak class="crm-action-lock">
                        <strong>Qualification locked after approval</strong>
                        <span x-show="qualificationComplete" x-text="'Final price ' + money(qualification.final?.leadPricePaise || lead.leadPricePaise) + ' · ' + humanize(qualification.final?.leadIntent || lead.leadIntent || 'low') + ' intent · ' + humanize(qualification.final?.priority || lead.priority || 'normal') + ' priority'"></span>
                        <span x-show="!qualificationComplete">This lead was already provider-controlled before qualification was completed.</span>
                      </div>

                      <div x-show="validationReady && !providerControlled && !isRejected" x-cloak>
                        <div x-show="qualificationLoading" class="text-muted mb-2">Loading qualification…</div>
                        <template x-for="question in qualification.questions" :key="question.id">
                          <div class="mb-3">
                            <label class="form-label" x-text="question.prompt"></label>
                            <select class="form-select" x-model="qualificationAnswers[question.id]" @change="qualificationAnswerChanged()" :disabled="qualificationSaving || isRejected">
                              <option value="">Select an answer</option>
                              <template x-for="option in question.options" :key="question.id + '-' + option.id">
                                <option :value="option.id" x-text="option.label"></option>
                              </template>
                            </select>
                          </div>
                        </template>

                        <div x-show="qualificationPreviewing" class="text-muted mb-2">Calculating qualification…</div>
                        <div x-show="qualification.system" x-cloak>
                          <div class="alert alert-light border mb-3">
                            <div class="fw-semibold mb-1">System calculation</div>
                            <div class="small">
                              Price score <strong x-text="qualification.system?.priceScorePercent + '%'"></strong>
                              → rounded to <strong x-text="qualification.system?.roundedPricePercent + '%'"></strong>
                              of Category maximum <strong x-text="money(qualification.system?.categoryMaxLeadPricePaise)"></strong>.
                            </div>
                            <div class="small mt-1">
                              Suggested price <strong x-text="money(qualification.system?.leadPricePaise)"></strong>
                              · Intent <strong x-text="humanize(qualification.system?.leadIntent)"></strong>
                              · Priority <strong x-text="humanize(qualification.system?.priority)"></strong>
                            </div>
                          </div>

                          <div class="row g-2 mb-3">
                            <div class="col-md-4">
                              <label class="form-label">Final lead price (₹)</label>
                              <input type="number" class="form-control" min="0" step="10" :max="Number(qualification.categoryMaxLeadPricePaise || 0) / 100" x-model.number="qualificationFinal.leadPriceRupees">
                            </div>
                            <div class="col-md-4">
                              <label class="form-label">Final intent</label>
                              <select class="form-select" x-model="qualificationFinal.leadIntent">
                                <option value="low">Low</option>
                                <option value="medium">Medium</option>
                                <option value="high">High</option>
                              </select>
                            </div>
                            <div class="col-md-4">
                              <label class="form-label">Final priority</label>
                              <select class="form-select" x-model="qualificationFinal.priority">
                                <option value="low">Low</option>
                                <option value="normal">Normal</option>
                                <option value="high">High</option>
                                <option value="urgent">Urgent</option>
                              </select>
                            </div>
                          </div>

                          <button class="btn btn-primary w-100" @click="saveQualification()" :disabled="qualificationSaving || !qualificationAnswersComplete || isRejected">
                            <span x-text="qualificationSaving ? 'Saving…' : (qualificationComplete ? 'Update qualification' : 'Complete qualification')"></span>
                          </button>
                          <p class="crm-action-help mb-0 mt-2">System values are suggestions. Final price, intent and priority remain editable until approval. Price cannot exceed the Category maximum.</p>
                        </div>
                        <div x-show="!qualification.system && !qualificationPreviewing" class="crm-action-help">Answer all six questions to calculate the qualification.</div>
                      </div>
                    </article>

                    <article class="crm-lead-action-card crm-requirement-action" :class="{'is-required': validationReady && qualificationComplete && !requirementApproved && !providerControlled && !isRejected, 'is-complete': requirementApproved, 'is-locked': !validationReady || !qualificationComplete || providerControlled || isRejected}">
                      <div class="crm-action-heading">
                        <span class="crm-action-step">3</span>
                        <div>
                          <h3>Customer requirement</h3>
                          <p>Capture the customer's need, then use AI to prepare clear provider-facing wording.</p>
                        </div>
                        <span class="crm-status ms-auto" :class="requirementApproved ? 'status-approved' : 'status-pending'" x-text="requirementApproved ? 'Approved' : (providerControlled ? 'Not captured' : (requirementForm.status === 'ready' ? 'Ready' : (requirementForm.status === 'clarify' ? 'Clarify' : 'Pending')))"></span>
                      </div>

                      <div x-show="providerControlled" x-cloak class="crm-action-lock">
                        <strong x-text="requirementApproved ? 'Customer requirement approved' : 'AI requirement was not captured for this existing approved lead'"></strong>
                        <span x-show="!requirementApproved">The lead remains approved and existing provider access is unchanged.</span>
                        <span x-show="lead.providerRequirementTitle" x-text="lead.providerRequirementTitle"></span>
                        <span x-show="lead.providerRequirementDetails" x-text="lead.providerRequirementDetails"></span>
                      </div>

                      <div x-show="!validationReady && !providerControlled" x-cloak class="crm-action-lock crm-action-lock-warning">
                        <strong>Complete lead validation first</strong>
                        <span>Mark the lead Valid before preparing the customer requirement.</span>
                      </div>
                      <div x-show="validationReady && !qualificationComplete && !providerControlled && !isRejected" x-cloak class="crm-action-lock crm-action-lock-warning">
                        <strong>Complete lead qualification first</strong>
                        <span>Save all six qualification answers before preparing provider-facing requirement wording.</span>
                      </div>
                      <div x-show="validationReady && isRejected && !providerControlled" x-cloak class="crm-action-lock crm-action-lock-warning">
                        <strong>Restore the rejected lead first</strong>
                        <span>The customer requirement can only be approved for an active lead.</span>
                      </div>

                      <div x-show="validationReady && qualificationComplete && !providerControlled && !isRejected" x-cloak>
                        <label class="form-label">Customer requirement</label>
                        <textarea
                          class="form-control mb-2"
                          rows="4"
                          maxlength="5000"
                          x-model="requirementForm.raw"
                          @input="requirementInputChanged()"
                          :disabled="requirementGenerating || requirementApproving"
                          placeholder="Write what the customer wants to buy, obtain, repair, install, rent, source or get done."
                        ></textarea>
                        <div class="form-text mb-2">Enter the customer's actual need in your own words. AI performs only a low-level clarity check and must not invent missing facts.</div>

                        <button class="btn btn-light w-100 mb-3" @click="generateRequirement()" :disabled="requirementGenerating || requirementApproving || !requirementForm.raw.trim()">
                          <span x-text="requirementGenerating ? 'Checking with AI…' : (requirementForm.status ? 'Generate again' : 'Check with AI')"></span>
                        </button>

                        <div x-show="requirementForm.status === 'clarify'" x-cloak class="alert alert-warning mb-3">
                          <div class="fw-semibold">Please clarify the requirement</div>
                          <div class="small mt-1" x-text="requirementForm.clarificationMessage"></div>
                          <div class="small mt-2">Update the customer requirement above and check again.</div>
                        </div>

                        <div x-show="requirementForm.status === 'ready'" x-cloak>
                          <div class="alert alert-success mb-3">
                            <div class="fw-semibold">AI wording is ready for employee review</div>
                            <div class="small mt-1">You may correct the wording before approval, but do not add facts the customer did not provide.</div>
                          </div>

                          <div class="mb-3">
                            <label class="form-label">WhatsApp requirement <span class="text-muted">(maximum 20 words)</span></label>
                            <input class="form-control" maxlength="300" x-model="requirementForm.providerTitle" :disabled="requirementApproving">
                            <div class="form-text"><span x-text="requirementTitleWords"></span> / 20 words · used in the provider Meta alert.</div>
                          </div>

                          <div class="mb-3">
                            <label class="form-label">Provider requirement details <span class="text-muted">(maximum 100 words)</span></label>
                            <textarea class="form-control" rows="4" maxlength="2000" x-model="requirementForm.providerDetails" :disabled="requirementApproving"></textarea>
                            <div class="form-text"><span x-text="requirementDetailsWords"></span> / 100 words · shown after the provider opens the enquiry.</div>
                          </div>

                          <button class="btn btn-primary w-100" @click="approveRequirement()" :disabled="requirementApproving || requirementGenerating || !requirementReadyToApprove">
                            <span x-text="requirementApproving ? 'Approving…' : 'Approve requirement & lead'"></span>
                          </button>
                          <p class="crm-action-help mb-0 mt-2">Approval saves both provider texts and moves this lead to Approved using the existing marketplace publication flow.</p>
                        </div>
                      </div>
                    </article>

                    <article class="crm-lead-action-card crm-journey-action" :class="{'is-locked': !validationReady || !qualificationComplete || providerControlled}">
                      <div class="crm-action-heading">
                        <span class="crm-action-step">4</span>
                        <div>
                          <h3>Journey status</h3>
                          <p>Move one stage at a time with a recorded note.</p>
                        </div>
                      </div>

                      <div class="crm-current-action-status">
                        <span>Current status</span>
                        <strong x-text="humanize(currentStatus)"></strong>
                        <small x-show="lead.statusUpdatedBy">Updated by <span x-text="lead.statusUpdatedBy"></span><span x-show="lead.statusUpdatedAt"> · <span x-text="formatDate(lead.statusUpdatedAt)"></span></span></small>
                      </div>

                      <div x-show="providerControlled" x-cloak class="crm-action-lock">
                        <strong>Employee journey actions are locked</strong>
                        <span>An approved lead is automatically published and cannot move backward. Provider confirmation controls the separate sale-conversion result.</span>
                      </div>
                      <div x-show="!validationReady && !providerControlled" x-cloak class="crm-action-lock crm-action-lock-warning">
                        <strong>Complete lead validation first</strong>
                        <span>Mark the lead Valid to unlock qualification and journey actions, or Invalid to reject it automatically.</span>
                      </div>
                      <div x-show="validationReady && !qualificationComplete && !providerControlled && !isRejected" x-cloak class="crm-action-lock crm-action-lock-warning">
                        <strong>Complete lead qualification first</strong>
                        <span>Answer all six qualification questions and save the final price, intent and priority before moving forward.</span>
                      </div>

                      <div x-show="validationReady && !providerControlled" x-cloak>
                        <label class="form-label">Reason / note</label>
                        <textarea class="form-control mb-2" rows="2" x-model="statusNote" maxlength="1000" :disabled="lead.isActive === false" :placeholder="lead.agentId ? 'Mandatory for every status change' : 'Required when rejecting; optional for Next or Previous'"></textarea>
                        <div class="d-flex gap-2 mb-2">
                          <button class="btn btn-light flex-fill" @click="changeStatus('previous')" :disabled="lead.isActive === false || statusSaving || !canPrevious" x-text="isRejected ? 'Restore previous' : 'Previous'"></button>
                          <button class="btn btn-primary flex-fill" @click="changeStatus('next')" :disabled="lead.isActive === false || statusSaving || !canNext">Next</button>
                        </div>
                        <button class="btn btn-outline-danger w-100" @click="changeStatus('reject')" :disabled="lead.isActive === false || statusSaving || !canReject">Reject lead</button>
                      </div>
                    </article>

                    <article class="crm-lead-action-card crm-conversion-action" :class="{'is-complete': lead.providerSaleConversionStatus === 'converted'}">
                      <div class="crm-action-heading">
                        <span class="crm-action-step">5</span>
                        <div>
                          <h3>Sale conversion</h3>
                          <p>Read-only and calculated from unlocked providers.</p>
                        </div>
                        <span class="crm-status ms-auto" :class="lead.providerSaleConversionStatus === 'converted' ? 'status-sale-converted' : 'status-pending'" x-text="saleConversionLabel"></span>
                      </div>
                      <div class="crm-conversion-summary">
                        <strong x-text="lead.unlockedCount ? (lead.providerConfirmedCount || 0) : '—'"></strong>
                        <span x-text="lead.unlockedCount ? 'providers currently Confirmed' : 'Available after the first unlock'"></span>
                      </div>
                      <p class="mb-2" x-text="saleConversionMessage"></p>
                      <a class="btn btn-light w-100" :href="providerJourneyUrl">Review provider statuses</a>
                    </article>
                  </div>
                </div>
              </section>

              <div class="card mb-3 crm-lead-summary-card">
                <div class="card-header d-flex align-items-center flex-wrap gap-2">
                  <h5 class="mb-0" x-text="lead.requirementTitle || 'Requirement'"></h5>
                  <span class="crm-status ms-auto" :class="lead.isActive === false ? 'status-inactive' : statusClass(currentStatus)" x-text="lead.isActive === false ? 'Deactivated' : humanize(currentStatus)"></span>
                </div>
                <div class="card-body">
                  <div class="row g-3">
                    <template x-for="item in summary" :key="item.label">
                      <div class="col-md-4 col-xl-3">
                        <div class="text-muted fs-sm" x-text="item.label"></div>
                        <div class="fw-semibold" x-text="item.value || '—'"></div>
                      </div>
                    </template>
                  </div>
                  <details class="crm-details-panel mt-3">
                    <summary>Additional details</summary>
                    <pre class="crm-json bg-light p-3 rounded mb-0 mt-2" x-text="JSON.stringify(lead.additionalDetails || {}, null, 2)"></pre>
                  </details>
                </div>
              </div>

              <div class="card mb-3">
                <div class="card-header"><h5 class="mb-0">CRM lead journey</h5></div>
                <div class="card-body">
                  <div class="crm-journey" :class="isRejected && 'crm-journey-rejected'">
                    <template x-for="(step,index) in journeySteps" :key="step">
                      <div class="crm-journey-step" :class="stepClass(step)">
                        <div class="crm-journey-dot" x-text="index + 1"></div>
                        <div class="crm-journey-label" x-text="humanize(step)"></div>
                      </div>
                    </template>
                  </div>
                  <div x-show="isRejected" x-cloak class="alert alert-danger mt-3 mb-0">
                    Rejected from <strong x-text="humanize(lead.metadata?.rejectedFromStatus || 'new')"></strong>
                    <span x-show="lead.metadata?.rejectionReason"> — <span x-text="lead.metadata?.rejectionReason"></span></span>
                  </div>
                </div>
              </div>

              <div class="row g-3">
                <div class="col-xl-8">
                  <div class="card mb-3">
                    <div class="card-header d-flex align-items-center">
                      <h5 class="mb-0">Lead activity timeline</h5>
                      <span class="badge bg-light text-dark ms-auto" x-text="leadTimeline.length + ' events'"></span>
                    </div>
                    <div class="card-body">
                      <div class="crm-timeline" x-show="leadTimeline.length">
                        <template x-for="event in leadTimeline" :key="event.timelineId || event.createdAt || event.message">
                          <div class="crm-timeline-item">
                            <div class="crm-timeline-marker"></div>
                            <div class="crm-timeline-content">
                              <div class="d-flex flex-wrap gap-2 align-items-center">
                                <strong x-text="timelineTitle(event)"></strong>
                                <small class="text-muted" x-text="formatDate(event.createdAt)"></small>
                              </div>
                              <div class="text-muted mt-1" x-show="event.message" x-text="event.message"></div>
                              <div class="mt-1" x-show="event.method"><span class="fw-semibold">Validation method:</span> <span x-text="humanize(event.method)"></span></div>
                              <div class="mt-1" x-show="event.note"><span class="fw-semibold">Reason/note:</span> <span x-text="event.note"></span></div>
                              <small class="text-muted d-block mt-1">Updated by <span x-text="event.actor || 'system'"></span></small>
                            </div>
                          </div>
                        </template>
                      </div>
                      <div class="text-center text-muted py-3" x-show="!leadTimeline.length">No lead activity recorded</div>
                    </div>
                  </div>

                  <div class="card mb-3">
                    <div class="card-header d-flex align-items-center">
                      <div>
                        <h5 class="mb-1">Communication history</h5>
                        <p class="text-muted mb-0">WhatsApp, email and manually logged contact for this lead.</p>
                      </div>
                      <a class="btn btn-light btn-sm ms-auto" :href="'/communications/send?enquiryId='+recordId">Send message</a>
                    </div>
                    <div class="table-responsive">
                      <table class="table mb-0">
                        <thead><tr><th>Channel</th><th>Purpose</th><th>Status</th><th>Message</th><th>Date</th></tr></thead>
                        <tbody>
                          <template x-for="row in communications" :key="row.communicationId">
                            <tr><td x-text="humanize(row.channel)"></td><td x-text="humanize(row.purpose)"></td><td><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span></td><td><div class="text-truncate" style="max-width:280px" x-text="row.subject || row.message || '—'"></div><div class="text-danger fs-sm" x-show="row.failureReason" x-text="row.failureReason"></div></td><td x-text="formatDate(row.createdAt)"></td></tr>
                          </template>
                          <tr x-show="!communications.length"><td colspan="5" class="text-center text-muted py-4">No communication history</td></tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>

                <div class="col-xl-4">
                  <div class="card mb-3 crm-sticky-side-card">
                    <div class="card-header d-flex align-items-center">
                      <div>
                        <h5 class="mb-1">Provider status</h5>
                        <p class="text-muted mb-0">Live conversion inputs.</p>
                      </div>
                      <span class="badge bg-light text-dark ms-auto" x-text="(lead.unlockedCount || 0) + ' of ' + (lead.maxProviderUnlocks || 5) + ' unlocked'"></span>
                    </div>
                    <div class="card-body">
                      <div class="crm-provider-stat-grid mb-3">
                        <div><span>Unlock limit</span><strong x-text="lead.maxProviderUnlocks || 5"></strong></div>
                        <div><span>Unlocked</span><strong x-text="lead.unlockedCount || 0"></strong></div>
                        <div><span>Remaining</span><strong x-text="lead.remainingUnlocks || 0"></strong></div>
                        <div><span>Confirmed</span><strong x-text="lead.providerConfirmedCount || 0"></strong></div>
                      </div>
                      <a class="btn btn-primary w-100" :href="providerJourneyUrl">View provider status table</a>
                    </div>
                  </div>

                  <div class="card">
                    <div class="card-header"><h5 class="mb-0">Add note</h5></div>
                    <div class="card-body">
                      <textarea class="form-control mb-2" rows="4" x-model="note" maxlength="5000" placeholder="Add an internal note to the activity timeline"></textarea>
                      <button class="btn btn-light w-100" @click="addNote()" :disabled="noteSaving || !note.trim()" x-text="noteSaving ? 'Adding…' : 'Add note'"></button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <script>
              function leadShow() {
                return {
                  recordId: pathRecordId(),
                  lead: {},
                  communications: [],
                  note: '',
                  statusNote: '',
                  referralForm: { status: '', method: '', reason: '', note: '' },
                  qualification: { questions: [], answers: {}, system: null, final: null, completed: false, locked: false, categoryMaxLeadPricePaise: 10000 },
                  qualificationAnswers: {},
                  qualificationFinal: { leadPriceRupees: 0, leadIntent: '', priority: '' },
                  requirementForm: {
                    raw: '',
                    status: '',
                    clarificationReason: '',
                    clarificationMessage: '',
                    providerTitle: '',
                    providerDetails: '',
                    generatedAt: null,
                    approvedAt: null
                  },
                  requirementGeneratedRaw: '',
                  loading: true,
                  statusSaving: false,
                  referralSaving: false,
                  qualificationLoading: false,
                  qualificationPreviewing: false,
                  qualificationSaving: false,
                  requirementGenerating: false,
                  requirementApproving: false,
                  noteSaving: false,
                  stateSaving: false,
                  journeySteps: ['new', 'verification', 'approved'],
                  get providerJourneyUrl() {
                    return '/enquiries/' + this.recordId + '/providers';
                  },
                  get currentStatus() {
                    return this.lead.journeyStatus || this.lead.status || 'new';
                  },
                  get isRejected() {
                    return this.currentStatus === 'rejected';
                  },
                  get providerControlled() {
                    return this.currentStatus === 'approved';
                  },
                  get validationReady() {
                    return this.lead.agentReferralValidation === 'valid';
                  },
                  get qualificationComplete() {
                    return this.qualification?.completed === true;
                  },
                  get qualificationAnswersComplete() {
                    const questions = Array.isArray(this.qualification?.questions) ? this.qualification.questions : [];
                    return questions.length === 6 && questions.every((question) => Boolean(this.qualificationAnswers?.[question.id]));
                  },
                  get requirementApproved() {
                    return Boolean(
                      this.lead.requirementAiApprovedAt
                      && this.lead.providerRequirementTitle
                      && this.lead.providerRequirementDetails
                    );
                  },
                  get requirementTitleWords() {
                    return this.wordCount(this.requirementForm.providerTitle);
                  },
                  get requirementDetailsWords() {
                    return this.wordCount(this.requirementForm.providerDetails);
                  },
                  get requirementReadyToApprove() {
                    return this.requirementForm.status === 'ready'
                      && Boolean(this.requirementForm.providerTitle.trim())
                      && Boolean(this.requirementForm.providerDetails.trim())
                      && this.requirementTitleWords <= 20
                      && this.requirementDetailsWords <= 100;
                  },
                  get journeyBaseStatus() {
                    return this.isRejected ? (this.lead.metadata?.rejectedFromStatus || 'new') : this.currentStatus;
                  },
                  get canPrevious() {
                    return !this.providerControlled && this.validationReady && (this.isRejected || this.journeySteps.indexOf(this.journeyBaseStatus) > 0);
                  },
                  get canNext() {
                    if (this.providerControlled || !this.validationReady || !this.qualificationComplete || this.isRejected) return false;
                    if (this.journeyBaseStatus === 'verification' && !this.requirementApproved) return false;
                    const employeeSteps = this.journeySteps;
                    const index = employeeSteps.indexOf(this.journeyBaseStatus);
                    return index >= 0 && index < employeeSteps.length - 1;
                  },
                  get canReject() {
                    return !this.providerControlled && this.validationReady && !this.isRejected;
                  },
                  get saleConversionLabel() {
                    if (this.lead.providerSaleConversionStatus === 'converted') return 'Sale converted';
                    if (this.lead.unlockedCount) return 'Awaiting confirmation';
                    return 'No provider unlocks';
                  },
                  get saleConversionMessage() {
                    const count = Number(this.lead.providerConfirmedCount || 0);
                    if (this.lead.providerSaleConversionStatus === 'converted') {
                      return count + ' unlocked provider' + (count === 1 ? ' is' : 's are') + ' currently Confirmed.';
                    }
                    if (this.lead.unlockedCount) {
                      return 'The sale-conversion result changes automatically when an unlocked provider marks the lead Confirmed.';
                    }
                    return 'Sale conversion begins after a provider unlocks the approved marketplace lead.';
                  },
                  get summary() {
                    return [
                      { label: 'Reference ID', value: this.lead.enquiryId },
                      { label: 'Record state', value: this.lead.isActive === false ? 'Deactivated' : 'Active' },
                      { label: 'Customer', value: this.lead.name },
                      { label: 'Mobile', value: this.lead.mobile ? '+91 ' + this.lead.mobile : '' },
                      { label: 'Source', value: this.lead.sourceChannel === 'agent' ? 'Agent Portal' : humanize(this.lead.sourceChannel || 'admin') },
                      { label: 'Referral ID', value: this.lead.referralId || '—' },
                      { label: 'Agent', value: this.lead.agentBusinessName || this.lead.agentName || '—' },
                      { label: 'Customer OTP', value: this.lead.customerMobileVerified ? 'Verified' : 'Not verified' },
                      { label: 'Category', value: this.lead.category || humanize(this.lead.categorySlug) },
                      { label: 'Service Types', value: Array.isArray(this.lead.serviceTypes) && this.lead.serviceTypes.length ? this.lead.serviceTypes.map((item) => item.name || item).filter(Boolean).join(', ') : (this.lead.serviceType || '—') },
                      { label: 'Intent', value: this.lead.leadIntent ? humanize(this.lead.leadIntent) + ' intent' : 'Not qualified' },
                      { label: 'Priority', value: humanize(this.lead.priority || 'normal') + ' priority' },
                      { label: 'City', value: this.lead.city },
                      { label: 'Price', value: money(this.lead.leadPricePaise) },
                      { label: 'Status', value: humanize(this.currentStatus) },
                      { label: 'Marketplace', value: this.lead.marketplaceAvailable ? 'Published' : humanize(this.lead.marketplaceStatus || 'draft') },
                      { label: 'Unlock capacity', value: (this.lead.unlockedCount || 0) + ' of ' + (this.lead.maxProviderUnlocks || 5) },
                      { label: 'Confirmed', value: (this.lead.providerConfirmedCount || 0) + ' providers' }
                    ];
                  },
                  get leadTimeline() {
                    return [...(this.lead.timeline || [])].sort((left, right) => new Date(right.createdAt || 0).getTime() - new Date(left.createdAt || 0).getTime());
                  },
                  notify(message, type = 'success') {
                    showCrmToast(message, type);
                  },
                  wordCount(value) {
                    const text = String(value || '').replace(/[\r\n\t]+/g, ' ').replace(/\s{2,}/g, ' ').trim();
                    return text ? text.split(/\s+/).length : 0;
                  },
                  applyRequirement(data = {}) {
                    this.requirementForm = {
                      raw: data.customerRequirementRaw ?? data.raw ?? this.lead.customerRequirementRaw ?? '',
                      status: data.status ?? data.requirementAiStatus ?? this.lead.requirementAiStatus ?? '',
                      clarificationReason: data.clarificationReason ?? data.requirementAiClarificationReason ?? this.lead.requirementAiClarificationReason ?? '',
                      clarificationMessage: data.clarificationMessage ?? data.requirementAiClarificationMessage ?? this.lead.requirementAiClarificationMessage ?? '',
                      providerTitle: data.providerTitle ?? data.requirementAiProviderTitle ?? data.approvedProviderTitle ?? this.lead.requirementAiProviderTitle ?? this.lead.providerRequirementTitle ?? '',
                      providerDetails: data.providerDetails ?? data.requirementAiProviderDetails ?? data.approvedProviderDetails ?? this.lead.requirementAiProviderDetails ?? this.lead.providerRequirementDetails ?? '',
                      generatedAt: data.generatedAt ?? data.requirementAiGeneratedAt ?? this.lead.requirementAiGeneratedAt ?? null,
                      approvedAt: data.approvedAt ?? data.requirementAiApprovedAt ?? this.lead.requirementAiApprovedAt ?? null
                    };
                    this.requirementGeneratedRaw = this.requirementForm.status ? this.requirementForm.raw : '';
                  },
                  requirementInputChanged() {
                    if (!this.requirementForm.status) return;
                    if (String(this.requirementForm.raw || '').trim() === String(this.requirementGeneratedRaw || '').trim()) return;
                    this.requirementForm.status = '';
                    this.requirementForm.clarificationReason = '';
                    this.requirementForm.clarificationMessage = '';
                    this.requirementForm.providerTitle = '';
                    this.requirementForm.providerDetails = '';
                    this.requirementForm.generatedAt = null;
                  },
                  stepClass(step) {
                    const stepIndex = this.journeySteps.indexOf(step);
                    const currentIndex = this.journeySteps.indexOf(this.journeyBaseStatus);
                    return {
                      'is-complete': stepIndex < currentIndex,
                      'is-current': stepIndex === currentIndex && !this.isRejected,
                      'is-rejected-stage': stepIndex === currentIndex && this.isRejected,
                      'is-provider-stage': false
                    };
                  },
                  timelineTitle(event) {
                    if (event.type === 'status_changed') return humanize(event.toStatus || 'Status changed');
                    if (event.type === 'provider_sale_conversion') return 'Sale converted by provider';
                    if (event.type === 'provider_sale_conversion_reverted') return 'Sale conversion reversed';
                    if (event.type === 'lead_qualification') return 'Lead qualification completed';
                    if (event.type === 'lead_requalified') return 'Lead qualification updated';
                    if (['agent_referral_validation', 'lead_validation'].includes(event.type)) return 'Lead validation updated';
                    if (event.type === 'requirement_ai_generated') return 'Customer requirement prepared';
                    if (event.type === 'requirement_ai_clarification') return 'Customer requirement needs clarification';
                    if (event.type === 'customer_requirement_approved') return 'Customer requirement approved';
                    if (event.type === 'created') return 'Lead created';
                    if (event.type === 'note') return 'Note added';
                    if (event.type === 'deactivated') return 'Lead deactivated';
                    if (event.type === 'reactivated') return 'Lead reactivated';
                    return humanize(event.type || 'Activity');
                  },
                  applyQualification(data = {}) {
                    const savedAnswers = { ...(data.answers || {}) };
                    this.qualification = {
                      questions: Array.isArray(data.questions) ? data.questions : [],
                      answers: savedAnswers,
                      system: data.system || null,
                      final: data.final || null,
                      completed: data.completed === true,
                      locked: data.locked === true,
                      categoryMaxLeadPricePaise: Number(data.categoryMaxLeadPricePaise ?? 10000),
                      completedAt: data.completedAt || null,
                      completedBy: data.completedBy || ''
                    };
                    this.qualificationAnswers = { ...savedAnswers };
                    this.$nextTick(() => {
                      this.qualificationAnswers = { ...savedAnswers };
                    });
                    const selected = data.final || data.system || {};
                    this.qualificationFinal = {
                      leadPriceRupees: Number(selected.leadPricePaise || 0) / 100,
                      leadIntent: selected.leadIntent || '',
                      priority: selected.priority || ''
                    };
                  },
                  async loadQualification() {
                    this.qualificationLoading = true;
                    try {
                      const data = (await apiFetch('/api/enquiry/' + this.recordId + '/qualification')).data || {};
                      this.applyQualification(data);
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.qualificationLoading = false;
                    }
                  },
                  async qualificationAnswerChanged() {
                    if (!this.qualificationAnswersComplete || this.qualificationPreviewing || this.providerControlled || this.isRejected) return;
                    this.qualificationPreviewing = true;
                    try {
                      const data = (await apiFetch('/api/enquiry/' + this.recordId + '/qualification/preview', {
                        method: 'POST',
                        body: JSON.stringify({ answers: this.qualificationAnswers })
                      })).data || {};
                      this.qualification.system = data.system || null;
                      this.qualification.categoryMaxLeadPricePaise = Number(data.system?.categoryMaxLeadPricePaise ?? this.qualification.categoryMaxLeadPricePaise ?? 10000);
                      this.qualificationFinal = {
                        leadPriceRupees: Number(data.system?.leadPricePaise || 0) / 100,
                        leadIntent: data.system?.leadIntent || '',
                        priority: data.system?.priority || ''
                      };
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.qualificationPreviewing = false;
                    }
                  },
                  async saveQualification() {
                    if (this.qualificationSaving) return;
                    if (this.isRejected) {
                      this.notify('Restore the rejected lead before completing qualification.', 'error');
                      return;
                    }
                    if (!this.qualificationAnswersComplete) {
                      this.notify('Answer all six qualification questions.', 'error');
                      return;
                    }
                    if (!this.qualification.system) {
                      await this.qualificationAnswerChanged();
                      if (!this.qualification.system) return;
                    }
                    const priceRupees = Number(this.qualificationFinal.leadPriceRupees);
                    const maxRupees = Number(this.qualification.categoryMaxLeadPricePaise || 0) / 100;
                    if (!Number.isInteger(priceRupees) || priceRupees < 0 || priceRupees > maxRupees || priceRupees % 10 !== 0) {
                      this.notify('Final lead price must be within the Category maximum and use ₹10 increments.', 'error');
                      return;
                    }
                    this.qualificationSaving = true;
                    try {
                      const data = (await apiFetch('/api/enquiry/' + this.recordId + '/qualification', {
                        method: 'POST',
                        body: JSON.stringify({
                          answers: this.qualificationAnswers,
                          overrides: {
                            leadPricePaise: priceRupees * 100,
                            leadIntent: this.qualificationFinal.leadIntent,
                            priority: this.qualificationFinal.priority
                          }
                        })
                      })).data || {};
                      if (data.lead) this.lead = data.lead;
                      if (data.qualification) this.applyQualification(data.qualification);
                      this.notify(this.qualificationComplete ? 'Lead qualification saved. Customer requirement step is available.' : 'Lead qualification saved.', 'success');
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.qualificationSaving = false;
                    }
                  },
                  async load() {
                    this.loading = true;
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId)).data;
                      this.applyRequirement(this.lead);
                      const validation = this.lead.agentReferralValidation || 'pending';
                      this.referralForm.status = ['valid', 'invalid'].includes(validation) ? validation : '';
                      this.referralForm.method = this.lead.leadValidationMethod || '';
                      this.referralForm.reason = this.lead.agentReferralInvalidReason || '';
                      await this.loadQualification();
                      await this.loadCommunications();
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.loading = false;
                    }
                  },
                  async loadCommunications() {
                    try {
                      const body = await apiFetch('/api/communication?enquiryId=' + encodeURIComponent(this.recordId) + '&limit=20');
                      this.communications = body.data || [];
                    } catch (error) {
                      this.notify(error.message, 'error');
                    }
                  },
                  async changeStatus(action) {
                    if (this.statusSaving) return;
                    if (this.providerControlled) {
                      this.notify('Journey actions are locked after approval because the lead is already published.', 'error');
                      return;
                    }
                    if (!this.validationReady) {
                      this.notify('Complete lead validation first.', 'error');
                      return;
                    }
                    if (action === 'next' && !this.qualificationComplete) {
                      this.notify('Complete lead qualification before moving the journey forward.', 'error');
                      return;
                    }
                    if (action === 'next' && this.journeyBaseStatus === 'verification' && !this.requirementApproved) {
                      this.notify('Approve the customer requirement before approving this lead.', 'error');
                      return;
                    }
                    if ((this.lead.agentId || action === 'reject') && !this.statusNote.trim()) {
                      this.notify(this.lead.agentId ? 'Enter a mandatory note before changing this Agent Portal requirement.' : 'Enter a rejection reason before rejecting the lead.', 'error');
                      return;
                    }
                    if (action === 'reject' && !window.confirm('Reject this lead?\n\nThis will move the requirement to Rejected and make it unavailable to providers.')) return;
                    this.statusSaving = true;
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId + '/status', {
                        method: 'POST',
                        body: JSON.stringify({ action, note: this.statusNote })
                      })).data;
                      this.statusNote = '';
                      this.notify('Lead status updated to ' + humanize(this.currentStatus) + '.', 'success');
                      await this.loadQualification();
                      await this.loadCommunications();
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.statusSaving = false;
                    }
                  },
                  async generateRequirement() {
                    if (this.requirementGenerating || this.requirementApproving) return;
                    if (!this.requirementForm.raw.trim()) {
                      this.notify('Enter the customer requirement first.', 'error');
                      return;
                    }
                    this.requirementGenerating = true;
                    try {
                      const data = (await apiFetch('/api/enquiry/' + this.recordId + '/requirement/generate', {
                        method: 'POST',
                        body: JSON.stringify({ customerRequirementRaw: this.requirementForm.raw })
                      })).data || {};
                      if (data.lead) this.lead = data.lead;
                      this.applyRequirement(data.requirement || data.lead || {});
                      if (this.requirementForm.status === 'clarify') {
                        this.notify('AI needs one clarification before this requirement can be approved.', 'warning');
                      } else {
                        this.notify('Provider-facing requirement wording is ready for review.', 'success');
                      }
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.requirementGenerating = false;
                    }
                  },
                  async approveRequirement() {
                    if (this.requirementApproving || this.requirementGenerating) return;
                    if (!this.requirementReadyToApprove) {
                      this.notify('Keep the WhatsApp requirement within 20 words and provider details within 100 words.', 'error');
                      return;
                    }
                    if (!window.confirm('Approve this customer requirement and publish the lead to providers?')) return;
                    this.requirementApproving = true;
                    try {
                      const data = (await apiFetch('/api/enquiry/' + this.recordId + '/requirement/approve', {
                        method: 'POST',
                        body: JSON.stringify({
                          providerTitle: this.requirementForm.providerTitle,
                          providerDetails: this.requirementForm.providerDetails
                        })
                      })).data || {};
                      if (data.lead) this.lead = data.lead;
                      this.applyRequirement(data.requirement || data.lead || {});
                      this.notify('Customer requirement approved. Lead is now Approved.', 'success');
                      await this.loadQualification();
                      await this.loadCommunications();
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.requirementApproving = false;
                    }
                  },
                  async saveReferralValidation() {
                    if (this.referralSaving) return;
                    if (!this.referralForm.status) {
                      this.notify('Select Valid or Invalid.', 'error');
                      return;
                    }
                    if (!this.referralForm.method) {
                      this.notify('Select how the lead was validated.', 'error');
                      return;
                    }
                    if (this.referralForm.method === 'other' && !this.referralForm.note.trim()) {
                      this.notify('Please describe how the lead was validated.', 'error');
                      return;
                    }
                    if (this.referralForm.status === 'invalid' && !this.referralForm.reason) {
                      this.notify('Select why the lead is Invalid.', 'error');
                      return;
                    }
                    if (this.referralForm.status === 'invalid' && !this.referralForm.note.trim()) {
                      this.notify('Enter a reason explaining why the lead is Invalid.', 'error');
                      return;
                    }
                    this.referralSaving = true;
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId + '/referral-validation', {
                        method: 'POST',
                        body: JSON.stringify(this.referralForm)
                      })).data;
                      const markedInvalid = this.lead.agentReferralValidation === 'invalid';
                      this.referralForm.note = '';
                      await this.loadQualification();
                      this.notify(markedInvalid ? 'Lead marked Invalid. It was automatically moved to Rejected.' : 'Lead marked Valid. Complete qualification before moving the journey forward.', 'success');
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.referralSaving = false;
                    }
                  },
                  async addNote() {
                    if (this.noteSaving || !this.note.trim()) return;
                    this.noteSaving = true;
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId + '/note', {
                        method: 'POST',
                        body: JSON.stringify({ note: this.note })
                      })).data;
                      this.note = '';
                      this.notify('Note added to the lead activity timeline.', 'success');
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.noteSaving = false;
                    }
                  },
                  async reactivateLead() {
                    if (this.stateSaving) return;
                    if (!window.confirm('Reactivate this lead? Approved leads return to the marketplace when capacity remains.')) return;
                    this.stateSaving = true;
                    try {
                      this.lead = (await apiFetch('/api/enquiry/' + this.recordId + '/reactivate', { method: 'POST', body: '{}' })).data;
                      await this.loadQualification();
                      this.notify('Lead reactivated.', 'success');
                    } catch (error) {
                      this.notify(error.message, 'error');
                    } finally {
                      this.stateSaving = false;
                    }
                  }
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>