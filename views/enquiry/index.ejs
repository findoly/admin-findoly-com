<%- include('../partials/pageStart') %>
<div x-data="leadList()" x-init="init()">
  <div class="card mb-3"><div class="card-body py-3"><form class="row g-2 align-items-end crm-filter-toolbar" @submit.prevent="search()">
    <div class="col-12 col-lg-4"><label class="form-label">Search</label><input class="form-control" x-model="filters.q" placeholder="Name, mobile, title or lead ID"></div>
    <div class="col-6 col-md-3 col-lg-2"><label class="form-label">Status</label><select class="form-select" x-model="filters.status"><option value="">All</option><template x-for="s in statuses"><option :value="s" x-text="humanize(s)"></option></template></select></div>
    <div class="col-6 col-md-3 col-lg-2"><label class="form-label">Category</label><select class="form-select" x-model="filters.categorySlug"><option value="">All</option><template x-for="c in categories" :key="c.slug"><option :value="c.slug" x-text="c.name"></option></template></select></div>
    <div class="col-6 col-md-3 col-lg-2"><label class="form-label">From</label><input type="date" class="form-control" x-model="filters.startDate"></div>
    <div class="col-6 col-md-3 col-lg-2"><label class="form-label">To</label><input type="date" class="form-control" x-model="filters.endDate"></div>
    <div class="col-12 d-flex gap-2"><button class="btn btn-primary" :disabled="loading">Apply</button><button type="button" class="btn btn-light" @click="reset()">Clear</button><a class="btn btn-light ms-auto" href="/enquiries/new">New lead</a></div>
  </form></div></div>
  <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
  <div class="card" :class="loading && 'crm-loading'"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Requirement</th><th>Customer</th><th>Category</th><th>Status</th><th>Distribution</th><th>Price</th><th></th></tr></thead><tbody>
    <template x-for="lead in rows" :key="lead.enquiryId"><tr><td><div class="fw-semibold" x-text="lead.requirementTitle || lead.serviceType || 'Requirement'"></div><div class="text-muted fs-sm" x-text="lead.enquiryId"></div></td><td><div x-text="lead.name || '—'"></div><div class="text-muted fs-sm" x-text="lead.mobile || '—'"></div></td><td><div x-text="lead.category || humanize(lead.categorySlug)"></div><div class="text-muted fs-sm" x-text="lead.city || '—'"></div></td><td><span class="badge bg-light text-body border" x-text="humanize(lead.status)"></span></td><td><span x-text="lead.distributionCount || 0"></span> offered · <span x-text="lead.unlockedCount || 0"></span> unlocked</td><td x-text="money(lead.leadPricePaise)"></td><td class="crm-table-actions"><a class="btn btn-light btn-sm" :href="'/enquiries/'+lead.enquiryId">View</a><a class="btn btn-light btn-sm ms-1" :href="'/enquiries/'+lead.enquiryId+'/edit'">Edit</a></td></tr></template>
    <tr x-show="!loading && !rows.length"><td colspan="7" class="text-center text-muted py-4">No requirements found</td></tr>
  </tbody></table></div><div class="card-footer d-flex align-items-center"><span class="text-muted" x-text="pagination.total + ' records'"></span><div class="ms-auto btn-group"><button class="btn btn-light btn-sm" :disabled="pagination.page<=1" @click="go(pagination.page-1)">Previous</button><button class="btn btn-light btn-sm" disabled x-text="pagination.page+' / '+pagination.pages"></button><button class="btn btn-light btn-sm" :disabled="pagination.page>=pagination.pages" @click="go(pagination.page+1)">Next</button></div></div></div>
</div>
<script>
  function leadList(){return{rows:[],categories:[],statuses:['new','verification_pending','verified','approved','distributed','in_progress','completed','rejected','closed'],filters:{q:new URLSearchParams(location.search).get('q')||'',status:new URLSearchParams(location.search).get('status')||'',categorySlug:'',startDate:'',endDate:''},pagination:{page:1,pages:1,total:0},loading:false,error:'',async init(){try{this.categories=(await apiFetch('/api/catalog/categories')).data;await this.load();}catch(e){this.error=e.message;}},query(){const p=new URLSearchParams({...this.filters,page:this.pagination.page,limit:20});for(const[k,v]of[...p])if(!v)p.delete(k);return p.toString()},async load(){this.loading=true;this.error='';try{const b=await apiFetch('/api/enquiry?'+this.query());this.rows=b.data;this.pagination=b.pagination;}catch(e){this.error=e.message;}finally{this.loading=false;}},search(){this.pagination.page=1;this.load()},reset(){this.filters={q:'',status:'',categorySlug:'',startDate:'',endDate:''};this.search()},go(page){this.pagination.page=page;this.load()}}}
</script>
<%- include('../partials/pageEnd') %>
