<%
  const canAccess = typeof can === 'function' ? can : () => true;
  const canManageCatalog = canAccess('categories.manage');
  const canViewWebsiteMedia = canAccess('websiteContent.view');
%>
<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Catalog / Categories</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Create broad service groups such as Painting, Cleaning, or Home Repair.</p>
              </div>
              <div class="crm-page-actions">
                <a href="/service-types" class="btn btn-primary">Manage subcategories</a>
              </div>
            </div>
          </div>

          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
            <div x-data="categoryManager()" x-init="load()">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
              <div x-show="success" x-cloak class="alert alert-success" x-text="success"></div>

              <div class="crm-catalog-definition-grid mb-3">
                <div class="crm-catalog-definition-card">
                  <span class="crm-catalog-definition-number">1</span>
                  <div><strong>Category</strong><p>A broad service group. Example: Painting.</p></div>
                </div>
                <div class="crm-catalog-definition-card">
                  <span class="crm-catalog-definition-number">2</span>
                  <div><strong>Subcategory</strong><p>A specific service under a Category. Example: Interior Painting.</p></div>
                </div>
              </div>

              <div class="row g-3">
                <% if (canManageCatalog) { %>
                  <div class="col-xl-4">
                    <form class="card crm-catalog-form-card" @submit.prevent="saveCategory()">
                      <div class="card-header">
                        <div>
                          <h5 class="mb-1" x-text="editingId ? 'Edit category' : 'Create category'"></h5>
                          <p class="text-muted mb-0">Categories organize the services shown across CRM and Provider Portal.</p>
                        </div>
                      </div>
                      <div class="card-body">
                        <div class="mb-3">
                          <label class="form-label" for="category-name">Category name</label>
                          <input id="category-name" class="form-control" x-model="form.name" @input="syncSlug()" maxlength="120" placeholder="Example: Painting" required>
                        </div>
                        <div class="mb-3">
                          <label class="form-label" for="category-slug">Slug</label>
                          <input id="category-slug" class="form-control" x-model="form.slug" @input="slugTouched=true" :disabled="Boolean(editingId)" maxlength="80" pattern="[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*" placeholder="painting" required>
                          <div class="form-text">Used internally for matching. It cannot be changed after creation.</div>
                        </div>
                        <div class="mb-3">
                          <label class="form-label" for="category-description">Description</label>
                          <textarea id="category-description" class="form-control" rows="4" x-model="form.description" maxlength="2000" placeholder="Describe the services grouped under this Category"></textarea>
                        </div>
                        <div class="mb-3">
                          <label class="form-label" for="category-alert-distance">Provider alert distance (km)</label>
                          <input id="category-alert-distance" type="number" class="form-control" min="1" max="100" step="1" x-model.number="form.alertDistanceKm" required>
                          <div class="form-text">Default nearby WhatsApp alert radius copied to new requirements. It can be overridden per requirement.</div>
                        </div>
                        <div class="mb-3">
                          <label class="form-label" for="category-provider-unlocks">Default provider unlocks</label>
                          <input id="category-provider-unlocks" type="number" class="form-control" min="1" max="1000" step="1" x-model.number="form.defaultProviderUnlocks" required>
                          <div class="form-text">Copied to each new requirement in this Category. Existing requirements keep their saved unlock limit.</div>
                        </div>
                        <div class="mb-3">
                          <label class="form-label" for="category-max-lead-price">Maximum lead price (₹)</label>
                          <input id="category-max-lead-price" type="number" class="form-control" min="0" max="10000000" step="10" x-model.number="form.maxLeadPriceRupees" required>
                          <div class="form-text">Highest provider unlock price for this Category. Qualification applies the rounded score percentage to this maximum.</div>
                        </div>
                        <div class="mb-3">
                          <label class="form-label" for="category-order">Website display order</label>
                          <input id="category-order" type="number" class="form-control" min="0" max="100000" step="1" x-model.number="form.displayOrder">
                        </div>
                        <% if (canViewWebsiteMedia) { %>
                        <div class="mb-3">
                          <label class="form-label" for="category-image">Website card image</label>
                          <select id="category-image" class="form-select" x-model="form.imageMediaId"><option value="">No image</option><template x-for="media in mediaItems" :key="media.mediaId"><option :value="media.mediaId" x-text="media.altText || media.originalName || media.fileName"></option></template></select>
                        </div>
                        <div class="mb-3">
                          <label class="form-label" for="category-banner">Optional banner image</label>
                          <select id="category-banner" class="form-select" x-model="form.bannerMediaId"><option value="">No banner</option><template x-for="media in mediaItems" :key="media.mediaId"><option :value="media.mediaId" x-text="media.altText || media.originalName || media.fileName"></option></template></select>
                          <div class="form-text"><a href="/website-content/media">Open Media Library</a> to upload or manage images.</div>
                        </div>
                        <% } else { %><div class="alert alert-light border mb-3">Website images are managed by users with Website Content access.</div><% } %>
                        <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="category-website" x-model="form.websiteVisible"><label class="form-check-label" for="category-website">Visible on Findoly.com</label></div>
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="category-active" x-model="form.active">
                          <label class="form-check-label" for="category-active">Active and available in new forms</label>
                        </div>
                      </div>
                      <div class="card-footer d-flex gap-2">
                        <button type="button" class="btn btn-light" x-show="editingId" @click="resetCategoryForm()">Cancel</button>
                        <button class="btn btn-primary ms-auto" :disabled="saving" x-text="saving ? 'Saving…' : (editingId ? 'Update category' : 'Create category')"></button>
                      </div>
                    </form>
                  </div>
                <% } %>

                <div class="<%= canManageCatalog ? 'col-xl-8' : 'col-12' %>">
                  <div class="card" :class="loading && 'crm-loading'">
                    <div class="card-header crm-card-heading crm-list-heading">
                      <div>
                        <h5 class="mb-1">Category list</h5>
                        <p class="text-muted mb-0"><span x-text="pagination.returned"></span> Categories on this page</p>
                      </div>
                    </div>

                    <form class="crm-filter-bar crm-filter-bar-embedded" @submit.prevent="search()">
                      <label class="crm-search-control">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                        <input type="search" x-model="q" maxlength="100" placeholder="Search name, slug, or description" aria-label="Search categories">
                      </label>
                      <label class="crm-filter-field"><span>Status</span><select x-model="status"><option value="">All statuses</option><option value="true">Active</option><option value="false">Inactive</option></select></label>
                      <label class="crm-filter-field"><span>Sort</span><select x-model="sort"><option value="newest">Recently updated</option><option value="oldest">Oldest updated</option><option value="name_asc">Name A–Z</option><option value="name_desc">Name Z–A</option></select></label>
                      <label class="crm-filter-field"><span>Rows</span><select x-model.number="pagination.limit" @change="search()"><option :value="10">10</option><option :value="20">20</option><option :value="50">50</option><option :value="100">100</option></select></label>
                      <div class="crm-filter-actions"><button class="btn btn-primary" type="submit">Apply</button><button class="btn btn-light" type="button" x-show="q || status || sort !== 'newest' || pagination.limit !== 20" @click="clearFilters()">Clear</button></div>
                    </form>

                    <div class="table-responsive">
                      <table class="table crm-table mb-0">
                        <thead><tr><th>Category</th><th>Slug</th><th>Subcategories</th><th>Alert radius</th><th>Unlock limit</th><th>Max lead price</th><th>Status</th><th>Updated</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                          <template x-if="loading"><tr><td colspan="9"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
                          <template x-for="category in categories" :key="category.categoryId || category.slug">
                            <tr>
                              <td><div class="fw-semibold" x-text="category.name"></div><small class="text-muted" x-text="category.description || 'No description added'"></small></td>
                              <td><code x-text="category.slug"></code></td>
                              <td><a class="btn btn-light btn-sm" :href="subcategoriesUrl(category)"><span x-text="category.serviceTypeCount || 0"></span> managed</a></td>
                              <td><span x-text="Number(category.alertDistanceKm || 20) + ' km'"></span></td>
                              <td><span x-text="Number(category.defaultProviderUnlocks || 3)"></span></td>
                              <td><span x-text="'₹' + (Number(category.maxLeadPricePaise ?? 10000) / 100).toLocaleString('en-IN')"></span></td>
                              <td><span class="badge" :class="category.active !== false ? 'bg-success bg-opacity-10 text-success' : 'bg-secondary bg-opacity-10 text-secondary'" x-text="category.active !== false ? 'Active' : 'Inactive'"></span></td>
                              <td x-text="formatDate(category.updatedAt || category.createdAt)"></td>
                              <td class="text-end crm-table-actions">
                                <a class="btn btn-light btn-sm" :href="subcategoriesUrl(category)">Subcategories</a>
                                <% if (canManageCatalog) { %><button class="btn btn-light btn-sm" type="button" @click="editCategory(category)">Edit</button><% } %>
                              </td>
                            </tr>
                          </template>
                          <tr x-show="!categories.length && !loading"><td colspan="9" class="text-center py-5"><strong>No Categories found</strong><div class="text-muted mt-1" x-text="q || status ? 'Clear the filters and try again.' : 'Create your first Category to start adding Subcategories.'"></div></td></tr>
                        </tbody>
                      </table>
                    </div>
                    <div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong> · <span x-text="pagination.returned"></span> shown</div><div class="crm-pagination"><button type="button" :disabled="pagination.page<=1 || loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button type="button" :disabled="!pagination.hasNext || loading" @click="next()">Next</button></div></div>
                  </div>
                </div>
              </div>
            </div>

            <script>
              function categoryManager() {
                return {
                  categories: [], mediaItems: [], editingId: '', loading: true, saving: false,
                  error: '', success: '', q: '', status: '', sort: 'newest',
                  pagination: createCursorPagination(20),
                  form: { name: '', slug: '', description: '', alertDistanceKm: 20, defaultProviderUnlocks: 3, maxLeadPriceRupees: 100, displayOrder: 0, websiteVisible: true, imageMediaId: '', bannerMediaId: '', active: true },
                  slugTouched: false,
                  slugify(value) { return String(value || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''); },
                  syncSlug() { if (!this.editingId && !this.slugTouched) this.form.slug = this.slugify(this.form.name); },
                  query() {
                    const params = new URLSearchParams({ paginate: 'true', includeInactive: 'true', q: this.q, active: this.status, sort: this.sort, limit: this.pagination.limit, cursor: this.pagination.cursor });
                    [...params].forEach(([key, value]) => { if (value === '') params.delete(key); });
                    return params.toString();
                  },
                  async load() {
                    this.loading = true; this.error = '';
                    try {
                      const body = await apiFetch('/api/catalog/categories?' + this.query());
                      this.categories = body.data || [];
                      if (<%= canViewWebsiteMedia ? 'true' : 'false' %>) this.mediaItems = (await apiFetch('/api/website-content/media?limit=500')).data || [];
                      applyCursorPagination(this.pagination, body.pagination || {});
                    } catch (error) { this.error = error.message; } finally { this.loading = false; }
                  },
                  search() { resetCursorPagination(this.pagination); this.load(); },
                  next() { if (cursorNext(this.pagination)) this.load(); },
                  previous() { if (cursorPrevious(this.pagination)) this.load(); },
                  clearFilters() { this.q = ''; this.status = ''; this.sort = 'newest'; this.pagination.limit = 20; this.search(); },
                  subcategoriesUrl(category) { return '/service-types?categorySlug=' + encodeURIComponent(category.slug || ''); },
                  editCategory(category) {
                    this.editingId = category.categoryId;
                    this.form = { name: category.name || '', slug: category.slug || '', description: category.description || '', alertDistanceKm: Number(category.alertDistanceKm || 20), defaultProviderUnlocks: Number(category.defaultProviderUnlocks || 3), maxLeadPriceRupees: Number(category.maxLeadPricePaise ?? 10000) / 100, displayOrder: Number(category.displayOrder || 0), websiteVisible: category.websiteVisible !== false, imageMediaId: category.imageMediaId || '', bannerMediaId: category.bannerMediaId || '', active: category.active !== false };
                    this.slugTouched = true; this.error = ''; this.success = '';
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                  },
                  resetCategoryForm() { this.editingId = ''; this.form = { name: '', slug: '', description: '', alertDistanceKm: 20, defaultProviderUnlocks: 3, maxLeadPriceRupees: 100, displayOrder: 0, websiteVisible: true, imageMediaId: '', bannerMediaId: '', active: true }; this.slugTouched = false; },
                  async saveCategory() {
                    if (this.saving) return;
                    this.saving = true; this.error = ''; this.success = '';
                    try {
                      const alertDistanceKm = Number(this.form.alertDistanceKm);
                      if (!Number.isInteger(alertDistanceKm) || alertDistanceKm < 1 || alertDistanceKm > 100) {
                        throw new Error('Provider alert distance must be a whole number between 1 and 100 km');
                      }
                      const defaultProviderUnlocks = Number(this.form.defaultProviderUnlocks);
                      if (!Number.isInteger(defaultProviderUnlocks) || defaultProviderUnlocks < 1 || defaultProviderUnlocks > 1000) {
                        throw new Error('Default provider unlocks must be a whole number between 1 and 1000');
                      }
                      const maxLeadPriceRupees = Number(this.form.maxLeadPriceRupees);
                      if (!Number.isInteger(maxLeadPriceRupees) || maxLeadPriceRupees < 0 || maxLeadPriceRupees > 10000000 || maxLeadPriceRupees % 10 !== 0) {
                        throw new Error('Maximum lead price must be a whole rupee amount in ₹10 increments');
                      }
                      const payload = { ...this.form, maxLeadPricePaise: maxLeadPriceRupees * 100 };
                      delete payload.maxLeadPriceRupees;
                      const url = this.editingId ? '/api/catalog/categories/' + encodeURIComponent(this.editingId) : '/api/catalog/categories';
                      await apiFetch(url, { method: this.editingId ? 'PUT' : 'POST', body: JSON.stringify(payload) });
                      this.success = this.editingId ? 'Category updated successfully.' : 'Category created successfully. You can now add its Subcategories.';
                      this.resetCategoryForm(); this.search();
                    } catch (error) { this.error = error.message; } finally { this.saving = false; }
                  }
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>