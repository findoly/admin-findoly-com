<%- include('../partials/pageStart') %><div x-data="listPage()" x-init="load()"><div class="d-flex gap-2 mb-3"><input class="form-control" style="max-width:360px" x-model="q" @keyup.enter="load" placeholder="Search follow-ups"><select class="form-select" style="max-width:180px" x-model="status" @change="load"><option value="">All statuses</option><option>open</option><option>pending</option><option>completed</option><option>cancelled</option></select><a href="/follow-ups/new" class="btn btn-primary ms-auto">New follow-up</a></div><div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Title</th><th>Lead</th><th>Due</th><th>Channel</th><th>Status</th><th></th></tr></thead><tbody><template x-for="r in rows" :key="r.followUpId"><tr><td><div class="fw-semibold" x-text="r.title"></div><div class="text-muted fs-sm" x-text="r.customerName"></div></td><td><a :href="'/enquiries/'+r.enquiryId" x-text="r.enquiryId||'—'"></a></td><td x-text="r.dueAt||'—'"></td><td x-text="humanize(r.channel)"></td><td x-text="humanize(r.status)"></td><td><a class="btn btn-light btn-sm" :href="'/follow-ups/'+r.followUpId+'/edit'">Edit</a></td></tr></template></tbody></table></div></div></div><script>function listPage(){return{rows:[],q:'',status:'',async load(){const b=await apiFetch('/api/follow-up?'+new URLSearchParams({q:this.q,status:this.status}));this.rows=b.data}}}</script><%- include('../partials/pageEnd') %>
