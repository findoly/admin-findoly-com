<%- include('../partials/pageStart', { subtitle: 'List and queue' }) %>

<div class="card">
  <div class="card-header d-sm-flex align-items-sm-center py-sm-0">
    <div>
      <h5 class="py-sm-2 my-sm-1 mb-0">Follow-up list</h5>
      <div class="text-muted fs-sm">One page for listing and search only. Use Create to add a new task.</div>
    </div>
    <div class="mt-2 mt-sm-0 ms-sm-auto d-flex gap-2">
      <a href="/api/follow-ups" target="_blank" class="btn btn-light btn-sm"><i class="ph-code me-2"></i>API</a>
      <a href="/search/follow-ups" class="btn btn-light btn-sm"><i class="ph-magnifying-glass me-2"></i>Advanced search</a>
      <a href="/follow-ups/new" class="btn btn-primary btn-sm"><i class="ph-plus me-2"></i>Create follow-up</a>
    </div>
  </div>

  <div class="card-body border-top">
    <form method="get" class="row g-3 align-items-end">
      <div class="col-xl-4 col-lg-6">
        <label class="form-label">Search</label>
        <div class="form-control-feedback form-control-feedback-start">
          <input class="form-control" name="q" placeholder="Title, customer, owner, notes..." value="<%= filters.q || filters.search || '' %>">
          <div class="form-control-feedback-icon"><i class="ph-magnifying-glass"></i></div>
        </div>
      </div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All statuses</option><% statuses.forEach((s)=>{ %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= humanize(s) %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Channel</label><select class="form-select" name="channel"><option value="">All channels</option><% ['call','whatsapp','email','sms'].forEach((channel)=>{ %><option value="<%= channel %>" <%= filters.channel === channel ? 'selected' : '' %>><%= humanize(channel) %></option><% }) %></select></div>
      <div class="col-xl-2 col-lg-3 col-sm-6"><label class="form-label">Owner</label><input class="form-control" name="owner" value="<%= filters.owner || '' %>" placeholder="admin@email.com"></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><label class="form-label">Per page</label><select class="form-select" name="pageSize"><% [10,25,50,100].forEach((size)=>{ %><option value="<%= size %>" <%= String(filters.pageSize || 25) === String(size) ? 'selected' : '' %>><%= size %></option><% }) %></select></div>
      <div class="col-xl-1 col-lg-3 col-sm-6"><button class="btn btn-primary w-100" type="submit">Filter</button></div>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table text-nowrap">
      <thead><tr><th>Task</th><th>Customer</th><th>Related enquiry</th><th>Owner</th><th>Channel</th><th>Status</th><th>Due</th><th class="text-center" style="width: 220px;">Actions</th></tr></thead>
      <tbody>
        <% followUps.forEach((item) => { %>
          <tr>
            <td><div class="fw-semibold"><%= item.title %></div><div class="text-muted fs-sm text-truncate" style="max-width: 280px;"><%= item.notes || '' %></div></td>
            <td><%= item.customerName || '-' %></td>
            <td><% if (item.enquiryId) { %><a href="/enquiries/<%= item.enquiryId %>"><%= item.enquiryId %></a><% } else { %>-<% } %></td>
            <td><%= item.owner || '-' %></td>
            <td><%= humanize(item.channel) %></td>
            <td><%- include('../partials/statusBadge', { value: item.status, humanize }) %></td>
            <td><%= formatDate(item.dueAt) %></td>
            <td class="text-center">
              <div class="d-inline-flex gap-1">
                <a href="/follow-ups/<%= item.id %>" class="btn btn-outline-primary btn-sm"><i class="ph-eye me-1"></i>View</a>
                <a href="/follow-ups/<%= item.id %>/edit" class="btn btn-outline-secondary btn-sm"><i class="ph-pencil me-1"></i>Edit</a>
                <% if (item.status !== 'done') { %>
                  <form method="post" action="/follow-ups/<%= item.id %>" class="d-inline"><input type="hidden" name="status" value="done"><input type="hidden" name="returnTo" value="/follow-ups"><button class="btn btn-light btn-sm" type="submit">Done</button></form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (!followUps.length) { %><tr><td colspan="8" class="text-muted text-center py-4">No follow-ups found. <a href="/follow-ups/new">Create your first follow-up</a>.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination }) %>
</div>

<%- include('../partials/pageEnd') %>
