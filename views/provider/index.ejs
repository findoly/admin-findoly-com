<%- include('../partials/pageStart') %>
<div x-data="providerList()" x-init="load()"><div class="card mb-3"><div class="card-body py-3"><form class="row g-2 align-items-end" @submit.prevent="search"><div class="col-md-5"><label class="form-label">Search</label><input class="form-control" x-model="filters.q" placeholder="Name, mobile, business or city"></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" x-model="filters.status"><option value="">All</option><option>active</option><option>inactive</option><option>pending</option><option>blocked</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Apply</button></div><div class="col-md-2"><a href="/providers/new" class="btn btn-light w-100">New provider</a></div></form></div></div><div x-show="error" class="alert alert-danger" x-text="error"></div><div class="card"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Provider</th><th>Mobile</th><th>Categories</th><th>Status</th><th>Wallet</th><th></th></tr></thead><tbody><template x-for="p in rows" :key="p.providerId"><tr><td><div class="fw-semibold" x-text="p.name"></div><div class="text-muted fs-sm" x-text="p.businessName || p.providerId"></div></td><td x-text="p.mobile"></td><td x-text="(p.categorySlugs||[]).join(', ') || '—'"></td><td><span class="badge bg-light text-body border" x-text="humanize(p.status)"></span><div class="fs-sm text-muted" x-text="p.portalAccessEnabled === false ? 'Portal disabled' : 'Portal enabled'"></div></td><td x-text="money(p.walletBalancePaise)"></td><td><a class="btn btn-light btn-sm" :href="'/providers/'+p.providerId">View</a><a class="btn btn-light btn-sm ms-1" :href="'/providers/'+p.providerId+'/edit'">Edit</a></td></tr></template><tr x-show="!rows.length"><td colspan="6" class="text-center text-muted py-4">No providers found</td></tr></tbody></table></div><div class="card-footer d-flex"><span x-text="pagination.total+' records'"></span><div class="ms-auto btn-group"><button class="btn btn-light btn-sm" :disabled="pagination.page<=1" @click="go(-1)">Previous</button><button class="btn btn-light btn-sm" disabled x-text="pagination.page+' / '+pagination.pages"></button><button class="btn btn-light btn-sm" :disabled="pagination.page>=pagination.pages" @click="go(1)">Next</button></div></div></div></div>
<script>function providerList(){return{rows:[],filters:{q:'',status:''},pagination:{page:1,pages:1,total:0},error:'',async load(){try{const q=new URLSearchParams({...this.filters,page:this.pagination.page,limit:20});const b=await apiFetch('/api/provider?'+q);this.rows=b.data;this.pagination=b.pagination;}catch(e){this.error=e.message;}},search(){this.pagination.page=1;this.load()},go(n){this.pagination.page+=n;this.load()}}}</script>
<%- include('../partials/pageEnd') %>
