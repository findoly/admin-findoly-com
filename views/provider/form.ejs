<%- include('../partials/pageStart') %>
<div x-data="providerForm()" x-init="init()"><div x-show="error" class="alert alert-danger" x-text="error"></div><form class="card" @submit.prevent="save"><div class="card-body" :class="loading && 'crm-loading'"><div class="row g-3"><div class="col-md-6"><label class="form-label">Name</label><input class="form-control" x-model="form.name" required></div><div class="col-md-6"><label class="form-label">Business name</label><input class="form-control" x-model="form.businessName"></div><div class="col-md-4"><label class="form-label">Mobile</label><input class="form-control" x-model="form.mobile" required></div><div class="col-md-4"><label class="form-label">Email</label><input class="form-control" type="email" x-model="form.email"></div><div class="col-md-4"><label class="form-label">City</label><input class="form-control" x-model="form.city"></div><div class="col-md-6"><label class="form-label">Categories (comma separated)</label><input class="form-control" x-model="categoryText"></div><div class="col-md-6"><label class="form-label">Service areas (comma separated)</label><input class="form-control" x-model="areaText"></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" x-model="form.status"><option>active</option><option>inactive</option><option>pending</option><option>blocked</option></select></div><div class="col-md-3"><label class="form-label">Onboarding</label><select class="form-select" x-model="form.onboardingStage"><option>new</option><option>documents_pending</option><option>training_pending</option><option>ready</option><option>paused</option></select></div><div class="col-md-3"><label class="form-label">Availability</label><input class="form-control" x-model="form.availability"></div><div class="col-md-3"><label class="form-label">Rating</label><input type="number" min="0" max="5" step=".1" class="form-control" x-model.number="form.rating"></div><div class="col-md-6"><div class="form-check mt-4"><input class="form-check-input" type="checkbox" x-model="form.portalAccessEnabled" id="portal"><label class="form-check-label" for="portal">Portal access enabled</label></div></div><div class="col-md-6"><div class="form-check mt-4"><input class="form-check-input" type="checkbox" x-model="form.documentsVerified" id="docs"><label class="form-check-label" for="docs">Documents verified</label></div></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" x-model="form.notes"></textarea></div></div></div><div class="card-footer d-flex"><a href="/providers" class="btn btn-light">Cancel</a><button class="btn btn-primary ms-auto" :disabled="saving">Save provider</button></div></form></div>
<script>function providerForm(){return{mode:<%- JSON.stringify(mode) %>,recordId:<%- JSON.stringify(recordId) %>,form:{name:'',businessName:'',mobile:'',email:'',city:'',state:'',status:'active',onboardingStage:'new',availability:'available_today',rating:0,portalAccessEnabled:true,documentsVerified:false,notes:''},categoryText:'',areaText:'',loading:true,saving:false,error:'',async init(){try{if(this.mode==='edit'){const d=(await apiFetch('/api/provider/'+this.recordId)).data;this.form={...this.form,...d};this.categoryText=(d.categorySlugs||[]).join(', ');this.areaText=(d.serviceAreas||[]).join(', ');}}catch(e){this.error=e.message;}finally{this.loading=false;}},async save(){this.saving=true;try{const payload={...this.form,categorySlugs:this.categoryText.split(',').map(v=>v.trim()).filter(Boolean),skills:this.categoryText.split(',').map(v=>v.trim()).filter(Boolean),serviceAreas:this.areaText.split(',').map(v=>v.trim()).filter(Boolean)};const b=await apiFetch(this.mode==='edit'?'/api/provider/'+this.recordId:'/api/provider',{method:this.mode==='edit'?'PUT':'POST',body:JSON.stringify(payload)});location.href='/providers/'+b.data.providerId;}catch(e){this.error=e.message;}finally{this.saving=false;}}}}</script>
<%- include('../partials/pageEnd') %>
