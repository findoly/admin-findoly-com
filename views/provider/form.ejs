<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Provider network</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Manage provider profile, categories and portal access.</p>
              </div>
              <a href="/providers" class="btn btn-light crm-primary-action"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to providers</a>
            </div>
          </div>
          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <div x-data="providerForm()" x-init="init()">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
              <div x-show="prefillWarning" x-cloak class="alert alert-warning" x-text="prefillWarning"></div>
              <div x-show="sourceRequest.providerJoinRequestId" x-cloak class="alert alert-info crm-provider-request-prefill">
                <div><strong>Creating from provider joining request</strong><span x-text="sourceRequest.providerJoinRequestId"></span></div>
                <a :href="'/provider-requests/'+sourceRequest.providerJoinRequestId">Review request</a>
              </div>
              <div x-show="sourceRequest.status === 'rejected'" x-cloak class="alert alert-warning">
                <strong>Reopening a rejected request</strong>
                <p class="mb-2 mt-1">Add a new internal reason explaining why this request should now be converted.</p>
                <label class="form-label" for="providerRequestReopenNote">Reopening reason</label>
                <textarea id="providerRequestReopenNote" class="form-control" rows="3" maxlength="2000" x-model="requestReopenNote" placeholder="Explain why the rejected request is now being approved"></textarea>
              </div>
              <form class="card" @submit.prevent="save">
                <div class="card-body" :class="loading && 'crm-loading'">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label">Name</label>
                      <input class="form-control" x-model="form.name" maxlength="120" required />
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Business name</label>
                      <input class="form-control" x-model="form.businessName" maxlength="160" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Mobile</label>
                      <div class="input-group">
                        <span class="input-group-text crm-mobile-prefix">+91</span>
                        <input
                          class="form-control"
                          x-model="form.mobile"
                          @input="form.mobile = digitsOnly(form.mobile)"
                          inputmode="numeric"
                          autocomplete="tel-national"
                          pattern="[6-9][0-9]{9}"
                          minlength="10"
                          maxlength="10"
                          placeholder="10 digit mobile number"
                          required
                        />
                      </div>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">WhatsApp number</label>
                      <div class="input-group">
                        <span class="input-group-text crm-mobile-prefix">+91</span>
                        <input class="form-control" x-model="form.whatsappNumber" @input="form.whatsappNumber = digitsOnly(form.whatsappNumber)" inputmode="numeric" autocomplete="tel-national" pattern="[6-9][0-9]{9}" minlength="10" maxlength="10" placeholder="Defaults to mobile" required />
                      </div>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Email</label>
                      <input class="form-control" type="email" x-model="form.email" maxlength="254" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Service PIN code <span class="text-danger">*</span></label>
                      <input class="form-control" x-model="form.servicePincode" @input="form.servicePincode = String(form.servicePincode || '').replace(/\D/g, '').slice(0, 6)" @blur="lookupPincode()" inputmode="numeric" pattern="[1-9][0-9]{5}" maxlength="6" placeholder="400001" required />
                      <div class="form-text" x-text="locationLoading ? 'Checking PIN code…' : 'This PIN code controls nearby marketplace lead visibility.'"></div>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">City <span class="text-danger">*</span></label>
                      <input class="form-control" x-model="form.city" maxlength="100" placeholder="Mumbai" required />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">State <span class="text-danger">*</span></label>
                      <input class="form-control" x-model="form.state" maxlength="100" placeholder="Maharashtra" required />
                    </div>
                    <div class="col-12">
                      <label class="form-label">Full address <span class="text-muted">(optional)</span></label>
                      <input class="form-control" x-model="form.serviceAddress" maxlength="500" placeholder="Business or service address" />
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Categories</label>
                      <select
                        class="form-select crm-multi-select"
                        x-model="form.categorySlugs"
                        @change="syncWhatsappLeadPreferences()"
                        multiple
                        size="6"
                        required
                      >
                        <template x-for="category in categories" :key="category.slug">
                          <option :value="category.slug" x-text="category.name"></option>
                        </template>
                      </select>
                      <div class="form-text">Select one or more categories. Options are managed from the Categories feature.</div>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Service areas (comma separated)</label>
                      <input class="form-control" x-model="areaText" maxlength="5000" />
                    </div>
                    <div class="col-12">
                      <div class="border rounded p-3">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" x-model="form.whatsappLeadAlertsEnabled" id="whatsappLeadAlertsEnabled" />
                          <label class="form-check-label fw-semibold" for="whatsappLeadAlertsEnabled">Enable WhatsApp lead alerts</label>
                        </div>
                        <div class="form-text">Controls nearby lead WhatsApp alerts only. Provider Portal access and lead visibility remain unchanged.</div>

                        <div class="mt-3" x-show="form.whatsappLeadAlertsEnabled" x-cloak>
                          <div class="fw-semibold mb-2">WhatsApp lead alert services</div>
                          <div class="text-muted small" x-show="!form.categorySlugs.length">Select at least one category to configure WhatsApp alert subcategories.</div>
                          <template x-for="category in selectedCategories()" :key="category.slug">
                            <div class="border rounded p-3 mb-2">
                              <div class="fw-semibold" x-text="category.name"></div>
                              <div class="d-flex flex-wrap gap-3 mt-2">
                                <div class="form-check">
                                  <input
                                    class="form-check-input"
                                    type="radio"
                                    :id="'whatsapp-all-' + category.slug"
                                    :name="'whatsapp-mode-' + category.slug"
                                    value="all"
                                    x-model="preferenceFor(category.slug).mode"
                                    @change="preferenceFor(category.slug).serviceTypeIds = []"
                                  />
                                  <label class="form-check-label" :for="'whatsapp-all-' + category.slug">All subcategories</label>
                                </div>
                                <div class="form-check">
                                  <input
                                    class="form-check-input"
                                    type="radio"
                                    :id="'whatsapp-selected-' + category.slug"
                                    :name="'whatsapp-mode-' + category.slug"
                                    value="selected"
                                    x-model="preferenceFor(category.slug).mode"
                                  />
                                  <label class="form-check-label" :for="'whatsapp-selected-' + category.slug">Select specific subcategories</label>
                                </div>
                              </div>

                              <div class="mt-2" x-show="preferenceFor(category.slug).mode === 'selected'" x-cloak>
                                <div class="text-muted small" x-show="serviceTypeLoading[category.slug]">Loading subcategories…</div>
                                <div class="text-muted small" x-show="!serviceTypeLoading[category.slug] && !(serviceTypesByCategory[category.slug] || []).length">No active subcategories are configured for this category.</div>
                                <div class="row g-2" x-show="!serviceTypeLoading[category.slug] && (serviceTypesByCategory[category.slug] || []).length">
                                  <template x-for="serviceType in (serviceTypesByCategory[category.slug] || [])" :key="serviceType.serviceTypeId">
                                    <div class="col-md-4 col-sm-6">
                                      <div class="form-check">
                                        <input
                                          class="form-check-input"
                                          type="checkbox"
                                          :id="'whatsapp-service-' + serviceType.serviceTypeId"
                                          :value="serviceType.serviceTypeId"
                                          x-model="preferenceFor(category.slug).serviceTypeIds"
                                        />
                                        <label class="form-check-label" :for="'whatsapp-service-' + serviceType.serviceTypeId" x-text="serviceType.name"></label>
                                      </div>
                                    </div>
                                  </template>
                                </div>
                              </div>
                            </div>
                          </template>
                        </div>
                      </div>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Status</label>
                      <select class="form-select" x-model="form.status">
                        <option>active</option>
                        <option>inactive</option>
                        <option>pending</option>
                        <option>blocked</option>
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Onboarding</label>
                      <select class="form-select" x-model="form.onboardingStage">
                        <option>new</option>
                        <option>documents_pending</option>
                        <option>training_pending</option>
                        <option>ready</option>
                        <option>paused</option>
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Availability</label>
                      <input class="form-control" x-model="form.availability" maxlength="80" />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Rating</label>
                      <input type="number" min="0" max="5" step=".1" class="form-control" x-model.number="form.rating" required />
                    </div>
                    <div class="col-md-6">
                      <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" x-model="form.portalAccessEnabled" id="portal" />
                        <label class="form-check-label" for="portal">Portal access enabled</label>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" x-model="form.documentsVerified" id="docs" />
                        <label class="form-check-label" for="docs">Documents verified</label>
                      </div>
                    </div>
                    <div class="col-12">
                      <label class="form-label">Notes</label>
                      <textarea class="form-control" x-model="form.notes" maxlength="5000"></textarea>
                    </div>
                  </div>
                </div>
                <div class="card-footer d-flex">
                  <a href="/providers" class="btn btn-light">Cancel</a>
                  <button class="btn btn-primary ms-auto" :disabled="saving" x-text="saving ? 'Saving…' : 'Save provider'"></button>
                </div>
              </form>
            </div>
            <script>
              function providerForm() {
                return {
                  mode: pageMode(),
                  recordId: pageMode() === "edit" ? pathRecordId(true) : "",
                  requestId: pageMode() === "create" ? queryValue("requestId") : "",
                  sourceRequest: {},
                  requestReopenNote: "",
                  prefillWarning: "",
                  categories: [],
                  serviceTypesByCategory: {},
                  serviceTypeLoading: {},
                  form: {
                    name: "",
                    businessName: "",
                    mobile: "",
                    whatsappNumber: "",
                    email: "",
                    city: "",
                    state: "",
                    servicePincode: "",
                    serviceAddress: "",
                    status: "active",
                    onboardingStage: "new",
                    categorySlugs: [],
                    whatsappLeadAlertsEnabled: true,
                    whatsappLeadPreferences: [],
                    availability: "available_today",
                    rating: 0,
                    portalAccessEnabled: true,
                    documentsVerified: false,
                    notes: "",
                  },
                  areaText: "",
                  loading: true,
                  locationLoading: false,
                  lastLookedUpPincode: "",
                  saving: false,
                  error: "",
                  digitsOnly(value) {
                    let digits = String(value || "").replace(/\D/g, "");
                    if (digits.length === 12 && digits.startsWith("91")) digits = digits.slice(2);
                    if (digits.length === 11 && digits.startsWith("0")) digits = digits.slice(1);
                    return digits.slice(0, 10);
                  },
                  categoryLabel(categorySlug) {
                    return this.categories.find((category) => category.slug === categorySlug)?.name || categorySlug;
                  },
                  selectedCategories() {
                    const selected = new Set(Array.isArray(this.form.categorySlugs) ? this.form.categorySlugs : []);
                    return this.categories.filter((category) => selected.has(category.slug));
                  },
                  preferenceFor(categorySlug) {
                    let preference = this.form.whatsappLeadPreferences.find((item) => item.categorySlug === categorySlug);
                    if (!preference) {
                      preference = { categorySlug, mode: "all", serviceTypeIds: [] };
                      this.form.whatsappLeadPreferences.push(preference);
                    }
                    if (preference.mode !== "selected") preference.mode = "all";
                    if (!Array.isArray(preference.serviceTypeIds)) preference.serviceTypeIds = [];
                    return preference;
                  },
                  async loadServiceTypes(categorySlug) {
                    if (Array.isArray(this.serviceTypesByCategory[categorySlug])) return;
                    this.serviceTypeLoading[categorySlug] = true;
                    try {
                      const response = await apiFetch('/api/catalog/service-types?categorySlug=' + encodeURIComponent(categorySlug));
                      this.serviceTypesByCategory[categorySlug] = response.data || [];
                    } catch (error) {
                      this.error = error.message;
                    } finally {
                      this.serviceTypeLoading[categorySlug] = false;
                    }
                  },
                  async syncWhatsappLeadPreferences() {
                    const selected = new Set(Array.isArray(this.form.categorySlugs) ? this.form.categorySlugs : []);
                    this.form.whatsappLeadPreferences = (Array.isArray(this.form.whatsappLeadPreferences) ? this.form.whatsappLeadPreferences : [])
                      .filter((preference) => selected.has(preference.categorySlug))
                      .map((preference) => ({
                        categorySlug: preference.categorySlug,
                        mode: preference.mode === "selected" ? "selected" : "all",
                        serviceTypeIds: Array.isArray(preference.serviceTypeIds) ? preference.serviceTypeIds : [],
                      }));
                    for (const categorySlug of selected) this.preferenceFor(categorySlug);
                    await Promise.all([...selected].map((categorySlug) => this.loadServiceTypes(categorySlug)));
                  },
                  async init() {
                    try {
                      this.categories = (await apiFetch("/api/catalog/categories")).data || [];
                      if (this.mode === "edit") {
                        const d = (await apiFetch("/api/provider/" + this.recordId)).data;
                        this.form = {
                          ...this.form,
                          ...d,
                          mobile: this.digitsOnly(d.mobile),
                          whatsappNumber: this.digitsOnly(d.whatsappNumber || d.mobile),
                          categorySlugs: Array.isArray(d.categorySlugs) ? d.categorySlugs : [],
                          whatsappLeadAlertsEnabled: d.whatsappLeadAlertsEnabled !== false,
                          whatsappLeadPreferences: Array.isArray(d.whatsappLeadPreferences)
                            ? d.whatsappLeadPreferences.map((preference) => ({
                                categorySlug: preference.categorySlug,
                                mode: preference.mode === 'selected' ? 'selected' : 'all',
                                serviceTypeIds: Array.isArray(preference.serviceTypeIds) ? preference.serviceTypeIds : [],
                              }))
                            : [],
                        };
                        this.areaText = (d.serviceAreas || []).join(", ");
                      } else if (this.requestId) {
                        const request = (await apiFetch('/api/provider-requests/' + encodeURIComponent(this.requestId))).data || {};
                        this.sourceRequest = request;
                        this.form = {
                          ...this.form,
                          name: request.name || '',
                          businessName: request.businessName || '',
                          mobile: this.digitsOnly(request.mobile),
                          whatsappNumber: this.digitsOnly(request.whatsappNumber || request.mobile),
                          email: request.email || '',
                          city: request.city || '',
                          state: request.state || '',
                          servicePincode: request.servicePincode || '',
                          serviceAddress: request.serviceAddress || '',
                          categorySlugs: request.categorySlug && this.categories.some((category) => category.slug === request.categorySlug) ? [request.categorySlug] : [],
                        };
                        if (request.categorySlug && !this.form.categorySlugs.length) {
                          this.prefillWarning = 'The requested category is no longer available. Select an active category before creating the provider.';
                        }
                        this.areaText = [request.city, request.servicePincode].filter(Boolean).join(', ');
                      }
                      await this.syncWhatsappLeadPreferences();
                    } catch (e) {
                      this.error = e.message;
                    } finally {
                      this.loading = false;
                    }
                  },
                  async lookupPincode() {
                    const pincode = String(this.form.servicePincode || '');
                    if (!/^[1-9]\d{5}$/.test(pincode) || this.locationLoading || this.lastLookedUpPincode === pincode) return;
                    this.locationLoading = true;
                    try {
                      const location = (await apiFetch('/api/location/pincode/' + encodeURIComponent(pincode))).data || {};
                      this.form.city = location.city || this.form.city;
                      this.form.state = location.state || this.form.state;
                      this.lastLookedUpPincode = pincode;
                    } catch (error) {
                      this.error = error.message + ' Enter city and state manually to continue.';
                    } finally {
                      this.locationLoading = false;
                    }
                  },
                  async save() {
                    if (this.saving) return;
                    this.saving = true;
                    this.error = "";
                    try {
                      if (!/^[6-9]\d{9}$/.test(this.form.mobile)) {
                        throw new Error("Enter a valid 10-digit Indian provider mobile number");
                      }
                      this.form.whatsappNumber = this.digitsOnly(this.form.whatsappNumber || this.form.mobile);
                      if (!/^[6-9]\d{9}$/.test(this.form.whatsappNumber)) {
                        throw new Error("Enter a valid 10-digit Indian WhatsApp number");
                      }
                      if (!this.form.categorySlugs.length) {
                        throw new Error("Select at least one category");
                      }
                      await this.syncWhatsappLeadPreferences();
                      const whatsappLeadPreferences = this.form.categorySlugs.map((categorySlug) => {
                        const preference = this.preferenceFor(categorySlug);
                        const serviceTypeIds = [...new Set((preference.serviceTypeIds || [])
                          .map((value) => String(value || '').trim())
                          .filter(Boolean))];
                        if (preference.mode === 'selected' && !serviceTypeIds.length) {
                          throw new Error(`Select at least one subcategory for ${this.categoryLabel(categorySlug)} or choose All subcategories`);
                        }
                        return {
                          categorySlug,
                          mode: preference.mode === 'selected' ? 'selected' : 'all',
                          serviceTypeIds: preference.mode === 'selected' ? serviceTypeIds : [],
                        };
                      });
                      if (!/^[1-9]\d{5}$/.test(String(this.form.servicePincode || ''))) {
                        throw new Error("Provider service PIN code must contain exactly 6 digits");
                      }
                      if (!String(this.form.city || '').trim()) throw new Error("Provider city is required");
                      if (!String(this.form.state || '').trim()) throw new Error("Provider state is required");
                      const serviceAreas = this.areaText
                        .split(",")
                        .map((value) => value.trim())
                        .filter(Boolean);
                      if (serviceAreas.length > 100) {
                        throw new Error("Service areas cannot contain more than 100 entries");
                      }
                      if (serviceAreas.some((value) => value.length > 120)) {
                        throw new Error("Each service area must be 120 characters or less");
                      }
                      if (!Number.isFinite(Number(this.form.rating)) || Number(this.form.rating) < 0 || Number(this.form.rating) > 5) {
                        throw new Error("Provider rating must be between 0 and 5");
                      }
                      const isRequestConversion = this.mode === "create" && Boolean(this.requestId);
                      if (isRequestConversion && this.sourceRequest.status === 'rejected') {
                        const reopenNote = String(this.requestReopenNote || '').trim();
                        if (!reopenNote || reopenNote === String(this.sourceRequest.internalNote || '').trim()) {
                          throw new Error('Add a new reason explaining why this rejected request is being converted');
                        }
                      }
                      const payload = {
                        ...this.form,
                        whatsappLeadPreferences,
                        skills: [...this.form.categorySlugs],
                        serviceAreas,
                        reopenNote: this.requestReopenNote,
                      };
                      const response = await apiFetch(
                        this.mode === "edit"
                          ? "/api/provider/" + this.recordId
                          : isRequestConversion
                            ? "/api/provider-requests/" + encodeURIComponent(this.requestId) + "/convert"
                            : "/api/provider",
                        {
                          method: this.mode === "edit" ? "PUT" : "POST",
                          body: JSON.stringify(payload),
                        },
                      );
                      const provider = isRequestConversion ? response.data.provider : response.data;
                      location.href = "/providers/" + provider.providerId;
                    } catch (e) {
                      this.error = e.message;
                    } finally {
                      this.saving = false;
                    }
                  },
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>