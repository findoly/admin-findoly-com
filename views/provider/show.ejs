<%- include('../partials/pageStart') %>
<div x-data="providerShow()" x-init="load()"><div x-show="error" class="alert alert-danger" x-text="error"></div><div class="d-flex gap-2 mb-3"><a class="btn btn-light" :href="'/providers/'+recordId+'/edit'">Edit</a><button class="btn btn-primary" @click="sync()">Sync approved leads</button></div><div class="row g-3"><div class="col-xl-4"><div class="card"><div class="card-body"><h4 x-text="provider.name"></h4><div class="text-muted mb-3" x-text="provider.businessName"></div><dl class="row mb-0"><dt class="col-5">Provider ID</dt><dd class="col-7" x-text="provider.providerId"></dd><dt class="col-5">Mobile</dt><dd class="col-7" x-text="provider.mobile"></dd><dt class="col-5">Status</dt><dd class="col-7" x-text="humanize(provider.status)"></dd><dt class="col-5">Wallet</dt><dd class="col-7 fw-semibold" x-text="money(provider.walletBalancePaise)"></dd><dt class="col-5">Categories</dt><dd class="col-7" x-text="(provider.categorySlugs||[]).join(', ')"></dd></dl></div></div></div><div class="col-xl-8"><div class="card mb-3"><div class="card-header"><h5 class="mb-0">Lead offers</h5></div><div class="table-responsive"><table class="table"><thead><tr><th>Lead</th><th>Status</th><th>Price</th><th>Date</th></tr></thead><tbody><template x-for="d in provider.distributions||[]" :key="d.leadDistributionId"><tr><td><a :href="'/enquiries/'+d.requirementId" x-text="d.leadTitle||d.requirementId"></a></td><td x-text="humanize(d.status)"></td><td x-text="money(d.leadPricePaise)"></td><td x-text="formatDate(d.distributedAt)"></td></tr></template></tbody></table></div></div><div class="card"><div class="card-header"><h5 class="mb-0">Wallet transactions</h5></div><div class="table-responsive"><table class="table"><thead><tr><th>Type</th><th>Amount</th><th>Balance</th><th>Date</th></tr></thead><tbody><template x-for="t in provider.transactions||[]" :key="t.walletTransactionId"><tr><td x-text="humanize(t.type)"></td><td x-text="money(t.amountPaise)"></td><td x-text="money(t.balanceAfterPaise)"></td><td x-text="formatDate(t.createdAt)"></td></tr></template></tbody></table></div></div></div></div></div>
<script>function providerShow(){return{recordId:<%- JSON.stringify(recordId) %>,provider:{},error:'',async load(){try{this.provider=(await apiFetch('/api/provider/'+this.recordId)).data;}catch(e){this.error=e.message;}},async sync(){try{await apiFetch('/api/provider/'+this.recordId+'/sync',{method:'POST',body:'{}'});await this.load();}catch(e){this.error=e.message;}}}}</script>
<%- include('../partials/pageEnd') %>
