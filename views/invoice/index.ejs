<%- include('../partials/pageStart') %><div x-data="listPage()" x-init="load()"><div class="d-flex gap-2 mb-3"><input class="form-control" style="max-width:360px" x-model="q" @keyup.enter="load" placeholder="Search invoices"><select class="form-select" style="max-width:180px" x-model="status" @change="load"><option value="">All statuses</option><option>draft</option><option>sent</option><option>paid</option><option>overdue</option><option>cancelled</option></select><a href="/billing/new" class="btn btn-primary ms-auto">New invoice</a></div><div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Invoice</th><th>Customer</th><th>Status</th><th>Total</th><th>Dates</th><th></th></tr></thead><tbody><template x-for="r in rows" :key="r.invoiceId"><tr><td><div class="fw-semibold" x-text="r.invoiceNo"></div><div class="text-muted fs-sm" x-text="r.enquiryId"></div></td><td x-text="r.customerName"></td><td x-text="humanize(r.status)"></td><td x-text="new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR'}).format(r.total||0)"></td><td x-text="(r.issueDate||'—')+' → '+(r.dueDate||'—')"></td><td><a class="btn btn-light btn-sm" :href="'/billing/'+r.invoiceId+'/edit'">Edit</a></td></tr></template></tbody></table></div></div></div><script>function listPage(){return{rows:[],q:'',status:'',async load(){const b=await apiFetch('/api/invoice?'+new URLSearchParams({q:this.q,status:this.status}));this.rows=b.data}}}</script><%- include('../partials/pageEnd') %>
