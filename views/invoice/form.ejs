<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Billing</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Create or update an invoice record.</p>
              </div>
              <a href="/billing" class="btn btn-light crm-primary-action"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to billing</a>
            </div>
          </div>
          <div class="content">
            <div
              x-show="shellError"
              x-cloak
              class="alert alert-danger"
              x-text="shellError"
            ></div>
            <div x-data="formPage()" x-init="init()">
              <div
                x-show="error"
                class="alert alert-danger"
                x-text="error"
              ></div>
              <form class="card" @submit.prevent="save">
                <div class="card-body">
                  <div class="row g-3">
                    <div class="col-md-3">
                      <label class="form-label">Invoice number</label
                      ><input class="form-control" x-model="form.invoiceNo" />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Requirement ID</label
                      ><input class="form-control" x-model="form.enquiryId" />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Customer</label
                      ><input
                        class="form-control"
                        x-model="form.customerName"
                      />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Provider</label
                      ><input
                        class="form-control"
                        x-model="form.providerName"
                      />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Status</label
                      ><select class="form-select" x-model="form.status">
                        <option>draft</option>
                        <option>sent</option>
                        <option>paid</option>
                        <option>overdue</option>
                        <option>cancelled</option>
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Issue date</label
                      ><input
                        type="date"
                        class="form-control"
                        x-model="form.issueDate"
                      />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Due date</label
                      ><input
                        type="date"
                        class="form-control"
                        x-model="form.dueDate"
                      />
                    </div>
                  </div>
                  <hr />
                  <template x-for="(item,index) in form.items" :key="index"
                    ><div class="row g-2 mb-2">
                      <div class="col-md-6">
                        <input
                          class="form-control"
                          placeholder="Description"
                          x-model="item.description"
                        />
                      </div>
                      <div class="col-md-2">
                        <input
                          type="number"
                          class="form-control"
                          placeholder="Qty"
                          x-model.number="item.qty"
                        />
                      </div>
                      <div class="col-md-3">
                        <input
                          type="number"
                          class="form-control"
                          placeholder="Rate"
                          x-model.number="item.rate"
                        />
                      </div>
                      <div class="col-md-1">
                        <button
                          type="button"
                          class="btn btn-light w-100"
                          @click="form.items.splice(index,1)"
                        >
                          ×
                        </button>
                      </div>
                    </div></template
                  ><button
                    type="button"
                    class="btn btn-light btn-sm"
                    @click="form.items.push({description:'',qty:1,rate:0})"
                  >
                    Add item
                  </button>
                  <div class="row g-3 mt-2">
                    <div class="col-md-3">
                      <label class="form-label">Discount</label
                      ><input
                        type="number"
                        class="form-control"
                        x-model.number="form.discount"
                      />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Tax</label
                      ><input
                        type="number"
                        class="form-control"
                        x-model.number="form.tax"
                      />
                    </div>
                    <div class="col-12">
                      <label class="form-label">Notes</label
                      ><textarea
                        class="form-control"
                        x-model="form.notes"
                      ></textarea>
                    </div>
                  </div>
                </div>
                <div class="card-footer">
                  <button class="btn btn-primary">Save invoice</button>
                </div>
              </form>
            </div>
            <script>
              function formPage() {
                return {
                  mode: pageMode(),
                  recordId: pageMode() === "edit" ? pathRecordId(true) : "",
                  form: {
                    invoiceNo: "",
                    enquiryId: queryValue("enquiryId"),
                    customerName: "",
                    providerName: "",
                    status: "draft",
                    issueDate: "",
                    dueDate: "",
                    items: [{ description: "Service", qty: 1, rate: 0 }],
                    discount: 0,
                    tax: 0,
                    notes: "",
                  },
                  error: "",
                  async init() {
                    if (this.mode === "edit")
                      this.form = {
                        ...this.form,
                        ...(await apiFetch("/api/invoice/" + this.recordId))
                          .data,
                      };
                  },
                  async save() {
                    try {
                      await apiFetch(
                        this.mode === "edit"
                          ? "/api/invoice/" + this.recordId
                          : "/api/invoice",
                        {
                          method: this.mode === "edit" ? "PUT" : "POST",
                          body: JSON.stringify(this.form),
                        },
                      );
                      location.href = "/billing";
                    } catch (e) {
                      this.error = e.message;
                    }
                  },
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
