{
  "name": "service-crm-admin",
  "version": "1.0.0",
  "description": "Express Generator-style LeadOps CRM for lead intake, verification, approval, follow-ups, provider onboarding and search.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "seed": "node scripts/seed.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "test:integration": "node --test test/*.test.js",
    "test:mongo": "RUN_MONGO_INTEGRATION=true node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "fs-extra": "^11.2.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.24.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
