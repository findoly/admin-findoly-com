{
  "name": "service-crm-admin",
  "version": "1.0.0",
  "description": "Simple Alpine.js CRM with dedicated frontend and API routes, denormalized MongoDB schemas and one-to-many lead distribution.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "check": "node scripts/check.js",
    "test": "node --test",
    "seed": "node scripts/seed.js",
    "migrate:structure": "node scripts/migrate-structure.js",
    "migrate:lead-distribution": "node scripts/migrate-structure.js",
    "migrate:agent-payouts": "node scripts/migrate-agent-payouts.js",
    "migrate:marketplace-location": "node scripts/backfill-marketplace-locations.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/client-sesv2": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "mongoose": "^8.24.1",
    "morgan": "^1.10.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
