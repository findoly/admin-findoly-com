#!/usr/bin/env node
"use strict";

require("dotenv").config();

const http = require("http");
const { loadAwsSecrets } = require("../config/load-aws-secrets");
const { createCloudWatchLogger } = require("../services/logging/cloudwatch-logger");

const cloudwatchLogger = createCloudWatchLogger({
  service: "crm",
  credentialPrefix: "CRM_SECRETS_",
  defaultLogGroup: "/findoly/crm/production",
});
cloudwatchLogger.install();

let server = null;
let mongoose = null;
let shuttingDown = false;
let runPromise = null;
let signalHandlersInstalled = false;
let processErrorHandlersInstalled = false;
let fatalErrorHandling = false;
let activeHandler = startupHandler;
let bootstrapState = "starting";

function resolvePort(env = process.env) {
  const port = Number(env.PORT || 3000);
  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    throw new Error("PORT must be a whole number between 1 and 65535");
  }
  return port;
}

function startupHandler(_req, res) {
  res.statusCode = 503;
  res.setHeader("Content-Type", "application/json; charset=utf-8");
  res.setHeader("Cache-Control", "no-store");
  res.setHeader("Retry-After", "3");
  res.end(JSON.stringify({
    success: false,
    code: "CRM_STARTING",
    message: bootstrapState === "failed" ? "CRM startup failed" : "CRM is starting",
  }));
}

function dispatchRequest(req, res) {
  return activeHandler(req, res);
}

function listen(serverInstance, port) {
  return new Promise((resolve, reject) => {
    const onError = (error) => {
      serverInstance.off("error", onError);
      reject(error);
    };
    serverInstance.once("error", onError);
    serverInstance.listen(port, () => {
      serverInstance.off("error", onError);
      resolve();
    });
  });
}

async function closeServer() {
  if (!server || !server.listening) return;
  await new Promise((resolve) => server.close(resolve));
}

async function shutdown(signal) {
  if (shuttingDown) return;
  shuttingDown = true;
  console.log(`${signal} received. Shutting down CRM gracefully...`);

  const configuredTimeout = Number(process.env.SHUTDOWN_TIMEOUT_MS || 10000);
  const shutdownTimeoutMs = Number.isFinite(configuredTimeout)
    ? Math.min(Math.max(configuredTimeout, 1000), 120000)
    : 10000;
  const forceTimer = setTimeout(() => {
    console.error("Graceful shutdown timed out");
    process.exit(1);
  }, shutdownTimeoutMs);
  forceTimer.unref();

  await closeServer();
  if (mongoose && mongoose.connection.readyState !== 0) {
    await mongoose.disconnect().catch((error) => console.error("MongoDB disconnect error:", error.message));
  }

  clearTimeout(forceTimer);
  await cloudwatchLogger.shutdown({ timeoutMs: 2000 });
  process.exit(0);
}

function installSignalHandlers() {
  if (signalHandlersInstalled) return;
  signalHandlersInstalled = true;
  process.once("SIGTERM", () => shutdown("SIGTERM"));
  process.once("SIGINT", () => shutdown("SIGINT"));
}

function installProcessErrorHandlers() {
  if (processErrorHandlersInstalled) return;
  processErrorHandlersInstalled = true;

  process.on("unhandledRejection", (reason) => {
    console.error({
      event: "unhandled_rejection",
      error: reason instanceof Error
        ? { name: reason.name, message: reason.message, stack: reason.stack }
        : String(reason),
    });
  });

  process.on("uncaughtException", async (error) => {
    if (fatalErrorHandling) return;
    fatalErrorHandling = true;
    console.error({
      event: "uncaught_exception",
      error: {
        name: error?.name || "Error",
        message: error?.message || String(error),
        stack: error?.stack || "",
      },
    });
    process.exitCode = 1;
    await closeServer().catch(() => {});
    if (mongoose && mongoose.connection.readyState !== 0) {
      await mongoose.disconnect().catch((disconnectError) => {
        console.error("MongoDB disconnect error after uncaught exception:", disconnectError);
      });
    }
    await cloudwatchLogger.flush({ timeoutMs: 2000 });
    process.exit(1);
  });
}

async function start({
  loadSecrets = loadAwsSecrets,
  loadApp = () => require("../app"),
  loadMongoose = () => require("mongoose"),
  httpModule = http,
} = {}) {
  const port = resolvePort();
  activeHandler = startupHandler;
  bootstrapState = "starting";
  server = httpModule.createServer(dispatchRequest);
  await listen(server, port);
  console.log(`CRM bootstrap listener active on port ${port}`);

  try {
    const secretResult = await loadSecrets();
    cloudwatchLogger.configureFromEnv();
    if (!secretResult.skipped) {
      console.log(`CRM configuration loaded from AWS Secrets Manager (${secretResult.loaded} values)`);
    }

    const app = loadApp();
    mongoose = loadMongoose();
    app.set("port", port);
    await app.locals.databasePromise;

    activeHandler = app;
    bootstrapState = "ready";
    server.on("error", (error) => {
      console.error("HTTP server error:", error);
      process.exitCode = 1;
    });
    console.log(`Findoly CRM listening on port ${port}`);
    return server;
  } catch (error) {
    bootstrapState = "failed";
    activeHandler = startupHandler;
    await closeServer().catch(() => {});
    throw error;
  }
}

function run() {
  if (runPromise) return runPromise;
  installSignalHandlers();
  installProcessErrorHandlers();
  runPromise = start().catch(async (error) => {
    console.error("CRM startup failed:", error.message);
    process.exitCode = 1;
    await cloudwatchLogger.flush({ timeoutMs: 2000 });
    throw error;
  });
  return runPromise;
}

run().catch(() => {});

module.exports = {
  cloudwatchLogger,
  dispatchRequest,
  installProcessErrorHandlers,
  installSignalHandlers,
  listen,
  resolvePort,
  run,
  shutdown,
  start,
  startupHandler,
};
